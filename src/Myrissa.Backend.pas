function TMyrSSAFunc.HasLocalDecl(const AName: string): Boolean;
var
  LI: Integer;
begin
  // True if this function declares a local or parameter with this name.
  // Used to make function scope shadow same-named globals.
  Result := False;
  for LI := 0 to GetLocalCount() - 1 do
  begin
    if GetLocal(LI).LocalName = AName then
    begin
      Result := True;
      Exit;
    end;
  end;
end;

function TMyrSSAFunc.FindLocalIndex(const AName: string): Integer;
var
  LI: Integer;
begin
  // Index into the local table for a named local or parameter, -1 if absent.
  // HasLocalDecl and IsByRefParam both run this same scan; this is the
  // index-returning form the aggregate-address resolver needs.
  Result := -1;
  for LI := 0 to GetLocalCount() - 1 do
  begin
    if GetLocal(LI).LocalName = AName then
    begin
      Result := LI;
      Exit;
    end;
  end;
end;

