function TMyrIR.High(const ATypeName: string): TMyrIRExpr;
var
  LTypeIndex: Integer;
  LEntry: TMyrIRTypeEntry;
begin
  LTypeIndex := FindType(ATypeName);
  if LTypeIndex < 0 then
  begin
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_IR_UNKNOWN_TYPE, RSIRHighUnknown, [ATypeName]);
    Result := TMyrIRExpr.None();
    Exit;
  end;

  LEntry := FTypes[LTypeIndex];
  case LEntry.Kind of
    tkFixedArray:
      Result := MakeInt64(LEntry.FixedArrayType.HighBound);
    tkEnum:
      begin
        if Length(LEntry.EnumType.Values) > 0 then
          Result := MakeInt64(LEntry.EnumType.Values[System.High(LEntry.EnumType.Values)].OrdinalValue)
        else
          Result := MakeInt64(0);
      end;
    tkSet:
      Result := MakeInt64(LEntry.SetType.HighBound);
  else
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_IR_TYPE_BUILD, RSIRHighNotApplicable, [ATypeName]);
    Result := TMyrIRExpr.None();
  end;
end;

