  { SHF_ALLOC }
  SHF_ALLOC = 2;

  { SHF_EXECINSTR }
  SHF_EXECINSTR = 4;

  { ELF_SHENTSIZE }
  ELF_SHENTSIZE = 64;

  { ELF_SYMENTSIZE }
