{ TMyrExpr }
class operator TMyrExpr.Add(const A, B: TMyrExpr): TMyrExpr;
begin
  Assert(Assigned(TMyrExprFactory.OnBinary), 'TMyrExpr: No expression factory registered');
  Result := TMyrExprFactory.OnBinary(A.Owner, opAdd, A.Index, B.Index);
end;

