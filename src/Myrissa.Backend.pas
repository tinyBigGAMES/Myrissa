  LInstr.Dest := Result;
  AddInstr(LInstr);
end;

function TMyrCodeBuilder.VaArgAt(const AIndex: TMyrOperand; const AType: TMyrValueType): TMyrTempHandle;
var
  LInstr: TMyrInstruction;
begin
  Result := AllocTemp();

  LInstr := Default(TMyrInstruction);
  LInstr.Kind := ikVaArgAt;
  LInstr.Dest := Result;
  LInstr.Op1 := AIndex;                          // Index expression
  LInstr.Op2 := TMyrOperand.FromImm(Ord(AType)); // Type to read as
  AddInstr(LInstr);
end;

function TMyrCodeBuilder.SyscallOp(const ANumber: TMyrOperand; const AArgs: array of TMyrOperand): TMyrTempHandle;
var
  LInstr: TMyrInstruction;
  LI: Integer;
begin
  Result := AllocTemp();

  LInstr := Default(TMyrInstruction);
  LInstr.Kind := ikSyscall;
  LInstr.Dest := Result;
  LInstr.Op1 := ANumber;              // Syscall number, loaded to RAX last

  // Arguments map to RDI, RSI, RDX, R10, R8, R9 in order (Linux x86_64 ABI)
  SetLength(LInstr.Args, Length(AArgs));
  for LI := 0 to High(AArgs) do
    LInstr.Args[LI] := AArgs[LI];

  AddInstr(LInstr);
end;



