  end;

  // Helper: IDIV reg64 (signed divide RDX:RAX by reg, result in RAX, remainder in RDX)
  procedure EmitIdivReg(const AReg: Byte);
  begin
    EmitRex(True, False, False, AReg >= 8);
    EmitByte($F7);  // IDIV r/m64
    EmitModRM(3, 7, AReg and 7);  // reg=7 for IDIV
  end;

  // Helper: DIV reg64 (UNSIGNED divide RDX:RAX by reg, result in RAX,
  // remainder in RDX). Shares opcode F7 with IDIV and differs only in the
  // ModRM reg field: /6 is DIV, /7 is IDIV. Verified against the
  // Intel SDM Vol.2 F7 group-3 opcode extension table.
  // The caller MUST zero RDX first (XOR RDX,RDX) - never CQO, which
  // sign-extends and is exactly what makes the signed path wrong above 2^63.
  procedure EmitDivReg(const AReg: Byte);
  begin
    EmitRex(True, False, False, AReg >= 8);
    EmitByte($F7);  // DIV r/m64
    EmitModRM(3, 6, AReg and 7);  // reg=6 for DIV
  end;

  // Helper: JS rel8 (jump if sign flag set). 2 bytes. Used by the unsigned
  // int-to-float fixup, where a set sign bit means the value is >= 2^63 and
  // the plain signed CVTSI2SD would produce a negative double.
  procedure EmitJsRel8(const ADisp: Int8);
  begin
    EmitByte($78);  // JS rel8
    EmitByte(Byte(ADisp));
  end;

