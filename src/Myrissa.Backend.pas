function TMyrELFLinker.HasSymbol(const AName: string): Boolean;
begin
  // Index is normally built by Resolve(); a query-only caller may ask before
  if (FSymbolIndex.Count = 0) and (FObjects.Count > 0) then
    BuildGlobalSymbolIndex();
  Result := FSymbolIndex.ContainsKey(AName);
end;

function TMyrELFLinker.GetNeededLibs(): TArray<string>;
var
  LNames: TStringList;
  LI: Integer;
  LJ: Integer;
begin
  // Distinct needlib names across ALL loaded objects (not just selected):
  // chasing happens before Resolve(), when nothing is selected yet.
  LNames := TStringList.Create();
  try
    LNames.CaseSensitive := False;
    LNames.Duplicates := dupIgnore;
    LNames.Sorted := True;

    for LI := 0 to FObjects.Count - 1 do
      for LJ := 0 to High(FObjects[LI].NeededLibs) do
        LNames.Add(FObjects[LI].NeededLibs[LJ]);

    Result := LNames.ToStringArray();
  finally
    LNames.Free();
  end;
end;

function TMyrELFLinker.GetShortImports(): TArray<TMyrShortImportEntry>;
var
  LList: TList<TMyrShortImportEntry>;
  LSeen: TStringList;
  LI: Integer;
  LJ: Integer;
begin
  // needdll pairs across ALL loaded objects, deduplicated on symbol name.
  LList := TList<TMyrShortImportEntry>.Create();
  LSeen := TStringList.Create();
  try
    LSeen.CaseSensitive := True;
    LSeen.Duplicates := dupIgnore;
    LSeen.Sorted := True;
    for LI := 0 to FObjects.Count - 1 do
    begin
      for LJ := 0 to High(FObjects[LI].NeededDlls) do
      begin
        if LSeen.IndexOf(FObjects[LI].NeededDlls[LJ].SymbolName) >= 0 then
          Continue;
        LSeen.Add(FObjects[LI].NeededDlls[LJ].SymbolName);
        LList.Add(FObjects[LI].NeededDlls[LJ]);
      end;
    end;
    Result := LList.ToArray();
  finally
    LSeen.Free();
    LList.Free();
  end;
end;

