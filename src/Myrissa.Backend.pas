function TMyrNativeBackend.GetFieldOffset(const ATypeName: string; const AFieldName: string): Integer;
var
  LTypeIndex: Integer;
  LFieldInfo: TMyrIR.TMyrIRRecordField;
begin
  LTypeIndex := FindType(ATypeName);
  if LTypeIndex < 0 then
    Exit(-1);

  if FIR.FindRecordField(LTypeIndex, AFieldName, LFieldInfo) then
    Result := LFieldInfo.FieldOffset
  else
    Result := -1;
end;

