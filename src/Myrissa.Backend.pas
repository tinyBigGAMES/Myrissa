    function GetArrayReleaseTarget(): TMyrSSAOperand;
    function GetArrayReleaseOnDetachTarget(): TMyrSSAOperand;
    function GetDynLenTarget(): TMyrSSAOperand;
    function GetArrayReleaseCompositeTarget(): TMyrSSAOperand;
    function GetArrayReleaseCompositeOnDetachTarget(): TMyrSSAOperand;
    // Appends a compiler-synthesized function (a per-type release thunk) to the
    // function list and returns its index. The index is stable for sikFuncAddr:
