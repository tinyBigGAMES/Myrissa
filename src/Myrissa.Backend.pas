function TMyrCOFFLinker.HasSymbol(const AName: string): Boolean;
begin
  // Index is normally built by Resolve(); a query-only caller may ask before
  if (FSymbolIndex.Count = 0) and (FObjects.Count > 0) then
    BuildGlobalSymbolIndex();
  Result := FSymbolIndex.ContainsKey(AName);
end;

function TMyrCOFFLinker.GetNeededLibs(): TArray<string>;
var
  LNames: TStringList;
  LI: Integer;
  LJ: Integer;
begin
  // Distinct /DEFAULTLIB names across ALL loaded objects (not just selected):
  // chasing happens before Resolve(), when nothing is selected yet.
  LNames := TStringList.Create();
  try
    LNames.CaseSensitive := False;
    LNames.Duplicates := dupIgnore;
    LNames.Sorted := True;

    for LI := 0 to FObjects.Count - 1 do
      for LJ := 0 to High(FObjects[LI].DefaultLibs) do
        LNames.Add(FObjects[LI].DefaultLibs[LJ]);

    Result := LNames.ToStringArray();
  finally
    LNames.Free();
  end;
end;

function TMyrCOFFLinker.GetShortImports(): TArray<TMyrShortImportEntry>;
var
  LList: TList<TMyrShortImportEntry>;
  LSeen: TStringList;
  LI: Integer;
  LJ: Integer;
begin
  // Two sources, one result: IMPORT_OBJECT members parsed from import
  // libraries (foreign SDK .lib files), plus the .myrissa.needdll bindings
  // recorded by Myrissa objects (the COFF twin of the ELF note). Dedup on
  // symbol name, first seen wins.
  LList := TList<TMyrShortImportEntry>.Create();
  LSeen := TStringList.Create();
  try
    LSeen.CaseSensitive := True;
    LSeen.Duplicates := dupIgnore;
    LSeen.Sorted := True;
    for LI := 0 to FShortImports.Count - 1 do
    begin
      if LSeen.IndexOf(FShortImports[LI].SymbolName) >= 0 then
        Continue;
      LSeen.Add(FShortImports[LI].SymbolName);
      LList.Add(FShortImports[LI]);
    end;
    for LI := 0 to FObjects.Count - 1 do
    begin
      for LJ := 0 to High(FObjects[LI].NeededDlls) do
      begin
        if LSeen.IndexOf(FObjects[LI].NeededDlls[LJ].SymbolName) >= 0 then
          Continue;
        LSeen.Add(FObjects[LI].NeededDlls[LJ].SymbolName);
        LList.Add(FObjects[LI].NeededDlls[LJ]);
      end;
    end;
    Result := LList.ToArray();
  finally
    LSeen.Free();
    LList.Free();
  end;
end;

