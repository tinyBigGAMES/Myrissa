  { TMyrSSAStringCleanup }
  TMyrSSAStringCleanup = class(TMyrSSAPass)
  private
    FSSABuilder: TMyrSSABuilder;
    FIR: TMyrIR;
    // Maps an IR composite type index onto the index of the release thunk
    // synthesized for it. One thunk per element TYPE, not per array or per use
    // site, so array[0..9999] of TItem emits exactly one thunk.
    FThunkCache: TDictionary<Integer, Integer>;
    // Emits the cleanup call for a single managed LEAF slot (string, wstring
    // or dynarray). ASlot is consumed directly as the load source, so it may
    // be a local index, a global index, or a pointer var produced by
    // sikFieldAddr. AInstrIdx advances past every instruction inserted.
    // When AHasPrefixArg is True, APrefixArg is passed as the FIRST call
    // argument ahead of the loaded value - the DLL detach twins take the
    // fdwReason in that position.
    procedure DoEmitLeafRelease(const AFunc: TMyrSSAFunc; const ABlock: TMyrSSABlock;
      var AInstrIdx: Integer; const ASlot: TMyrSSAOperand;
      const ATargetFunc: TMyrSSAOperand; const AMemSize: Integer;
      const APrefixArg: TMyrSSAOperand; const AHasPrefixArg: Boolean);
    // Selects the cleanup routine for a managed leaf type. The three indices
    // are positional - string, wstring, dynarray - so the EXE path supplies
    // the plain triple and the DLL path supplies the OnDetach triple.
    // Returns -1 when the type is not a releasable leaf.
    function DoResolveLeafFuncIdx(const ATypeRef: TMyrTypeRef;
      const AStrRelease: TMyrSSAOperand; const AFreeMem: TMyrSSAOperand;
      const ADynFree: TMyrSSAOperand): TMyrSSAOperand;
    // Maps a managed leaf type onto RT_ArrayRelease's AKind selector:
    // 0 = string, 1 = wstring, 2 = dynarray. Returns -1 when the type is not
    // a releasable leaf. The dispatch order MUST match DoResolveLeafFuncIdx -
    // wstring is tested before string.
    function DoResolveLeafKind(const ATypeRef: TMyrTypeRef): Integer;
    // Recursively emits releases for every managed member reachable from
    // APtrVar, which must hold the ADDRESS of a value of type ATypeRef.
    // Records recurse per managed field; aliases unwrap. Unions and overlay
    // groups are deliberately SKIPPED - their members share storage and there
    // is no discriminant, so releasing one would be an unsound guess and
    // releasing several would be a double free.
    procedure DoEmitCompositeRelease(const AFunc: TMyrSSAFunc;
      const ABlock: TMyrSSABlock; var AInstrIdx: Integer; const APtrVar: TMyrSSAVar;
      const ATypeRef: TMyrTypeRef; const AStrRelease: TMyrSSAOperand;
      const AFreeMem: TMyrSSAOperand; const ADynFree: TMyrSSAOperand;
      const APrefixArg: TMyrSSAOperand; const AHasPrefixArg: Boolean);
    // Entry point used by the locals and globals cleanup loops. Leaf types
    // keep the original direct load(slot) form; composites take the address
    // of the slot once and then recurse through DoEmitCompositeRelease.
    procedure DoEmitManagedRelease(const AFunc: TMyrSSAFunc;
      const ABlock: TMyrSSABlock; var AInstrIdx: Integer; const ASlot: TMyrSSAOperand;
      const ATypeRef: TMyrTypeRef; const AStrRelease: TMyrSSAOperand;
      const AFreeMem: TMyrSSAOperand; const ADynFree: TMyrSSAOperand;
      const APrefixArg: TMyrSSAOperand; const AHasPrefixArg: Boolean);
    // Returns the index of the release thunk for composite element type
    // ATypeRef, synthesizing it on first use and caching it by type index.
    // The thunk has signature (APtr: Pointer) and releases every managed member
    // reachable from APtr by delegating to DoEmitCompositeRelease - the member
    // walk is NOT reimplemented here.
    // Returns -1 when the type is not a composite with managed members, or when
    // the thunk cannot be built.
    function DoGetCompositeThunkIdx(const ATypeRef: TMyrTypeRef;
      const AStrRelease: TMyrSSAOperand; const AFreeMem: TMyrSSAOperand;
      const ADynFree: TMyrSSAOperand): Integer;
    // Emits the composite-element array walk: takes the thunk's address and
    // calls RT_ArrayReleaseComposite(ptr, count, stride, thunk). ACountOperand
    // supplies the element count, which is an immediate for a fixed array and a
    // runtime value for a dynarray. Returns False when the walk cannot be
    // emitted, leaving AInstrIdx untouched.
    function DoEmitCompositeArrayWalk(const AFunc: TMyrSSAFunc;
      const ABlock: TMyrSSABlock; var AInstrIdx: Integer;
      const ABaseOperand: TMyrSSAOperand; const ACountOperand: TMyrSSAOperand;
      const AElemTypeRef: TMyrTypeRef; const AElemStride: Int64;
      const AStrRelease: TMyrSSAOperand; const AFreeMem: TMyrSSAOperand;
      const ADynFree: TMyrSSAOperand; const APrefixArg: TMyrSSAOperand;
      const AHasPrefixArg: Boolean): Boolean;
  public
    constructor Create(const ASSABuilder: TMyrSSABuilder; const AIR: TMyrIR); reintroduce;
    destructor Destroy(); override;
    procedure Run(const AFunc: TMyrSSAFunc); override;
  end;

  { TMyrSSABuilder }
  TMyrSSABuilder = class(TBaseObject)
  private
    FOptions: TMyrSSAOptions;
