  finally
    LProduct.Free();
  end;
end;

function TMyrCodegen.GenerateELF(): TBytes;
var
  LProduct: TMyrBuildProduct;
  LWriter: TMyrELFWriter;
begin
  Result := nil;
  LProduct := TMyrBuildProduct.Create();
  try
    if not EmitMachineCode(LProduct) then
      Exit;

    // Publish the command line storage globals, captured during Compile()
    // before its state cleanup. The _start stub fills these from the initial
    // stack, so the writer needs their .data placement. -1 means the runtime
    // globals are absent and the stub emits padding instead.
    LProduct.ArgcGlobalIndex := FArgcDataIndex;
    LProduct.ArgvGlobalIndex := FArgvDataIndex;
    LProduct.HostGlobals.AddRange(FCompileHostGlobals);

    LWriter := TMyrELFWriter.Create();
    try
      LWriter.SetErrors(FErrors);
      LWriter.SetStatusCallback(FStatusCallback.Callback, FStatusCallback.UserData);
      LWriter.Init(FCode, FCompilePublicGlobals, FLinkedLibs, FLinkedObjs,
        FOutputPath, GetDumpIR());
      Result := LWriter.WriteImage(LProduct, FData, FGlobals, FImports, FExports,
        FOutputType, FSubsystem);
      FTextRVA := LProduct.TextRVA;  // Save for debug info emission
      FDataRVA := LProduct.DataRVA;  // Save for debug info emission
    finally
      LWriter.Free();
    end;
  finally
    LProduct.Free();
  end;
end;


// Platform-specific code emission helpers
procedure EmitStackProbe_x64(const ATextSection: TMemoryStream; const AFrameSize: Cardinal);
var
  LProbeLoopTop: Int64;
begin
  // MOV EAX, AFrameSize (B8 imm32) — load total frame size as loop counter
  ATextSection.WriteData(Byte($B8));
  ATextSection.WriteData(Int32(AFrameSize));

  // loop_top: — probe loop touches each 4K page sequentially
  LProbeLoopTop := ATextSection.Size;

  // SUB RSP, 4096 (REX.W 81 /5 imm32) — move RSP down one page
  ATextSection.WriteData(Byte($48));
  ATextSection.WriteData(Byte($81));
  ATextSection.WriteData(Byte((3 shl 6) or (5 shl 3) or 4));  // ModRM: mod=11, reg=5(SUB), rm=RSP
  ATextSection.WriteData(Int32(4096));

  // TEST [RSP], ESP (85 24 24) — touch the page to trigger guard page commit
  ATextSection.WriteData(Byte($85));
  ATextSection.WriteData(Byte($24));
  ATextSection.WriteData(Byte($24));

  // SUB EAX, 4096 (2D imm32) — decrement remaining counter
  ATextSection.WriteData(Byte($2D));
  ATextSection.WriteData(Int32(4096));

  // CMP EAX, 4096 (3D imm32) — check if another full page remains
  ATextSection.WriteData(Byte($3D));
  ATextSection.WriteData(Int32(4096));

  // JAE loop_top (73 rel8) — unsigned: continue while remaining >= 4096
  ATextSection.WriteData(Byte($73));
  ATextSection.WriteData(Byte(LProbeLoopTop - ATextSection.Size - 1));

  // SUB RSP, RAX (REX.W 29 C4) — allocate remaining bytes (< 4096)
  ATextSection.WriteData(Byte($48));
  ATextSection.WriteData(Byte($29));
  ATextSection.WriteData(Byte((3 shl 6) or (0 shl 3) or 4));  // ModRM: mod=11, reg=RAX(0), rm=RSP(4)
end;


// TMyrCodegen - Compile (IR -> SSA -> x64)
procedure TMyrCodegen.Compile(const AIR: TMyrIR; const AStatusCallback: TStatusCallback; const AUserData: Pointer);
var
  LI: Integer;
  LSize: Integer;
  LSSA: TMyrSSABuilder;
  LImportName: string;
  LImportExternalName: string;
  LExpr: TMyrIR.TMyrIRExprNode;
  LDataPtr: PByte;
  LVarType: TMyrValueType;
  LGlobalIndex: Integer;
begin
  // Step 1: Emit strings to data section
  SetLength(FCompileStringHandles, AIR.GetStringCount());
  for LI := 0 to AIR.GetStringCount() - 1 do
  begin
    if AIR.GetString(LI).IsWide then
      FCompileStringHandles[LI] := GetData().AddStringW(AIR.GetString(LI).Value)
    else
      FCompileStringHandles[LI] := GetData().AddString(AIR.GetString(LI).Value);
  end;

  // Step 2: Emit imports
  SetLength(FCompileImportHandles, AIR.GetImportCount());
  for LI := 0 to AIR.GetImportCount() - 1 do
  begin
    if AIR.GetImport(LI).Linkage = plC then
      LImportName := AIR.GetImport(LI).FuncName
    else
      LImportName := TMyrABIMangler.MangleFunctionWithLinkage(
        AIR.GetImport(LI).FuncName, AIR.GetImport(LI).ParamTypes, AIR.GetImport(LI).Linkage);
    // A re-export's ExternalName is the symbol the library exports: it
    // mangles under the same linkage rule as the referenced name.
    LImportExternalName := AIR.GetImport(LI).ExternalName;
    if (LImportExternalName <> '') and (AIR.GetImport(LI).Linkage <> plC) then
      LImportExternalName := TMyrABIMangler.MangleFunctionWithLinkage(
        LImportExternalName, AIR.GetImport(LI).ParamTypes, AIR.GetImport(LI).Linkage);
    FCompileImportHandles[LI] := GetImports().Add(
      AIR.GetImport(LI).DllName, LImportName,
      LImportExternalName,
      AIR.GetImport(LI).ReturnType, AIR.GetImport(LI).IsStatic,
      AIR.GetImport(LI).Linkage, AIR.GetImport(LI).ParamTypes,
      AIR.GetImport(LI).HostAddr);
  end;

  // Store param types for float/int register selection in GeneratePE
  SetLength(FCompileImportParamTypes, AIR.GetImportCount());
  for LI := 0 to AIR.GetImportCount() - 1 do
    FCompileImportParamTypes[LI] := Copy(AIR.GetImport(LI).ParamTypes);

  // Store composite param type refs for struct argument handling
  SetLength(FCompileImportParamTypeRefs, AIR.GetImportCount());
  for LI := 0 to AIR.GetImportCount() - 1 do
    FCompileImportParamTypeRefs[LI] := Copy(AIR.GetImport(LI).ParamTypeRefs);

  // Store IR reference for type size queries during emission
  FCompileIR := AIR;

  // Step 3: Emit globals to data section
  SetLength(FCompileGlobalHandles, AIR.GetGlobalCount());
  for LI := 0 to AIR.GetGlobalCount() - 1 do
  begin
    if not AIR.GetGlobal(LI).GlobalTypeRef.IsPrimitive and
       (AIR.GetGlobal(LI).GlobalTypeRef.TypeIndex >= 0) then
    begin
      LSize := AIR.GetTypeSize(AIR.GetGlobal(LI).GlobalTypeRef);
      if LSize <= 0 then
        LSize := 8;
    end
    else
    begin
      case AIR.GetGlobal(LI).GlobalType of
        cvtInt8, cvtUInt8:   LSize := 1;
        cvtInt16, cvtUInt16: LSize := 2;
        cvtInt32, cvtUInt32, cvtFloat32: LSize := 4;
        cvtInt64, cvtUInt64, cvtFloat64, cvtPointer: LSize := 8;
      else
        LSize := 8;
      end;
    end;
    FCompileGlobalHandles[LI] := GetGlobals().Reserve(LSize);

    // Write initial value if present (otherwise stays zero-initialized)
    if AIR.GetGlobal(LI).InitExpr >= 0 then
    begin
      LExpr := AIR.GetExpression(AIR.GetGlobal(LI).InitExpr);
      LDataPtr := PByte(GetGlobals().GetDataPointer()) +
        GetGlobals().GetEntry(FCompileGlobalHandles[LI]).Offset;
      if LExpr.Kind = TMyrIR.TMyrIRExprKind.ekConstInt then
      begin
        case LSize of
          1: PByte(LDataPtr)^ := Byte(LExpr.ConstInt);
          2: PWord(LDataPtr)^ := Word(LExpr.ConstInt);
          4: PCardinal(LDataPtr)^ := Cardinal(LExpr.ConstInt);
          8: PInt64(LDataPtr)^ := LExpr.ConstInt;
        end;
      end
      else if LExpr.Kind = TMyrIR.TMyrIRExprKind.ekConstFloat then
      begin
        case LSize of
          4: PSingle(LDataPtr)^ := Single(LExpr.ConstFloat);
          8: PDouble(LDataPtr)^ := LExpr.ConstFloat;
        end;
      end;
    end;
  end;

  // Collect public globals — store resolved .data offsets for export table in GeneratePE
  FCompilePublicGlobals.Clear();
  FCompileHostGlobals.Clear();
  for LI := 0 to AIR.GetGlobalCount() - 1 do
  begin
    if AIR.GetGlobal(LI).IsPublic then
      FCompilePublicGlobals.Add(TPair<Integer, string>.Create(
        Integer(GetGlobals().GetEntry(FCompileGlobalHandles[LI]).Offset),
        AIR.GetGlobal(LI).GlobalName));
    // Every global this module defines itself is a candidate provider for a
    // linked static lib's undefined references (imported globals are not
    // ours to provide)
    if AIR.GetGlobal(LI).ImportIndex < 0 then
      FCompileHostGlobals.Add(TPair<string, Cardinal>.Create(
        AIR.GetGlobal(LI).GlobalName,
        GetGlobals().GetEntry(FCompileGlobalHandles[LI]).Offset));
  end;

  // Persist the command-line globals' data indexes now: the cleanup at the end
  // of this method clears FCompileIR and FCompileGlobalHandles, but GenerateELF
  // runs later and needs these to emit the _start argc/argv capture prologue.
  FArgcDataIndex := -1;
  FArgvDataIndex := -1;
  LGlobalIndex := AIR.FindGlobal(RT_Argc);
  if LGlobalIndex >= 0 then
    FArgcDataIndex := FCompileGlobalHandles[LGlobalIndex].Index;
  LGlobalIndex := AIR.FindGlobal(RT_Argv);
  if LGlobalIndex >= 0 then
    FArgvDataIndex := FCompileGlobalHandles[LGlobalIndex].Index;

  // Record global variables in source map (for debugger)
  if FSourceMap <> nil then
  begin
    for LI := 0 to AIR.GetGlobalCount() - 1 do
    begin
      if AIR.GetGlobal(LI).GlobalTypeRef.IsPrimitive then
        LVarType := AIR.GetGlobal(LI).GlobalType
      else
        LVarType := cvtPointer;

      FSourceMap.AddVariable(0, AIR.GetGlobal(LI).GlobalName, LVarType,
        vlkMemory,
        Integer(GetGlobals().GetEntry(FCompileGlobalHandles[LI]).Offset),
        0, False, True, 0, 0);
    end;
  end;

  // Step 4: Build SSA from high-level IR
  LSSA := TMyrSSABuilder.Create();
  try
    LSSA.SetErrors(FErrors);

    if Assigned(AStatusCallback) then
      LSSA.SetStatusCallback(AStatusCallback, AUserData);

    LSSA.BuildFrom(AIR, GetDumpIR());
    LSSA.Optimize(GetOptimizationLevel());
    SetSSADump(LSSA.DumpSSA());

    // Eliminate phi nodes before emission
    for LI := 0 to LSSA.GetFunctionCount() - 1 do
      LSSA.EliminatePhiNodes(LSSA.GetFunction(LI));

    // Emit SSA to code builders
    EmitSSAToCode(LSSA);
  finally
    LSSA.Free();
  end;

  // Clear compilation state
  SetLength(FCompileImportHandles, 0);
  SetLength(FCompileStringHandles, 0);
  SetLength(FCompileGlobalHandles, 0);
  SetLength(FCompileImportParamTypes, 0);
  SetLength(FCompileImportParamTypeRefs, 0);
  FCompileIR := nil;
end;

function TMyrCodegen.ResolveSSAOperand(
  const AOp: TMyrSSAOperand;
  const ALocalHandles: TDictionary<string, TMyrLocalHandle>;
  const AVarTemps: TDictionary<string, TMyrTempHandle>
): TMyrOperand;
var
  LLocalHandle: TMyrLocalHandle;
  LTempHandle: TMyrTempHandle;
  LVarKey: string;
begin
  case AOp.Kind of
    sokNone:
      Result := TMyrOperand.None();
      
    sokImmediate:
      begin
        if AOp.ImmIsFloat then
          Result := TMyrOperand.FromImm(AOp.ImmFloat)
        else
          Result := TMyrOperand.FromImm(AOp.ImmInt);
      end;
      
    sokVar:
      begin
        LVarKey := AOp.Var_.ToString();
        
        // First check if it's a tracked SSA temp
        if AVarTemps.TryGetValue(LVarKey, LTempHandle) then
        begin
          Result := TMyrOperand.FromTemp(LTempHandle);
        end
        // Otherwise check if it's a local/param
        else if ALocalHandles.TryGetValue(AOp.Var_.BaseName, LLocalHandle) then
        begin
          // Load the local into a temp
          LTempHandle := GetCode().Load(LLocalHandle);
          Result := TMyrOperand.FromTemp(LTempHandle);
        end
        else
        begin
          // Unknown variable - return immediate 0
          Result := TMyrOperand.FromImm(Int64(0));
        end;
      end;
      
    sokData:
      begin
        // Data handle - use actual handle from FCompileStringHandles
        Result := TMyrOperand.FromData(FCompileStringHandles[AOp.DataIndex]);
      end;
      
    sokGlobal:
      begin
        // Imported globals (ImportIndex >= 0) live in another module -- access via IAT slot
        if FCompileIR.GetGlobal(AOp.GlobalIndex).ImportIndex >= 0 then
          Result := TMyrOperand.FromImport(FCompileImportHandles[FCompileIR.GetGlobal(AOp.GlobalIndex).ImportIndex])
        else
          // Local global - use actual handle from FCompileGlobalHandles (goes to .data section)
          Result := TMyrOperand.FromGlobal(FCompileGlobalHandles[AOp.GlobalIndex]);
      end;
      
    sokImport:
      begin
        // Import handle - use actual handle from FCompileImportHandles
        Result := TMyrOperand.FromImport(FCompileImportHandles[AOp.ImportIndex]);
      end;
      
    sokFunc:
      begin
        // Function handle
        Result := TMyrOperand.FromFunc(TMyrFuncHandle.Invalid());
        Result.FuncHandle.Index := AOp.FuncIndex;
      end;
      
    sokBlock:
      begin
        // Block reference - shouldn't be used as operand directly
        Result := TMyrOperand.None();
      end;
  else
    Result := TMyrOperand.None();
  end;
end;

function TMyrCodegen.StoreSSAVarValue(
  const ADest: TMyrSSAVar;
  const AValue: TMyrOperand;
  const ALocalHandles: TDictionary<string, TMyrLocalHandle>;
  const AVarTemps: TDictionary<string, TMyrTempHandle>
): TMyrTempHandle;
var
  LLocalHandle: TMyrLocalHandle;
  LVarKey: string;
begin
  LVarKey := ADest.ToString();
  
  // Check if this is a local variable (not a temp)
  if ALocalHandles.TryGetValue(ADest.BaseName, LLocalHandle) then
  begin
    // Store to local - DO NOT cache, always load fresh for loops to work
    GetCode().Store(LLocalHandle, AValue);
    Result := TMyrTempHandle.Invalid();
  end
  else
  begin
    // It's a temp variable - track the operand's temp handle
    if AValue.Kind = okTemp then
    begin
      Result := AValue.TempHandle;
      AVarTemps.AddOrSetValue(LVarKey, Result);
    end
    else if AValue.Kind = okImmediate then
    begin
      // Create a temp for immediate value - use add with 0
      Result := GetCode().OpAdd(AValue, Int64(0));
      AVarTemps.AddOrSetValue(LVarKey, Result);
    end
    else if AValue.Kind = okData then
    begin
      // Create a temp for data address - use add with 0 to materialize address
      Result := GetCode().OpAdd(AValue, Int64(0));
      AVarTemps.AddOrSetValue(LVarKey, Result);
    end
    else if AValue.Kind = okGlobal then
    begin
      // Create a temp for global address - use add with 0 to materialize address
      Result := GetCode().OpAdd(AValue, Int64(0));
      AVarTemps.AddOrSetValue(LVarKey, Result);
    end
    else if AValue.Kind = okImport then
    begin
      // Create a temp for import address (IAT pointer) - materialize via add+0
      Result := GetCode().OpAdd(AValue, Int64(0));
      AVarTemps.AddOrSetValue(LVarKey, Result);
    end
    else if AValue.Kind = okLocal then
    begin
      // Load local into temp
      Result := GetCode().Load(AValue.LocalHandle);
      AVarTemps.AddOrSetValue(LVarKey, Result);
    end
    else
    begin
      Result := TMyrTempHandle.Invalid();
    end;
  end;
end;

procedure TMyrCodegen.EmitSSACall(
  const AInstr: TMyrSSAInstr;
  const ALocalHandles: TDictionary<string, TMyrLocalHandle>;
  const AVarTemps: TDictionary<string, TMyrTempHandle>
);
var
  LArgs: TArray<TMyrOperand>;
  LFuncHandle: TMyrFuncHandle;
  LI: Integer;
  LArg: TMyrSSAOperand;
  LLocalHandle: TMyrLocalHandle;
  LLocalInfo: TMyrLocalInfo;
  LFuncInfo: TMyrFuncInfo;
begin
  // Resolve arguments, with special handling for large struct locals
  SetLength(LArgs, Length(AInstr.CallArgs));
  LFuncInfo := GetCode().GetFunc(GetCode().GetCurrentFuncHandle().Index);
  for LI := 0 to High(AInstr.CallArgs) do
  begin
    LArg := AInstr.CallArgs[LI];
    // Check for large struct local that needs address passed (Win64 ABI: >8 bytes)
    if (LArg.Kind = sokVar) and
       (not AVarTemps.ContainsKey(LArg.Var_.ToString())) and
       ALocalHandles.TryGetValue(LArg.Var_.BaseName, LLocalHandle) and
       (not LLocalHandle.IsParam) then
    begin
      LLocalInfo := LFuncInfo.Locals[LLocalHandle.Index];
      if (LLocalInfo.LocalType = cvtVoid) and (LLocalInfo.LocalSize > 8) then
      begin
        // Large struct local - return local operand for LEA in backend
        LArgs[LI] := TMyrOperand.FromLocal(LLocalHandle);
        Continue;
      end;
    end;
    LArgs[LI] := ResolveSSAOperand(LArg, ALocalHandles, AVarTemps);
  end;
  
  // Call based on target type
  if AInstr.CallTarget.Kind = sokImport then
  begin
    if Length(LArgs) > 0 then
      GetCode().Call(FCompileImportHandles[AInstr.CallTarget.ImportIndex], LArgs)
    else
      GetCode().Call(FCompileImportHandles[AInstr.CallTarget.ImportIndex]);
  end
  else if AInstr.CallTarget.Kind = sokFunc then
  begin
    // Local function call
    LFuncHandle.Index := AInstr.CallTarget.FuncIndex;
    if Length(LArgs) > 0 then
      GetCode().Call(LFuncHandle, LArgs)
    else
      GetCode().Call(LFuncHandle);
  end;
end;

function TMyrCodegen.EmitSSACallWithResult(
  const AInstr: TMyrSSAInstr;
  const ALocalHandles: TDictionary<string, TMyrLocalHandle>;
  const AVarTemps: TDictionary<string, TMyrTempHandle>
): TMyrTempHandle;
var
  LArgs: TArray<TMyrOperand>;
  LFuncHandle: TMyrFuncHandle;
  LI: Integer;
  LArg: TMyrSSAOperand;
  LLocalHandle: TMyrLocalHandle;
  LLocalInfo: TMyrLocalInfo;
  LFuncInfo: TMyrFuncInfo;
begin
  // Resolve arguments, with special handling for large struct locals
  SetLength(LArgs, Length(AInstr.CallArgs));
  LFuncInfo := GetCode().GetFunc(GetCode().GetCurrentFuncHandle().Index);
  for LI := 0 to High(AInstr.CallArgs) do
  begin
    LArg := AInstr.CallArgs[LI];
    // Check for large struct local that needs address passed (Win64 ABI: >8 bytes)
    if (LArg.Kind = sokVar) and
       (not AVarTemps.ContainsKey(LArg.Var_.ToString())) and
       ALocalHandles.TryGetValue(LArg.Var_.BaseName, LLocalHandle) and
       (not LLocalHandle.IsParam) then
    begin
      LLocalInfo := LFuncInfo.Locals[LLocalHandle.Index];
      if (LLocalInfo.LocalType = cvtVoid) and (LLocalInfo.LocalSize > 8) then
      begin
        // Large struct local - return local operand for LEA in backend
        LArgs[LI] := TMyrOperand.FromLocal(LLocalHandle);
        Continue;
      end;
    end;
    LArgs[LI] := ResolveSSAOperand(LArg, ALocalHandles, AVarTemps);
  end;
  
  // Call based on target type
  if AInstr.CallTarget.Kind = sokImport then
  begin
    if Length(LArgs) > 0 then
      Result := GetCode().CallFunc(FCompileImportHandles[AInstr.CallTarget.ImportIndex], LArgs)
    else
      Result := GetCode().CallFunc(FCompileImportHandles[AInstr.CallTarget.ImportIndex]);
  end
  else if AInstr.CallTarget.Kind = sokFunc then
  begin
    // Local function call
    LFuncHandle.Index := AInstr.CallTarget.FuncIndex;
    if Length(LArgs) > 0 then
      Result := GetCode().CallFunc(LFuncHandle, LArgs)
    else
      Result := GetCode().CallFunc(LFuncHandle);
  end
  else
  begin
    Result := TMyrTempHandle.Invalid();
  end;
end;

procedure TMyrCodegen.EmitSSAIndirectCall(
  const AInstr: TMyrSSAInstr;
  const ALocalHandles: TDictionary<string, TMyrLocalHandle>;
  const AVarTemps: TDictionary<string, TMyrTempHandle>
);
var
  LArgs: TArray<TMyrOperand>;
  LFuncPtr: TMyrOperand;
  LI: Integer;
begin
  // Resolve the function pointer operand
  LFuncPtr := ResolveSSAOperand(AInstr.Op1, ALocalHandles, AVarTemps);
  
  // Resolve arguments
  SetLength(LArgs, Length(AInstr.CallArgs));
  for LI := 0 to High(AInstr.CallArgs) do
    LArgs[LI] := ResolveSSAOperand(AInstr.CallArgs[LI], ALocalHandles, AVarTemps);
  
  // Indirect call through function pointer
  if Length(LArgs) > 0 then
    GetCode().CallIndirect(LFuncPtr, LArgs)
  else
    GetCode().CallIndirect(LFuncPtr);
end;

function TMyrCodegen.EmitSSAIndirectCallWithResult(
  const AInstr: TMyrSSAInstr;
  const ALocalHandles: TDictionary<string, TMyrLocalHandle>;
  const AVarTemps: TDictionary<string, TMyrTempHandle>
): TMyrTempHandle;
var
  LArgs: TArray<TMyrOperand>;
  LFuncPtr: TMyrOperand;
  LI: Integer;
begin
  // Resolve the function pointer operand
  LFuncPtr := ResolveSSAOperand(AInstr.Op1, ALocalHandles, AVarTemps);
  
  // Resolve arguments
  SetLength(LArgs, Length(AInstr.CallArgs));
  for LI := 0 to High(AInstr.CallArgs) do
    LArgs[LI] := ResolveSSAOperand(AInstr.CallArgs[LI], ALocalHandles, AVarTemps);
  
  // Indirect call through function pointer with result. CallReturnSize was
  // resolved from the pointer's routine type during SSA conversion; codegen
  // cannot recover it here because an indirect target has no TMyrFuncInfo.
  if Length(LArgs) > 0 then
    Result := GetCode().CallIndirectFunc(LFuncPtr, LArgs, AInstr.CallReturnSize)
  else
    Result := GetCode().CallIndirectFunc(LFuncPtr, [], AInstr.CallReturnSize);
end;

function TMyrCodegen.EmitSSASyscall(
  const AInstr: TMyrSSAInstr;
  const ALocalHandles: TDictionary<string, TMyrLocalHandle>;
  const AVarTemps: TDictionary<string, TMyrTempHandle>
): TMyrTempHandle;
var
  LArgs: TArray<TMyrOperand>;
  LNumber: TMyrOperand;
  LI: Integer;
begin
  // Syscall number is carried in Op1, arguments in CallArgs
  LNumber := ResolveSSAOperand(AInstr.Op1, ALocalHandles, AVarTemps);

  SetLength(LArgs, Length(AInstr.CallArgs));
  for LI := 0 to High(AInstr.CallArgs) do
    LArgs[LI] := ResolveSSAOperand(AInstr.CallArgs[LI], ALocalHandles, AVarTemps);

  Result := GetCode().SyscallOp(LNumber, LArgs);
end;

procedure TMyrCodegen.EmitSSAToCode(const ASSA: TMyrSSABuilder);
var
  LI: Integer;
  LJ: Integer;
  LK: Integer;
  LFunc: TMyrSSAFunc;
  LBlock: TMyrSSABlock;
  LInstr: TMyrSSAInstr;
  LLocal: TMyrSSALocalInfo;
  LLocalHandles: TDictionary<string, TMyrLocalHandle>;
  LLabelHandles: TDictionary<Integer, TMyrLabelHandle>;
  LVarTemps: TDictionary<string, TMyrTempHandle>;
  LLocalHandle: TMyrLocalHandle;
  LLabelHandle: TMyrLabelHandle;
  LOp1: TMyrOperand;
  LOp2: TMyrOperand;
  LDestTemp: TMyrTempHandle;
  // Exception scope handling
  LExcScope: TMyrSSAExceptionScope;
  LTryBeginHandle: TMyrLabelHandle;
  LTryEndHandle: TMyrLabelHandle;
  LExceptHandle: TMyrLabelHandle;
  LFinallyHandle: TMyrLabelHandle;
  LEndHandle: TMyrLabelHandle;
  // Variable location recording
  LVarParamCount: Integer;
  LVarParamIdx: Integer;
  LVarLocalIdx: Integer;
  LVarOffset: Integer;
  LVarType: TMyrValueType;
  // Syscall argument array
begin
  Status('SSA: Emitting to backend (%d functions)', [ASSA.GetFunctionCount()]);
  
  // Note: Phi nodes eliminated by caller (Compile) before this method
  
  for LI := 0 to ASSA.GetFunctionCount() - 1 do
  begin
    LFunc := ASSA.GetFunction(LI);
    Status(GetDumpIR(), 'SSA: Emitting function: %s', [LFunc.GetFuncName()]);
    if ((LI + 1) mod 10 = 0) and (ASSA.GetFunctionCount() > 10) then
      Status('SSA:   %d/%d functions emitted...', [LI + 1, ASSA.GetFunctionCount()]);
    
    LLocalHandles := TDictionary<string, TMyrLocalHandle>.Create();
    LLabelHandles := TDictionary<Integer, TMyrLabelHandle>.Create();
    LVarTemps := TDictionary<string, TMyrTempHandle>.Create();
    try
      // Begin function
      GetCode().BeginProc(
        LFunc.GetFuncName(),
        LFunc.GetIsEntryPoint(),
        LFunc.GetIsDllEntry(),
        LFunc.GetIsPublic(),
        LFunc.GetLinkage()
      );
      GetCode().SetReturnType(LFunc.GetReturnType(), LFunc.GetReturnSize(), LFunc.GetReturnAlignment());
      GetCode().SetIsVariadic(LFunc.GetIsVariadic());

      // Add parameters first
      for LJ := 0 to LFunc.GetLocalCount() - 1 do
      begin
        LLocal := LFunc.GetLocal(LJ);
        if LLocal.IsParam then
        begin
          if LLocal.LocalTypeRef.IsPrimitive then
            LLocalHandle := GetCode().AddParam(LLocal.LocalName, LLocal.LocalTypeRef.Primitive, LLocal.IsByRef)
          else
            LLocalHandle := GetCode().AddParam(LLocal.LocalName, LLocal.LocalSize, LLocal.LocalAlignment, LLocal.IsByRef);
          LLocalHandles.AddOrSetValue(LLocal.LocalName, LLocalHandle);
        end;
      end;

      // Add locals
      for LJ := 0 to LFunc.GetLocalCount() - 1 do
      begin
        LLocal := LFunc.GetLocal(LJ);
        if not LLocal.IsParam then
        begin
          if LLocal.LocalTypeRef.IsPrimitive then
            LLocalHandle := GetCode().AddLocal(LLocal.LocalName, LLocal.LocalTypeRef.Primitive)
          else
            LLocalHandle := GetCode().AddLocal(LLocal.LocalName, LLocal.LocalSize, LLocal.LocalAlignment);
          LLocalHandles.AddOrSetValue(LLocal.LocalName, LLocalHandle);
        end;
      end;

      // Record variable locations in source map (for debugger)
      // Uses same offset formulas as GetParamOffset/GetLocalOffset
      if FSourceMap <> nil then
      begin
        LVarParamCount := 0;
        LVarParamIdx := 0;
        LVarLocalIdx := 0;

        // Count params
        for LJ := 0 to LFunc.GetLocalCount() - 1 do
        begin
          if LFunc.GetLocal(LJ).IsParam then
            Inc(LVarParamCount);
        end;

        // Record params
        for LJ := 0 to LFunc.GetLocalCount() - 1 do
        begin
          LLocal := LFunc.GetLocal(LJ);
          if LLocal.IsParam then
          begin
            if LFunc.GetIsVariadic() then
              LVarOffset := -(40 + (LVarParamIdx + 1) * 8)
            else
              LVarOffset := -(40 + LVarParamIdx * 8);

            if LLocal.LocalTypeRef.IsPrimitive then
              LVarType := LLocal.LocalTypeRef.Primitive
            else
              LVarType := cvtPointer;

            FSourceMap.AddVariable(LI, LLocal.LocalName, LVarType,
              vlkStack, LVarOffset, 0, True, False, 0, 0);
            Inc(LVarParamIdx);
          end;
        end;

        // Record locals
        if LFunc.GetIsVariadic() then
          LVarOffset := 40 + 4 * 8
        else
          LVarOffset := 40 + LVarParamCount * 8;

        for LJ := 0 to LFunc.GetLocalCount() - 1 do
        begin
          LLocal := LFunc.GetLocal(LJ);
          if not LLocal.IsParam then
          begin
            if LLocal.LocalTypeRef.IsPrimitive then
              LVarType := LLocal.LocalTypeRef.Primitive
            else
              LVarType := cvtPointer;

            FSourceMap.AddVariable(LI, LLocal.LocalName, LVarType,
              vlkStack, -LVarOffset, 0, False, False, 0, 0);
            LVarOffset := LVarOffset + ((LLocal.LocalSize + 7) div 8) * 8;
            Inc(LVarLocalIdx);
          end;
        end;
      end;

      // Create labels for all blocks
      for LJ := 0 to LFunc.GetBlockCount() - 1 do
      begin
        LBlock := LFunc.GetBlock(LJ);
        LLabelHandle := GetCode().DefineLabel(LBlock.GetBlockName());
        LLabelHandles.Add(LBlock.GetBlockId(), LLabelHandle);
      end;

      // Emit each block
      for LJ := 0 to LFunc.GetBlockCount() - 1 do
      begin
        LBlock := LFunc.GetBlock(LJ);
        
        // Mark block label
        if LLabelHandles.TryGetValue(LBlock.GetBlockId(), LLabelHandle) then
          GetCode().MarkLabel(LLabelHandle);
        
        // Emit instructions
        for LK := 0 to LBlock.GetInstructionCount() - 1 do
        begin
          LInstr := LBlock.GetInstruction(LK);
          
          // Propagate source location to code builder (for debugger source map)
          if LInstr.SourceLine > 0 then
            GetCode().SetSourceLocation(LInstr.SourceLine, LInstr.SourceColumn, LInstr.SourceFile);

          // Resolve operands
          LOp1 := ResolveSSAOperand(LInstr.Op1, LLocalHandles, LVarTemps);
          LOp2 := ResolveSSAOperand(LInstr.Op2, LLocalHandles, LVarTemps);
          
          case LInstr.Kind of
            sikNop:
              begin
                // Do nothing
              end;
              
            sikAssign:
              begin
                // Store the value in a temp and track it
                if LOp1.Kind = okNone then
                  Continue;
                  
                // For SSA, we track the temp handle by variable name
                LDestTemp := StoreSSAVarValue(LInstr.Dest, LOp1, LLocalHandles, LVarTemps);
              end;
              
            sikAdd:
              begin
                LDestTemp := GetCode().OpAdd(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;
              
            sikSub:
              begin
                LDestTemp := GetCode().OpSub(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;
              
            sikMul:
              begin
                LDestTemp := GetCode().OpMul(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;
              
            sikDiv:
              begin
                LDestTemp := GetCode().OpDiv(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;
              
            sikMod:
              begin
                LDestTemp := GetCode().OpMod(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;
              
            sikUDiv:
              begin
                LDestTemp := GetCode().OpUDiv(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;
              
            sikUMod:
              begin
                LDestTemp := GetCode().OpUMod(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;
              
            sikNeg:
              begin
                // Negate: 0 - value
                LDestTemp := GetCode().OpSub(0, LOp1);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;

            sikFAdd:
              begin
                LDestTemp := GetCode().OpFAdd(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;

            sikFSub:
              begin
                LDestTemp := GetCode().OpFSub(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;

            sikFMul:
              begin
                LDestTemp := GetCode().OpFMul(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;

            sikFDiv:
              begin
                LDestTemp := GetCode().OpFDiv(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;

            sikFNeg:
              begin
                LDestTemp := GetCode().OpFNeg(LOp1);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;

            sikIntToFloat:
              begin
                LDestTemp := GetCode().OpIntToFloat(LOp1);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;

            sikUIntToFloat:
              begin
                LDestTemp := GetCode().OpUIntToFloat(LOp1);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;

            sikFloatToInt:
              begin
                LDestTemp := GetCode().OpFloatToInt(LOp1);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;

            sikFloatToUInt:
              begin
                LDestTemp := GetCode().OpFloatToUInt(LOp1);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;

            sikFloat32ToFloat64:
              begin
                LDestTemp := GetCode().OpFloat32ToFloat64(LOp1);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;
              
            sikBitAnd:
              begin
                LDestTemp := GetCode().OpAnd(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;
              
            sikBitOr:
              begin
                LDestTemp := GetCode().OpOr(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;
              
            sikBitXor:
              begin
                LDestTemp := GetCode().OpXor(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;
              
            sikBitNot:
              begin
                LDestTemp := GetCode().OpNot(LOp1);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;
              
            sikShl:
              begin
                LDestTemp := GetCode().OpShl(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;
              
            sikShr:
              begin
                LDestTemp := GetCode().OpShr(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;
              
            sikCmpEq:
              begin
                LDestTemp := GetCode().CmpEq(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;
              
            sikCmpNe:
              begin
                LDestTemp := GetCode().CmpNe(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;
              
            sikCmpLt:
              begin
                LDestTemp := GetCode().CmpLt(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;
              
            sikCmpLe:
              begin
                LDestTemp := GetCode().CmpLe(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;
              
            sikCmpGt:
              begin
                LDestTemp := GetCode().CmpGt(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;
              
            sikCmpGe:
              begin
                LDestTemp := GetCode().CmpGe(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;

            sikUCmpLt:
              begin
                LDestTemp := GetCode().UCmpLt(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;

            sikUCmpLe:
              begin
                LDestTemp := GetCode().UCmpLe(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;

            sikUCmpGt:
              begin
                LDestTemp := GetCode().UCmpGt(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;

            sikUCmpGe:
              begin
                LDestTemp := GetCode().UCmpGe(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;

            sikFCmpEq:
              begin
                LDestTemp := GetCode().FCmpEq(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;

            sikFCmpNe:
              begin
                LDestTemp := GetCode().FCmpNe(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;

            sikFCmpLt:
              begin
                LDestTemp := GetCode().FCmpLt(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;

            sikFCmpLe:
              begin
                LDestTemp := GetCode().FCmpLe(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;

            sikFCmpGt:
              begin
                LDestTemp := GetCode().FCmpGt(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;

            sikFCmpGe:
              begin
                LDestTemp := GetCode().FCmpGe(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;
              
            sikSetLiteral:
              begin
                // Use stored type info for LowBound and StorageSize
                LDestTemp := GetCode().OpSetLiteral(
                  LInstr.SetElements, 
                  LInstr.SetLowBound,
                  LInstr.SetStorageSize
                );
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;
              
            sikSetUnion:
              begin
                LDestTemp := GetCode().OpSetUnion(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;
              
            sikSetDiff:
              begin
                LDestTemp := GetCode().OpSetDiff(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;
              
            sikSetInter:
              begin
                LDestTemp := GetCode().OpSetInter(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;
              
            sikSetIn:
              begin
                LDestTemp := GetCode().OpSetIn(LOp1, LOp2, LInstr.SetLowBound);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;
              
            sikSetEq:
              begin
                LDestTemp := GetCode().OpSetEq(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;
              
            sikSetNe:
              begin
                LDestTemp := GetCode().OpSetNe(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;
              
            sikSetSubset:
              begin
                LDestTemp := GetCode().OpSetSubset(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;
              
            sikSetSuperset:
              begin
                LDestTemp := GetCode().OpSetSuperset(LOp1, LOp2);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;
              
            sikLoad:
              begin
                // Handle sokLocalIndex specially - load from local by index
                if LInstr.Op1.Kind = sokLocalIndex then
                begin
                  LLocal := LFunc.GetLocal(LInstr.Op1.LocalIndex);
                  if LLocalHandles.TryGetValue(LLocal.LocalName, LLocalHandle) then
                  begin
                    LDestTemp := GetCode().Load(LLocalHandle);
                    LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
                  end;
                end
                else
                begin
                  LDestTemp := GetCode().LoadPtr(LOp1, LInstr.MemSize, LInstr.MemIsFloat, LInstr.MemIsSigned);
                  LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
                end;
              end;
              
            sikStore:
              begin
                GetCode().StorePtr(LOp1, LOp2, LInstr.MemSize, LInstr.MemIsFloat);
              end;
              
            sikAddressOf:
              begin
                // Get address of local variable.
                // The managed-cleanup pass addresses a local by INDEX
                // (sokLocalIndex) rather than by name, because at that point it
                // is walking the function's local table, not an AST expression.
                // Var_ is the sokVar arm of the operand and is UNPOPULATED for
                // the index form, so without this branch BaseName is empty, the
                // handle lookup fails, and NO address is emitted at all - the
                // dependent call then receives an undefined temp. Mirrors the
                // identical special case in sikLoad above.
                if LInstr.Op1.Kind = sokLocalIndex then
                begin
                  LLocal := LFunc.GetLocal(LInstr.Op1.LocalIndex);
                  if LLocalHandles.TryGetValue(LLocal.LocalName, LLocalHandle) then
                  begin
                    LDestTemp := GetCode().AddressOf(LLocalHandle);
                    LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
                  end;
                end
                else if LLocalHandles.TryGetValue(LInstr.Op1.Var_.BaseName, LLocalHandle) then
                begin
                  LDestTemp := GetCode().AddressOf(LLocalHandle);
                  LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
                end;
              end;
              
            sikFieldAddr:
              begin
                // Compute field address: base + offset
                // LOp1 = base address, LInstr.Op2.FieldName = field name
                // For now, use Op2.ImmInt as field offset (set by caller or default 0)
                // TODO: Look up field offset from type registry
                LDestTemp := GetCode().OpAdd(LOp1, LInstr.Op2.ImmInt);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;
              
            sikIndexAddr:
              begin
                // Compute element address: base + (index * elementSize)
                // LOp1 = base address, LOp2 = index, LInstr.Op2.ElementSize = element size
                // addr = base + index * elementSize
                LDestTemp := GetCode().OpMul(LOp2, LInstr.Op2.ElementSize);
                LDestTemp := GetCode().OpAdd(LOp1, TMyrOperand.FromTemp(LDestTemp));
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;
              
            sikJump:
              begin
                if LLabelHandles.TryGetValue(LInstr.Op1.BlockIndex, LLabelHandle) then
                  GetCode().Jump(LLabelHandle);
              end;
              
            sikJumpIf:
              begin
                if LLabelHandles.TryGetValue(LInstr.Op2.BlockIndex, LLabelHandle) then
                  GetCode().JumpIf(LOp1, LLabelHandle);
              end;
              
            sikJumpIfNot:
              begin
                if LLabelHandles.TryGetValue(LInstr.Op2.BlockIndex, LLabelHandle) then
                  GetCode().JumpIfNot(LOp1, LLabelHandle);
              end;
              
            sikPhi:
              begin
                // TODO: Phi nodes should be eliminated before emission
                // For now, skip them
              end;
              
            sikCall:
              begin
                // Call without return value
                EmitSSACall(LInstr, LLocalHandles, LVarTemps);
              end;
              
            sikCallAssign:
              begin
                // Call with return value
                LDestTemp := EmitSSACallWithResult(LInstr, LLocalHandles, LVarTemps);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;
              
            sikFuncAddr:
              begin
                // Get address of a local function
                LDestTemp := GetCode().LoadFuncAddr(LInstr.Op1.FuncIndex);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;
              
            sikIndirectCall:
              begin
                // Indirect call (no return value)
                EmitSSAIndirectCall(LInstr, LLocalHandles, LVarTemps);
              end;
              
            sikIndirectCallAssign:
              begin
                // Indirect call with return value
                LDestTemp := EmitSSAIndirectCallWithResult(LInstr, LLocalHandles, LVarTemps);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;
              
            sikBlockCopy:
              begin
                // Whole-object move. Both operands are already addresses.
                GetCode().BlockCopy(LOp1, LOp2, LInstr.CopySize);
              end;

            sikReturn:
              begin
                GetCode().Return();
              end;
              
            sikReturnValue:
              begin
                GetCode().Return(LOp1);
              end;
              
            sikVaCount:
              begin
                LDestTemp := GetCode().VaCount();
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;
              
            sikVaArgAt:
              begin
                LDestTemp := GetCode().VaArgAt(LOp1, LInstr.VaArgType);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;

            sikSyscall:
              begin
                LDestTemp := EmitSSASyscall(LInstr, LLocalHandles, LVarTemps);
                LVarTemps.AddOrSetValue(LInstr.Dest.ToString(), LDestTemp);
              end;
          end;
        end;
      end;
      
      //------------------------------------------------------------------------
      // Register exception scopes
      //------------------------------------------------------------------------
      for LK := 0 to LFunc.GetExceptionScopeCount() - 1 do
      begin
        LExcScope := LFunc.GetExceptionScope(LK);
        
        // Map block indices to label handles
        // -1 means no handler for that scope type
        if LLabelHandles.TryGetValue(LExcScope.TryBlockIndex, LTryBeginHandle) and
           LLabelHandles.TryGetValue(LExcScope.EndBlockIndex, LEndHandle) then
        begin
          // Try end block (where try body ends)
          if LExcScope.TryEndBlockIndex >= 0 then
            LLabelHandles.TryGetValue(LExcScope.TryEndBlockIndex, LTryEndHandle)
          else
            LTryEndHandle.Index := -1;
          
          // Except handler
          if LExcScope.ExceptBlockIndex >= 0 then
            LLabelHandles.TryGetValue(LExcScope.ExceptBlockIndex, LExceptHandle)
          else
            LExceptHandle.Index := -1;
          
          // Finally handler
          if LExcScope.FinallyBlockIndex >= 0 then
            LLabelHandles.TryGetValue(LExcScope.FinallyBlockIndex, LFinallyHandle)
          else
            LFinallyHandle.Index := -1;
          
          GetCode().AddExceptionScope(
            LTryBeginHandle,
            LTryEndHandle,
            LExceptHandle,
            LFinallyHandle,
            LEndHandle
          );
        end;
      end;
      
      // End function
      GetCode().EndProc();

    finally
      LVarTemps.Free();
      LLabelHandles.Free();
      LLocalHandles.Free();
    end;
  end;

  Status('SSA: Emission complete');
end;

// Compile-time helpers for print/println
procedure rt_write(const AIR: TMyrIR; const AArgs: array of TMyrIRExpr);
begin
  if Length(AArgs) > 0 then
    AIR.Call('printf', AArgs);
end;

procedure rt_writeln(const AIR: TMyrIR; const AArgs: array of TMyrIRExpr);
begin
  if Length(AArgs) > 0 then
    AIR.Call('printf', AArgs);
  AIR.Call('printf', [AIR.Str(#10)]);
end;

// TMyrRuntime - String Type Definitions
// Defines TStringRec and 'string' pointer type only.
// Called early in TNative.Create() so user code can reference 'string' type.
// Safe to call multiple times - checks if types already exist.
// Platform neutral: the layout is identical on every target, so this is a
// concrete base method rather than a per-platform override.
//==============================================================================

procedure TMyrRuntime.AddTypes(const AIR: TMyrIR);
begin
  // Define TStringRec type
  AIR.DefineRecord('TStringRec')
     .Field('RefCount', cvtInt64)
     .Field('Length', cvtUInt64)
     .Field('Capacity', cvtUInt64)
     .Field('Data', cvtPointer)
     .Field('Data16', cvtPointer)
  .EndRecord();

  // Register 'string' as a pointer to TStringRec
  AIR.DefinePointer('string', 'TStringRec', False);

  // Register 'wstring' as a raw pointer type (PWideChar, no backing record)
  AIR.DefinePointer('wstring');
end;

// TMyrRuntime - Module Finalizers
// Registers and runs module finalize functions in LIFO order at shutdown.
// Platform neutral: the body is pure IR over RT_AllocMem / RT_FreeMem with no
// platform calls, so this is a concrete base method rather than a per-platform
// override.
//==============================================================================

procedure TMyrRuntime.AddFinalizers(const AIR: TMyrIR);
begin
  // Globals: finalizer slot array and count
  AIR.Global(RT_FinCount, cvtInt64);
  AIR.Global(RT_FinSlots, cvtPointer);

  // RT_RegisterFinalizer(AFuncPtr: Pointer)
  // Registers a module finalize function for LIFO execution at shutdown.
  // Lazy-allocates the slot array on first use (256 slots max).
  AIR.Func(RT_RegisterFinalizer, cvtVoid, False, plC, False)
     .Param('AFuncPtr', cvtPointer);

  // Lazy-allocate slot array (256 * 8 = 2048 bytes)
  AIR.When(AIR.Eq(AIR.Get(RT_FinSlots), AIR.Null()))
     .Assign(RT_FinSlots, AIR.Invoke(RT_AllocMem, [AIR.MakeInt64(2048)]))
  .EndWhen();

  // Bounds check: bail if full
  AIR.When(AIR.Ge(AIR.Get(RT_FinCount), AIR.MakeInt64(256)))
     .Return()
  .EndWhen();

  // Store function pointer at RT_FinSlots[RT_FinCount]
  AIR.SetVal(
     AIR.Deref(
        AIR.Add(AIR.Get(RT_FinSlots),
                AIR.Mul(AIR.Get(RT_FinCount), AIR.MakeInt64(8))),
        cvtPointer),
     AIR.Get('AFuncPtr'));

  AIR.Assign(RT_FinCount, AIR.Add(AIR.Get(RT_FinCount), AIR.MakeInt64(1)))
     .Return()
  .EndFunc();

  // RT_RunFinalizers()
  // Runs all registered finalizers in LIFO order (last registered = first run).
  // Called by RT_Halt before other shutdown cleanup.
  AIR.Func(RT_RunFinalizers, cvtVoid, False, plC, False)
     .Local('LCount', cvtInt64)
     .Local('i', cvtInt64)
     .Local('LIdx', cvtInt64)
     .Local('LFuncPtr', cvtPointer);

  // Nothing to do if no finalizers registered
  AIR.When(AIR.Eq(AIR.Get(RT_FinSlots), AIR.Null()))
     .Return()
  .EndWhen();

  // Iterate in reverse (LIFO) -- cache count locally, use count-up pattern
  AIR.Assign('LCount', AIR.Get(RT_FinCount));
  AIR.Assign('i', AIR.MakeInt64(0));
  AIR.Loop(AIR.Lt(AIR.Get('i'), AIR.Get('LCount')));

  // Reverse index for LIFO order
  AIR.Assign('LIdx', AIR.Sub(AIR.Sub(AIR.Get('LCount'), AIR.MakeInt64(1)), AIR.Get('i')));

  // Load function pointer from slot and call it
  AIR.Assign('LFuncPtr', AIR.Deref(
     AIR.Add(AIR.Get(RT_FinSlots),
             AIR.Mul(AIR.Get('LIdx'), AIR.MakeInt64(8))),
     cvtPointer));
  AIR.CallIndirect(AIR.Get('LFuncPtr'));

  AIR.Assign('i', AIR.Add(AIR.Get('i'), AIR.MakeInt64(1)));
  AIR.EndLoop();

  // Free the slot array
  AIR.Call(RT_FreeMem, [AIR.Get(RT_FinSlots)])
     .Assign(RT_FinSlots, AIR.Null())
     .Return();
  AIR.EndFunc();
end;
procedure TMyrRuntime.AddStrings(const AIR: TMyrIR);
var
  LDeref: TMyrIRExpr;
begin
  // Import C runtime for memory copy

  // Ensure string types are defined (idempotent - may already be defined)
  AddTypes(AIR);

  // Cbr_StrAlloc(ACapacity: UInt64): Pointer
  // Allocates a new string with the specified capacity.
  // RefCount = 1, Length = 0, Data buffer allocated and null-terminated.
  AIR.Func(RT_StrAlloc, cvtPointer, False, plC, False)
     .Param('ACapacity', cvtUInt64)
     .Local('LRec', cvtPointer)
     .Local('LData', cvtPointer)
     // Allocate the TStringRec struct (40 bytes)
     .Assign('LRec', AIR.Invoke(RT_GetMem, [AIR.MakeInt64(40)]))
     // Allocate data buffer (capacity + 1 for null terminator)
     .Assign('LData', AIR.Invoke(RT_GetMem, [AIR.Add(AIR.Get('ACapacity'), AIR.MakeInt64(1))]));

  // Initialize fields
  LDeref := AIR.Deref(AIR.Get('LRec'), 'TStringRec');
  AIR.SetVal(AIR.GetField(LDeref, 'RefCount'), AIR.MakeInt64(1));

  LDeref := AIR.Deref(AIR.Get('LRec'), 'TStringRec');
  AIR.SetVal(AIR.GetField(LDeref, 'Length'), AIR.MakeInt64(0));

  LDeref := AIR.Deref(AIR.Get('LRec'), 'TStringRec');
  AIR.SetVal(AIR.GetField(LDeref, 'Capacity'), AIR.Get('ACapacity'));

  LDeref := AIR.Deref(AIR.Get('LRec'), 'TStringRec');
  AIR.SetVal(AIR.GetField(LDeref, 'Data'), AIR.Get('LData'));

  LDeref := AIR.Deref(AIR.Get('LRec'), 'TStringRec');
  AIR.SetVal(AIR.GetField(LDeref, 'Data16'), AIR.Null());

  // Null-terminate the empty string and return
  AIR.Call('memset', [AIR.Get('LData'), AIR.MakeInt64(0), AIR.MakeInt64(1)])
     .Return(AIR.Get('LRec'))
  .EndFunc();

  // RT_StrFree(AStr: Pointer)
  // Frees the string's data buffer and the TStringRec struct.
  // Does nothing if AStr is nil.
  AIR.Func(RT_StrFree, cvtVoid, False, plC, False)
     .Param('AStr', cvtPointer)
     .Local('LData', cvtPointer)
     .Local('LData16', cvtPointer)
     // if AStr = nil then exit
     .When(AIR.Eq(AIR.Get('AStr'), AIR.Null()))
        .Return()
     .EndWhen();

  // Free UTF-16 cache if present
  LDeref := AIR.Deref(AIR.Get('AStr'), 'TStringRec');
  AIR.Assign('LData16', AIR.GetField(LDeref, 'Data16'))
     .When(AIR.Ne(AIR.Get('LData16'), AIR.Null()))
        .Call(RT_FreeMem, [AIR.Get('LData16')])
     .EndWhen();

  // Free data buffer
  LDeref := AIR.Deref(AIR.Get('AStr'), 'TStringRec');
  AIR.Assign('LData', AIR.GetField(LDeref, 'Data'))
     .When(AIR.Ne(AIR.Get('LData'), AIR.Null()))
        .Call(RT_FreeMem, [AIR.Get('LData')])
     .EndWhen()
     // Free struct
     .Call(RT_FreeMem, [AIR.Get('AStr')])
     .Return()
  .EndFunc();

  // RT_StrAddRef(AStr: Pointer)
  // Increments the reference count if not nil and not immortal (-1).
  AIR.Func(RT_StrAddRef, cvtVoid, False, plC, False)
     .Param('AStr', cvtPointer)
     .Local('LRefCount', cvtInt64)
     // if AStr = nil then exit
     .When(AIR.Eq(AIR.Get('AStr'), AIR.Null()))
        .Return()
     .EndWhen();

  // Get current refcount
  LDeref := AIR.Deref(AIR.Get('AStr'), 'TStringRec');
  AIR.Assign('LRefCount', AIR.GetField(LDeref, 'RefCount'))
     // if RefCount = -1 (immortal) then exit
     .When(AIR.Eq(AIR.Get('LRefCount'), AIR.MakeInt64(-1)))
        .Return()
     .EndWhen();

  // Increment refcount
  LDeref := AIR.Deref(AIR.Get('AStr'), 'TStringRec');
  AIR.SetVal(AIR.GetField(LDeref, 'RefCount'), AIR.Add(AIR.Get('LRefCount'), AIR.MakeInt64(1)))
     .Return()
  .EndFunc();

  // RT_StrRelease(AStr: Pointer)
  // Decrements the reference count. Frees the string if count reaches zero.
  // Does nothing if nil or immortal (-1).
  AIR.Func(RT_StrRelease, cvtVoid, False, plC, False)
     .Param('AStr', cvtPointer)
     .Local('LRefCount', cvtInt64)
     // if AStr = nil then exit
     .When(AIR.Eq(AIR.Get('AStr'), AIR.Null()))
        .Return()
     .EndWhen();

  // Get current refcount
  LDeref := AIR.Deref(AIR.Get('AStr'), 'TStringRec');
  AIR.Assign('LRefCount', AIR.GetField(LDeref, 'RefCount'))
     // if RefCount = -1 (immortal) then exit
     .When(AIR.Eq(AIR.Get('LRefCount'), AIR.MakeInt64(-1)))
        .Return()
     .EndWhen()
     // Decrement refcount
     .Assign('LRefCount', AIR.Sub(AIR.Get('LRefCount'), AIR.MakeInt64(1)));

  LDeref := AIR.Deref(AIR.Get('AStr'), 'TStringRec');
  AIR.SetVal(AIR.GetField(LDeref, 'RefCount'), AIR.Get('LRefCount'))
     // if RefCount = 0 then free
     .When(AIR.Eq(AIR.Get('LRefCount'), AIR.MakeInt64(0)))
        .Call(RT_StrFree, [AIR.Get('AStr')])
     .EndWhen()
     .Return()
  .EndFunc();

  // RT_ReleaseOnDetach(AReason: Int32; AStr: Pointer)
  // Conditionally releases a managed string during DLL unload.
  // Only releases when AReason = 0 (DLL_PROCESS_DETACH).
  // Called by SSA cleanup pass for managed globals in DllMain.
  AIR.Func(RT_ReleaseOnDetach, cvtVoid, False, plC, False)
     .Param('AReason', cvtInt32)
     .Param('AStr', cvtPointer)
     // Only release on DLL_PROCESS_DETACH (reason = 0)
     .When(AIR.Eq(AIR.Get('AReason'), AIR.Int32(0)))
        .Call(RT_StrRelease, [AIR.Get('AStr')])
     .EndWhen()
     .Return()
  .EndFunc();

  // RT_FreeOnDetach(AReason: Int32; APtr: Pointer)
  // Conditionally frees a raw heap buffer (wstring) during DLL unload.
  // Only frees when AReason = 0 (DLL_PROCESS_DETACH) and APtr <> nil.
  // Twin of Cbr_ReleaseOnDetach for wstring globals in DllMain.
  AIR.Func(RT_FreeOnDetach, cvtVoid, False, plC, False)
     .Param('AReason', cvtInt32)
     .Param('APtr', cvtPointer)
     .When(AIR.Eq(AIR.Get('AReason'), AIR.Int32(0)))
        .When(AIR.Ne(AIR.Get('APtr'), AIR.Null()))
           .Call(RT_FreeMem, [AIR.Get('APtr')])
        .EndWhen()
     .EndWhen()
     .Return()
  .EndFunc();

  // RT_StrFromLiteral(AData: Pointer; ALen: UInt64): Pointer
  // Creates a new string from static literal data.
  // Copies the data, sets length, null-terminates.
  AIR.Func(RT_StrFromLiteral, cvtPointer, False, plC, False)
     .Param('AData', cvtPointer)
     .Param('ALen', cvtUInt64)
     .Local('LRec', cvtPointer)
     .Local('LData', cvtPointer)
     // Allocate string with capacity = length
     .Assign('LRec', AIR.Invoke(RT_StrAlloc, [AIR.Get('ALen')]));

  // Get data pointer
  LDeref := AIR.Deref(AIR.Get('LRec'), 'TStringRec');
  AIR.Assign('LData', AIR.GetField(LDeref, 'Data'))
     // Copy literal data
     .Call('memcpy', [AIR.Get('LData'), AIR.Get('AData'), AIR.Get('ALen')]);

  // Set length
  LDeref := AIR.Deref(AIR.Get('LRec'), 'TStringRec');
  AIR.SetVal(AIR.GetField(LDeref, 'Length'), AIR.Get('ALen'))
     // Null terminate (memset at data+len)
     .Call('memset', [AIR.Add(AIR.Get('LData'), AIR.Get('ALen')), AIR.MakeInt64(0), AIR.MakeInt64(1)])
     .Return(AIR.Get('LRec'))
  .EndFunc();

  // RT_StrFromChar(AChar: UInt64): Pointer
  // Creates a new string from a single character.
  // Allocates string, stores char, sets length to 1, null-terminates.
  AIR.Func(RT_StrFromChar, cvtPointer, False, plC, False)
     .Param('AChar', cvtUInt64)
     .Local('LRec', cvtPointer)
     .Local('LData', cvtPointer)
     // Allocate string with capacity = 1
     .Assign('LRec', AIR.Invoke(RT_StrAlloc, [AIR.MakeInt64(1)]));

  // Get data pointer
  LDeref := AIR.Deref(AIR.Get('LRec'), 'TStringRec');
  AIR.Assign('LData', AIR.GetField(LDeref, 'Data'))
     // Store char byte at data[0]
     .Call('memset', [AIR.Get('LData'), AIR.Get('AChar'), AIR.MakeInt64(1)]);

  // Set length to 1
  LDeref := AIR.Deref(AIR.Get('LRec'), 'TStringRec');
  AIR.SetVal(AIR.GetField(LDeref, 'Length'), AIR.MakeInt64(1))
     // Null terminate at data[1]
     .Call('memset', [AIR.Add(AIR.Get('LData'), AIR.MakeInt64(1)), AIR.MakeInt64(0), AIR.MakeInt64(1)])
     .Return(AIR.Get('LRec'))
  .EndFunc();

  // RT_StrConcat(AStr1, AStr2: Pointer): Pointer
  // Creates a new string that is the concatenation of AStr1 and AStr2.
  // Handles nil strings as empty.
  AIR.Func(RT_StrConcat, cvtPointer, False, plC, False)
     .Param('AStr1', cvtPointer)
     .Param('AStr2', cvtPointer)
     .Local('LLen1', cvtUInt64)
     .Local('LLen2', cvtUInt64)
     .Local('LTotalLen', cvtUInt64)
     .Local('LRec', cvtPointer)
     .Local('LData', cvtPointer)
     .Local('LData1', cvtPointer)
     .Local('LData2', cvtPointer)
     // Get length of first string (0 if nil)
     .When(AIR.Eq(AIR.Get('AStr1'), AIR.Null()))
        .Assign('LLen1', AIR.MakeInt64(0))
     .Otherwise();

  LDeref := AIR.Deref(AIR.Get('AStr1'), 'TStringRec');
  AIR.Assign('LLen1', AIR.GetField(LDeref, 'Length'))
     .EndWhen()
     // Get length of second string (0 if nil)
     .When(AIR.Eq(AIR.Get('AStr2'), AIR.Null()))
        .Assign('LLen2', AIR.MakeInt64(0))
     .Otherwise();

  LDeref := AIR.Deref(AIR.Get('AStr2'), 'TStringRec');
  AIR.Assign('LLen2', AIR.GetField(LDeref, 'Length'))
     .EndWhen()
     // Total length
     .Assign('LTotalLen', AIR.Add(AIR.Get('LLen1'), AIR.Get('LLen2')))
     // Allocate new string
     .Assign('LRec', AIR.Invoke(RT_StrAlloc, [AIR.Get('LTotalLen')]));

  // Get data pointer of result
  LDeref := AIR.Deref(AIR.Get('LRec'), 'TStringRec');
  AIR.Assign('LData', AIR.GetField(LDeref, 'Data'))
     // Copy first string if not empty
     .When(AIR.Gt(AIR.Get('LLen1'), AIR.MakeInt64(0)));

  LDeref := AIR.Deref(AIR.Get('AStr1'), 'TStringRec');
  AIR.Assign('LData1', AIR.GetField(LDeref, 'Data'))
        .Call('memcpy', [AIR.Get('LData'), AIR.Get('LData1'), AIR.Get('LLen1')])
     .EndWhen()
     // Copy second string if not empty
     .When(AIR.Gt(AIR.Get('LLen2'), AIR.MakeInt64(0)));

  LDeref := AIR.Deref(AIR.Get('AStr2'), 'TStringRec');
  AIR.Assign('LData2', AIR.GetField(LDeref, 'Data'))
        .Call('memcpy', [AIR.Add(AIR.Get('LData'), AIR.Get('LLen1')), AIR.Get('LData2'), AIR.Get('LLen2')])
     .EndWhen();

  // Set length and null-terminate
  LDeref := AIR.Deref(AIR.Get('LRec'), 'TStringRec');
  AIR.SetVal(AIR.GetField(LDeref, 'Length'), AIR.Get('LTotalLen'))
     .Call('memset', [AIR.Add(AIR.Get('LData'), AIR.Get('LTotalLen')), AIR.MakeInt64(0), AIR.MakeInt64(1)])
     .Return(AIR.Get('LRec'))
  .EndFunc();

  // RT_StrAssign(ADest: Pointer; ASrc: Pointer)
  // Assignment with automatic reference counting.
  // ADest is pointer to a string variable (pointer to pointer to TStringRec).
  // Automatically AddRefs source and releases old dest value.
  // Self-assignment safe: AddRef before Release prevents use-after-free.
  AIR.Func(RT_StrAssign, cvtVoid, False, plC, False)
     .Param('ADest', cvtPointer)   // Pointer to the string variable
     .Param('ASrc', cvtPointer)    // Source string (TStringRec pointer)
     .Local('LOld', cvtPointer)
     // Get old value from destination
     .Assign('LOld', AIR.Deref(AIR.Get('ADest'), cvtPointer))
     // AddRef the source FIRST (self-assignment safe: refcount 1->2)
     .Call(RT_StrAddRef, [AIR.Get('ASrc')])
     // Store new value
     .SetVal(AIR.Deref(AIR.Get('ADest'), cvtPointer), AIR.Get('ASrc'))
     // Release old value LAST (self-assignment safe: refcount 2->1)
     .Call(RT_StrRelease, [AIR.Get('LOld')])
     .Return()
  .EndFunc();

  // RT_StrLen(AStr: Pointer): UInt64
  // Returns the length of the string in bytes. Returns 0 if nil.
  AIR.Func(RT_StrLen, cvtUInt64, False, plC, False)
     .Param('AStr', cvtPointer)
     .When(AIR.Eq(AIR.Get('AStr'), AIR.Null()))
        .Return(AIR.MakeInt64(0))
     .EndWhen();

  LDeref := AIR.Deref(AIR.Get('AStr'), 'TStringRec');
  AIR.Return(AIR.GetField(LDeref, 'Length'))
  .EndFunc();

  // RT_StrSetLength(ADest: Pointer; ANewLen: UInt64)
  // Resizes the string in the variable slot to ANewLen bytes.
  // Allocates a fresh rec, copies min(oldLen, ANewLen) bytes, zero-fills any
  // grown tail, releases the old rec, stores the new one. Nil old = empty.
  AIR.Func(RT_StrSetLength, cvtVoid, False, plC, False)
     .Param('ADest', cvtPointer)   // Pointer to the string variable slot
     .Param('ANewLen', cvtUInt64)
     .Local('LOld', cvtPointer)
     .Local('LNew', cvtPointer)
     .Local('LOldLen', cvtUInt64)
     .Local('LCopyLen', cvtUInt64)
     .Local('LOldData', cvtPointer)
     .Local('LNewData', cvtPointer);

  AIR.Let('LOld', AIR.Deref(AIR.Get('ADest'), cvtPointer));
  AIR.Let('LNew', AIR.Invoke(RT_StrAlloc, [AIR.Get('ANewLen')]));
  AIR.Let('LOldLen', AIR.Invoke(RT_StrLen, [AIR.Get('LOld')]));

  // LCopyLen = min(LOldLen, ANewLen)
  AIR.When(AIR.Lt(AIR.Get('LOldLen'), AIR.Get('ANewLen')))
     .Assign('LCopyLen', AIR.Get('LOldLen'))
  .Otherwise()
     .Assign('LCopyLen', AIR.Get('ANewLen'))
  .EndWhen();

  // New data pointer
  LDeref := AIR.Deref(AIR.Get('LNew'), 'TStringRec');
  AIR.Assign('LNewData', AIR.GetField(LDeref, 'Data'));

  // Copy the surviving prefix
  AIR.When(AIR.Gt(AIR.Get('LCopyLen'), AIR.MakeInt64(0)));
  LDeref := AIR.Deref(AIR.Get('LOld'), 'TStringRec');
  AIR.Assign('LOldData', AIR.GetField(LDeref, 'Data'))
     .Call('memcpy', [AIR.Get('LNewData'), AIR.Get('LOldData'), AIR.Get('LCopyLen')])
  .EndWhen();

  // Zero-fill grown tail plus terminator: (ANewLen - LCopyLen + 1) bytes
  AIR.Call('memset', [AIR.Add(AIR.Get('LNewData'), AIR.Get('LCopyLen')),
     AIR.MakeInt64(0),
     AIR.Add(AIR.Sub(AIR.Get('ANewLen'), AIR.Get('LCopyLen')), AIR.MakeInt64(1))]);

  // Set the new length
  LDeref := AIR.Deref(AIR.Get('LNew'), 'TStringRec');
  AIR.SetVal(AIR.GetField(LDeref, 'Length'), AIR.Get('ANewLen'));

  // Release old, store new
  AIR.Call(RT_StrRelease, [AIR.Get('LOld')]);
  AIR.SetVal(AIR.Deref(AIR.Get('ADest'), cvtPointer), AIR.Get('LNew'));
  AIR.Return();
  AIR.EndFunc();

  // RT_StrCompare(AStr1, AStr2: Pointer): Int64
  // Lexicographic comparison. Returns <0 if AStr1<AStr2, 0 if equal, >0 if AStr1>AStr2.
  // Nil is treated as less than any non-nil string.
  AIR.Func(RT_StrCompare, cvtInt64, False, plC, False)
     .Param('AStr1', cvtPointer)
     .Param('AStr2', cvtPointer)
     .Local('LLen1', cvtUInt64)
     .Local('LLen2', cvtUInt64)
     .Local('LMinLen', cvtUInt64)
     .Local('LData1', cvtPointer)
     .Local('LData2', cvtPointer)
     .Local('LResult', cvtInt32)
     // Check AStr1 nil
     .When(AIR.Eq(AIR.Get('AStr1'), AIR.Null()))
        // AStr1 is nil - check AStr2
        .When(AIR.Eq(AIR.Get('AStr2'), AIR.Null()))
           .Return(AIR.MakeInt64(0))   // Both nil -> equal
        .EndWhen()
        .Return(AIR.MakeInt64(-1))     // AStr1 nil, AStr2 not nil -> less than
     .EndWhen()
     // AStr1 not nil - check AStr2
     .When(AIR.Eq(AIR.Get('AStr2'), AIR.Null()))
        .Return(AIR.MakeInt64(1))      // AStr1 not nil, AStr2 nil -> greater than
     .EndWhen();

  // Get lengths
  LDeref := AIR.Deref(AIR.Get('AStr1'), 'TStringRec');
  AIR.Assign('LLen1', AIR.GetField(LDeref, 'Length'));
  LDeref := AIR.Deref(AIR.Get('AStr2'), 'TStringRec');
  AIR.Assign('LLen2', AIR.GetField(LDeref, 'Length'));

  // Get data pointers
  LDeref := AIR.Deref(AIR.Get('AStr1'), 'TStringRec');
  AIR.Assign('LData1', AIR.GetField(LDeref, 'Data'));
  LDeref := AIR.Deref(AIR.Get('AStr2'), 'TStringRec');
  AIR.Assign('LData2', AIR.GetField(LDeref, 'Data'));

  // LMinLen = min(LLen1, LLen2)
  AIR.When(AIR.Lt(AIR.Get('LLen1'), AIR.Get('LLen2')))
       .Assign('LMinLen', AIR.Get('LLen1'))
     .Otherwise()
       .Assign('LMinLen', AIR.Get('LLen2'))
     .EndWhen();

  // LResult = memcmp(LData1, LData2, LMinLen)
  AIR.Assign('LResult', AIR.Invoke('memcmp', [AIR.Get('LData1'), AIR.Get('LData2'), AIR.Get('LMinLen')]))
     // If memcmp result < 0, return -1
     .When(AIR.Lt(AIR.Get('LResult'), AIR.MakeInt64(0)))
        .Return(AIR.MakeInt64(-1))
     .EndWhen()
     // If memcmp result > 0, return 1
     .When(AIR.Gt(AIR.Get('LResult'), AIR.MakeInt64(0)))
        .Return(AIR.MakeInt64(1))
     .EndWhen()
     // memcmp returned 0, compare by length
     .When(AIR.Lt(AIR.Get('LLen1'), AIR.Get('LLen2')))
        .Return(AIR.MakeInt64(-1))
     .EndWhen()
     .When(AIR.Gt(AIR.Get('LLen1'), AIR.Get('LLen2')))
        .Return(AIR.MakeInt64(1))
     .EndWhen()
     .Return(AIR.MakeInt64(0))
  .EndFunc();

  // RT_StrData(AStr: Pointer): Pointer
  // Returns pointer to the UTF-8 data (for pchar() conversion).
  // Returns nil if string is nil.
  AIR.Func(RT_StrData, cvtPointer, False, plC, False)
     .Param('AStr', cvtPointer)
     .When(AIR.Eq(AIR.Get('AStr'), AIR.Null()))
        .Return(AIR.Null())
     .EndWhen();

  LDeref := AIR.Deref(AIR.Get('AStr'), 'TStringRec');
  AIR.Return(AIR.GetField(LDeref, 'Data'))
  .EndFunc();

  AddStringsUtf16(AIR);

end;

procedure TMyrRuntime.AddIntrinsics(const AIR: TMyrIR);
begin
  // RT_WStrLen(AStr: Pointer): UInt64
  // Returns the length of a raw UTF-16 string (number of 16-bit units).
  // Returns 0 if nil. Authored as a 16-bit scan in IR, NOT via wcslen:
  // glibc's wcslen counts 32-bit wchar_t units and Myrissa wstrings are
  // UTF-16 on every target.
  AIR.Func(RT_WStrLen, cvtUInt64, False, plC, False)
     .Param('AStr', cvtPointer)
     .Local('LLen', cvtUInt64)
     .When(AIR.Eq(AIR.Get('AStr'), AIR.Null()))
        .Return(AIR.MakeInt64(0))
     .EndWhen()
     .Assign('LLen', AIR.MakeInt64(0))
     .Loop(AIR.Ne(AIR.Deref(AIR.Add(AIR.Get('AStr'),
        AIR.Mul(AIR.Get('LLen'), AIR.MakeInt64(2))), cvtUInt16), AIR.MakeInt64(0)))
        .Assign('LLen', AIR.Add(AIR.Get('LLen'), AIR.MakeInt64(1)))
     .EndLoop()
     .Return(AIR.Get('LLen'))
  .EndFunc();

  // RT_WStrConcat(AStr1, AStr2: Pointer): Pointer
  // Concatenates two raw wchar_t* wide strings. Allocates new buffer via
  // RT_GetMem. Caller is responsible for freeing. Handles nil as empty.
  AIR.Func(RT_WStrConcat, cvtPointer, False, plC, False)
     .Param('AStr1', cvtPointer)
     .Param('AStr2', cvtPointer)
     .Local('LLen1', cvtUInt64)
     .Local('LLen2', cvtUInt64)
     .Local('LTotalLen', cvtUInt64)
     .Local('LBuf', cvtPointer)
     // Get length of first string (0 if nil)
     .When(AIR.Eq(AIR.Get('AStr1'), AIR.Null()))
        .Assign('LLen1', AIR.MakeInt64(0))
     .Otherwise()
        .Assign('LLen1', AIR.Invoke(RT_WStrLen, [AIR.Get('AStr1')]))
     .EndWhen()
     // Get length of second string (0 if nil)
     .When(AIR.Eq(AIR.Get('AStr2'), AIR.Null()))
        .Assign('LLen2', AIR.MakeInt64(0))
     .Otherwise()
        .Assign('LLen2', AIR.Invoke(RT_WStrLen, [AIR.Get('AStr2')]))
     .EndWhen()
     // Total length in wide chars
     .Assign('LTotalLen', AIR.Add(AIR.Get('LLen1'), AIR.Get('LLen2')))
     // Allocate buffer: (LTotalLen + 1) * 2 bytes
     .Assign('LBuf', AIR.Invoke(RT_GetMem,
        [AIR.Mul(AIR.Add(AIR.Get('LTotalLen'), AIR.MakeInt64(1)), AIR.MakeInt64(2))]))
     // Copy first string if not empty
     .When(AIR.Gt(AIR.Get('LLen1'), AIR.MakeInt64(0)))
        .Call('memcpy', [AIR.Get('LBuf'), AIR.Get('AStr1'),
           AIR.Mul(AIR.Get('LLen1'), AIR.MakeInt64(2))])
     .EndWhen()
     // Copy second string after first
     .When(AIR.Gt(AIR.Get('LLen2'), AIR.MakeInt64(0)))
        .Call('memcpy', [AIR.Add(AIR.Get('LBuf'), AIR.Mul(AIR.Get('LLen1'), AIR.MakeInt64(2))),
           AIR.Get('AStr2'), AIR.Mul(AIR.Get('LLen2'), AIR.MakeInt64(2))])
     .EndWhen()
     // Null terminate (2 bytes of zero)
     .Call('memset', [AIR.Add(AIR.Get('LBuf'), AIR.Mul(AIR.Get('LTotalLen'), AIR.MakeInt64(2))),
        AIR.MakeInt64(0), AIR.MakeInt64(2)])
     .Return(AIR.Get('LBuf'))
  .EndFunc();

  // RT_WStrCompare(AStr1, AStr2: Pointer): Int64
  // Lexicographic comparison of two raw wchar_t* wide strings.
  // Returns -1, 0, or 1. Nil is treated as less than any non-nil string.
  AIR.Func(RT_WStrCompare, cvtInt64, False, plC, False)
     .Param('AStr1', cvtPointer)
     .Param('AStr2', cvtPointer)
     .Local('LLen1', cvtUInt64)
     .Local('LLen2', cvtUInt64)
     .Local('LMinLen', cvtUInt64)
     .Local('LResult', cvtInt32)
     // Check AStr1 nil
     .When(AIR.Eq(AIR.Get('AStr1'), AIR.Null()))
        // AStr1 is nil — check AStr2
        .When(AIR.Eq(AIR.Get('AStr2'), AIR.Null()))
           .Return(AIR.MakeInt64(0))   // Both nil -> equal
        .EndWhen()
        .Return(AIR.MakeInt64(-1))     // AStr1 nil, AStr2 not nil -> less than
     .EndWhen()
     // AStr1 not nil — check AStr2
     .When(AIR.Eq(AIR.Get('AStr2'), AIR.Null()))
        .Return(AIR.MakeInt64(1))      // AStr1 not nil, AStr2 nil -> greater than
     .EndWhen()
     // Get lengths
     .Assign('LLen1', AIR.Invoke(RT_WStrLen, [AIR.Get('AStr1')]))
     .Assign('LLen2', AIR.Invoke(RT_WStrLen, [AIR.Get('AStr2')]))
     // LMinLen = min(LLen1, LLen2)
     .When(AIR.Lt(AIR.Get('LLen1'), AIR.Get('LLen2')))
        .Assign('LMinLen', AIR.Get('LLen1'))
     .Otherwise()
        .Assign('LMinLen', AIR.Get('LLen2'))
     .EndWhen()
     // LResult = memcmp(AStr1, AStr2, LMinLen * 2)
     .Assign('LResult', AIR.Invoke('memcmp', [AIR.Get('AStr1'), AIR.Get('AStr2'),
        AIR.Mul(AIR.Get('LMinLen'), AIR.MakeInt64(2))]))
     // If memcmp result < 0, return -1
     .When(AIR.Lt(AIR.Get('LResult'), AIR.MakeInt64(0)))
        .Return(AIR.MakeInt64(-1))
     .EndWhen()
     // If memcmp result > 0, return 1
     .When(AIR.Gt(AIR.Get('LResult'), AIR.MakeInt64(0)))
        .Return(AIR.MakeInt64(1))
     .EndWhen()
     // memcmp returned 0, compare by length
     .When(AIR.Lt(AIR.Get('LLen1'), AIR.Get('LLen2')))
        .Return(AIR.MakeInt64(-1))
     .EndWhen()
     .When(AIR.Gt(AIR.Get('LLen1'), AIR.Get('LLen2')))
        .Return(AIR.MakeInt64(1))
     .EndWhen()
     .Return(AIR.MakeInt64(0))
  .EndFunc();

  // RT_WStrFromLiteral(AData: Pointer, AWideLen: Int64): Pointer
  // Creates a heap-allocated copy of a UTF-16 literal. AWideLen is the number
  // of wide characters (not bytes). Allocates (AWideLen+1)*2 bytes and null-
  // terminates. Caller is responsible for freeing via Cbr_FreeMem.
  AIR.Func(RT_WStrFromLiteral, cvtPointer, False, plC, False)
     .Param('AData', cvtPointer)
     .Param('AWideLen', cvtInt64)
     .Local('LBuf', cvtPointer)
     // Allocate buffer: (AWideLen + 1) * 2 bytes
     .Assign('LBuf', AIR.Invoke(RT_GetMem,
        [AIR.Mul(AIR.Add(AIR.Get('AWideLen'), AIR.MakeInt64(1)), AIR.MakeInt64(2))]))
     // Copy AWideLen * 2 bytes from literal data
     .Call('memcpy', [AIR.Get('LBuf'), AIR.Get('AData'),
        AIR.Mul(AIR.Get('AWideLen'), AIR.MakeInt64(2))])
     // Null-terminate (2 bytes of zero)
     .Call('memset', [AIR.Add(AIR.Get('LBuf'),
        AIR.Mul(AIR.Get('AWideLen'), AIR.MakeInt64(2))),
        AIR.MakeInt64(0), AIR.MakeInt64(2)])
     .Return(AIR.Get('LBuf'))
  .EndFunc();

  // RT_WStrAssign(ADest: Pointer; ASrc: Pointer)
  // Assignment for raw wchar_t* wstrings (no refcounting -- each variable
  // owns its buffer). ADest is the address of the wstring variable slot.
  // Duplicates the source buffer, stores the copy, frees the old buffer.
  // Self-assignment safe: the copy is taken before the old buffer is freed.
  // Length comes from Cbr_WStrLen (16-bit scan, declared above) so the
  // UTF-16 length logic exists exactly once.
  AIR.Func(RT_WStrAssign, cvtVoid, False, plC, False)
     .Param('ADest', cvtPointer)   // Pointer to the wstring variable slot
     .Param('ASrc', cvtPointer)    // Source raw UTF-16 buffer
     .Local('LOld', cvtPointer)
     .Local('LLen', cvtUInt64)
     .Local('LBuf', cvtPointer);

  // Read old value from the destination slot
  AIR.Let('LOld', AIR.Deref(AIR.Get('ADest'), cvtPointer));

  // nil source: store nil, free old, done
  AIR.When(AIR.Eq(AIR.Get('ASrc'), AIR.Null()))
     .SetVal(AIR.Deref(AIR.Get('ADest'), cvtPointer), AIR.Null())
     .When(AIR.Ne(AIR.Get('LOld'), AIR.Null()))
        .Call(RT_FreeMem, [AIR.Get('LOld')])
     .EndWhen()
     .Return()
  .EndWhen();

  // Get the source length in UTF-16 units (single source: Cbr_WStrLen)
  AIR.Let('LLen', AIR.Invoke(RT_WStrLen, [AIR.Get('ASrc')]));

  // Duplicate: (LLen + 1) * 2 bytes including the terminator
  AIR.Let('LBuf', AIR.Invoke(RT_GetMem,
     [AIR.Mul(AIR.Add(AIR.Get('LLen'), AIR.MakeInt64(1)), AIR.MakeInt64(2))]));
  AIR.Call('memcpy', [AIR.Get('LBuf'), AIR.Get('ASrc'),
     AIR.Mul(AIR.Add(AIR.Get('LLen'), AIR.MakeInt64(1)), AIR.MakeInt64(2))]);

  // Store the copy, then free the old buffer
  AIR.SetVal(AIR.Deref(AIR.Get('ADest'), cvtPointer), AIR.Get('LBuf'));
  AIR.When(AIR.Ne(AIR.Get('LOld'), AIR.Null()))
     .Call(RT_FreeMem, [AIR.Get('LOld')])
  .EndWhen();
  AIR.Return();
  AIR.EndFunc();

  // RT_WStrSetLength(ADest: Pointer; ANewLen: UInt64)
  // Resizes the raw UTF-16 wstring in the variable slot to ANewLen units.
  // Allocates a fresh buffer, copies min(oldLen, ANewLen) units, zero-fills
  // any grown tail plus the terminator, frees the old buffer, stores the new.
  AIR.Func(RT_WStrSetLength, cvtVoid, False, plC, False)
     .Param('ADest', cvtPointer)   // Pointer to the wstring variable slot
     .Param('ANewLen', cvtUInt64)
     .Local('LOld', cvtPointer)
     .Local('LBuf', cvtPointer)
     .Local('LOldLen', cvtUInt64)
     .Local('LCopyLen', cvtUInt64);

  AIR.Let('LOld', AIR.Deref(AIR.Get('ADest'), cvtPointer));
  AIR.Let('LOldLen', AIR.Invoke(RT_WStrLen, [AIR.Get('LOld')]));

  // LCopyLen = min(LOldLen, ANewLen)
  AIR.When(AIR.Lt(AIR.Get('LOldLen'), AIR.Get('ANewLen')))
     .Assign('LCopyLen', AIR.Get('LOldLen'))
  .Otherwise()
     .Assign('LCopyLen', AIR.Get('ANewLen'))
  .EndWhen();

  // Allocate (ANewLen + 1) * 2 bytes
  AIR.Let('LBuf', AIR.Invoke(RT_GetMem,
     [AIR.Mul(AIR.Add(AIR.Get('ANewLen'), AIR.MakeInt64(1)), AIR.MakeInt64(2))]));

  // Copy the surviving prefix (LCopyLen * 2 bytes)
  AIR.When(AIR.Gt(AIR.Get('LCopyLen'), AIR.MakeInt64(0)))
     .Call('memcpy', [AIR.Get('LBuf'), AIR.Get('LOld'),
        AIR.Mul(AIR.Get('LCopyLen'), AIR.MakeInt64(2))])
  .EndWhen();

  // Zero-fill grown tail plus terminator: (ANewLen - LCopyLen + 1) * 2 bytes
  AIR.Call('memset', [AIR.Add(AIR.Get('LBuf'),
     AIR.Mul(AIR.Get('LCopyLen'), AIR.MakeInt64(2))),
     AIR.MakeInt64(0),
     AIR.Mul(AIR.Add(AIR.Sub(AIR.Get('ANewLen'), AIR.Get('LCopyLen')),
        AIR.MakeInt64(1)), AIR.MakeInt64(2))]);

  // Store new, free old
  AIR.SetVal(AIR.Deref(AIR.Get('ADest'), cvtPointer), AIR.Get('LBuf'));
  AIR.When(AIR.Ne(AIR.Get('LOld'), AIR.Null()))
     .Call(RT_FreeMem, [AIR.Get('LOld')])
  .EndWhen();
  AIR.Return();
  AIR.EndFunc();

  AddIntrinsicsUtf8(AIR);

  // RT_Len(ATag: Int64, AVal: Pointer): UInt64
  // Unified len() intrinsic. Dispatches to the correct length routine
  // based on a compile-time type tag injected by the codegen.
  //   Tag 0 = string  → Cbr_StrLen (managed TStringRec)
  //   Tag 1 = wstring → Cbr_WStrLen (raw wchar_t*)
  //   Tag 2 = dynarray → Cbr_DynLen (length header at ptr-8)
  AIR.Func(RT_Len, cvtUInt64, False, plC, False)
     .Param('ATag', cvtInt64)
     .Param('AVal', cvtPointer)

     // Tag 0: string (managed TStringRec)
     .When(AIR.Eq(AIR.Get('ATag'), AIR.MakeInt64(0)))
        .Return(AIR.Invoke(RT_StrLen, [AIR.Get('AVal')]))
     .EndWhen()

     // Tag 1: wstring (raw wchar_t*)
     .When(AIR.Eq(AIR.Get('ATag'), AIR.MakeInt64(1)))
        .Return(AIR.Invoke(RT_WStrLen, [AIR.Get('AVal')]))
     .EndWhen()

     // Tag 2: dynarray (length at ptr - 8)
     .When(AIR.Eq(AIR.Get('ATag'), AIR.MakeInt64(2)))
        .Return(AIR.Invoke(RT_DynLen, [AIR.Get('AVal')]))
     .EndWhen()

     // Unknown tag — return 0
     .Return(AIR.MakeInt64(0))
  .EndFunc();

  // RT_DynLen(APtr: Pointer): UInt64
  // Returns the length of a dynamic array. The length is stored as an Int64
  // at (APtr - 8), i.e. in the 8 bytes immediately before the data pointer.
  // Returns 0 if APtr is nil.
  AIR.Func(RT_DynLen, cvtUInt64, False, plC, False)
     .Param('APtr', cvtPointer)
     .Local('LHeader', cvtPointer)
     .When(AIR.Eq(AIR.Get('APtr'), AIR.Null()))
        .Return(AIR.MakeInt64(0))
     .EndWhen()
     // Length is at APtr - 8
     .Let('LHeader', AIR.Sub(AIR.Get('APtr'), AIR.MakeInt64(8)))
     .Return(AIR.Deref(AIR.Get('LHeader'), cvtUInt64))
  .EndFunc();

  // RT_SetLength(AVar: Pointer, ANewLen: Int64, AElemSize: Int64)
  // Allocates or reallocates a dynamic array, PRESERVING existing elements.
  // AVar = address of the pointer variable (passed by reference).
  // Layout: [Length:Int64][Element0][Element1]...
  // The pointer stored in *AVar points to Element0 (past the header).
  //
  // Regrow goes through RT_ReAllocMem so surviving elements keep their bytes
  // and, for managed elements, their ownership. The previous free-then-alloc
  // form orphaned every managed element on ANY setlength over a non-nil
  // array (the test_exe_dynrec leak) and silently destroyed the surviving
  // elements' data as well. The grown tail is zeroed explicitly because
  // ReAllocMem does not zero new bytes and managed slots must read as nil.
  //
  // KNOWN LIMITATION: SHRINKING an array whose truncated tail holds managed
  // elements leaks those elements - this routine has no element-kind/thunk
  // argument to release them with. Threading the RT_ArrayReleaseComposite
  // machinery through here is a design addition tracked as its own item.
  AIR.Func(RT_SetLength, cvtVoid, False, plC, False)
     .Param('AVar', cvtPointer)
     .Param('ANewLen', cvtInt64)
     .Param('AElemSize', cvtInt64)
     .Local('LOldPtr', cvtPointer)
     .Local('LBlock', cvtPointer)
     .Local('LDataPtr', cvtPointer)
     .Local('LOldBytes', cvtInt64)
     .Local('LNewBytes', cvtInt64)
     .Local('LIdx', cvtInt64);

  // Read old pointer from *AVar
  AIR.Let('LOldPtr', AIR.Deref(AIR.Get('AVar'), cvtPointer));

  AIR.Let('LNewBytes', AIR.Mul(AIR.Get('ANewLen'), AIR.Get('AElemSize')));

  // Fresh allocation: AllocMem zero-initializes, so the tail-zero loop below
  // has nothing to do - LOldBytes is set to LNewBytes to make it a no-op.
  AIR.When(AIR.Eq(AIR.Get('LOldPtr'), AIR.Null()))
     .Assign('LBlock', AIR.Invoke(RT_AllocMem,
        [AIR.Add(AIR.MakeInt64(8), AIR.Get('LNewBytes'))]))
     .Assign('LOldBytes', AIR.Get('LNewBytes'))
  .EndWhen();

  // Regrow: reallocate the whole block (header included), keeping the
  // surviving elements' bytes and ownership. Old byte count is read from the
  // header BEFORE the realloc moves the block.
  AIR.When(AIR.Ne(AIR.Get('LOldPtr'), AIR.Null()))
     .Assign('LOldBytes', AIR.Mul(
        AIR.Deref(AIR.Sub(AIR.Get('LOldPtr'), AIR.MakeInt64(8)), cvtInt64),
        AIR.Get('AElemSize')))
     .Assign('LBlock', AIR.Invoke(RT_ReAllocMem,
        [AIR.Sub(AIR.Get('LOldPtr'), AIR.MakeInt64(8)),
         AIR.Add(AIR.MakeInt64(8), AIR.Get('LNewBytes'))]))
  .EndWhen();

  // Store length in the header (first 8 bytes)
  AIR.SetVal(AIR.Deref(AIR.Get('LBlock'), cvtInt64), AIR.Get('ANewLen'));

  // Data pointer = block + 8
  AIR.Let('LDataPtr', AIR.Add(AIR.Get('LBlock'), AIR.MakeInt64(8)));

  // Zero the grown tail byte-by-byte: [LOldBytes, LNewBytes). Skipped
  // entirely on shrink (LOldBytes >= LNewBytes) and on fresh allocation.
  AIR.Assign('LIdx', AIR.Get('LOldBytes'));
  AIR.Loop(AIR.Lt(AIR.Get('LIdx'), AIR.Get('LNewBytes')));
  AIR.SetVal(AIR.Deref(AIR.Add(AIR.Get('LDataPtr'), AIR.Get('LIdx')), cvtInt8),
     AIR.MakeInt64(0));
  AIR.Assign('LIdx', AIR.Add(AIR.Get('LIdx'), AIR.MakeInt64(1)));
  AIR.EndLoop();

  // Store data pointer into *AVar
  AIR.SetVal(AIR.Deref(AIR.Get('AVar'), cvtPointer), AIR.Get('LDataPtr'));

  AIR.Return();
  AIR.EndFunc();

  //----------------------------------------------------------------------------
  // Cbr_DynFree(APtr: Pointer)
  // Frees a dynamic array. APtr is the data pointer (block starts at APtr-8).
  // Does nothing if APtr is nil. Used by the cleanup pass for managed locals.
  //----------------------------------------------------------------------------
  AIR.Func(RT_DynFree, cvtVoid, False, plC, False)
     .Param('APtr', cvtPointer)
     .When(AIR.Eq(AIR.Get('APtr'), AIR.Null()))
        .Return()
     .EndWhen()
     .Call(RT_FreeMem, [AIR.Sub(AIR.Get('APtr'), AIR.MakeInt64(8))])
     .Return()
  .EndFunc();

  // RT_DynFreeOnDetach(AReason: Int32; APtr: Pointer)
  // Conditionally frees a dynamic array during DLL unload.
  // Only frees when AReason = 0 (DLL_PROCESS_DETACH); nil-safe via DynFree.
  // Twin of Cbr_ReleaseOnDetach/Cbr_FreeOnDetach for dynarray globals.
  AIR.Func(RT_DynFreeOnDetach, cvtVoid, False, plC, False)
     .Param('AReason', cvtInt32)
     .Param('APtr', cvtPointer)
     .When(AIR.Eq(AIR.Get('AReason'), AIR.Int32(0)))
        .Call(RT_DynFree, [AIR.Get('APtr')])
     .EndWhen()
     .Return()
  .EndFunc();

  // RT_ArrayRelease(APtr: Pointer; ACount: Int64; AStride: Int64; AKind: Int32)
  // Releases every element of a fixed array of managed elements.
  // APtr is the address of element zero; AStride is the element size in bytes.
  // AKind selects the leaf release: 0 = string, 1 = wstring, 2 = dynarray.
  // This is a COUNTED LOOP by design -- the cleanup pass must never unroll a
  // per-element release sequence, since array[0..9999] of string would emit
  // ten thousand call sites.
  // Every leaf release is nil-safe on both targets, so an array that was never
  // assigned walks its full length harmlessly.
  AIR.Func(RT_ArrayRelease, cvtVoid, False, plC, False)
     .Param('APtr', cvtPointer)
     .Param('ACount', cvtInt64)
     .Param('AStride', cvtInt64)
     .Param('AKind', cvtInt32)
     .Local('LIdx', cvtInt64)
     .Local('LElem', cvtPointer);

  // Nothing to walk without a base address.
  AIR.When(AIR.Eq(AIR.Get('APtr'), AIR.Null()))
     .Return()
  .EndWhen();

  AIR.Assign('LIdx', AIR.MakeInt64(0));
  AIR.Loop(AIR.Lt(AIR.Get('LIdx'), AIR.Get('ACount')));

  // Each element slot holds the managed pointer itself, so load through the
  // stride offset rather than passing the slot address to the leaf routine.
  AIR.Assign('LElem', AIR.Deref(
     AIR.Add(AIR.Get('APtr'), AIR.Mul(AIR.Get('LIdx'), AIR.Get('AStride'))),
     cvtPointer));

  // Kind dispatch mirrors DoResolveLeafFuncIdx's positional triple.
  AIR.When(AIR.Eq(AIR.Get('AKind'), AIR.Int32(0)))
     .Call(RT_StrRelease, [AIR.Get('LElem')])
  .EndWhen();

  AIR.When(AIR.Eq(AIR.Get('AKind'), AIR.Int32(1)))
     .Call(RT_FreeMem, [AIR.Get('LElem')])
  .EndWhen();

  AIR.When(AIR.Eq(AIR.Get('AKind'), AIR.Int32(2)))
     .Call(RT_DynFree, [AIR.Get('LElem')])
  .EndWhen();

  AIR.Assign('LIdx', AIR.Add(AIR.Get('LIdx'), AIR.MakeInt64(1)));
  AIR.EndLoop();

  AIR.Return();
  AIR.EndFunc();

  // RT_ArrayReleaseComposite(APtr: Pointer; ACount: Int64; AStride: Int64;
  //                          AThunk: Pointer)
  // Releases every element of a fixed array whose ELEMENT TYPE IS COMPOSITE --
  // a record holding managed fields, or a nested array.
  // RT_ArrayRelease cannot serve this case. It DEREFERENCES each slot, which is
  // correct only when the slot itself holds the managed pointer. A record
  // element is stored INLINE, so its managed fields live at offsets INSIDE the
  // element and the element ADDRESS is what the per-type release thunk needs.
  // AThunk is the address of a compiler-emitted release routine for the element
  // type, invoked once per element as AThunk(elementAddress).
  // Counted loop by design, exactly as RT_ArrayRelease -- never an unrolled
  // per-element sequence, since array[0..9999] of a record must not emit ten
  // thousand call sites.
  // Nil-safe on both targets: a nil base address or a nil thunk walks nothing.
  AIR.Func(RT_ArrayReleaseComposite, cvtVoid, False, plC, False)
     .Param('APtr', cvtPointer)
     .Param('ACount', cvtInt64)
     .Param('AStride', cvtInt64)
     .Param('AThunk', cvtPointer)
     .Local('LIdx', cvtInt64)
     .Local('LElem', cvtPointer);

  // Nothing to walk without a base address.
  AIR.When(AIR.Eq(AIR.Get('APtr'), AIR.Null()))
     .Return()
  .EndWhen();

  // A nil thunk means the element type resolved to no release routine at all.
  // Walking would call through a null pointer, so return instead.
  AIR.When(AIR.Eq(AIR.Get('AThunk'), AIR.Null()))
     .Return()
  .EndWhen();

  AIR.Assign('LIdx', AIR.MakeInt64(0));
  AIR.Loop(AIR.Lt(AIR.Get('LIdx'), AIR.Get('ACount')));

  // The element ADDRESS, deliberately NOT dereferenced -- see the header above.
  // This is the single line that distinguishes this walker from RT_ArrayRelease.
  AIR.Assign('LElem',
     AIR.Add(AIR.Get('APtr'), AIR.Mul(AIR.Get('LIdx'), AIR.Get('AStride'))));

  AIR.CallIndirect(AIR.Get('AThunk'), [AIR.Get('LElem')]);

  AIR.Assign('LIdx', AIR.Add(AIR.Get('LIdx'), AIR.MakeInt64(1)));
  AIR.EndLoop();

  AIR.Return();
  AIR.EndFunc();

  // RT_ArrayReleaseOnDetach(AReason: Int32; APtr: Pointer; ACount: Int64;
  //                         AStride: Int64; AKind: Int32)
  // Conditionally releases a fixed managed array during DLL unload.
  // Only releases when AReason = 0 (DLL_PROCESS_DETACH).
  // Twin of RT_DynFreeOnDetach for fixed-array globals in a DLL.
  AIR.Func(RT_ArrayReleaseOnDetach, cvtVoid, False, plC, False)
     .Param('AReason', cvtInt32)
     .Param('APtr', cvtPointer)
     .Param('ACount', cvtInt64)
     .Param('AStride', cvtInt64)
     .Param('AKind', cvtInt32)
     .When(AIR.Eq(AIR.Get('AReason'), AIR.Int32(0)))
        .Call(RT_ArrayRelease, [AIR.Get('APtr'), AIR.Get('ACount'),
                                AIR.Get('AStride'), AIR.Get('AKind')])
     .EndWhen()
     .Return()
  .EndFunc();

  // RT_ArrayReleaseCompositeOnDetach(AReason: Int32; APtr: Pointer;
  //                                  ACount: Int64; AStride: Int64;
  //                                  AThunk: Pointer)
  // Conditionally releases a fixed or dynamic array of COMPOSITE elements
  // during DLL unload. Only releases when AReason = 0 (DLL_PROCESS_DETACH).
  // Twin of RT_ArrayReleaseOnDetach for composite element types.
  // The reason is checked ONCE here and the plain composite walker is then
  // delegated to, exactly as RT_ArrayReleaseOnDetach delegates to
  // RT_ArrayRelease. The per-type thunk therefore needs no detach variant.
  AIR.Func(RT_ArrayReleaseCompositeOnDetach, cvtVoid, False, plC, False)
     .Param('AReason', cvtInt32)
     .Param('APtr', cvtPointer)
     .Param('ACount', cvtInt64)
     .Param('AStride', cvtInt64)
     .Param('AThunk', cvtPointer)
     .When(AIR.Eq(AIR.Get('AReason'), AIR.Int32(0)))
        .Call(RT_ArrayReleaseComposite, [AIR.Get('APtr'), AIR.Get('ACount'),
                                         AIR.Get('AStride'), AIR.Get('AThunk')])
     .EndWhen()
     .Return()
  .EndFunc();
end;

type
  { TMyrCmpDifferFunc }
  // Returns a family's "the two operands differ" expression -- non-zero when
  // they are NOT equal. Invoked after the function prologue has been emitted,
  // so it may reference the declared parameters and locals by name.
  TMyrCmpDifferFunc = reference to function(const AIR: TMyrIR): TMyrIRExpr;

  { TMyrCmpBodyProc }
  // Emits family-specific statements at a fixed point inside the scaffold.
  TMyrCmpBodyProc = reference to procedure(const AIR: TMyrIR);

  { TMyrCmpArgsFunc }
  // Returns the printf value arguments that match a family's value format.
  TMyrCmpArgsFunc = reference to function(const AIR: TMyrIR): TArray<TMyrIRExpr>;

{ DoCmpDifferNe }
// The plain inequality differ, shared by every family whose operands compare
// with a single integer or pointer Ne.
function DoCmpDifferNe(): TMyrCmpDifferFunc;
begin
  Result :=
    function(const AIR: TMyrIR): TMyrIRExpr
    begin
      Result := AIR.Ne(AIR.Get('AExpected'), AIR.Get('AActual'));
    end;
end;

{ DoCmpArgsOperands }
// The plain value argument pair, shared by every family that prints its two
// operands directly rather than a converted or substituted form.
function DoCmpArgsOperands(): TMyrCmpArgsFunc;
begin
  Result :=
    function(const AIR: TMyrIR): TArray<TMyrIRExpr>
    begin
      Result := [AIR.Get('AExpected'), AIR.Get('AActual')];
    end;
end;

{ DoEmitStandaloneHalt }
// A failed assert is fatal outside the test runner: there is no harness to
// record the failure and no next test to advance to, so continuing would run
// code whose stated precondition is known to be false. Inside the runner it
// must NOT halt -- RT_TestRunAll needs control back to mark this test failed
// and continue with the remaining registered tests. Every assert family routes
// its termination through here so the two modes cannot drift apart.
procedure DoEmitStandaloneHalt(const AIR: TMyrIR);
begin
  AIR.When(AIR.Eq(AIR.Invoke(RT_IsUnitTestMode, []), AIR.MakeInt64(0)))
     .Call(RT_Halt, [AIR.MakeInt64(1)])
  .EndWhen();
end;

{ DoEmitCmpAssert }
// Emits one RT_TestAssertCmp* comparison family. Every family shares this one
// scaffold: the relation gate, the keyword selection, the optional message and
// the colour reset exist in exactly one copy, so eq and neq cannot drift apart
// and neither can the ten type families. Only genuinely per-family logic
// arrives through the callbacks.
procedure DoEmitCmpAssert(const AIR: TMyrIR; const AName: string;
  const AOperandType: TMyrValueType; const AKeywordEq: string;
  const AKeywordNeq: string; const AValueFormat: string;
  const AHasEpsilon: Boolean; const ADiffer: TMyrCmpDifferFunc;
  const AExtraLocals: TMyrCmpBodyProc; const APrepare: TMyrCmpBodyProc;
  const AValueArgs: TMyrCmpArgsFunc; const ACleanup: TMyrCmpBodyProc);
var
  LArgs: TArray<TMyrIRExpr>;
begin
  AIR.Func(AName, cvtVoid, False, plC, False)
     .Param('AExpected', AOperandType)
     .Param('AActual', AOperandType);

  // The tolerance family carries its epsilon ahead of the relation so that
  // the relation always occupies the same position relative to the trailing
  // message/file/line group.
  if AHasEpsilon then
    AIR.Param('AEpsilon', cvtFloat64);

  AIR.Param('ARelation', cvtInt64)
     .Param('AMsg', cvtPointer)
     .Param('AFile', cvtPointer)
     .Param('ALine', cvtInt64)
     .Local('LDiffer', cvtInt64)
     .Local('LKeyword', cvtPointer)
     .Local('LNot', cvtPointer);

  if Assigned(AExtraLocals) then
    AExtraLocals(AIR);

  // LDiffer is the ONLY per-family comparison. Computing it once here keeps
  // the gate below byte-identical across families and, for the string
  // families, avoids invoking the comparison routine a second time.
  AIR.Assign('LDiffer', ADiffer(AIR));

  // Uniform failure gate: an equality assert fails when the values differ, an
  // inequality assert fails when they do not. A reserved relation matches
  // neither arm and therefore never reports a failure.
  AIR.When(AIR.LogOr(
     AIR.LogAnd(AIR.Eq(AIR.Get('ARelation'), AIR.MakeInt64(RT_CMP_EQ)),
                AIR.Ne(AIR.Get('LDiffer'), AIR.MakeInt64(0))),
     AIR.LogAnd(AIR.Eq(AIR.Get('ARelation'), AIR.MakeInt64(RT_CMP_NEQ)),
                AIR.Eq(AIR.Get('LDiffer'), AIR.MakeInt64(0)))))
     .Assign(RT_TestFailed, AIR.MakeInt64(1));

  if Assigned(APrepare) then
    APrepare(AIR);

  // Keyword and negation word follow the relation, so the reported statement
  // name is always the one the user actually wrote. There is no ternary or
  // select builder in the IR -- this nested When/Otherwise is the idiom.
  AIR.When(AIR.Eq(AIR.Get('ARelation'), AIR.MakeInt64(RT_CMP_NEQ)))
     .Assign('LKeyword', AIR.Str(AKeywordNeq))
     .Assign('LNot', AIR.Str('not '))
  .Otherwise()
     .Assign('LKeyword', AIR.Str(AKeywordEq))
     .Assign('LNot', AIR.Str(''))
  .EndWhen();

  // Mode branch: test runner buffers into RT_TestErrBuf, standalone prints
  // directly to stdout via printf.
  AIR.When(AIR.Ne(AIR.Invoke(RT_IsUnitTestMode, []), AIR.MakeInt64(0)));

  // Test runner path: sprintf into buffer
  LArgs := [
    AIR.Add(AIR.Get(RT_TestErrBuf), AIR.Get(RT_TestErrPos)),
    AIR.Str('  ' + #27'[1;31m%s' + #27'[31m failed at %s:%lld: expected ' +
      AValueFormat),
    AIR.Get('LKeyword'),
    AIR.Invoke(RT_BaseName, [AIR.Get('AFile')]),
    AIR.Get('ALine'),
    AIR.Get('LNot')];
  LArgs := LArgs + AValueArgs(AIR);
  AIR.Assign(RT_TestErrPos, AIR.Add(AIR.Get(RT_TestErrPos),
     AIR.Invoke('sprintf', LArgs)));

  AIR.When(AIR.Ne(AIR.Get('AMsg'), AIR.Null()))
     .Assign(RT_TestErrPos, AIR.Add(AIR.Get(RT_TestErrPos),
        AIR.Invoke('sprintf', [
          AIR.Add(AIR.Get(RT_TestErrBuf), AIR.Get(RT_TestErrPos)),
          AIR.Str(' - %s'), AIR.Get('AMsg')])))
  .EndWhen();

  AIR.Assign(RT_TestErrPos, AIR.Add(AIR.Get(RT_TestErrPos),
     AIR.Invoke('sprintf', [
       AIR.Add(AIR.Get(RT_TestErrBuf), AIR.Get(RT_TestErrPos)),
       AIR.Str(#27'[0m' + #10)])));

  AIR.Otherwise();

  // Standalone path: printf directly to stdout
  LArgs := [
    AIR.Str('  ' + #27'[1;31m%s' + #27'[31m failed at %s:%lld: expected ' +
      AValueFormat),
    AIR.Get('LKeyword'),
    AIR.Invoke(RT_BaseName, [AIR.Get('AFile')]),
    AIR.Get('ALine'),
    AIR.Get('LNot')];
  LArgs := LArgs + AValueArgs(AIR);
  AIR.Call('printf', LArgs);

  AIR.When(AIR.Ne(AIR.Get('AMsg'), AIR.Null()))
     .Call('printf', [AIR.Str(' - %s'), AIR.Get('AMsg')])
  .EndWhen();

  AIR.Call('printf', [AIR.Str(#27'[0m' + #10)]);

  AIR.EndWhen();

  // Cleanup runs after output so freed buffers are never read.
  if Assigned(ACleanup) then
    ACleanup(AIR);

  // Standalone mode is fatal, test-runner mode is not. See
  // DoEmitStandaloneHalt. Placed after cleanup so the family's temporaries
  // are released before the process terminates.
  DoEmitStandaloneHalt(AIR);

  AIR.EndWhen();
  AIR.EndFunc();
end;

{ TMyrRuntime }
procedure TMyrRuntime.AddUnitTesting(const AIR: TMyrIR);
begin
  // Import strcmp from msvcrt.dll for string comparison

  // Globals: test registration arrays and state
  AIR.Global(RT_TestCount, cvtInt64);
  AIR.Global(RT_TestNames, cvtPointer);
  AIR.Global(RT_TestFuncs, cvtPointer);
  AIR.Global(RT_TestFiles, cvtPointer);
  AIR.Global(RT_TestLines, cvtPointer);
  AIR.Global(RT_TestFailed, cvtInt64);
  AIR.Global(RT_TestErrBuf, cvtPointer);
  AIR.Global(RT_TestErrPos, cvtInt64);

  // RT_IsUnitTestMode() -> int64
  // Returns 1 when the test runner buffer has been allocated (i.e. at least
  // one test was registered via RT_TestRegister), 0 otherwise.
  AIR.Func(RT_IsUnitTestMode, cvtInt64, False, plC, False);
  AIR.When(AIR.Ne(AIR.Get(RT_TestErrBuf), AIR.Null()))
     .Ret(AIR.MakeInt64(1))
  .EndWhen();
  AIR.Ret(AIR.MakeInt64(0));
  AIR.EndFunc();

  // RT_TestRegister(AName: ptr, AFunc: ptr, AFile: ptr, ALine: int64) -> int32
  // Registers a test function. Lazy-allocates arrays on first use (256 max).
  AIR.Func(RT_TestRegister, cvtInt32, False, plC, False)
     .Param('AName', cvtPointer)
     .Param('AFunc', cvtPointer)
     .Param('AFile', cvtPointer)
     .Param('ALine', cvtInt64);

  // Bounds check
  AIR.When(AIR.Ge(AIR.Get(RT_TestCount), AIR.MakeInt64(256)))
     .Ret(AIR.Int32(0))
  .EndWhen();

  // Lazy-allocate arrays (256 * 8 = 2048 bytes each)
  AIR.When(AIR.Eq(AIR.Get(RT_TestNames), AIR.Null()))
     .Assign(RT_TestNames, AIR.Invoke(RT_AllocMem, [AIR.MakeInt64(2048)]))
     .Assign(RT_TestFuncs, AIR.Invoke(RT_AllocMem, [AIR.MakeInt64(2048)]))
     .Assign(RT_TestFiles, AIR.Invoke(RT_AllocMem, [AIR.MakeInt64(2048)]))
     .Assign(RT_TestLines, AIR.Invoke(RT_AllocMem, [AIR.MakeInt64(2048)]))
     .Assign(RT_TestErrBuf, AIR.Invoke(RT_AllocMem, [AIR.MakeInt64(4096)]))
  .EndWhen();

  // Store at RT_TestNames[count]
  AIR.SetVal(
     AIR.Deref(
        AIR.Add(AIR.Get(RT_TestNames),
                AIR.Mul(AIR.Get(RT_TestCount), AIR.MakeInt64(8))),
        cvtPointer),
     AIR.Get('AName'));

  // Store at RT_TestFuncs[count]
  AIR.SetVal(
     AIR.Deref(
        AIR.Add(AIR.Get(RT_TestFuncs),
                AIR.Mul(AIR.Get(RT_TestCount), AIR.MakeInt64(8))),
        cvtPointer),
     AIR.Get('AFunc'));

  // Store at RT_TestFiles[count]
  AIR.SetVal(
     AIR.Deref(
        AIR.Add(AIR.Get(RT_TestFiles),
                AIR.Mul(AIR.Get(RT_TestCount), AIR.MakeInt64(8))),
        cvtPointer),
     AIR.Get('AFile'));

  // Store at RT_TestLines[count]
  AIR.SetVal(
     AIR.Deref(
        AIR.Add(AIR.Get(RT_TestLines),
                AIR.Mul(AIR.Get(RT_TestCount), AIR.MakeInt64(8))),
        cvtInt64),
     AIR.Get('ALine'));

  AIR.Assign(RT_TestCount, AIR.Add(AIR.Get(RT_TestCount), AIR.MakeInt64(1)));
  AIR.Ret(AIR.Int32(1));
  AIR.EndFunc();

  // RT_TestRunAll() -> int32
  // Runs all registered tests, prints PASS/FAIL, returns 1 if any failed.
  AIR.Func(RT_TestRunAll, cvtInt32, False, plC, False)
     .Local('i', cvtInt64)
     .Local('LPassed', cvtInt64)
     .Local('LFailed', cvtInt64)
     .Local('LFuncPtr', cvtPointer)
     .Local('LName', cvtPointer);

  AIR.Assign('LPassed', AIR.MakeInt64(0));
  AIR.Assign('LFailed', AIR.MakeInt64(0));

  // Nothing to run?
  AIR.When(AIR.Eq(AIR.Get(RT_TestCount), AIR.MakeInt64(0)))
     .Call('printf', [AIR.Str('No tests registered.' + #10)])
     .Ret(AIR.Int32(0))
  .EndWhen();

  // Header
  AIR.Call('printf', [AIR.Str(#10 + #27'[1;36m=== Unit Tests ===' + #27'[0m' + #10)]);
  AIR.Call('printf', [AIR.Str('Running %lld test(s)...' + #10 + #10),
     AIR.Get(RT_TestCount)]);

  // Loop over all tests
  AIR.Assign('i', AIR.MakeInt64(0));
  AIR.Loop(AIR.Lt(AIR.Get('i'), AIR.Get(RT_TestCount)));

  // Reset failed flag and error buffer
  AIR.Assign(RT_TestFailed, AIR.MakeInt64(0));
  AIR.Assign(RT_TestErrPos, AIR.MakeInt64(0));
  AIR.SetVal(AIR.Deref(AIR.Get(RT_TestErrBuf), cvtInt8), AIR.MakeInt64(0));

  // Load name and function pointer
  AIR.Assign('LName', AIR.Deref(
     AIR.Add(AIR.Get(RT_TestNames),
             AIR.Mul(AIR.Get('i'), AIR.MakeInt64(8))),
     cvtPointer));
  AIR.Assign('LFuncPtr', AIR.Deref(
     AIR.Add(AIR.Get(RT_TestFuncs),
             AIR.Mul(AIR.Get('i'), AIR.MakeInt64(8))),
     cvtPointer));

  // Call the test function
  AIR.CallIndirect(AIR.Get('LFuncPtr'));

  // Check result
  AIR.When(AIR.Ne(AIR.Get(RT_TestFailed), AIR.MakeInt64(0)))
     .Call('printf', [AIR.Str('' + #27'[1;31m[FAIL]' + #27'[0m %s' + #10), AIR.Get('LName')])
     .Call('printf', [AIR.Str('%s'), AIR.Get(RT_TestErrBuf)])
     .Assign('LFailed', AIR.Add(AIR.Get('LFailed'), AIR.MakeInt64(1)))
  .EndWhen();

  AIR.When(AIR.Eq(AIR.Get(RT_TestFailed), AIR.MakeInt64(0)))
     .Call('printf', [AIR.Str(#27'[1;32m[PASS]' + #27'[0m %s' + #10), AIR.Get('LName')])
     .Assign('LPassed', AIR.Add(AIR.Get('LPassed'), AIR.MakeInt64(1)))
  .EndWhen();

  AIR.Assign('i', AIR.Add(AIR.Get('i'), AIR.MakeInt64(1)));
  AIR.EndLoop();

  // Summary
  AIR.Call('printf', [AIR.Str(#10 + #27'[1;36m=== Results: ' + #27'[32m%lld passed' + #27'[0m' + #27'[1;36m, ' + #27'[31m%lld failed' + #27'[0m' + #27'[1;36m, %lld total ===' + #27'[0m' + #10),
     AIR.Get('LPassed'), AIR.Get('LFailed'), AIR.Get(RT_TestCount)]);

  // Free arrays
  AIR.Call(RT_FreeMem, [AIR.Get(RT_TestNames)]);
  AIR.Call(RT_FreeMem, [AIR.Get(RT_TestFuncs)]);
  AIR.Call(RT_FreeMem, [AIR.Get(RT_TestFiles)]);
  AIR.Call(RT_FreeMem, [AIR.Get(RT_TestLines)]);
  AIR.Call(RT_FreeMem, [AIR.Get(RT_TestErrBuf)]);
  AIR.Assign(RT_TestNames, AIR.Null());
  AIR.Assign(RT_TestFuncs, AIR.Null());
  AIR.Assign(RT_TestFiles, AIR.Null());
  AIR.Assign(RT_TestLines, AIR.Null());
  AIR.Assign(RT_TestErrBuf, AIR.Null());

  // Return 1 if any failed, 0 if all passed
  AIR.When(AIR.Gt(AIR.Get('LFailed'), AIR.MakeInt64(0)))
     .Ret(AIR.Int32(1))
  .EndWhen();
  AIR.Ret(AIR.Int32(0));
  AIR.EndFunc();

  // Assert functions -- each checks a condition, sets RT_TestFailed on failure,
  // and prints the failure location via printf.

  // RT_TestAssert(ACond: int64, AFile: ptr, ALine: int64)
  AIR.Func(RT_TestAssert, cvtVoid, False, plC, False)
     .Param('ACond', cvtInt64)
     .Param('AFile', cvtPointer)
     .Param('ALine', cvtInt64);
  AIR.When(AIR.Eq(AIR.Get('ACond'), AIR.MakeInt64(0)))
     .Assign(RT_TestFailed, AIR.MakeInt64(1));
  AIR.When(AIR.Ne(AIR.Invoke(RT_IsUnitTestMode, []), AIR.MakeInt64(0)))
     .Assign(RT_TestErrPos, AIR.Add(AIR.Get(RT_TestErrPos),
        AIR.Invoke('sprintf', [
          AIR.Add(AIR.Get(RT_TestErrBuf), AIR.Get(RT_TestErrPos)),
          AIR.Str('  ' + #27'[1;31massert' + #27'[31m failed at %s:%lld' + #27'[0m' + #10),
          AIR.Invoke(RT_BaseName, [AIR.Get('AFile')]), AIR.Get('ALine')])))
  .Otherwise()
     .Call('printf', [
        AIR.Str('  ' + #27'[1;31massert' + #27'[31m failed at %s:%lld' + #27'[0m' + #10),
        AIR.Invoke(RT_BaseName, [AIR.Get('AFile')]), AIR.Get('ALine')])
  .EndWhen();

  DoEmitStandaloneHalt(AIR);

  AIR.EndWhen();
  AIR.EndFunc();

  // RT_TestAssertTrue(ACond: int64, AFile: ptr, ALine: int64)
  AIR.Func(RT_TestAssertTrue, cvtVoid, False, plC, False)
     .Param('ACond', cvtInt64)
     .Param('AFile', cvtPointer)
     .Param('ALine', cvtInt64);
  AIR.When(AIR.Eq(AIR.Get('ACond'), AIR.MakeInt64(0)))
     .Assign(RT_TestFailed, AIR.MakeInt64(1));
  AIR.When(AIR.Ne(AIR.Invoke(RT_IsUnitTestMode, []), AIR.MakeInt64(0)))
     .Assign(RT_TestErrPos, AIR.Add(AIR.Get(RT_TestErrPos),
        AIR.Invoke('sprintf', [
          AIR.Add(AIR.Get(RT_TestErrBuf), AIR.Get(RT_TestErrPos)),
          AIR.Str('  ' + #27'[1;31masserttrue' + #27'[31m failed at %s:%lld' + #27'[0m' + #10),
          AIR.Invoke(RT_BaseName, [AIR.Get('AFile')]), AIR.Get('ALine')])))
  .Otherwise()
     .Call('printf', [
        AIR.Str('  ' + #27'[1;31masserttrue' + #27'[31m failed at %s:%lld' + #27'[0m' + #10),
        AIR.Invoke(RT_BaseName, [AIR.Get('AFile')]), AIR.Get('ALine')])
  .EndWhen();

  DoEmitStandaloneHalt(AIR);

  AIR.EndWhen();
  AIR.EndFunc();

  // RT_TestAssertFalse(ACond: int64, AFile: ptr, ALine: int64)
  AIR.Func(RT_TestAssertFalse, cvtVoid, False, plC, False)
     .Param('ACond', cvtInt64)
     .Param('AFile', cvtPointer)
     .Param('ALine', cvtInt64);
  AIR.When(AIR.Ne(AIR.Get('ACond'), AIR.MakeInt64(0)))
     .Assign(RT_TestFailed, AIR.MakeInt64(1));
  AIR.When(AIR.Ne(AIR.Invoke(RT_IsUnitTestMode, []), AIR.MakeInt64(0)))
     .Assign(RT_TestErrPos, AIR.Add(AIR.Get(RT_TestErrPos),
        AIR.Invoke('sprintf', [
          AIR.Add(AIR.Get(RT_TestErrBuf), AIR.Get(RT_TestErrPos)),
          AIR.Str('  ' + #27'[1;31massertfalse' + #27'[31m failed at %s:%lld' + #27'[0m' + #10),
          AIR.Invoke(RT_BaseName, [AIR.Get('AFile')]), AIR.Get('ALine')])))
  .Otherwise()
     .Call('printf', [
        AIR.Str('  ' + #27'[1;31massertfalse' + #27'[31m failed at %s:%lld' + #27'[0m' + #10),
        AIR.Invoke(RT_BaseName, [AIR.Get('AFile')]), AIR.Get('ALine')])
  .EndWhen();

  DoEmitStandaloneHalt(AIR);

  AIR.EndWhen();
  AIR.EndFunc();

  // RT_TestAssertCmpInt(AExpected, AActual: int64, ARelation: int64,
  //                     AMsg: ptr, AFile: ptr, ALine: int64)
  DoEmitCmpAssert(AIR, RT_TestAssertCmpInt, cvtInt64, 'asserteq', 'assertneq',
    '%s%lld, got %lld', False, DoCmpDifferNe(), nil, nil,
    DoCmpArgsOperands(), nil);

  // RT_TestAssertCmpUInt(AExpected, AActual: int64, ARelation: int64,
  //                      AMsg: ptr, AFile: ptr, ALine: int64)
  DoEmitCmpAssert(AIR, RT_TestAssertCmpUInt, cvtInt64, 'asserteq', 'assertneq',
    '%s%llu, got %llu', False, DoCmpDifferNe(), nil, nil,
    DoCmpArgsOperands(), nil);

  // RT_TestAssertCmpFloat(AExpected, AActual: float64, ARelation: int64,
  //                       AMsg: ptr, AFile: ptr, ALine: int64)
  DoEmitCmpAssert(AIR, RT_TestAssertCmpFloat, cvtFloat64, 'asserteq',
    'assertneq', '%s%g, got %g', False,
    function(const AIR: TMyrIR): TMyrIRExpr
    begin
      Result := AIR.FNe(AIR.Get('AExpected'), AIR.Get('AActual'));
    end,
    nil, nil, DoCmpArgsOperands(), nil);

  // RT_TestAssertCmpFloatTol(AExpected, AActual: float64, AEpsilon: float64,
  //                          ARelation: int64, AMsg: ptr, AFile: ptr,
  //                          ALine: int64)
  // Tolerance compare. "Differ" means |AExpected - AActual| > AEpsilon,
  // expressed as two one-sided comparisons OR'd together rather than as
  // fabs(): the runtime imports no libm, and adding one for a single
  // absolute value would be a new external dependency on both targets.
  // Float comparisons lower through UCOMISD to an integer 0 or 1 in a
  // general register, so LogOr combines them exactly as the integer
  // comparisons elsewhere in this runtime are combined. Feeding this
  // through the shared relation gate gives assertneqf -- "must differ by
  // more than epsilon" -- for free once the keyword exists.
  DoEmitCmpAssert(AIR, RT_TestAssertCmpFloatTol, cvtFloat64, 'asserteqf',
    'assertneqf', '%s%g, got %g (epsilon %g)', True,
    function(const AIR: TMyrIR): TMyrIRExpr
    begin
      Result := AIR.LogOr(
        AIR.FGt(AIR.FSub(AIR.Get('AExpected'), AIR.Get('AActual')),
                AIR.Get('AEpsilon')),
        AIR.FGt(AIR.FSub(AIR.Get('AActual'), AIR.Get('AExpected')),
                AIR.Get('AEpsilon')));
    end,
    nil, nil,
    function(const AIR: TMyrIR): TArray<TMyrIRExpr>
    begin
      Result := [AIR.Get('AExpected'), AIR.Get('AActual'),
                 AIR.Get('AEpsilon')];
    end,
    nil);

  // RT_TestAssertCmpStr(AExpected, AActual: ptr, ARelation: int64,
  //                     AMsg: ptr, AFile: ptr, ALine: int64)
  DoEmitCmpAssert(AIR, RT_TestAssertCmpStr, cvtPointer, 'asserteq',
    'assertneq', '%s"%s", got "%s"', False,
    function(const AIR: TMyrIR): TMyrIRExpr
    begin
      Result := AIR.Ne(
        AIR.Invoke('strcmp', [AIR.Get('AExpected'), AIR.Get('AActual')]),
        AIR.Int32(0));
    end,
    nil, nil, DoCmpArgsOperands(), nil);

  // RT_TestAssertCmpWStr(AExpected, AActual: ptr, ARelation: int64,
  //                      AMsg: ptr, AFile: ptr, ALine: int64)
  // Compares UTF-16 content via RT_WStrCompare, which is nil-safe and scans
  // 16-bit units. wcscmp is NOT usable here: glibc wchar_t is 32-bit while
  // Myrissa wstrings are UTF-16 on every target.
  // The failure message converts both operands to UTF-8 via RT_Utf8 so the
  // values print as text rather than garbage. Both buffers are heap-allocated
  // and are freed by the cleanup callback, which the scaffold runs after the
  // final sprintf; RT_FreeMem is nil-safe, so a nil operand (RT_Utf8 returns
  // nil for nil) needs no extra guard.
  DoEmitCmpAssert(AIR, RT_TestAssertCmpWStr, cvtPointer, 'asserteq',
    'assertneq', '%s"%s", got "%s"', False,
    function(const AIR: TMyrIR): TMyrIRExpr
    begin
      Result := AIR.Ne(
        AIR.Invoke(RT_WStrCompare, [AIR.Get('AExpected'), AIR.Get('AActual')]),
        AIR.MakeInt64(0));
    end,
    procedure(const AIR: TMyrIR)
    begin
      AIR.Local('LExpUtf8', cvtPointer)
         .Local('LActUtf8', cvtPointer);
    end,
    procedure(const AIR: TMyrIR)
    begin
      AIR.Assign('LExpUtf8', AIR.Invoke(RT_Utf8, [AIR.Get('AExpected')]));
      AIR.Assign('LActUtf8', AIR.Invoke(RT_Utf8, [AIR.Get('AActual')]));
    end,
    function(const AIR: TMyrIR): TArray<TMyrIRExpr>
    begin
      Result := [AIR.Get('LExpUtf8'), AIR.Get('LActUtf8')];
    end,
    procedure(const AIR: TMyrIR)
    begin
      AIR.Call(RT_FreeMem, [AIR.Get('LExpUtf8')]);
      AIR.Call(RT_FreeMem, [AIR.Get('LActUtf8')]);
    end);

  // RT_TestAssertCmpBool(AExpected, AActual: int64, ARelation: int64,
  //                      AMsg: ptr, AFile: ptr, ALine: int64)
  // Booleans print as words rather than numbers, so each operand is mapped to
  // a literal through its own When/Otherwise. The old body could special-case
  // on the truthiness of AExpected alone because equality failure implied the
  // values differed; under a relation gate an inequality failure means they
  // are EQUAL, so both operands must be formatted independently.
  DoEmitCmpAssert(AIR, RT_TestAssertCmpBool, cvtInt64, 'asserteq', 'assertneq',
    '%s%s, got %s', False, DoCmpDifferNe(),
    procedure(const AIR: TMyrIR)
    begin
      AIR.Local('LExpWord', cvtPointer)
         .Local('LActWord', cvtPointer);
    end,
    procedure(const AIR: TMyrIR)
    begin
      AIR.When(AIR.Eq(AIR.Get('AExpected'), AIR.MakeInt64(0)))
         .Assign('LExpWord', AIR.Str('false'))
      .Otherwise()
         .Assign('LExpWord', AIR.Str('true'))
      .EndWhen();
      AIR.When(AIR.Eq(AIR.Get('AActual'), AIR.MakeInt64(0)))
         .Assign('LActWord', AIR.Str('false'))
      .Otherwise()
         .Assign('LActWord', AIR.Str('true'))
      .EndWhen();
    end,
    function(const AIR: TMyrIR): TArray<TMyrIRExpr>
    begin
      Result := [AIR.Get('LExpWord'), AIR.Get('LActWord')];
    end,
    nil);

  // RT_TestAssertCmpChar(AExpected, AActual: int64, ARelation: int64,
  //                      AMsg: ptr, AFile: ptr, ALine: int64)
  DoEmitCmpAssert(AIR, RT_TestAssertCmpChar, cvtInt64, 'asserteq', 'assertneq',
    '%s''%c'', got ''%c''', False, DoCmpDifferNe(), nil, nil,
    DoCmpArgsOperands(), nil);

  // RT_TestAssertCmpWChar(AExpected, AActual: int64, ARelation: int64,
  //                       AMsg: ptr, AFile: ptr, ALine: int64)
  // UTF-16 code units are printed as numeric code points -- there is no runtime
  // UTF-16 to UTF-8 conversion helper, and %c would emit garbage for non-ASCII.
  DoEmitCmpAssert(AIR, RT_TestAssertCmpWChar, cvtInt64, 'asserteq',
    'assertneq', '%sU+%04llX, got U+%04llX', False, DoCmpDifferNe(), nil, nil,
    DoCmpArgsOperands(), nil);

  // RT_TestAssertCmpPtr(AExpected, AActual: ptr, ARelation: int64,
  //                     AMsg: ptr, AFile: ptr, ALine: int64)
  DoEmitCmpAssert(AIR, RT_TestAssertCmpPtr, cvtPointer, 'asserteq',
    'assertneq', '%s%p, got %p', False, DoCmpDifferNe(), nil, nil,
    DoCmpArgsOperands(), nil);

  // RT_TestAssertNil(APtr: ptr, AFile: ptr, ALine: int64)
  AIR.Func(RT_TestAssertNil, cvtVoid, False, plC, False)
     .Param('APtr', cvtPointer)
     .Param('AFile', cvtPointer)
     .Param('ALine', cvtInt64);
  AIR.When(AIR.Ne(AIR.Get('APtr'), AIR.Null()))
     .Assign(RT_TestFailed, AIR.MakeInt64(1));
  AIR.When(AIR.Ne(AIR.Invoke(RT_IsUnitTestMode, []), AIR.MakeInt64(0)))
     .Assign(RT_TestErrPos, AIR.Add(AIR.Get(RT_TestErrPos),
        AIR.Invoke('sprintf', [
          AIR.Add(AIR.Get(RT_TestErrBuf), AIR.Get(RT_TestErrPos)),
          AIR.Str('  ' + #27'[1;31massertnil' + #27'[31m failed at %s:%lld: got %p' + #27'[0m' + #10),
          AIR.Invoke(RT_BaseName, [AIR.Get('AFile')]), AIR.Get('ALine'), AIR.Get('APtr')])))
  .Otherwise()
     .Call('printf', [
        AIR.Str('  ' + #27'[1;31massertnil' + #27'[31m failed at %s:%lld: got %p' + #27'[0m' + #10),
        AIR.Invoke(RT_BaseName, [AIR.Get('AFile')]), AIR.Get('ALine'), AIR.Get('APtr')])
  .EndWhen();

  DoEmitStandaloneHalt(AIR);

  AIR.EndWhen();
  AIR.EndFunc();

  // RT_TestAssertNotNil(APtr: ptr, AFile: ptr, ALine: int64)
  AIR.Func(RT_TestAssertNotNil, cvtVoid, False, plC, False)
     .Param('APtr', cvtPointer)
     .Param('AFile', cvtPointer)
     .Param('ALine', cvtInt64);
  AIR.When(AIR.Eq(AIR.Get('APtr'), AIR.Null()))
     .Assign(RT_TestFailed, AIR.MakeInt64(1));
  AIR.When(AIR.Ne(AIR.Invoke(RT_IsUnitTestMode, []), AIR.MakeInt64(0)))
     .Assign(RT_TestErrPos, AIR.Add(AIR.Get(RT_TestErrPos),
        AIR.Invoke('sprintf', [
          AIR.Add(AIR.Get(RT_TestErrBuf), AIR.Get(RT_TestErrPos)),
          AIR.Str('  ' + #27'[1;31massertnotnil' + #27'[31m failed at %s:%lld: got nil' + #27'[0m' + #10),
          AIR.Invoke(RT_BaseName, [AIR.Get('AFile')]), AIR.Get('ALine')])))
  .Otherwise()
     .Call('printf', [
        AIR.Str('  ' + #27'[1;31massertnotnil' + #27'[31m failed at %s:%lld: got nil' + #27'[0m' + #10),
        AIR.Invoke(RT_BaseName, [AIR.Get('AFile')]), AIR.Get('ALine')])
  .EndWhen();

  DoEmitStandaloneHalt(AIR);

  AIR.EndWhen();
  AIR.EndFunc();

  // RT_TestFail(AMsg: ptr, AFile: ptr, ALine: int64)
  AIR.Func(RT_TestFail, cvtVoid, False, plC, False)
     .Param('AMsg', cvtPointer)
     .Param('AFile', cvtPointer)
     .Param('ALine', cvtInt64);
  AIR.Assign(RT_TestFailed, AIR.MakeInt64(1));
  AIR.When(AIR.Ne(AIR.Invoke(RT_IsUnitTestMode, []), AIR.MakeInt64(0)))
     .Assign(RT_TestErrPos, AIR.Add(AIR.Get(RT_TestErrPos),
        AIR.Invoke('sprintf', [
          AIR.Add(AIR.Get(RT_TestErrBuf), AIR.Get(RT_TestErrPos)),
          AIR.Str('  ' + #27'[1;31mfail' + #27'[31m at %s:%lld: %s' + #27'[0m' + #10),
          AIR.Invoke(RT_BaseName, [AIR.Get('AFile')]), AIR.Get('ALine'), AIR.Get('AMsg')])))
  .Otherwise()
     .Call('printf', [
        AIR.Str('  ' + #27'[1;31mfail' + #27'[31m at %s:%lld: %s' + #27'[0m' + #10),
        AIR.Invoke(RT_BaseName, [AIR.Get('AFile')]), AIR.Get('ALine'), AIR.Get('AMsg')])
  .EndWhen();

  DoEmitStandaloneHalt(AIR);

  AIR.EndFunc();
end;

procedure TMyrRuntime.AddAll(const AIR: TMyrIR; const AOptLevel: Integer; const AIsDll: Boolean);
begin
  // Imports first, always. Every shared body below resolves its external
  // calls by name, so the whole platform surface must exist before any of
  // them runs.
  AddImports(AIR);
  AddIO(AIR, AIsDll);
  AddMemory(AIR, AOptLevel, AIsDll);
  AddStrings(AIR);
  AddIntrinsics(AIR);
  AddExceptions(AIR);
  AddCommandLine(AIR);
  AddFinalizers(AIR);
  AddBaseName(AIR);
  AddUnitTesting(AIR);
  AddSystem(AIR, AOptLevel);
  if AIsDll then
    AddDllEntry(AIR);
end;

{ TMyrRuntimeWin64 }
procedure TMyrRuntimeWin64.AddImports(const AIR: TMyrIR);
begin
  //----------------------------------------------------------------------------
  // Single Win64 platform import surface. Declared before any runtime body is
  // built, so portable bodies in TMyrRuntime resolve these names regardless of
  // which subsystem consumes them.
  //----------------------------------------------------------------------------

  // Process control
  AIR.Import('kernel32.dll', 'ExitProcess', [cvtUInt32], cvtVoid, False);

  // Console I/O
  AIR.Import('msvcrt.dll', 'printf', [cvtPointer], cvtInt32, True);
  AIR.Import('kernel32.dll', 'SetConsoleOutputCP', [cvtUInt32], cvtInt32, False);
  AIR.Import('kernel32.dll', 'SetConsoleCP', [cvtUInt32], cvtInt32, False);

  // Heap
  AIR.Import('kernel32.dll', 'GetProcessHeap', [], cvtPointer, False);
  AIR.Import('kernel32.dll', 'HeapAlloc', [cvtPointer, cvtUInt32, cvtUInt64], cvtPointer, False);
  AIR.Import('kernel32.dll', 'HeapFree', [cvtPointer, cvtUInt32, cvtPointer], cvtInt32, False);
  AIR.Import('kernel32.dll', 'HeapReAlloc', [cvtPointer, cvtUInt32, cvtPointer, cvtUInt64], cvtPointer, False);
  AIR.Import('kernel32.dll', 'HeapSize', [cvtPointer, cvtUInt32, cvtPointer], cvtUInt64, False);

  // Command line
  AIR.Import('kernel32.dll', 'GetCommandLineW', [], cvtPointer, False);
  AIR.Import('shell32.dll', 'CommandLineToArgvW', [cvtPointer, cvtPointer], cvtPointer, False);
  AIR.Import('kernel32.dll', 'LocalFree', [cvtPointer], cvtPointer, False);
  AIR.Import('kernel32.dll', 'GetModuleFileNameW',
    [cvtPointer, cvtPointer, cvtUInt32], cvtUInt32, False);

  // Memory and string primitives
  AIR.Import('ntdll.dll', 'memcpy', [cvtPointer, cvtPointer, cvtUInt64], cvtPointer, False);
  AIR.Import('ntdll.dll', 'memset', [cvtPointer, cvtInt32, cvtUInt64], cvtPointer, False);
  AIR.Import('ntdll.dll', 'memcmp', [cvtPointer, cvtPointer, cvtUInt64], cvtInt32, False);
  AIR.Import('ntdll.dll', 'strlen', [cvtPointer], cvtUInt64, False);
  AIR.Import('msvcrt.dll', 'strcmp', [cvtPointer, cvtPointer], cvtInt32);
  AIR.Import('msvcrt.dll', 'sprintf', [cvtPointer, cvtPointer], cvtInt32, True);

  // Unicode conversion (both directions - consumed by AddIntrinsics)
  AIR.Import('kernel32.dll', 'MultiByteToWideChar',
    [cvtUInt32, cvtUInt32, cvtPointer, cvtInt32, cvtPointer, cvtInt32], cvtInt32, False);
  AIR.Import('kernel32.dll', 'WideCharToMultiByte',
    [cvtUInt32, cvtUInt32, cvtPointer, cvtInt32, cvtPointer, cvtInt32, cvtPointer, cvtPointer],
    cvtInt32, False);

  // TLS and SEH
  AIR.Import('kernel32.dll', 'TlsAlloc', [], cvtUInt32, False);
  AIR.Import('kernel32.dll', 'TlsGetValue', [cvtUInt32], cvtPointer, False);
  AIR.Import('kernel32.dll', 'TlsSetValue', [cvtUInt32, cvtPointer], cvtInt32, False);
  AIR.Import('kernel32.dll', 'RaiseException', [cvtUInt32, cvtUInt32, cvtUInt32, cvtPointer], cvtVoid, False);

  // Path
  AIR.Import('shlwapi.dll', 'PathFindFileNameA', [cvtPointer], cvtPointer);
end;

procedure TMyrRuntimeWin64.AddIntrinsicsUtf8(const AIR: TMyrIR);
begin
  // RT_Utf8(AWStr: Pointer): Pointer
  // Converts a raw wchar_t* wide string to a heap-allocated UTF-8 char*.
  // Returns nil if input is nil. Caller is responsible for freeing.
  AIR.Func(RT_Utf8, cvtPointer, False, plC, False)
     .Param('AWStr', cvtPointer)
     .VarDecl('LLen', cvtInt32)
     .VarDecl('LBuf', cvtPointer)
     // if AWStr = nil then return nil
     .When(AIR.Eq(AIR.Get('AWStr'), AIR.Null()))
        .Return(AIR.Null())
     .EndWhen()
     // Query required buffer size (CP_UTF8 = 65001, -1 = null-terminated)
     .Let('LLen', AIR.Invoke('WideCharToMultiByte',
        [AIR.MakeInt64(65001), AIR.MakeInt64(0), AIR.Get('AWStr'), AIR.MakeInt64(-1),
         AIR.Null(), AIR.MakeInt64(0), AIR.Null(), AIR.Null()]))
     // Allocate buffer
     .Let('LBuf', AIR.Invoke(RT_GetMem, [AIR.Get('LLen')]))
     // Convert wide to UTF-8
     .Call('WideCharToMultiByte',
        [AIR.MakeInt64(65001), AIR.MakeInt64(0), AIR.Get('AWStr'), AIR.MakeInt64(-1),
         AIR.Get('LBuf'), AIR.Get('LLen'), AIR.Null(), AIR.Null()])
     .Return(AIR.Get('LBuf'))
  .EndFunc();
end;

procedure TMyrRuntimeWin64.AddStringsUtf16(const AIR: TMyrIR);
var
  LDeref: TMyrIRExpr;
begin
  // RT_StrUtf16(AStr: Pointer): Pointer
  // Returns pointer to cached UTF-16 data. Converts from UTF-8 on first call.
  // Returns nil if string is nil.
  AIR.Func(RT_StrUtf16, cvtPointer, False, plC, False)
     .Param('AStr', cvtPointer)
     .Local('LData16', cvtPointer)
     .Local('LData', cvtPointer)
     .Local('LLen', cvtUInt64)
     .Local('LWideLen', cvtInt32)
     .Local('LBuf', cvtPointer)
     // if AStr = nil then return nil
     .When(AIR.Eq(AIR.Get('AStr'), AIR.Null()))
        .Return(AIR.Null())
     .EndWhen();

  // Check if already cached
  LDeref := AIR.Deref(AIR.Get('AStr'), 'TStringRec');
  AIR.Assign('LData16', AIR.GetField(LDeref, 'Data16'))
     .When(AIR.Ne(AIR.Get('LData16'), AIR.Null()))
        .Return(AIR.Get('LData16'))
     .EndWhen();

  // Get UTF-8 data pointer and length
  LDeref := AIR.Deref(AIR.Get('AStr'), 'TStringRec');
  AIR.Assign('LData', AIR.GetField(LDeref, 'Data'));

  LDeref := AIR.Deref(AIR.Get('AStr'), 'TStringRec');
  AIR.Assign('LLen', AIR.GetField(LDeref, 'Length'));

  // Query required buffer size (CP_UTF8 = 65001)
  AIR.Assign('LWideLen', AIR.Invoke('MultiByteToWideChar',
        [AIR.MakeInt64(65001), AIR.MakeInt64(0), AIR.Get('LData'), AIR.Get('LLen'), AIR.Null(), AIR.MakeInt64(0)]))
     // Allocate buffer: (LWideLen + 1) * 2 bytes for UTF-16 + null terminator
     .Assign('LBuf', AIR.Invoke(RT_GetMem,
        [AIR.Mul(AIR.Add(AIR.Get('LWideLen'), AIR.MakeInt64(1)), AIR.MakeInt64(2))]))
     // Convert UTF-8 to UTF-16
     .Call('MultiByteToWideChar',
        [AIR.MakeInt64(65001), AIR.MakeInt64(0), AIR.Get('LData'), AIR.Get('LLen'), AIR.Get('LBuf'), AIR.Get('LWideLen')]);

  // Null-terminate (2 bytes of zero)
  AIR.Call('memset', [AIR.Add(AIR.Get('LBuf'), AIR.Mul(AIR.Get('LWideLen'), AIR.MakeInt64(2))), AIR.MakeInt64(0), AIR.MakeInt64(2)]);

  // Store in cache
  LDeref := AIR.Deref(AIR.Get('AStr'), 'TStringRec');
  AIR.SetVal(AIR.GetField(LDeref, 'Data16'), AIR.Get('LBuf'))
     .Return(AIR.Get('LBuf'))
  .EndFunc();

  // RT_StrLiteralUtf16(AData: Pointer; ALen: UInt64): Pointer
  // Converts UTF-8 literal data to UTF-16. Returns pointer to allocated buffer.
  // Unlike Cbr_StrUtf16, this takes raw data pointer + length (no TStringRec).
  AIR.Func(RT_StrLiteralUtf16, cvtPointer, False, plC, False)
     .Param('AData', cvtPointer)
     .Param('ALen', cvtUInt64)
     .Local('LWideLen', cvtInt32)
     .Local('LBuf', cvtPointer)
     // Query required buffer size (CP_UTF8 = 65001)
     .Assign('LWideLen', AIR.Invoke('MultiByteToWideChar',
        [AIR.MakeInt64(65001), AIR.MakeInt64(0), AIR.Get('AData'), AIR.Get('ALen'), AIR.Null(), AIR.MakeInt64(0)]))
     // Allocate buffer: (LWideLen + 1) * 2 bytes
     .Assign('LBuf', AIR.Invoke(RT_GetMem,
        [AIR.Mul(AIR.Add(AIR.Get('LWideLen'), AIR.MakeInt64(1)), AIR.MakeInt64(2))]))
     // Convert UTF-8 to UTF-16
     .Call('MultiByteToWideChar',
        [AIR.MakeInt64(65001), AIR.MakeInt64(0), AIR.Get('AData'), AIR.Get('ALen'), AIR.Get('LBuf'), AIR.Get('LWideLen')])
     // Null-terminate (2 bytes of zero)
     .Call('memset', [AIR.Add(AIR.Get('LBuf'), AIR.Mul(AIR.Get('LWideLen'), AIR.MakeInt64(2))), AIR.MakeInt64(0), AIR.MakeInt64(2)])
     .Return(AIR.Get('LBuf'))
  .EndFunc();
end;

procedure TMyrRuntimeWin64.AddSystem(const AIR: TMyrIR; const AOptLevel: Integer);
begin
  // RT_Halt(AExitCode: Int32)
  // Terminates the process with the specified exit code.
  // At opt level 0, calls Cbr_ReportLeaks before ExitProcess for heap
  // leak detection in debug builds.
  AIR.Func(RT_Halt, cvtVoid, False, plC, False)
     .NoReturn()
     .Param('AExitCode', cvtInt32);
  // Run module finalizers in LIFO order
  AIR.Call(RT_RunFinalizers, []);
  // Free command line args before leak reporting
  AIR.Call(RT_FreeCommandLine, []);
  // Free exception TLS message before leak reporting
  AIR.Call(RT_FreeExceptions, []);
  if AOptLevel = 0 then
    AIR.Call(RT_ReportLeaks, []);
  AIR.Call('ExitProcess', [AIR.Get('AExitCode')])
  .EndFunc();
end;

procedure TMyrRuntimeWin64.AddIO(const AIR: TMyrIR; const AIsDll: Boolean);
begin
  // RT_InitConsole()
  // Initializes the console for UTF-8 output. Called at program startup.
  // Exported only from a DLL (it owns its own console setup); local in an
  // exe or a static lib.
  AIR.Func(RT_InitConsole, cvtVoid, False, plC, AIsDll)
     // Set console output code page to UTF-8 (65001)
     .Call('SetConsoleOutputCP', [AIR.MakeInt64(65001)])
     // Set console input code page to UTF-8 (65001)
     .Call('SetConsoleCP', [AIR.MakeInt64(65001)])
     .Return()
  .EndFunc();
end;

procedure TMyrRuntimeWin64.AddMemory(const AIR: TMyrIR; const AOptLevel: Integer; const AIsDll: Boolean);
begin
  // Debug heap tracking (only when optimization level = 0)
  if AOptLevel = 0 then
  begin
    AIR.Global(RT_AllocCount, cvtUInt64);
    AIR.Global(RT_FreeCount, cvtUInt64);
  end;

  // RT_GetMem(ASize: UInt64): Pointer
  // Allocates ASize bytes from the process heap
  AIR.Func(RT_GetMem, cvtPointer, False, plC, False)
     .Param('ASize', cvtUInt64)
     .Local('LHeap', cvtPointer)
     .Local('LResult', cvtPointer);

  AIR.Assign('LHeap', AIR.Invoke('GetProcessHeap', []));
  AIR.Assign('LResult', AIR.Invoke('HeapAlloc', [AIR.Get('LHeap'), AIR.MakeInt64(0), AIR.Get('ASize')]));

  if AOptLevel = 0 then
    AIR.Assign(RT_AllocCount, AIR.Add(AIR.Get(RT_AllocCount), AIR.MakeInt64(1)));

  AIR.Return(AIR.Get('LResult'));
  AIR.EndFunc();

  // RT_FreeMem(APtr: Pointer)
  // Frees memory previously allocated by Cbr_GetMem
  AIR.Func(RT_FreeMem, cvtVoid, False, plC, False)
     .Param('APtr', cvtPointer)
     .Local('LHeap', cvtPointer);

  // Guard: do nothing if pointer is nil
  AIR.When(AIR.Eq(AIR.Get('APtr'), AIR.Null()))
     .Return()
  .EndWhen();

  AIR.Assign('LHeap', AIR.Invoke('GetProcessHeap', []));
  AIR.Call('HeapFree', [AIR.Get('LHeap'), AIR.MakeInt64(0), AIR.Get('APtr')]);

  if AOptLevel = 0 then
    AIR.Assign(RT_FreeCount, AIR.Add(AIR.Get(RT_FreeCount), AIR.MakeInt64(1)));

  AIR.Return();
  AIR.EndFunc();

  // RT_ReAllocMem(APtr: Pointer; ANewSize: UInt64): Pointer
  // Reallocates memory block to new size
  AIR.Func(RT_ReAllocMem, cvtPointer, False, plC, False)
     .Param('APtr', cvtPointer)
     .Param('ANewSize', cvtUInt64)
     .Local('LHeap', cvtPointer)
     .Assign('LHeap', AIR.Invoke('GetProcessHeap', []))
     .Return(AIR.Invoke('HeapReAlloc', [AIR.Get('LHeap'), AIR.MakeInt64(0), AIR.Get('APtr'), AIR.Get('ANewSize')]))
  .EndFunc();

  // RT_AllocMem(ASize: UInt64): Pointer
  // Allocates and zero-initializes memory (uses HEAP_ZERO_MEMORY = 0x08)
  AIR.Func(RT_AllocMem, cvtPointer, False, plC, False)
     .Param('ASize', cvtUInt64)
     .Local('LHeap', cvtPointer)
     .Local('LResult', cvtPointer);

  AIR.Assign('LHeap', AIR.Invoke('GetProcessHeap', []));
  AIR.Assign('LResult', AIR.Invoke('HeapAlloc', [AIR.Get('LHeap'), AIR.MakeInt64(8), AIR.Get('ASize')]));

  if AOptLevel = 0 then
    AIR.Assign(RT_AllocCount, AIR.Add(AIR.Get(RT_AllocCount), AIR.MakeInt64(1)));

  AIR.Return(AIR.Get('LResult'));
  AIR.EndFunc();

  // RT_MemSize(APtr: Pointer): UInt64
  // Returns the size of an allocated memory block
  AIR.Func(RT_MemSize, cvtUInt64, False, plC, False)
     .Param('APtr', cvtPointer)
     .Local('LHeap', cvtPointer)
     .Assign('LHeap', AIR.Invoke('GetProcessHeap', []))
     .Return(AIR.Invoke('HeapSize', [AIR.Get('LHeap'), AIR.MakeInt64(0), AIR.Get('APtr')]))
  .EndFunc();

  // RT_ReportLeaks() - Debug only
  // Prints allocation summary to console
  if AOptLevel = 0 then
  begin
    // Exported only from a DLL (own heap, own leak report); local otherwise.
    AIR.Func(RT_ReportLeaks, cvtVoid, False, plC, AIsDll);
    AIR.Call('printf', [AIR.Str('[Heap] Allocs: %llu, Frees: %llu, Leaked: %lld' + #10),
                        AIR.Get(RT_AllocCount),
                        AIR.Get(RT_FreeCount),
                        AIR.Sub(AIR.Get(RT_AllocCount), AIR.Get(RT_FreeCount))]);
    AIR.Return();
    AIR.EndFunc();
  end;
end;

procedure TMyrRuntimeWin64.AddCommandLine(const AIR: TMyrIR);
begin
  // Globals for argc/argv storage
  AIR.Global(RT_Argc, cvtInt64);
  AIR.Global(RT_Argv, cvtPointer);

  // RT_InitCommandLine()
  // Parses command line, converts wide strings to UTF-8.
  // Uses a simple indexed loop to convert each wide string argument.
  AIR.Func(RT_InitCommandLine, cvtVoid, False, plC, False)
     .Local('LCmdLine', cvtPointer)
     .Local('LWargv', cvtPointer)
     .Local('LArgc', cvtInt32)
     .Local('i', cvtInt64)
     .Local('LWidePtr', cvtPointer)
     .Local('LLen', cvtInt32)
     .Local('LUtf8', cvtPointer)
     .Local('LWideBuf', cvtPointer);

  // Get wide command line and parse it
  AIR.Assign('LArgc', AIR.MakeInt64(0))  // Zero full 8-byte slot before 32-bit write by CommandLineToArgvW
     .Assign('LCmdLine', AIR.Invoke('GetCommandLineW', []))
     .Assign('LWargv', AIR.Invoke('CommandLineToArgvW',
        [AIR.Get('LCmdLine'), AIR.AddrOf('LArgc')]))
     .Assign(RT_Argc, AIR.Get('LArgc'))
     .Assign(RT_Argv, AIR.Invoke(RT_GetMem,
        [AIR.Mul(AIR.Get(RT_Argc), AIR.MakeInt64(8))]));

  // Loop: i = 0
  AIR.Assign('i', AIR.MakeInt64(0));

  // While i < Cbr_Argc
  AIR.Loop(AIR.Lt(AIR.Get('i'), AIR.Get(RT_Argc)));

  // LWidePtr := LWargv[i] (load pointer at offset i*8)
  AIR.Assign('LWidePtr', AIR.Deref(
     AIR.Add(AIR.Get('LWargv'), AIR.Mul(AIR.Get('i'), AIR.MakeInt64(8))),
     cvtPointer));

  // LLen := WideCharToMultiByte(CP_UTF8, 0, LWidePtr, -1, nil, 0, nil, nil)
  AIR.Assign('LLen', AIR.Invoke('WideCharToMultiByte',
     [AIR.MakeInt64(65001), AIR.MakeInt64(0), AIR.Get('LWidePtr'), AIR.MakeInt64(-1),
      AIR.Null(), AIR.MakeInt64(0), AIR.Null(), AIR.Null()]));

  // LUtf8 := Cbr_GetMem(LLen)
  AIR.Assign('LUtf8', AIR.Invoke(RT_GetMem, [AIR.Get('LLen')]));

  // WideCharToMultiByte(CP_UTF8, 0, LWidePtr, -1, LUtf8, LLen, nil, nil)
  AIR.Call('WideCharToMultiByte',
     [AIR.MakeInt64(65001), AIR.MakeInt64(0), AIR.Get('LWidePtr'), AIR.MakeInt64(-1),
      AIR.Get('LUtf8'), AIR.Get('LLen'), AIR.Null(), AIR.Null()]);

  // Cbr_Argv[i] := LUtf8
  AIR.SetVal(
     AIR.Deref(AIR.Add(AIR.Get(RT_Argv), AIR.Mul(AIR.Get('i'), AIR.MakeInt64(8))), cvtPointer),
     AIR.Get('LUtf8'));

  // i := i + 1
  AIR.Assign('i', AIR.Add(AIR.Get('i'), AIR.MakeInt64(1)));

  AIR.EndLoop();

  // Free the wide argv array (allocated by CommandLineToArgvW)
  AIR.Call('LocalFree', [AIR.Get('LWargv')]);

  // Replace argv[0] with full absolute path via GetModuleFileNameW
  // Allocate wide buffer (MAX_PATH = 260 wchars = 520 bytes)
  AIR.Assign('LWideBuf', AIR.Invoke(RT_GetMem, [AIR.MakeInt64(520)]));

  // GetModuleFileNameW(nil, LWideBuf, 260)
  AIR.Call('GetModuleFileNameW',
     [AIR.Null(), AIR.Get('LWideBuf'), AIR.MakeInt64(260)]);

  // Get UTF-8 length
  AIR.Assign('LLen', AIR.Invoke('WideCharToMultiByte',
     [AIR.MakeInt64(65001), AIR.MakeInt64(0), AIR.Get('LWideBuf'), AIR.MakeInt64(-1),
      AIR.Null(), AIR.MakeInt64(0), AIR.Null(), AIR.Null()]));

  // Allocate UTF-8 buffer
  AIR.Assign('LUtf8', AIR.Invoke(RT_GetMem, [AIR.Get('LLen')]));

  // Convert wide -> UTF-8
  AIR.Call('WideCharToMultiByte',
     [AIR.MakeInt64(65001), AIR.MakeInt64(0), AIR.Get('LWideBuf'), AIR.MakeInt64(-1),
      AIR.Get('LUtf8'), AIR.Get('LLen'), AIR.Null(), AIR.Null()]);

  // Free old argv[0] (it was allocated by Cbr_GetMem in the loop above)
  AIR.Call(RT_FreeMem, [AIR.Deref(
     AIR.Get(RT_Argv), cvtPointer)]);

  // Store new UTF-8 path as argv[0]
  AIR.SetVal(
     AIR.Deref(AIR.Get(RT_Argv), cvtPointer),
     AIR.Get('LUtf8'));

  // Free wide buffer
  AIR.Call(RT_FreeMem, [AIR.Get('LWideBuf')])
     .Return()
  .EndFunc();

  // RT_FreeCommandLine()
  // Frees all allocated UTF-8 strings and the argv array.
  // Called by Cbr_Halt before leak reporting.
  AIR.Func(RT_FreeCommandLine, cvtVoid, False, plC, False)
     .Local('i', cvtInt64)
     .Local('LPtr', cvtPointer);

  // Guard: if Cbr_Argv is nil (InitCommandLine was never called), skip cleanup
  AIR.When(AIR.Eq(AIR.Get(RT_Argv), AIR.Null()))
     .Return()
  .EndWhen();

  // Loop: free each UTF-8 string
  AIR.Assign('i', AIR.MakeInt64(0));

  AIR.Loop(AIR.Lt(AIR.Get('i'), AIR.Get(RT_Argc)));

  // LPtr := Cbr_Argv[i]
  AIR.Assign('LPtr', AIR.Deref(
     AIR.Add(AIR.Get(RT_Argv), AIR.Mul(AIR.Get('i'), AIR.MakeInt64(8))),
     cvtPointer));

  // Free the UTF-8 string
  AIR.Call(RT_FreeMem, [AIR.Get('LPtr')]);

  // i := i + 1
  AIR.Assign('i', AIR.Add(AIR.Get('i'), AIR.MakeInt64(1)));

  AIR.EndLoop();

  // Free the argv array itself
  AIR.Call(RT_FreeMem, [AIR.Get(RT_Argv)])
     .Return()
  .EndFunc();

  // RT_ParamCount(): Int64
  // Returns argc - 1 (Pascal semantics: excludes program name).
  AIR.Func(RT_ParamCount, cvtInt64, False, plC, False)
     .Return(AIR.Sub(AIR.Get(RT_Argc), AIR.MakeInt64(1)))
  .EndFunc();

  // RT_ParamStr(AIndex: Int64): Pointer
  // Returns pointer to UTF-8 string at given index.
  // Returns nil if index out of range.
  AIR.Func(RT_ParamStr, cvtPointer, False, plC, False)
     .Param('AIndex', cvtInt64);

  // Check bounds: AIndex < 0
  AIR.When(AIR.Lt(AIR.Get('AIndex'), AIR.MakeInt64(0)))
     .Return(AIR.Null())
  .EndWhen();

  // Check bounds: AIndex >= Cbr_Argc
  AIR.When(AIR.Ge(AIR.Get('AIndex'), AIR.Get(RT_Argc)))
     .Return(AIR.Null())
  .EndWhen();

  // Return Cbr_Argv[AIndex]
  AIR.Return(AIR.Deref(
     AIR.Add(AIR.Get(RT_Argv), AIR.Mul(AIR.Get('AIndex'), AIR.MakeInt64(8))),
     cvtPointer))
  .EndFunc();
end;

procedure TMyrRuntimeWin64.AddDllEntry(const AIR: TMyrIR);
var
  LI: Integer;
  LFunc: TMyrIR.TMyrIRFunc;
begin
  // Create DllMain(hinstDLL, fdwReason, lpvReserved) -> BOOL
  AIR.DllMain();

  // ATTACH path (fdwReason == 1)
  AIR.When(AIR.Eq(AIR.Get('fdwReason'), AIR.UInt32(1)));
    AIR.Call(RT_InitExceptions, []);
    // Call all module init functions
    for LI := 0 to AIR.GetFunctionCount() - 1 do
    begin
      LFunc := AIR.GetFunction(LI);
      if LFunc.FuncName.StartsWith(RT_ModuleInit + '_') then
        AIR.Call(LFunc.FuncName, []);
    end;
  AIR.EndWhen();

  // DETACH path (fdwReason == 0)
  AIR.When(AIR.Eq(AIR.Get('fdwReason'), AIR.UInt32(0)));
    // Call all module finalize functions in reverse order
    for LI := AIR.GetFunctionCount() - 1 downto 0 do
    begin
      LFunc := AIR.GetFunction(LI);
      if LFunc.FuncName.StartsWith(RT_ModuleFinalize + '_') then
        AIR.Call(LFunc.FuncName, []);
    end;
    AIR.Call(RT_FreeExceptions, []);
  AIR.EndWhen();

  // Return TRUE
  AIR.Ret(AIR.Int32(1));
  AIR.EndFunc();
end;

procedure TMyrRuntimeWin64.AddExceptions(const AIR: TMyrIR);
begin
  // TLS imports (TlsAlloc/TlsGetValue/TlsSetValue, RaiseException) are
  // declared in AddImports, the per-target import hook.

  // Global variables for TLS slot indices
  AIR.Global(RT_TlsExcCode, cvtUInt32);   // TLS slot for exception code
  AIR.Global(RT_TlsExcMsg, cvtUInt32);    // TLS slot for exception message

  // RT_InitExceptions()
  // Allocates TLS slots. Must be called at process/thread startup.
  AIR.Func(RT_InitExceptions, cvtVoid, False, plC, False)
     .Assign(RT_TlsExcCode, AIR.Invoke('TlsAlloc', []))
     .Assign(RT_TlsExcMsg, AIR.Invoke('TlsAlloc', []))
     .Return()
  .EndFunc();

  // RT_SetException(ACode: Int32; AMsg: Pointer)
  // Internal helper: stores code and copies message to TLS.
  // Frees old message if present.
  AIR.Func(RT_SetException, cvtVoid, False, plC, False)
     .Param('ACode', cvtInt32)
     .Param('AMsg', cvtPointer)
     .Local('LOldMsg', cvtPointer)
     .Local('LLen', cvtUInt64)
     .Local('LNewMsg', cvtPointer)
     // Get and free old message if any
     .Assign('LOldMsg', AIR.Invoke('TlsGetValue', [AIR.Get(RT_TlsExcMsg)]))
     .When(AIR.Ne(AIR.Get('LOldMsg'), AIR.Null()))
        .Call(RT_FreeMem, [AIR.Get('LOldMsg')])
     .EndWhen()
     // Copy new message if not nil
     .When(AIR.Ne(AIR.Get('AMsg'), AIR.Null()))
        .Assign('LLen', AIR.Invoke('strlen', [AIR.Get('AMsg')]))
        .Assign('LNewMsg', AIR.Invoke(RT_GetMem, [AIR.Add(AIR.Get('LLen'), AIR.MakeInt64(1))]))
        .Call('memcpy', [AIR.Get('LNewMsg'), AIR.Get('AMsg'), AIR.Add(AIR.Get('LLen'), AIR.MakeInt64(1))])
        .Call('TlsSetValue', [AIR.Get(RT_TlsExcMsg), AIR.Get('LNewMsg')])
     .Otherwise()
        .Call('TlsSetValue', [AIR.Get(RT_TlsExcMsg), AIR.Null()])
     .EndWhen()
     // Store code (cast to pointer for TLS)
     .Call('TlsSetValue', [AIR.Get(RT_TlsExcCode), AIR.Get('ACode')])
     .Return()
  .EndFunc();

  // RT_Raise(AMsg: Pointer)
  // Raises exception with default code (1) and message.
  AIR.Func(RT_Raise, cvtVoid, False, plC, False)
     .Param('AMsg', cvtPointer)
     .Call(RT_SetException, [AIR.MakeInt64(1), AIR.Get('AMsg')])
     // RaiseException(0xE0505858, 0, 0, nil) - 'PXX' custom exception
     .Call('RaiseException', [AIR.MakeInt64($E0505858), AIR.MakeInt64(0), AIR.MakeInt64(0), AIR.Null()])
     .Return()
  .EndFunc();

  // RT_RaiseCode(ACode: Int32; AMsg: Pointer)
  // Raises exception with custom code and message.
  AIR.Func(RT_RaiseCode, cvtVoid, False, plC, False)
     .Param('ACode', cvtInt32)
     .Param('AMsg', cvtPointer)
     .Call(RT_SetException, [AIR.Get('ACode'), AIR.Get('AMsg')])
     // RaiseException(0xE0505858, 0, 0, nil) - 'PXX' custom exception
     .Call('RaiseException', [AIR.MakeInt64($E0505858), AIR.MakeInt64(0), AIR.MakeInt64(0), AIR.Null()])
     .Return()
  .EndFunc();

  // RT_GetExceptionCode(): Int32
  // Returns the current exception code from TLS.
  AIR.Func(RT_GetExceptionCode, cvtInt32, False, plC, False)
     .Return(AIR.Invoke('TlsGetValue', [AIR.Get(RT_TlsExcCode)]))
  .EndFunc();

  // RT_GetExceptionMessage(): Pointer
  // Returns pointer to the current exception message from TLS.
  AIR.Func(RT_GetExceptionMsg, cvtPointer, False, plC, False)
     .Return(AIR.Invoke('TlsGetValue', [AIR.Get(RT_TlsExcMsg)]))
  .EndFunc();

  // RT_SEHFilter(AExcPtrs: Pointer): Int32
  // SEH filter function called by __C_specific_handler for except scopes.
  // Extracts the Windows exception code from EXCEPTION_POINTERS and maps it
  // to a portable Myrissa exception code with a message (matching the Myra
  // runtime's table), so exccode()/excmsg() are target-neutral:
  //   2=Divide by zero, 3=Access violation, 4=Stack overflow,
  //   5=Numeric overflow, 6=Illegal instruction, 99=Unknown hardware.
  // For our custom software exceptions (code = 0xE0505858), Cbr_Raise/
  // Cbr_RaiseCode already called Cbr_SetException, so we skip.
  // Returns 1 (EXCEPTION_EXECUTE_HANDLER) to always handle the exception.
  AIR.Func(RT_SEHFilter, cvtInt32, False, plC, False)
     .Param('AExcPtrs', cvtPointer)
     .Local('LExcRecord', cvtPointer)
     .Local('LRaw', cvtInt64)
     .Local('LCode', cvtInt64)
     .Local('LMapCode', cvtInt64)
     .Local('LMapMsg', cvtPointer)
     // ExceptionRecord = *(EXCEPTION_POINTERS*) — first field at offset 0
     .Assign('LExcRecord', AIR.Deref(AIR.Get('AExcPtrs')))
     // Load 8 bytes from ExceptionRecord offset 0 (ExceptionCode + ExceptionFlags)
     .Assign('LRaw', AIR.Deref(AIR.Get('LExcRecord')))
     // Mask to lower 32 bits to isolate ExceptionCode (DWORD)
     .Assign('LCode', AIR.BitAnd(AIR.Get('LRaw'), AIR.MakeInt64($FFFFFFFF)))
     // If not our custom exception marker, map the hardware exception code
     // to the portable code + message, then store both in one call.
     .When(AIR.Ne(AIR.Get('LCode'), AIR.MakeInt64(Int64($E0505858))))
        // Default: unknown hardware exception
        .Assign('LMapCode', AIR.MakeInt64(99))
        .Assign('LMapMsg', AIR.Str('Hardware exception'))
        // EXCEPTION_ACCESS_VIOLATION / EXCEPTION_IN_PAGE_ERROR
        .When(AIR.BitOr(
            AIR.Eq(AIR.Get('LCode'), AIR.MakeInt64($C0000005)),
            AIR.Eq(AIR.Get('LCode'), AIR.MakeInt64($C0000006))))
           .Assign('LMapCode', AIR.MakeInt64(3))
           .Assign('LMapMsg', AIR.Str('Access violation'))
        .EndWhen()
        // EXCEPTION_INT_DIVIDE_BY_ZERO / EXCEPTION_FLT_DIVIDE_BY_ZERO
        .When(AIR.BitOr(
            AIR.Eq(AIR.Get('LCode'), AIR.MakeInt64($C0000094)),
            AIR.Eq(AIR.Get('LCode'), AIR.MakeInt64($C000008E))))
           .Assign('LMapCode', AIR.MakeInt64(2))
           .Assign('LMapMsg', AIR.Str('Divide by zero'))
        .EndWhen()
        // EXCEPTION_STACK_OVERFLOW
        .When(AIR.Eq(AIR.Get('LCode'), AIR.MakeInt64($C00000FD)))
           .Assign('LMapCode', AIR.MakeInt64(4))
           .Assign('LMapMsg', AIR.Str('Stack overflow'))
        .EndWhen()
        // EXCEPTION_INT_OVERFLOW / EXCEPTION_FLT_OVERFLOW / EXCEPTION_FLT_UNDERFLOW
        .When(AIR.BitOr(AIR.BitOr(
            AIR.Eq(AIR.Get('LCode'), AIR.MakeInt64($C0000095)),
            AIR.Eq(AIR.Get('LCode'), AIR.MakeInt64($C0000091))),
            AIR.Eq(AIR.Get('LCode'), AIR.MakeInt64($C0000093))))
           .Assign('LMapCode', AIR.MakeInt64(5))
           .Assign('LMapMsg', AIR.Str('Numeric overflow'))
        .EndWhen()
        // EXCEPTION_ILLEGAL_INSTRUCTION / EXCEPTION_PRIV_INSTRUCTION
        .When(AIR.BitOr(
            AIR.Eq(AIR.Get('LCode'), AIR.MakeInt64($C000001D)),
            AIR.Eq(AIR.Get('LCode'), AIR.MakeInt64($C0000096))))
           .Assign('LMapCode', AIR.MakeInt64(6))
           .Assign('LMapMsg', AIR.Str('Illegal instruction'))
        .EndWhen()
        .Call(RT_SetException, [AIR.Get('LMapCode'), AIR.Get('LMapMsg')])
     .EndWhen()
     // Always handle the exception
     .Return(AIR.MakeInt64(1))
  .EndFunc();

  // RT_FreeExceptions()
  // Frees the TLS exception message if allocated. Called by RT_Halt.
  AIR.Func(RT_FreeExceptions, cvtVoid, False, plC, False)
     .Local('LMsg', cvtPointer)
     .Assign('LMsg', AIR.Invoke('TlsGetValue', [AIR.Get(RT_TlsExcMsg)]))
     .When(AIR.Ne(AIR.Get('LMsg'), AIR.Null()))
        .Call(RT_FreeMem, [AIR.Get('LMsg')])
        .Call('TlsSetValue', [AIR.Get(RT_TlsExcMsg), AIR.Null()])
     .EndWhen()
     .Return()
  .EndFunc();
end;

procedure TMyrRuntimeWin64.AddBaseName(const AIR: TMyrIR);
begin
  // RT_BaseName(APath: Pointer): Pointer
  // Returns a pointer to the file name portion of APath.
  // Win64: wraps PathFindFileNameA (imported in AddImports).
  AIR.Func(RT_BaseName, cvtPointer, False, plC, False)
     .Param('APath', cvtPointer)
     .Return(AIR.Invoke('PathFindFileNameA', [AIR.Get('APath')]))
  .EndFunc();
end;

{ TMyrRuntimeLinux64 }
procedure TMyrRuntimeLinux64.AddImports(const AIR: TMyrIR);
begin
  // Process control
  AIR.Import('libc.so.6', 'exit', [cvtInt32], cvtVoid, False);
  AIR.Import('libc.so.6', 'abort', [], cvtVoid, False);

  // Heap
  AIR.Import('libc.so.6', 'malloc', [cvtUInt64], cvtPointer, False);
  AIR.Import('libc.so.6', 'free', [cvtPointer], cvtVoid, False);
  AIR.Import('libc.so.6', 'realloc', [cvtPointer, cvtUInt64], cvtPointer, False);
  AIR.Import('libc.so.6', 'malloc_usable_size', [cvtPointer], cvtUInt64, False);

  // I/O
  AIR.Import('libc.so.6', 'printf', [cvtPointer], cvtInt32, True);

  // Memory and string primitives - identical names and signatures to win64
  AIR.Import('libc.so.6', 'memcpy', [cvtPointer, cvtPointer, cvtUInt64], cvtPointer, False);
  AIR.Import('libc.so.6', 'memset', [cvtPointer, cvtInt32, cvtUInt64], cvtPointer, False);
  AIR.Import('libc.so.6', 'memcmp', [cvtPointer, cvtPointer, cvtUInt64], cvtInt32, False);
  AIR.Import('libc.so.6', 'strlen', [cvtPointer], cvtUInt64, False);
  AIR.Import('libc.so.6', 'strcmp', [cvtPointer, cvtPointer], cvtInt32);
  AIR.Import('libc.so.6', 'sprintf', [cvtPointer, cvtPointer], cvtInt32, True);

  // Thread-local storage - primitives for the per-target RT_ exception and
  // TLS implementations.
  AIR.Import('libc.so.6', 'pthread_key_create', [cvtPointer, cvtPointer], cvtInt32, False);
  AIR.Import('libc.so.6', 'pthread_getspecific', [cvtUInt32], cvtPointer, False);
  AIR.Import('libc.so.6', 'pthread_setspecific', [cvtUInt32, cvtPointer], cvtInt32, False);

  // Signal handling - hardware exception delivery for the setjmp frame chain
  AIR.Import('libc.so.6', 'sigaction', [cvtInt32, cvtPointer, cvtPointer], cvtInt32, False);
  AIR.Import('libc.so.6', '__sigsetjmp', [cvtPointer, cvtInt32], cvtInt32, False);
  AIR.Import('libc.so.6', 'siglongjmp', [cvtPointer, cvtInt32], cvtVoid, False);

  // Path
  AIR.Import('libc.so.6', 'basename', [cvtPointer], cvtPointer, False);
end;

procedure TMyrRuntimeLinux64.AddIntrinsicsUtf8(const AIR: TMyrIR);
begin
  // RT_Utf8(AWStr: Pointer): Pointer
  // Converts a raw wchar_t* wide string to a heap-allocated UTF-8 char*.
  // Returns nil if input is nil. Caller is responsible for freeing.
  //
  // Win64 imports WideCharToMultiByte from kernel32; linux64 has no equivalent
  // import, so the conversion is expressed directly in IR. Input is
  // null-terminated, so the unit count is measured first.
  //
  // Buffer is worst-cased at 3 bytes per UTF-16 unit: a BMP code point needs at
  // most 3 UTF-8 bytes, and a surrogate PAIR (2 units) needs 4, so 3 per unit
  // is always sufficient. Plus one byte for the null terminator.
  AIR.Func(RT_Utf8, cvtPointer, False, plC, False)
     .Param('AWStr', cvtPointer)
     .Local('LN', cvtUInt64)
     .Local('LI', cvtUInt64)
     .Local('LJ', cvtUInt64)
     .Local('LBuf', cvtPointer)
     .Local('LU', cvtUInt64)
     .Local('LU2', cvtUInt64)
     .Local('LCP', cvtUInt64)
     .When(AIR.Eq(AIR.Get('AWStr'), AIR.Null()))
        .Return(AIR.Null())
     .EndWhen()
     // Measure: count UTF-16 units up to the terminating zero unit
     .Assign('LN', AIR.MakeInt64(0))
     .Loop(AIR.Ne(AIR.Deref(AIR.Add(AIR.Get('AWStr'),
        AIR.Mul(AIR.Get('LN'), AIR.MakeInt64(2))), cvtUInt16), AIR.MakeInt64(0)))
        .Assign('LN', AIR.Add(AIR.Get('LN'), AIR.MakeInt64(1)))
     .EndLoop()
     .Assign('LBuf', AIR.Invoke(RT_GetMem,
        [AIR.Add(AIR.Mul(AIR.Get('LN'), AIR.MakeInt64(3)), AIR.MakeInt64(1))]))
     .Assign('LI', AIR.MakeInt64(0))
     .Assign('LJ', AIR.MakeInt64(0))
     .Loop(AIR.Lt(AIR.Get('LI'), AIR.Get('LN')))
        .Assign('LU', AIR.Deref(AIR.Add(AIR.Get('AWStr'),
           AIR.Mul(AIR.Get('LI'), AIR.MakeInt64(2))), cvtUInt16))
        // High surrogate (0xD800..0xDBFF) starts a pair
        .When(AIR.LogAnd(AIR.Ge(AIR.Get('LU'), AIR.MakeInt64(55296)),
                         AIR.Lt(AIR.Get('LU'), AIR.MakeInt64(56320))))
           .Assign('LU2', AIR.Deref(AIR.Add(AIR.Get('AWStr'),
              AIR.Mul(AIR.Add(AIR.Get('LI'), AIR.MakeInt64(1)), AIR.MakeInt64(2))), cvtUInt16))
           .Assign('LCP', AIR.Add(AIR.MakeInt64(65536),
              AIR.Add(AIR.ShiftL(AIR.Sub(AIR.Get('LU'), AIR.MakeInt64(55296)), AIR.MakeInt64(10)),
                      AIR.Sub(AIR.Get('LU2'), AIR.MakeInt64(56320)))))
           .Assign('LI', AIR.Add(AIR.Get('LI'), AIR.MakeInt64(2)))
        .Otherwise()
           .Assign('LCP', AIR.Get('LU'))
           .Assign('LI', AIR.Add(AIR.Get('LI'), AIR.MakeInt64(1)))
        .EndWhen()
        // Encode LCP as 1..4 UTF-8 bytes
        .When(AIR.Lt(AIR.Get('LCP'), AIR.MakeInt64(128)))
           .SetVal(AIR.Deref(AIR.Add(AIR.Get('LBuf'), AIR.Get('LJ')), cvtUInt8),
              AIR.Get('LCP'))
           .Assign('LJ', AIR.Add(AIR.Get('LJ'), AIR.MakeInt64(1)))
        .Otherwise()
           .When(AIR.Lt(AIR.Get('LCP'), AIR.MakeInt64(2048)))
              .SetVal(AIR.Deref(AIR.Add(AIR.Get('LBuf'), AIR.Get('LJ')), cvtUInt8),
                 AIR.BitOr(AIR.MakeInt64(192), AIR.ShiftR(AIR.Get('LCP'), AIR.MakeInt64(6))))
              .SetVal(AIR.Deref(AIR.Add(AIR.Get('LBuf'),
                 AIR.Add(AIR.Get('LJ'), AIR.MakeInt64(1))), cvtUInt8),
                 AIR.BitOr(AIR.MakeInt64(128), AIR.BitAnd(AIR.Get('LCP'), AIR.MakeInt64(63))))
              .Assign('LJ', AIR.Add(AIR.Get('LJ'), AIR.MakeInt64(2)))
           .Otherwise()
              .When(AIR.Lt(AIR.Get('LCP'), AIR.MakeInt64(65536)))
                 .SetVal(AIR.Deref(AIR.Add(AIR.Get('LBuf'), AIR.Get('LJ')), cvtUInt8),
                    AIR.BitOr(AIR.MakeInt64(224), AIR.ShiftR(AIR.Get('LCP'), AIR.MakeInt64(12))))
                 .SetVal(AIR.Deref(AIR.Add(AIR.Get('LBuf'),
                    AIR.Add(AIR.Get('LJ'), AIR.MakeInt64(1))), cvtUInt8),
                    AIR.BitOr(AIR.MakeInt64(128), AIR.BitAnd(
                       AIR.ShiftR(AIR.Get('LCP'), AIR.MakeInt64(6)), AIR.MakeInt64(63))))
                 .SetVal(AIR.Deref(AIR.Add(AIR.Get('LBuf'),
                    AIR.Add(AIR.Get('LJ'), AIR.MakeInt64(2))), cvtUInt8),
                    AIR.BitOr(AIR.MakeInt64(128), AIR.BitAnd(AIR.Get('LCP'), AIR.MakeInt64(63))))
                 .Assign('LJ', AIR.Add(AIR.Get('LJ'), AIR.MakeInt64(3)))
              .Otherwise()
                 .SetVal(AIR.Deref(AIR.Add(AIR.Get('LBuf'), AIR.Get('LJ')), cvtUInt8),
                    AIR.BitOr(AIR.MakeInt64(240), AIR.ShiftR(AIR.Get('LCP'), AIR.MakeInt64(18))))
                 .SetVal(AIR.Deref(AIR.Add(AIR.Get('LBuf'),
                    AIR.Add(AIR.Get('LJ'), AIR.MakeInt64(1))), cvtUInt8),
                    AIR.BitOr(AIR.MakeInt64(128), AIR.BitAnd(
                       AIR.ShiftR(AIR.Get('LCP'), AIR.MakeInt64(12)), AIR.MakeInt64(63))))
                 .SetVal(AIR.Deref(AIR.Add(AIR.Get('LBuf'),
                    AIR.Add(AIR.Get('LJ'), AIR.MakeInt64(2))), cvtUInt8),
                    AIR.BitOr(AIR.MakeInt64(128), AIR.BitAnd(
                       AIR.ShiftR(AIR.Get('LCP'), AIR.MakeInt64(6)), AIR.MakeInt64(63))))
                 .SetVal(AIR.Deref(AIR.Add(AIR.Get('LBuf'),
                    AIR.Add(AIR.Get('LJ'), AIR.MakeInt64(3))), cvtUInt8),
                    AIR.BitOr(AIR.MakeInt64(128), AIR.BitAnd(AIR.Get('LCP'), AIR.MakeInt64(63))))
                 .Assign('LJ', AIR.Add(AIR.Get('LJ'), AIR.MakeInt64(4)))
              .EndWhen()
           .EndWhen()
        .EndWhen()
     .EndLoop()
     // Null-terminate
     .SetVal(AIR.Deref(AIR.Add(AIR.Get('LBuf'), AIR.Get('LJ')), cvtUInt8), AIR.MakeInt64(0))
     .Return(AIR.Get('LBuf'))
  .EndFunc();
end;

procedure TMyrRuntimeLinux64.AddStringsUtf16(const AIR: TMyrIR);
var
  LDeref: TMyrIRExpr;
begin
  // RT_StrLiteralUtf16(AData: Pointer; ALen: UInt64): Pointer
  // UTF-8 to UTF-16 conversion authored in IR. Win64 imports
  // MultiByteToWideChar from kernel32; linux64 has no equivalent import, so the
  // conversion is expressed directly. Declared BEFORE RT_StrUtf16 because
  // RT_StrUtf16 calls it.
  //
  // Buffer is worst-cased: a UTF-8 byte never produces more than one UTF-16
  // code unit, so ALen units is always sufficient. Plus one unit for the
  // null terminator.
  AIR.Func(RT_StrLiteralUtf16, cvtPointer, False, plC, False)
     .Param('AData', cvtPointer)
     .Param('ALen', cvtUInt64)
     .Local('LI', cvtUInt64)
     .Local('LJ', cvtUInt64)
     .Local('LBuf', cvtPointer)
     .Local('LB0', cvtUInt64)
     .Local('LCP', cvtUInt64)
     .Local('LHi', cvtUInt64)
     .Local('LLo', cvtUInt64)
     .Assign('LBuf', AIR.Invoke(RT_GetMem,
        [AIR.Mul(AIR.Add(AIR.Get('ALen'), AIR.MakeInt64(1)), AIR.MakeInt64(2))]))
     .Assign('LI', AIR.MakeInt64(0))
     .Assign('LJ', AIR.MakeInt64(0))
     .Loop(AIR.Lt(AIR.Get('LI'), AIR.Get('ALen')))
        .Assign('LB0', AIR.Deref(AIR.Add(AIR.Get('AData'), AIR.Get('LI')), cvtUInt8))
        // 1-byte sequence: 0xxxxxxx
        .When(AIR.Lt(AIR.Get('LB0'), AIR.MakeInt64(128)))
           .Assign('LCP', AIR.Get('LB0'))
           .Assign('LI', AIR.Add(AIR.Get('LI'), AIR.MakeInt64(1)))
        .Otherwise()
           // 2-byte sequence: 110xxxxx 10xxxxxx
           .When(AIR.Lt(AIR.Get('LB0'), AIR.MakeInt64(224)))
              .Assign('LCP', AIR.BitOr(
                 AIR.ShiftL(AIR.BitAnd(AIR.Get('LB0'), AIR.MakeInt64(31)), AIR.MakeInt64(6)),
                 AIR.BitAnd(AIR.Deref(AIR.Add(AIR.Get('AData'),
                    AIR.Add(AIR.Get('LI'), AIR.MakeInt64(1))), cvtUInt8), AIR.MakeInt64(63))))
              .Assign('LI', AIR.Add(AIR.Get('LI'), AIR.MakeInt64(2)))
           .Otherwise()
              // 3-byte sequence: 1110xxxx 10xxxxxx 10xxxxxx
              .When(AIR.Lt(AIR.Get('LB0'), AIR.MakeInt64(240)))
                 .Assign('LCP', AIR.BitOr(AIR.BitOr(
                    AIR.ShiftL(AIR.BitAnd(AIR.Get('LB0'), AIR.MakeInt64(15)), AIR.MakeInt64(12)),
                    AIR.ShiftL(AIR.BitAnd(AIR.Deref(AIR.Add(AIR.Get('AData'),
                       AIR.Add(AIR.Get('LI'), AIR.MakeInt64(1))), cvtUInt8),
                       AIR.MakeInt64(63)), AIR.MakeInt64(6))),
                    AIR.BitAnd(AIR.Deref(AIR.Add(AIR.Get('AData'),
                       AIR.Add(AIR.Get('LI'), AIR.MakeInt64(2))), cvtUInt8), AIR.MakeInt64(63))))
                 .Assign('LI', AIR.Add(AIR.Get('LI'), AIR.MakeInt64(3)))
              .Otherwise()
                 // 4-byte sequence: 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx
                 .Assign('LCP', AIR.BitOr(AIR.BitOr(AIR.BitOr(
                    AIR.ShiftL(AIR.BitAnd(AIR.Get('LB0'), AIR.MakeInt64(7)), AIR.MakeInt64(18)),
                    AIR.ShiftL(AIR.BitAnd(AIR.Deref(AIR.Add(AIR.Get('AData'),
                       AIR.Add(AIR.Get('LI'), AIR.MakeInt64(1))), cvtUInt8),
                       AIR.MakeInt64(63)), AIR.MakeInt64(12))),
                    AIR.ShiftL(AIR.BitAnd(AIR.Deref(AIR.Add(AIR.Get('AData'),
                       AIR.Add(AIR.Get('LI'), AIR.MakeInt64(2))), cvtUInt8),
                       AIR.MakeInt64(63)), AIR.MakeInt64(6))),
                    AIR.BitAnd(AIR.Deref(AIR.Add(AIR.Get('AData'),
                       AIR.Add(AIR.Get('LI'), AIR.MakeInt64(3))), cvtUInt8), AIR.MakeInt64(63))))
                 .Assign('LI', AIR.Add(AIR.Get('LI'), AIR.MakeInt64(4)))
              .EndWhen()
           .EndWhen()
        .EndWhen()
        // Emit: BMP code points are one unit, everything above needs a surrogate pair
        .When(AIR.Lt(AIR.Get('LCP'), AIR.MakeInt64(65536)))
           .SetVal(AIR.Deref(AIR.Add(AIR.Get('LBuf'),
              AIR.Mul(AIR.Get('LJ'), AIR.MakeInt64(2))), cvtUInt16), AIR.Get('LCP'))
           .Assign('LJ', AIR.Add(AIR.Get('LJ'), AIR.MakeInt64(1)))
        .Otherwise()
           .Assign('LCP', AIR.Sub(AIR.Get('LCP'), AIR.MakeInt64(65536)))
           .Assign('LHi', AIR.BitOr(AIR.MakeInt64(55296),
              AIR.ShiftR(AIR.Get('LCP'), AIR.MakeInt64(10))))
           .Assign('LLo', AIR.BitOr(AIR.MakeInt64(56320),
              AIR.BitAnd(AIR.Get('LCP'), AIR.MakeInt64(1023))))
           .SetVal(AIR.Deref(AIR.Add(AIR.Get('LBuf'),
              AIR.Mul(AIR.Get('LJ'), AIR.MakeInt64(2))), cvtUInt16), AIR.Get('LHi'))
           .SetVal(AIR.Deref(AIR.Add(AIR.Get('LBuf'),
              AIR.Mul(AIR.Add(AIR.Get('LJ'), AIR.MakeInt64(1)), AIR.MakeInt64(2))),
              cvtUInt16), AIR.Get('LLo'))
           .Assign('LJ', AIR.Add(AIR.Get('LJ'), AIR.MakeInt64(2)))
        .EndWhen()
     .EndLoop()
     // Null-terminate with a zero UTF-16 unit
     .SetVal(AIR.Deref(AIR.Add(AIR.Get('LBuf'),
        AIR.Mul(AIR.Get('LJ'), AIR.MakeInt64(2))), cvtUInt16), AIR.MakeInt64(0))
     .Return(AIR.Get('LBuf'))
  .EndFunc();

  // RT_StrUtf16(AStr: Pointer): Pointer
  // Returns pointer to cached UTF-16 data. Converts from UTF-8 on first call.
  // Returns nil if string is nil. Same contract as win64; the conversion is
  // delegated to RT_StrLiteralUtf16 so the loop exists once.
  AIR.Func(RT_StrUtf16, cvtPointer, False, plC, False)
     .Param('AStr', cvtPointer)
     .Local('LData16', cvtPointer)
     .Local('LData', cvtPointer)
     .Local('LLen', cvtUInt64)
     .Local('LBuf', cvtPointer)
     .When(AIR.Eq(AIR.Get('AStr'), AIR.Null()))
        .Return(AIR.Null())
     .EndWhen();

  // Check if already cached
  LDeref := AIR.Deref(AIR.Get('AStr'), 'TStringRec');
  AIR.Assign('LData16', AIR.GetField(LDeref, 'Data16'))
     .When(AIR.Ne(AIR.Get('LData16'), AIR.Null()))
        .Return(AIR.Get('LData16'))
     .EndWhen();

  // Get UTF-8 data pointer and length
  LDeref := AIR.Deref(AIR.Get('AStr'), 'TStringRec');
  AIR.Assign('LData', AIR.GetField(LDeref, 'Data'));

  LDeref := AIR.Deref(AIR.Get('AStr'), 'TStringRec');
  AIR.Assign('LLen', AIR.GetField(LDeref, 'Length'));

  AIR.Assign('LBuf', AIR.Invoke(RT_StrLiteralUtf16,
     [AIR.Get('LData'), AIR.Get('LLen')]));

  // Store in cache
  LDeref := AIR.Deref(AIR.Get('AStr'), 'TStringRec');
  AIR.SetVal(AIR.GetField(LDeref, 'Data16'), AIR.Get('LBuf'))
     .Return(AIR.Get('LBuf'))
  .EndFunc();
end;

procedure TMyrRuntimeLinux64.AddSystem(const AIR: TMyrIR; const AOptLevel: Integer);
begin
  // RT_Halt(AExitCode: Int32)
  // Terminates the process with the specified exit code. Mirrors the Win64
  // shutdown order exactly, ending in libc exit() the same way Win64 ends in
  // ExitProcess. exit() flushes stdio (glibc fully buffers stdout when it is
  // not a TTY), runs atexit handlers, then issues exit_group itself. A raw
  // exit_group here would discard every buffered byte of program output.
  // At opt level 0, reports heap leaks before terminating.
  AIR.Func(RT_Halt, cvtVoid, False, plC, False)
     .NoReturn()
     .Param('AExitCode', cvtInt32);
  // Run module finalizers in LIFO order
  AIR.Call(RT_RunFinalizers, []);

  // Free command line args before leak reporting
  AIR.Call(RT_FreeCommandLine, []);
  // Free exception state before leak reporting
  AIR.Call(RT_FreeExceptions, []);
  if AOptLevel = 0 then
    AIR.Call(RT_ReportLeaks, []);
  AIR.Call('exit', [AIR.Get('AExitCode')])
  .EndFunc();
end;

procedure TMyrRuntimeLinux64.AddIO(const AIR: TMyrIR; const AIsDll: Boolean);
begin
  // Import C runtime printf (variadic) - used by rt_write/rt_writeln helpers.
  // win64 takes this from msvcrt; on Linux it comes from libc.
  AIR.Import('libc.so.6', 'printf', [cvtPointer], cvtInt32, True);

  // RT_InitConsole()
  // No-op on Linux - the console is UTF-8 by default, so there is no code
  // page to set. The routine must still exist because entry points call it.
  // Exported only from a shared object; local in an exe or a static lib.
  AIR.Func(RT_InitConsole, cvtVoid, False, plC, AIsDll)
     .Return()
  .EndFunc();
end;

procedure TMyrRuntimeLinux64.AddMemory(const AIR: TMyrIR; const AOptLevel: Integer; const AIsDll: Boolean);
begin
  // Allocation layout. Every block carries a 16-byte header holding the total
  // mapped length, which munmap needs at free time:
  //
  //   [base]      UInt64  total mapped bytes (header included)
  //   [base + 8]  UInt64  unused (padding to keep the payload 16-aligned)
  //   [base + 16] payload, returned to the caller
  //
  // The total is deliberately NOT rounded to 16. mmap returns page-aligned
  // memory and the kernel rounds both the mapping and the munmap length to a
  // page, so the payload is 16-aligned regardless and rounding buys nothing.

  // Debug heap tracking (only when optimization level = 0)
  if AOptLevel = 0 then
  begin
    AIR.Global(RT_AllocCount, cvtUInt64);
    AIR.Global(RT_FreeCount, cvtUInt64);
  end;

  // RT_GetMem(ASize: UInt64): Pointer
  // Maps ASize + 16 bytes of anonymous private memory, stores the total in
  // the header and returns the payload address.
  AIR.Func(RT_GetMem, cvtPointer, False, plC, False)
     .Param('ASize', cvtUInt64)
     .Local('LTotal', cvtUInt64)
     .Local('LBase', cvtPointer);

  AIR.Assign('LTotal', AIR.Add(AIR.Get('ASize'), AIR.MakeInt64(16)));
  AIR.Assign('LBase', AIR.Syscall(AIR.MakeInt64(SYS_MMAP), [
    AIR.MakeInt64(0),                     // addr: kernel chooses
    AIR.Get('LTotal'),                    // length
    AIR.MakeInt64(PROT_READ_WRITE),       // prot
    AIR.MakeInt64(MAP_PRIVATE_ANON),      // flags
    AIR.MakeInt64(-1),                    // fd: none for anonymous
    AIR.MakeInt64(0)]));                  // offset

  // Store the total length in the header for RT_FreeMem and RT_MemSize.
  AIR.SetVal(AIR.Deref(AIR.Get('LBase'), cvtUInt64), AIR.Get('LTotal'));

  if AOptLevel = 0 then
    AIR.Assign(RT_AllocCount, AIR.Add(AIR.Get(RT_AllocCount), AIR.MakeInt64(1)));

  AIR.Return(AIR.Add(AIR.Get('LBase'), AIR.MakeInt64(16)));
  AIR.EndFunc();

  // RT_AllocMem(ASize: UInt64): Pointer
  // Zero-initialized allocation. Anonymous mmap pages arrive zeroed, so this
  // is RT_GetMem with no extra clearing step.
  AIR.Func(RT_AllocMem, cvtPointer, False, plC, False)
     .Param('ASize', cvtUInt64)
     .Return(AIR.Invoke(RT_GetMem, [AIR.Get('ASize')]))
  .EndFunc();

  // RT_MemSize(APtr: Pointer): UInt64
  // Returns the usable payload size: the stored total minus the header.
  AIR.Func(RT_MemSize, cvtUInt64, False, plC, False)
     .Param('APtr', cvtPointer)
     .Local('LBase', cvtPointer);

  AIR.When(AIR.Eq(AIR.Get('APtr'), AIR.Null()))
     .Return(AIR.MakeInt64(0))
  .EndWhen();

  AIR.Assign('LBase', AIR.Sub(AIR.Get('APtr'), AIR.MakeInt64(16)));
  AIR.Return(AIR.Sub(AIR.Deref(AIR.Get('LBase'), cvtUInt64), AIR.MakeInt64(16)));
  AIR.EndFunc();

  // RT_FreeMem(APtr: Pointer)
  // Unmaps the whole block, header included.
  AIR.Func(RT_FreeMem, cvtVoid, False, plC, False)
     .Param('APtr', cvtPointer)
     .Local('LBase', cvtPointer)
     .Local('LSysRes', cvtInt64);

  // Guard: do nothing if pointer is nil
  AIR.When(AIR.Eq(AIR.Get('APtr'), AIR.Null()))
     .Return()
  .EndWhen();

  AIR.Assign('LBase', AIR.Sub(AIR.Get('APtr'), AIR.MakeInt64(16)));
  AIR.Let('LSysRes', AIR.Syscall(AIR.MakeInt64(SYS_MUNMAP), [
    AIR.Get('LBase'),
    AIR.Deref(AIR.Get('LBase'), cvtUInt64)]));

  if AOptLevel = 0 then
    AIR.Assign(RT_FreeCount, AIR.Add(AIR.Get(RT_FreeCount), AIR.MakeInt64(1)));

  AIR.Return();
  AIR.EndFunc();

  // RT_ReportLeaks() - Debug only
  // Prints the allocation summary. Body is identical to Win64; printf is
  // provided by AddIO on this target rather than imported from msvcrt.
  if AOptLevel = 0 then
  begin
    // Exported only from a DLL (own heap, own leak report); local otherwise.
    AIR.Func(RT_ReportLeaks, cvtVoid, False, plC, AIsDll);
    AIR.Call('printf', [AIR.Str('[Heap] Allocs: %llu, Frees: %llu, Leaked: %lld' + #10),
                        AIR.Get(RT_AllocCount),
                        AIR.Get(RT_FreeCount),
                        AIR.Sub(AIR.Get(RT_AllocCount), AIR.Get(RT_FreeCount))]);
    AIR.Return();
    AIR.EndFunc();
  end;

  // RT_ReAllocMem(APtr: Pointer; ANewSize: UInt64): Pointer
  // Allocates a new block, copies min(old, new) bytes, frees the old block.
  // Uses libc memcpy (imported in AddImports). Heap counters stay balanced
  // because RT_GetMem / RT_FreeMem maintain them. Note: size comparison uses
  // the signed Lt comparator (no unsigned variant in the IR API); correct for
  // any realistic allocation size below 2^63.
  AIR.Func(RT_ReAllocMem, cvtPointer, False, plC, False)
     .Param('APtr', cvtPointer)
     .Param('ANewSize', cvtUInt64)
     .Local('LOldSize', cvtUInt64)
     .Local('LCopySize', cvtUInt64)
     .Local('LNew', cvtPointer);

  // nil input behaves like a fresh allocation
  AIR.When(AIR.Eq(AIR.Get('APtr'), AIR.Null()))
     .Return(AIR.Invoke(RT_GetMem, [AIR.Get('ANewSize')]))
  .EndWhen();

  AIR.Let('LOldSize', AIR.Invoke(RT_MemSize, [AIR.Get('APtr')]));
  AIR.Let('LNew', AIR.Invoke(RT_GetMem, [AIR.Get('ANewSize')]));

  // copy min(old, new) bytes into the new block
  AIR.Assign('LCopySize', AIR.Get('LOldSize'));
  AIR.When(AIR.Lt(AIR.Get('ANewSize'), AIR.Get('LOldSize')))
     .Assign('LCopySize', AIR.Get('ANewSize'))
  .EndWhen();
  AIR.Call('memcpy', [AIR.Get('LNew'), AIR.Get('APtr'), AIR.Get('LCopySize')]);

  AIR.Call(RT_FreeMem, [AIR.Get('APtr')]);
  AIR.Return(AIR.Get('LNew'));
  AIR.EndFunc();
end;

procedure TMyrRuntimeLinux64.AddCommandLine(const AIR: TMyrIR);
begin
  // Globals for argc/argv storage. On Linux these are filled by the _start
  // stub emitted by TMyrELFWriter, which reads them off the initial stack.
  // There is no parsing step - the kernel hands over argv already split.
  AIR.Global(RT_Argc, cvtInt64);
  AIR.Global(RT_Argv, cvtPointer);

  // RT_InitCommandLine()
  // No-op on Linux: argc/argv are stored by the _start stub before main
  // runs, so there is nothing left to initialize.
  AIR.Func(RT_InitCommandLine, cvtVoid, False, plC, False)
     .Return()
  .EndFunc();

  // RT_FreeCommandLine()
  // No-op on Linux: the argv block is kernel-owned stack memory and is not
  // heap allocated, so there is nothing to release.
  AIR.Func(RT_FreeCommandLine, cvtVoid, False, plC, False)
     .Return()
  .EndFunc();

  // RT_ParamCount(): Int64
  // Returns argc - 1 (Pascal semantics: excludes program name).
  // Body is identical to Win64 - it reads only the two globals above.
  AIR.Func(RT_ParamCount, cvtInt64, False, plC, False)
     .Return(AIR.Sub(AIR.Get(RT_Argc), AIR.MakeInt64(1)))
  .EndFunc();

  // RT_ParamStr(AIndex: Int64): Pointer
  // Returns pointer to the UTF-8 string at the given index, or nil if the
  // index is out of range. Body is identical to Win64; on Linux the argv
  // strings are already UTF-8 C strings, so no conversion is needed.
  AIR.Func(RT_ParamStr, cvtPointer, False, plC, False)
     .Param('AIndex', cvtInt64);

  // Check bounds: AIndex < 0
  AIR.When(AIR.Lt(AIR.Get('AIndex'), AIR.MakeInt64(0)))
     .Return(AIR.Null())
  .EndWhen();

  // Check bounds: AIndex >= RT_Argc
  AIR.When(AIR.Ge(AIR.Get('AIndex'), AIR.Get(RT_Argc)))
     .Return(AIR.Null())
  .EndWhen();

  // Return RT_Argv[AIndex]
  AIR.Return(AIR.Deref(
     AIR.Add(AIR.Get(RT_Argv), AIR.Mul(AIR.Get('AIndex'), AIR.MakeInt64(8))),
     cvtPointer))
  .EndFunc();
end;

procedure TMyrRuntimeLinux64.AddDllEntry(const AIR: TMyrIR);
var
  LI: Integer;
  LFunc: TMyrIR.TMyrIRFunc;
begin
  // Same DllMain shape as win64: the ELF writer routes DT_INIT/DT_FINI
  // through fixed thunks that call this function with fdwReason=1 (attach)
  // and fdwReason=0 (detach).
  AIR.DllMain();

  // ATTACH path (fdwReason == 1)
  AIR.When(AIR.Eq(AIR.Get('fdwReason'), AIR.UInt32(1)));
    AIR.Call(RT_InitExceptions, []);
    AIR.Call(RT_InitSignals, []);
    // Call all module init functions
    for LI := 0 to AIR.GetFunctionCount() - 1 do
    begin
      LFunc := AIR.GetFunction(LI);
      if LFunc.FuncName.StartsWith(RT_ModuleInit + '_') then
        AIR.Call(LFunc.FuncName, []);
    end;
  AIR.EndWhen();

  // DETACH path (fdwReason == 0)
  AIR.When(AIR.Eq(AIR.Get('fdwReason'), AIR.UInt32(0)));
    // Call all module finalize functions in reverse order
    for LI := AIR.GetFunctionCount() - 1 downto 0 do
    begin
      LFunc := AIR.GetFunction(LI);
      if LFunc.FuncName.StartsWith(RT_ModuleFinalize + '_') then
        AIR.Call(LFunc.FuncName, []);
    end;
    AIR.Call(RT_FreeExceptions, []);
  AIR.EndWhen();

  // Return TRUE
  AIR.Ret(AIR.Int32(1));
  AIR.EndFunc();
end;

// TMyrRuntimeLinux64 - Exception Handling (setjmp frame chain)
// Ported from Tiger.Runtime.Linux64.pas (TTigerLinux64Runtime.AddExceptions).
// Imports (pthread_*, sigaction, __sigsetjmp, siglongjmp, strlen, memcpy,
// memset) are declared in AddImports, the per-target import hook.
// The frame chain is populated by codegen: try-begin sites call
// RT_PushExceptFrame + __sigsetjmp, scope ends call RT_PopExceptFrame.
procedure TMyrRuntimeLinux64.AddExceptions(const AIR: TMyrIR);
const
  // Linux signal numbers
  SIGFPE  = 8;   // Floating point exception (includes div by zero)
  SIGSEGV = 11;  // Segmentation fault
  SIGILL  = 4;   // Illegal instruction
  SIGBUS  = 7;   // Bus error

  // Offsets within the exception frame (216 bytes total)
  FRAME_PREV     = 0;    // PrevFrame: Pointer (8 bytes)
  FRAME_JMPBUF   = 8;    // JmpBuf: sigjmp_buf (200 bytes)
  FRAME_TYPE     = 208;  // FrameType: Int32 (4 bytes)
  FRAME_SIZE     = 216;  // Total frame size (aligned to 8)

  // sigaction structure size (glibc x86-64)
  // sa_handler(8) + sa_mask(128) + sa_flags(4) + padding(4) + sa_restorer(8) = 152
  SIGACTION_SIZE = 152;
begin
  // Global variables for TLS slot keys
  AIR.Global(RT_TlsExcChain, cvtUInt32);  // TLS key for exception frame chain
  AIR.Global(RT_TlsExcCode, cvtUInt32);   // TLS key for exception code
  AIR.Global(RT_TlsExcMsg, cvtUInt32);    // TLS key for exception message

  // RT_InitExceptions()
  // Allocates TLS keys. Called at process startup.
  AIR.Func(RT_InitExceptions, cvtVoid, False, plC, False)
     .Call('pthread_key_create', [AIR.AddrOf(RT_TlsExcChain), AIR.Null()])
     .Call('pthread_key_create', [AIR.AddrOf(RT_TlsExcCode), AIR.Null()])
     .Call('pthread_key_create', [AIR.AddrOf(RT_TlsExcMsg), AIR.Null()])
     .Return()
  .EndFunc();

  // RT_SignalHandler(ASigNum: Int32; AInfo: Pointer; AContext: Pointer)
  // Signal handler for hardware exceptions. Maps the raw signal number to a
  // portable Myrissa exception code with a message (matching the Myra
  // runtime's table, target-neutral with Win64):
  //   2=Divide by zero, 3=Segmentation fault, 6=Illegal instruction,
  //   7=Bus error, 99=Unknown hardware. Then jumps to current except frame.
  AIR.Func(RT_SignalHandler, cvtVoid, False, plC, False)
     .Param('ASigNum', cvtInt32)
     .Param('AInfo', cvtPointer)
     .Param('AContext', cvtPointer)
     .Local('LFrame', cvtPointer)
     .Local('LJmpBuf', cvtPointer)
     .Local('LSig', cvtInt64)
     .Local('LMapCode', cvtInt64)
     .Local('LMapMsg', cvtPointer)
     // The kernel only guarantees the low 32 bits of the signal number
     // register; mask before comparing against full 64-bit immediates.
     .Assign('LSig', AIR.BitAnd(AIR.Get('ASigNum'), AIR.MakeInt64($FFFFFFFF)))
     // Default: unknown hardware exception
     .Assign('LMapCode', AIR.MakeInt64(99))
     .Assign('LMapMsg', AIR.Str('Hardware exception'))
     .When(AIR.Eq(AIR.Get('LSig'), AIR.MakeInt64(SIGFPE)))
        .Assign('LMapCode', AIR.MakeInt64(2))
        .Assign('LMapMsg', AIR.Str('Divide by zero'))
     .EndWhen()
     .When(AIR.Eq(AIR.Get('LSig'), AIR.MakeInt64(SIGSEGV)))
        .Assign('LMapCode', AIR.MakeInt64(3))
        .Assign('LMapMsg', AIR.Str('Segmentation fault'))
     .EndWhen()
     .When(AIR.Eq(AIR.Get('LSig'), AIR.MakeInt64(SIGBUS)))
        .Assign('LMapCode', AIR.MakeInt64(7))
        .Assign('LMapMsg', AIR.Str('Bus error'))
     .EndWhen()
     .When(AIR.Eq(AIR.Get('LSig'), AIR.MakeInt64(SIGILL)))
        .Assign('LMapCode', AIR.MakeInt64(6))
        .Assign('LMapMsg', AIR.Str('Illegal instruction'))
     .EndWhen()
     // Store portable code + message as the current exception
     .Call(RT_SetException, [AIR.Get('LMapCode'), AIR.Get('LMapMsg')])
     // Get current exception frame
     .Assign('LFrame', AIR.Invoke('pthread_getspecific', [AIR.Get(RT_TlsExcChain)]))
     // Calculate JmpBuf address (frame + 8)
     .Assign('LJmpBuf', AIR.Add(AIR.Get('LFrame'), AIR.MakeInt64(FRAME_JMPBUF)))
     // Jump to recovery point with value 1
     .Call('siglongjmp', [AIR.Get('LJmpBuf'), AIR.MakeInt64(1)])
     .Return()
  .EndFunc();

  // RT_InitSignals()
  // Installs signal handlers for hardware exceptions. Called at process startup.
  AIR.Func(RT_InitSignals, cvtVoid, False, plC, False)
     .Local('LSigAction', cvtPointer)
     // Allocate sigaction struct (152 bytes, zeroed)
     .Assign('LSigAction', AIR.Invoke(RT_GetMem, [AIR.MakeInt64(SIGACTION_SIZE)]))
     .Call('memset', [AIR.Get('LSigAction'), AIR.MakeInt64(0), AIR.MakeInt64(SIGACTION_SIZE)])
     // Set sa_handler = RT_SignalHandler (store function pointer at offset 0)
     .SetVal(AIR.Deref(AIR.Get('LSigAction'), cvtPointer), AIR.FuncAddr(RT_SignalHandler))
     // Install handler for SIGFPE (div by zero)
     .Call('sigaction', [AIR.MakeInt64(SIGFPE), AIR.Get('LSigAction'), AIR.Null()])
     // Install handler for SIGSEGV (access violation)
     .Call('sigaction', [AIR.MakeInt64(SIGSEGV), AIR.Get('LSigAction'), AIR.Null()])
     // Install handler for SIGILL (illegal instruction)
     .Call('sigaction', [AIR.MakeInt64(SIGILL), AIR.Get('LSigAction'), AIR.Null()])
     // Install handler for SIGBUS (bus error)
     .Call('sigaction', [AIR.MakeInt64(SIGBUS), AIR.Get('LSigAction'), AIR.Null()])
     // Free the sigaction struct
     .Call(RT_FreeMem, [AIR.Get('LSigAction')])
     .Return()
  .EndFunc();

  // RT_PushExceptFrame(AFrame: Pointer)
  // Pushes an exception frame onto the TLS chain.
  AIR.Func(RT_PushExceptFrame, cvtVoid, False, plC, False)
     .Param('AFrame', cvtPointer)
     .Local('LPrev', cvtPointer)
     // Get current chain head
     .Assign('LPrev', AIR.Invoke('pthread_getspecific', [AIR.Get(RT_TlsExcChain)]))
     // Store previous frame pointer at offset 0 of new frame
     .SetVal(AIR.Deref(AIR.Get('AFrame'), cvtPointer), AIR.Get('LPrev'))
     // Set new frame as chain head
     .Call('pthread_setspecific', [AIR.Get(RT_TlsExcChain), AIR.Get('AFrame')])
     .Return()
  .EndFunc();

  // RT_PopExceptFrame()
  // Pops the current exception frame from the TLS chain.
  AIR.Func(RT_PopExceptFrame, cvtVoid, False, plC, False)
     .Local('LFrame', cvtPointer)
     .Local('LPrev', cvtPointer)
     // Get current frame
     .Assign('LFrame', AIR.Invoke('pthread_getspecific', [AIR.Get(RT_TlsExcChain)]))
     // Get previous frame from offset 0
     .Assign('LPrev', AIR.Deref(AIR.Get('LFrame')))
     // Set previous as new chain head
     .Call('pthread_setspecific', [AIR.Get(RT_TlsExcChain), AIR.Get('LPrev')])
     .Return()
  .EndFunc();

  // RT_GetExceptFrame(): Pointer
  // Returns the current exception frame from TLS.
  AIR.Func(RT_GetExceptFrame, cvtPointer, False, plC, False)
     .Return(AIR.Invoke('pthread_getspecific', [AIR.Get(RT_TlsExcChain)]))
  .EndFunc();

  // RT_SetException(ACode: Int32; AMsg: Pointer)
  // Internal helper: stores code and copies message to TLS.
  // Frees old message if present.
  AIR.Func(RT_SetException, cvtVoid, False, plC, False)
     .Param('ACode', cvtInt32)
     .Param('AMsg', cvtPointer)
     .Local('LOldMsg', cvtPointer)
     .Local('LLen', cvtUInt64)
     .Local('LNewMsg', cvtPointer)
     // Get and free old message if any
     .Assign('LOldMsg', AIR.Invoke('pthread_getspecific', [AIR.Get(RT_TlsExcMsg)]))
     .When(AIR.Ne(AIR.Get('LOldMsg'), AIR.Null()))
        .Call(RT_FreeMem, [AIR.Get('LOldMsg')])
     .EndWhen()
     // Copy new message if not nil
     .When(AIR.Ne(AIR.Get('AMsg'), AIR.Null()))
        .Assign('LLen', AIR.Invoke('strlen', [AIR.Get('AMsg')]))
        .Assign('LNewMsg', AIR.Invoke(RT_GetMem, [AIR.Add(AIR.Get('LLen'), AIR.MakeInt64(1))]))
        .Call('memcpy', [AIR.Get('LNewMsg'), AIR.Get('AMsg'), AIR.Add(AIR.Get('LLen'), AIR.MakeInt64(1))])
        .Call('pthread_setspecific', [AIR.Get(RT_TlsExcMsg), AIR.Get('LNewMsg')])
     .Otherwise()
        .Call('pthread_setspecific', [AIR.Get(RT_TlsExcMsg), AIR.Null()])
     .EndWhen()
     // Store code (cast to pointer for TLS)
     .Call('pthread_setspecific', [AIR.Get(RT_TlsExcCode), AIR.Get('ACode')])
     .Return()
  .EndFunc();

  // RT_Raise(AMsg: Pointer)
  // Raises exception with default code (1) and message.
  AIR.Func(RT_Raise, cvtVoid, False, plC, False)
     .Param('AMsg', cvtPointer)
     .Local('LFrame', cvtPointer)
     .Local('LJmpBuf', cvtPointer)
     .Call(RT_SetException, [AIR.MakeInt64(1), AIR.Get('AMsg')])
     // Get current exception frame
     .Assign('LFrame', AIR.Invoke('pthread_getspecific', [AIR.Get(RT_TlsExcChain)]))
     // Calculate JmpBuf address (frame + 8)
     .Assign('LJmpBuf', AIR.Add(AIR.Get('LFrame'), AIR.MakeInt64(FRAME_JMPBUF)))
     // Jump to recovery point
     .Call('siglongjmp', [AIR.Get('LJmpBuf'), AIR.MakeInt64(1)])
     .Return()
  .EndFunc();

  // RT_RaiseCode(ACode: Int32; AMsg: Pointer)
  // Raises exception with custom code and message.
  AIR.Func(RT_RaiseCode, cvtVoid, False, plC, False)
     .Param('ACode', cvtInt32)
     .Param('AMsg', cvtPointer)
     .Local('LFrame', cvtPointer)
     .Local('LJmpBuf', cvtPointer)
     .Call(RT_SetException, [AIR.Get('ACode'), AIR.Get('AMsg')])
     // Get current exception frame
     .Assign('LFrame', AIR.Invoke('pthread_getspecific', [AIR.Get(RT_TlsExcChain)]))
     // Calculate JmpBuf address (frame + 8)
     .Assign('LJmpBuf', AIR.Add(AIR.Get('LFrame'), AIR.MakeInt64(FRAME_JMPBUF)))
     // Jump to recovery point
     .Call('siglongjmp', [AIR.Get('LJmpBuf'), AIR.MakeInt64(1)])
     .Return()
  .EndFunc();

  // RT_GetExceptionCode(): Int32
  // Returns the current exception code from TLS.
  AIR.Func(RT_GetExceptionCode, cvtInt32, False, plC, False)
     .Return(AIR.Invoke('pthread_getspecific', [AIR.Get(RT_TlsExcCode)]))
  .EndFunc();

  // RT_GetExceptionMsg(): Pointer
  // Returns pointer to the current exception message from TLS.
  AIR.Func(RT_GetExceptionMsg, cvtPointer, False, plC, False)
     .Return(AIR.Invoke('pthread_getspecific', [AIR.Get(RT_TlsExcMsg)]))
  .EndFunc();

  // RT_FreeExceptions()
  // Frees the TLS exception message if allocated. Called by RT_Halt.
  // Not present in Tiger; mirrors the win64 contract.
  AIR.Func(RT_FreeExceptions, cvtVoid, False, plC, False)
     .Local('LMsg', cvtPointer)
     .Assign('LMsg', AIR.Invoke('pthread_getspecific', [AIR.Get(RT_TlsExcMsg)]))
     .When(AIR.Ne(AIR.Get('LMsg'), AIR.Null()))
        .Call(RT_FreeMem, [AIR.Get('LMsg')])
        .Call('pthread_setspecific', [AIR.Get(RT_TlsExcMsg), AIR.Null()])
     .EndWhen()
     .Return()
  .EndFunc();
end;

procedure TMyrRuntimeLinux64.AddBaseName(const AIR: TMyrIR);
begin
  // RT_BaseName(APath: Pointer): Pointer
  // Returns a pointer to the file name portion of APath.
  // Linux64: wraps basename from libc.so.6 (imported in AddImports). The
  // dynamic symbol resolves to the GNU version, which does not modify APath.
  AIR.Func(RT_BaseName, cvtPointer, False, plC, False)
     .Param('APath', cvtPointer)
     .Return(AIR.Invoke('basename', [AIR.Get('APath')]))
  .EndFunc();
end;

{ TMyrNativeBackend }
constructor TMyrNativeBackend.Create();
begin
  inherited Create();

  FErrors.SetMaxErrors(100);

  FIR := TMyrIR.Create();
  FIR.SetErrors(FErrors);

  // Backend and default target runtime. The real target is not known until
  // SetTarget is called, which replaces the runtime if it differs.
  FTarget := tgWin64;
  FBackend := TMyrCodegen.Create();
  FRuntime := TMyrRuntimeWin64.Create();

  FBackend.SetErrors(FErrors);

  // Inject string types early so user code can reference 'string' type
  FRuntime.AddTypes(FIR);

  FResFiles := TStringList.Create();
  FSourceMap := TMyrSourceMap.Create();
  FStatus := Default(TCallback<TStatusCallback>);
end;

destructor TMyrNativeBackend.Destroy();
begin
  FResFiles.Free();
  FSourceMap.Free();
  FRuntime.Free();
  FBackend.Free();
  FIR.Free();

  inherited;
end;

procedure TMyrNativeBackend.SetTarget(const ATarget: TMyrTargetKind);
begin
  // The runtime emits target-specific imports (kernel32 on win64, libc on
  // linux64), so it must be replaced when the target changes. Types were
  // already injected into FIR by the previous runtime, so AddTypes is not
  // repeated here.
  if ATarget <> FTarget then
  begin
    FRuntime.Free();
    case ATarget of
      tgLinux64: FRuntime := TMyrRuntimeLinux64.Create();
      tgWin64  : FRuntime := TMyrRuntimeWin64.Create();
    else
      FRuntime := nil; // this should never happen.
    end;
  end;

  FTarget := ATarget;
  // The codegen selects its image writer from the target, so it must be
  // kept in step with the backend.
  if Assigned(FBackend) then
    FBackend.SetTarget(ATarget);
end;

function TMyrNativeBackend.GetTarget(): TMyrTargetKind;
begin
  Result := FTarget;
end;

procedure TMyrNativeBackend.SetErrors(const AErrors: TErrors);
begin
  inherited SetErrors(AErrors);
  if Assigned(FIR) then
    FIR.SetErrors(FErrors);
  if Assigned(FBackend) then
    FBackend.SetErrors(FErrors);
  //if Assigned(FRuntime) then
  //  FRuntime.SetErrors(FErrors);
end;

procedure TMyrNativeBackend.ApplyPostBuildResources(const AExePath: string);
var
  LIconPath: string;
  LIsExe: Boolean;
  LIsDll: Boolean;
  LI: Integer;
  LJ: Integer;
  LReader: TResourceReader;
  LHandle: THandle;
  LEntry: TResourceEntry;
begin
  // PE resources (manifest, icon, version info) exist only on win64
  if FTarget <> tgWin64 then
    Exit;

  LIsExe := AExePath.EndsWith('.exe', True);
  LIsDll := AExePath.EndsWith('.dll', True);

  // Only applies to EXE and DLL files
  if not LIsExe and not LIsDll then
    Exit;

  // 1. Add manifest (EXE only)
  if LIsExe then
  begin
    if TUtils.ResourceExist('EXE_MANIFEST') then
    begin
      if not TUtils.AddResManifestFromResource('EXE_MANIFEST', AExePath) then
        FErrors.Add(esWarning, WRN_MANIFEST_FAILED, RSWarnManifestFailed)
      else
        FBackend.Status('Added application manifest');
    end;
  end;

  // 2. Add icon if specified (EXE only)
  if LIsExe and (FExeIcon <> '') then
  begin
    try
      // FExeIcon arrives already resolved to an absolute path by the
      // @exeicon directive ingest in Myrissa.Frontend.Compiler.
      LIconPath := FExeIcon;
      if TFile.Exists(LIconPath) then
      begin
        TUtils.UpdateIconResource(AExePath, LIconPath);
        FBackend.Status('Added icon: %s', [LIconPath.Replace('\', '/')]);
      end
      else
        FErrors.Add(esWarning, WRN_ICON_NOT_FOUND, Format(RSWarnIconNotFound, [LIconPath]));
    except
      on E: Exception do
        FErrors.Add(esWarning, WRN_ICON_FAILED, Format(RSWarnIconFailed, [E.Message]));
    end;
  end;

  // 3. Add version info if enabled (EXE and DLL)
  if FAddVersionInfo then
  begin
    try
      TUtils.UpdateVersionInfoResource(
        AExePath,
        FVIMajor,
        FVIMinor,
        FVIPatch,
        FVIProductName,
        FVIDescription,
        FVIFilename,
        FVICompanyName,
        FVICopyright
      );
      FBackend.Status('Added version info: %d.%d.%d', [FVIMajor, FVIMinor, FVIPatch]);
    except
      on E: Exception do
        FErrors.Add(esWarning, MYR_WRN_VERSIONINFO_FAILED, Format(RSWarnVersionInfoFailed, [E.Message]));
    end;
  end;

  // 4. Apply .res files
  if FResFiles.Count > 0 then
  begin
    for LI := 0 to FResFiles.Count - 1 do
    begin
      if not TFile.Exists(FResFiles[LI]) then
        Continue;
      try
        LReader := TResourceReader.Create();
        try
          LReader.SetErrors(FErrors);
          LReader.LoadFromFile(FResFiles[LI]);
          if not FErrors.HasErrors() then
          begin
            LHandle := BeginUpdateResource(PChar(AExePath), False);
            if LHandle <> 0 then
            begin
              for LJ := 0 to LReader.EntryCount() - 1 do
              begin
                LEntry := LReader.GetEntry(LJ);
                UpdateResource(LHandle, MakeIntResource(LEntry.ResType),
                  PChar(LEntry.ResName), LEntry.LanguageId,
                  @LEntry.Data[0], Length(LEntry.Data));
              end;
              EndUpdateResource(LHandle, False);
              FBackend.Status('Applied resource file: %s', [TPath.GetFileName(FResFiles[LI])]);
            end;
          end;
        finally
          LReader.Free();
        end;
      except
        on E: Exception do
          FErrors.Add(esWarning, WRN_RESFILE_FAILED,
            Format('Failed to apply resource file "%s": %s', [FResFiles[LI], E.Message]));
      end;
    end;
  end;
end;

