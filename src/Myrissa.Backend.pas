  { TMyrELFObjWriter }
  // Writes an ET_REL relocatable object from a TMyrBuildProduct. Shares no
  // layout with TMyrELFWriter: an object has no program headers, no segments,
  // no stub -- section headers are mandatory and relocations are records,
  // not applied displacements. Mirrors TMyrCOFFWriter's role on win64.
  //
  // Sections, fixed index order:
  //   [0] NULL  [1] .text  [2] .rodata  [3] .data
  //   [4] .rela.text  [5] .symtab  [6] .strtab  [7] .shstrtab
  //
  // Symbols, locals first (mandatory -- linkers reject otherwise):
  //   null, section symbols (.text/.rodata/.data), non-public functions,
  //   then globals: public functions, public data objects, undefined
  //   imports. .symtab sh_info = index of the first global.
  TMyrELFObjWriter = class(TMyrImageWriter)
  private
    function DoValidate(const AProduct: TMyrBuildProduct;
      const AImports: TMyrImportBuilder;
      const AOutputType: TMyrOutputType): Boolean;
    function DoMangledFuncName(const AFuncIndex: Integer): string;
  public
    function WriteImage(const AProduct: TMyrBuildProduct;
      const AData: TMyrDataBuilder;
      const AGlobals: TMyrDataBuilder;
      const AImports: TMyrImportBuilder;
      const AExports: TMyrExportBuilder;
      const AOutputType: TMyrOutputType;
      const ASubsystem: TMyrSubsystem): TBytes; override;
  end;

  { TMyrELFLibWriter }
  // Writes a GNU ar static archive (.a) containing a single ET_REL member
  // produced by TMyrELFObjWriter. Mirrors TMyrLibWriter's role on win64: the
  // archive carries a '/' symbol index member (big-endian count, big-endian
  // per-symbol member offsets -- all pointing at the single .o member --
  // then NUL-terminated names) followed by the object member itself.
  TMyrELFLibWriter = class(TMyrImageWriter)
  public
    function WriteImage(const AProduct: TMyrBuildProduct;
      const AData: TMyrDataBuilder;
      const AGlobals: TMyrDataBuilder;
      const AImports: TMyrImportBuilder;
      const AExports: TMyrExportBuilder;
      const AOutputType: TMyrOutputType;
      const ASubsystem: TMyrSubsystem): TBytes; override;
  end;

