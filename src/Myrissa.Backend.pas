function TMyrIR.IntToFloat64(const AValue: TMyrIRExpr): TMyrIRExpr;
var
  LSrcType: TMyrValueType;
begin
  // Check source expression type to decide conversion
  if (AValue.Index >= 0) and (AValue.Index < FExpressions.Count) then
  begin
    LSrcType := FExpressions[AValue.Index].ResultType.Primitive;
    // Already float — no conversion needed
    if LSrcType in [cvtFloat32, cvtFloat64] then
      Exit(AValue);
    // uint64 is the ONLY integer type whose values can set bit 63, and
    // CVTSI2SD reads that bit as a sign. uint8/16/32 all fit exactly in the
    // signed range, so they keep the cheap direct conversion.
    if LSrcType = cvtUInt64 then
      Exit(MakeUnaryExpr(AValue, TMyrIROpKind.opUIntToFloat));
    // Known integer type — emit CVTSI2SD
    if LSrcType in [cvtInt8, cvtInt16, cvtInt32, cvtInt64,
                    cvtUInt8, cvtUInt16, cvtUInt32, cvtUInt64] then
      Exit(MakeUnaryExpr(AValue, TMyrIROpKind.opIntToFloat));
  end;
  // Unknown/untracked type — emit conversion (safe default)
  Result := MakeUnaryExpr(AValue, TMyrIROpKind.opIntToFloat);
end;

function TMyrIR.Float64ToInt(const AValue: TMyrIRExpr): TMyrIRExpr;
var
  LSrcType: TMyrValueType;
begin
  // Check source expression type to decide conversion
  if (AValue.Index >= 0) and (AValue.Index < FExpressions.Count) then
  begin
    LSrcType := FExpressions[AValue.Index].ResultType.Primitive;
    // Already integer — no conversion needed
    if LSrcType in [cvtInt8, cvtInt16, cvtInt32, cvtInt64,
                    cvtUInt8, cvtUInt16, cvtUInt32, cvtUInt64] then
      Exit(AValue);
    // Known float type — emit CVTTSD2SI
    if LSrcType in [cvtFloat32, cvtFloat64] then
      Exit(MakeUnaryExpr(AValue, TMyrIROpKind.opFloatToInt));
  end;
  // Unknown/untracked type — passthrough (assume integer, safer than corrupt)
  Result := AValue;
end;

function TMyrIR.ConvertFloat64ToInt(const AValue: TMyrIRExpr): TMyrIRExpr;
begin
  // Unconditional CVTTSD2SI. Unlike Float64ToInt this never inspects
  // ResultType, which is NOT populated for call results (Invoke) or for
  // expression temps (MakeUnaryExpr/MakeBinaryExpr) — on those paths the
  // guarded routine silently passes the raw bits through. Callers use this
  // entry point only when they have already established, from a source of
  // truth outside the IR, that the operand is float64 and the target is
  // an integer type.
  Result := MakeUnaryExpr(AValue, TMyrIROpKind.opFloatToInt);
end;

function TMyrIR.ConvertUIntToFloat64(const AValue: TMyrIRExpr): TMyrIRExpr;
begin
  // Unconditional unsigned CVTSI2SD-with-fixup. Same contract as
  // ConvertFloat64ToInt: never inspects ResultType, so it is correct on the
  // call-result and expression-temp paths where the guarded IntToFloat64
  // cannot tell uint64 from int64 and silently picks the signed conversion.
  Result := MakeUnaryExpr(AValue, TMyrIROpKind.opUIntToFloat);
end;

function TMyrIR.ConvertFloat64ToUInt(const AValue: TMyrIRExpr): TMyrIRExpr;
begin
  // Unconditional CVTTSD2SI-with-fixup. The DESTINATION type is what selects
  // this routine and the destination is not represented in the operand at
  // all, so there is nothing for a guarded variant to inspect - the caller
  // must have established from outside the IR that the target is unsigned.
  Result := MakeUnaryExpr(AValue, TMyrIROpKind.opFloatToUInt);
end;

function TMyrIR.Float32ToFloat64(const AValue: TMyrIRExpr): TMyrIRExpr;
var
  LSrcType: TMyrValueType;
begin
  if (AValue.Index >= 0) and (AValue.Index < FExpressions.Count) then
  begin
    LSrcType := FExpressions[AValue.Index].ResultType.Primitive;
    // Already float64 — no conversion needed
    if LSrcType = cvtFloat64 then
      Exit(AValue);
    // Float32 — emit CVTSS2SD
    if LSrcType = cvtFloat32 then
      Exit(MakeUnaryExpr(AValue, TMyrIROpKind.opFloat32ToFloat64));
  end;
  // Unknown/non-float — passthrough
  Result := AValue;
end;

