    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_IR_UNKNOWN_TYPE, RSIRLenUnknown, [ATypeName]);
    Result := TMyrIRExpr.None();
    Exit;
  end;

  LEntry := FTypes[LTypeIndex];
  case LEntry.Kind of
    tkFixedArray:
      Result := MakeInt64(LEntry.FixedArrayType.HighBound - LEntry.FixedArrayType.LowBound + 1);
  else
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_IR_TYPE_BUILD, RSIRLenNotApplicable, [ATypeName]);
    Result := TMyrIRExpr.None();
  end;
end;

