    ): TMyrSSAVar;
    function FindImportByName(const AIR: TMyrIR; const AName: string): Integer;
    function FindImportBySignature(
      const AIR: TMyrIR;
      const AName: string;
      const AArgTypes: TArray<TMyrTypeRef>
    ): Integer;
    function FindImportByArgCount(const AIR: TMyrIR; const AName: string;
      const AArgCount: Integer): Integer;
    function FindLocalFuncByName(const AIR: TMyrIR; const AName: string): Integer;
    // Runtime routine as a call target by identity: a local function when
    // the runtime is bundled, a static import when it is externalized (lib).
    function ResolveRuntimeTarget(const AIR: TMyrIR; const AName: string): TMyrSSAOperand;
    function FindLocalFuncByArgCount(const AIR: TMyrIR; const AName: string;
      const AArgCount: Integer): Integer;
    function FindLocalFuncBySignature(
      const AIR: TMyrIR;
      const AName: string;
      const AArgTypes: TArray<TMyrTypeRef>
    ): Integer;
    
    // SSA construction algorithms
    procedure ComputeDominators(const AFunc: TMyrSSAFunc);
    procedure ComputeDominanceFrontiers(const AFunc: TMyrSSAFunc);
    procedure InsertPhiNodes(const AFunc: TMyrSSAFunc);
    procedure RenameVariables(const AFunc: TMyrSSAFunc);
    
  public
    constructor Create(); override;
    destructor Destroy(); override;
    
    // Configuration
    procedure SetOptions(const AOptions: TMyrSSAOptions);
    function GetOptions(): TMyrSSAOptions;
    
    // Build from high-level IR
    procedure BuildFrom(const AIR: TMyrIR; const ADebug: Boolean);
    
    
    // Optimization
    procedure Optimize(const ALevel: Integer);
    procedure RemoveUnreferencedFunctions();
    procedure AddPass(const APass: TMyrSSAPass);
    
    // Debug
    function DumpSSA(): string;
    procedure EliminatePhiNodes(const AFunc: TMyrSSAFunc);
    procedure ClearPasses();
    
    
    // Query
    function GetFunctionCount(): Integer;
    function GetFunction(const AIndex: Integer): TMyrSSAFunc;
    function GetStrReleaseTarget(): TMyrSSAOperand;
    function GetStrAddRefTarget(): TMyrSSAOperand;
    function GetFreeMemTarget(): TMyrSSAOperand;
