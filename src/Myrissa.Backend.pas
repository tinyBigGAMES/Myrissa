    lskBSS,
    lskPData,
    lskXData,
    lskOther,
    // Symbols provided by the consuming module (exe/dll) itself, not by a
    // linked object. OffsetInMerged is the absolute offset in the consumer's
    // own section. Used to bind a static lib's undefined RT_* references to
