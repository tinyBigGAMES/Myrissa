function TMyrNativeBackend.GetSetLowBound(const ATypeName: string): Integer;
var
  LIndex: Integer;
  LEntry: TMyrIR.TMyrIRTypeEntry;
begin
  // LowBound of a named set type; 0 if unknown or not a set
  Result := 0;
  LIndex := FIR.FindType(ATypeName);
  if LIndex < 0 then
    Exit;
  LEntry := FIR.GetTypeEntry(LIndex);
  if LEntry.Kind = TMyrIR.TMyrIRTypeKind.tkSet then
    Result := LEntry.SetType.LowBound;
end;

