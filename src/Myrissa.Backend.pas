function TMyrIR.FindRecordField(const ATypeIndex: Integer; const AFieldName: string;
  out AFieldInfo: TMyrIRRecordField): Boolean;
var
  LEntry: TMyrIRTypeEntry;
  LI: Integer;
begin
  Result := False;
  AFieldInfo := Default(TMyrIRRecordField);

  if (ATypeIndex < 0) or (ATypeIndex >= FTypes.Count) then
    Exit;

  LEntry := FTypes[ATypeIndex];

  if LEntry.Kind = tkRecord then
  begin
    // Ensure record is finalized
    if not LEntry.RecordType.IsFinalized then
      FinalizeRecordLayout(ATypeIndex);

    // Re-read after finalization
    LEntry := FTypes[ATypeIndex];

    // Search in this record's own fields first
    for LI := 0 to Length(LEntry.RecordType.Fields) - 1 do
    begin
      // Myrissa is CASE-SENSITIVE. Both sides of this comparison come from
      // user source, so SameText let `rec.X` silently resolve to field `x`.
      if LEntry.RecordType.Fields[LI].FieldName = AFieldName then
      begin
        AFieldInfo := LEntry.RecordType.Fields[LI];
        Result := True;
        Exit;
      end;
    end;

    // Not found in own fields - search base type (recursive)
    if LEntry.RecordType.BaseTypeIndex >= 0 then
      Result := FindRecordField(LEntry.RecordType.BaseTypeIndex, AFieldName, AFieldInfo);
  end
  else if LEntry.Kind = tkAlias then
  begin
    // An alias names the SAME layout as the type it aliases, so field lookup
    // must see through it. Without this branch the lookup simply failed and
    // the caller was left holding a default TMyrIRRecordField - FieldOffset 0 -
    // which is indistinguishable from a legitimate first field. Every field of
    // an aliased record therefore resolved to offset 0 and silently wrote over
    // the first one.
    //
    // This covers a plain local alias (type TFoo = TBar) as well as the
    // qualified spelling of an imported type, which the emitter registers as
    // an alias of the bare name.
    if not LEntry.AliasType.AliasedType.IsPrimitive then
      Result := FindRecordField(LEntry.AliasType.AliasedType.TypeIndex,
        AFieldName, AFieldInfo);
  end
  else if LEntry.Kind = tkUnion then
  begin
    // Ensure union is finalized
    if not LEntry.UnionType.IsFinalized then
      FinalizeUnionLayout(ATypeIndex);

    // Re-read after finalization
    LEntry := FTypes[ATypeIndex];

    // Search union fields (all at offset 0)
    for LI := 0 to Length(LEntry.UnionType.Fields) - 1 do
    begin
      if LEntry.UnionType.Fields[LI].FieldName = AFieldName then
      begin
        AFieldInfo := LEntry.UnionType.Fields[LI];
        Result := True;
        Exit;
      end;
    end;
  end;
end;

