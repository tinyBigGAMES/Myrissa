  { TMyrSubsystem }
  TMyrSubsystem = (
    ssConsole,
    ssGui
  );



  { TMyrTargetInfo }
  TMyrTargetInfo = record
    // File extension for AOutputType on ATarget, including the leading dot.
    // Returns an empty string where the target uses no extension.
    class function FileExt(const ATarget: TMyrTargetKind; const AOutputType: TMyrOutputType): string; static;
    // Canonical lowercase target name, as accepted by the -t CLI flag and
    // used in generated artifact filenames. Not a display string.
    class function TargetText(const ATarget: TMyrTargetKind): string; static;
  end;

  { TMyrCallConv }
  TMyrCallConv = record
    ArgRegs: array[0..5] of Byte;   // integer/pointer arg registers in order
    MaxRegArgs: Integer;            // how many of ArgRegs are used
    ShadowSpace: Integer;           // bytes of mandatory shadow/home space (0 on SysV)
    RedZone: Integer;               // bytes of red zone below RSP (0 on Win64)
    StackAlign: Integer;            // required stack alignment at call sites
    CalleeSaved: array[0..7] of Byte;
    CalleeSavedCount: Integer;
  end;

const
  { WIN64_CALLCONV }
  WIN64_CALLCONV: TMyrCallConv = (
    ArgRegs: (REG_RCX, REG_RDX, REG_R8, REG_R9, 0, 0);
    MaxRegArgs: 4;
    ShadowSpace: 32;
    RedZone: 0;
    StackAlign: 16;
    CalleeSaved: (REG_RBX, REG_RBP, REG_RDI, REG_RSI, REG_R12, REG_R13, REG_R14, REG_R15);
    CalleeSavedCount: 8
  );

type
  { TMyrValueType }
  TMyrValueType = (
    cvtVoid,
    cvtBoolean,
    cvtInt8,
    cvtInt16,
    cvtInt32,
    cvtInt64,
    cvtUInt8,
    cvtUInt16,
    cvtUInt32,
    cvtUInt64,
    cvtFloat32,
    cvtFloat64,
    cvtPointer
  );

  { TMyrCallValue }
  TMyrCallValue = record
    ValueType: TMyrValueType;
    case Byte of
      0: (AsBoolean: Boolean);
      1: (AsInt8: Int8);
      2: (AsInt16: Int16);
      3: (AsInt32: Int32);
      4: (AsInt64: Int64);
      5: (AsUInt8: UInt8);
      6: (AsUInt16: UInt16);
      7: (AsUInt32: UInt32);
      8: (AsUInt64: UInt64);
      9: (AsFloat32: Single);
      10: (AsFloat64: Double);
      11: (AsPointer: Pointer);
  end;

  { TMyrOptimizeLevel }
  TMyrOptimizeLevel = (
    olNone,         // O0 — no optimization, fastest compile
    olBasic,        // O1 — constant folding, copy propagation, dead code elimination
    olFull          // O2 — includes CSE and additional backend passes
  );

  { TMyrLinkage }
  TMyrLinkage = (
    plC,            // C linkage - no mangling (language default, ordinal 0)
    plCPP           // Itanium C++ ABI mangling (cpplink)
  );

  { TMyrOpKind }
  TMyrOpKind = (
    // Arithmetic
    opAdd,
    opSub,
    opMul,
    opIntDiv,
    opMod,
    // Unsigned division and remainder. Distinct kinds, not a flag: the
    // expression factory receives only an op kind and two operand indices,
    // so signedness cannot be recovered downstream and must be chosen here.
    opUIntDiv,
    opUMod,
    opNeg,
    // Bitwise
    opBitAnd,
    opBitOr,
    opBitXor,
    opBitNot,
    // Shift
    opShiftL,
    opShiftR,
    // Comparison
    opEq,
    opNe,
    opLt,
    opLe,
    opGt,
    opGe,
    // Unsigned comparison - same bit patterns, unsigned ordering.
    // No unsigned equality: opEq/opNe are sign-agnostic.
    opULt,
    opULe,
    opUGt,
    opUGe,
    // Logical
    opLogAnd,
    opLogOr,
    opLogNot
  );

  { TMyrOperandKind }
  TMyrOperandKind = (
    okNone,
    okImmediate,
    okData,
    okGlobal,
    okImport,
    okLocal,
    okTemp,
    okFunc
  );

  { TMyrInstrKind }
  TMyrInstrKind = (
    ikNop,
    ikCall,
    ikCallImport,
    ikCallIndirect,
    ikReturn,
    ikReturnValue,
    ikStore,
    ikLoad,
    ikStorePtr,
    ikLoadPtr,
    ikAddressOf,
    ikBlockCopy,     // mem[Op1] := mem[Op2] for CopySize bytes (REP MOVSB)
    ikAdd,
    ikSub,
    ikMul,
    ikDiv,
    ikMod,
    ikUDiv,          // Unsigned: Dest = Op1 div Op2  (XOR RDX,RDX + DIV)
    ikUMod,          // Unsigned: Dest = Op1 mod Op2  (XOR RDX,RDX + DIV, rem in RDX)
    ikFAdd,          // Float: Dest = Op1 + Op2  (ADDSD)
    ikFSub,          // Float: Dest = Op1 - Op2  (SUBSD)
    ikFMul,          // Float: Dest = Op1 * Op2  (MULSD)
    ikFDiv,          // Float: Dest = Op1 / Op2  (DIVSD)
    ikFNeg,          // Float: Dest = -Op1       (0.0 - Op1)
    ikIntToFloat,    // Dest = float64(Op1)     (CVTSI2SD)
    ikFloatToInt,    // Dest = int64(Op1)       (CVTTSD2SI)
    ikUIntToFloat,   // Dest = float64(uint64 Op1)  (CVTSI2SD + >=2^63 fixup)
    ikFloatToUInt,   // Dest = uint64(Op1)      (CVTTSD2SI + >=2^63 fixup)
    ikFloat32ToFloat64, // Dest = float64(Op1)  (CVTSS2SD)
    ikBitAnd,
    ikBitOr,
    ikBitXor,
    ikBitNot,
    ikShl,
    ikShr,
    ikCmpEq,
    ikCmpNe,
    ikCmpLt,
    ikCmpLe,
    ikCmpGt,
    ikCmpGe,
    ikUCmpLt,        // Unsigned: Dest = Op1 < Op2   (SETB)
    ikUCmpLe,        // Unsigned: Dest = Op1 <= Op2  (SETBE)
    ikUCmpGt,        // Unsigned: Dest = Op1 > Op2   (SETA)
    ikUCmpGe,        // Unsigned: Dest = Op1 >= Op2  (SETAE)
    ikFCmpEq,        // Float: Dest = Op1 = Op2   (UCOMISD)
    ikFCmpNe,        // Float: Dest = Op1 <> Op2  (UCOMISD)
    ikFCmpLt,        // Float: Dest = Op1 < Op2   (UCOMISD)
    ikFCmpLe,        // Float: Dest = Op1 <= Op2  (UCOMISD)
    ikFCmpGt,        // Float: Dest = Op1 > Op2   (UCOMISD)
    ikFCmpGe,        // Float: Dest = Op1 >= Op2  (UCOMISD)
    ikJump,
    ikJumpIf,
    ikJumpIfNot,
    ikVaCount,       // dest := VaCount()
    ikVaArgAt,       // dest := VaArgAt(index, type)
    ikSyscall,       // dest := syscall(number, args...) - Linux x86_64
    ikLabel
  );

