procedure TMyrLinker.AddHostSymbol(const AName: string; const AKind: TMyrLinkerSectionKind;
  const AOffset: Cardinal);
var
  LResolved: TDictionary<string, TMyrLinkerResolvedSymbol>;
  LSym: TMyrLinkerResolvedSymbol;
begin
  LResolved := GetResolvedSymbols();
  if LResolved = nil then
    Exit;

  // A definition from a linked object takes precedence over the host's
  if LResolved.ContainsKey(AName) then
    Exit;

  LSym := Default(TMyrLinkerResolvedSymbol);
  LSym.SymbolName := AName;
  LSym.SectionKind := AKind;
  LSym.OffsetInMerged := AOffset;
  LResolved.Add(AName, LSym);
end;

