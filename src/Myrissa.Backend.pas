end;

function TMyrSSAFunc.NewVersion(const ABaseName: string): TMyrSSAVar;
var
  LVersion: Integer;
begin
  if not FNextVarVersion.TryGetValue(ABaseName, LVersion) then
    LVersion := 0;
    
  Result := TMyrSSAVar.Create(ABaseName, LVersion);
  FNextVarVersion.AddOrSetValue(ABaseName, LVersion + 1);
end;

function TMyrSSAFunc.CurrentVersion(const ABaseName: string): TMyrSSAVar;
var
  LVersion: Integer;
begin
  if FNextVarVersion.TryGetValue(ABaseName, LVersion) then
  begin
    if LVersion > 0 then
      Result := TMyrSSAVar.Create(ABaseName, LVersion - 1)
    else
      Result := TMyrSSAVar.None();
  end
  else
    Result := TMyrSSAVar.None();
end;

