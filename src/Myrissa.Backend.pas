  Assert(GCbrActiveExprOwner <> nil, 'Inv(): No active Cobra context');
  LIR := TMyrIR(GCbrActiveExprOwner);

  // Convert TMyrExpr args → TMyrIRExpr args
  SetLength(LIRArgs, Length(AArgs));
  for LI := 0 to System.High(AArgs) do
    LIRArgs[LI].Index := AArgs[LI].Index;

  LIRExpr := LIR.Invoke(AFuncName, LIRArgs);

  Result.Index := LIRExpr.Index;
  Result.Owner := GCbrActiveExprOwner;
end;

function ExprFactory_Binary(const AOwner: Pointer; const AOp: TMyrOpKind;
  const ALeft, ARight: Integer): TMyrExpr;
var
  LIR: TMyrIR;
  LNode: TMyrIR.TMyrIRExprNode;
  LIROp: TMyrIR.TMyrIROpKind;
begin
  LIR := TMyrIR(AOwner);
  LNode := Default(TMyrIR.TMyrIRExprNode);
  LNode.Kind := TMyrIR.TMyrIRExprKind.ekBinary;
  LNode.Left := ALeft;
  LNode.Right := ARight;

  // Map TMyrOpKind → TMyrIROpKind
  case AOp of
    TMyrOpKind.opAdd:    LIROp := TMyrIR.TMyrIROpKind.opAdd;
    TMyrOpKind.opSub:    LIROp := TMyrIR.TMyrIROpKind.opSub;
    TMyrOpKind.opMul:    LIROp := TMyrIR.TMyrIROpKind.opMul;
    TMyrOpKind.opIntDiv: LIROp := TMyrIR.TMyrIROpKind.opDiv;
    TMyrOpKind.opMod:    LIROp := TMyrIR.TMyrIROpKind.opMod;
    TMyrOpKind.opUIntDiv: LIROp := TMyrIR.TMyrIROpKind.opUDiv;
    TMyrOpKind.opUMod:    LIROp := TMyrIR.TMyrIROpKind.opUMod;
    TMyrOpKind.opBitAnd: LIROp := TMyrIR.TMyrIROpKind.opBitAnd;
    TMyrOpKind.opBitOr:  LIROp := TMyrIR.TMyrIROpKind.opBitOr;
    TMyrOpKind.opBitXor: LIROp := TMyrIR.TMyrIROpKind.opBitXor;
    TMyrOpKind.opShiftL: LIROp := TMyrIR.TMyrIROpKind.opShl;
    TMyrOpKind.opShiftR: LIROp := TMyrIR.TMyrIROpKind.opShr;
    TMyrOpKind.opEq:     LIROp := TMyrIR.TMyrIROpKind.opCmpEq;
    TMyrOpKind.opNe:     LIROp := TMyrIR.TMyrIROpKind.opCmpNe;
    TMyrOpKind.opLt:     LIROp := TMyrIR.TMyrIROpKind.opCmpLt;
    TMyrOpKind.opLe:     LIROp := TMyrIR.TMyrIROpKind.opCmpLe;
    TMyrOpKind.opGt:     LIROp := TMyrIR.TMyrIROpKind.opCmpGt;
    TMyrOpKind.opGe:     LIROp := TMyrIR.TMyrIROpKind.opCmpGe;
    TMyrOpKind.opULt:    LIROp := TMyrIR.TMyrIROpKind.opUCmpLt;
    TMyrOpKind.opULe:    LIROp := TMyrIR.TMyrIROpKind.opUCmpLe;
    TMyrOpKind.opUGt:    LIROp := TMyrIR.TMyrIROpKind.opUCmpGt;
    TMyrOpKind.opUGe:    LIROp := TMyrIR.TMyrIROpKind.opUCmpGe;
    TMyrOpKind.opLogAnd: LIROp := TMyrIR.TMyrIROpKind.opAnd;
    TMyrOpKind.opLogOr:  LIROp := TMyrIR.TMyrIROpKind.opOr;
  else
    LIROp := TMyrIR.TMyrIROpKind.opNone;
  end;
  LNode.Op := LIROp;

  Result.Index := LIR.FExpressions.Count;
  Result.Owner := AOwner;
  LIR.FExpressions.Add(LNode);
end;

function ExprFactory_Unary(const AOwner: Pointer; const AOp: TMyrOpKind;
  const AOperand: Integer): TMyrExpr;
var
  LIR: TMyrIR;
  LNode: TMyrIR.TMyrIRExprNode;
  LIROp: TMyrIR.TMyrIROpKind;
begin
  LIR := TMyrIR(AOwner);
  LNode := Default(TMyrIR.TMyrIRExprNode);
  LNode.Kind := TMyrIR.TMyrIRExprKind.ekUnary;
  LNode.Left := AOperand;
  LNode.Right := -1;

  case AOp of
    TMyrOpKind.opNeg:    LIROp := TMyrIR.TMyrIROpKind.opNeg;
    TMyrOpKind.opBitNot: LIROp := TMyrIR.TMyrIROpKind.opBitNot;
    TMyrOpKind.opLogNot: LIROp := TMyrIR.TMyrIROpKind.opNot;
  else
    LIROp := TMyrIR.TMyrIROpKind.opNone;
  end;
  LNode.Op := LIROp;

  Result.Index := LIR.FExpressions.Count;
  Result.Owner := AOwner;
  LIR.FExpressions.Add(LNode);
end;

