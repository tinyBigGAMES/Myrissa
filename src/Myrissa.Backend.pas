function TMyrIR.SetLit(const ATypeName: string; const AElements: array of Integer): TMyrIRExpr;
var
  LTypeIndex: Integer;
  LEntry: TMyrIRTypeEntry;
  LNode: TMyrIRExprNode;
  LI: Integer;
begin
  Result := TMyrIRExpr.None();

  // Find the set type
  LTypeIndex := FindType(ATypeName);
  if LTypeIndex < 0 then
  begin
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_IR_UNKNOWN_TYPE, RSIRUnknownSetType, [ATypeName]);
    Exit;
  end;

  LEntry := FTypes[LTypeIndex];
  if LEntry.Kind <> tkSet then
  begin
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_IR_TYPE_BUILD, RSIRTypeNotSet, [ATypeName]);
    Exit;
  end;

  LNode := Default(TMyrIRExprNode);
  LNode.Kind := ekSetLiteral;
  LNode.ResultType := TMyrTypeRef.FromComposite(LTypeIndex);
  LNode.SetTypeIndex := LTypeIndex;

  // Store elements (they will be adjusted by LowBound during code generation)
  SetLength(LNode.SetElements, Length(AElements));
  for LI := 0 to System.High(AElements) do
    LNode.SetElements[LI] := AElements[LI];

  Result := AddExpr(LNode);
end;

function TMyrIR.SetLitRange(const ATypeName: string; const ALow: Integer; const AHigh: Integer): TMyrIRExpr;
var
  LTypeIndex: Integer;
  LEntry: TMyrIRTypeEntry;
  LNode: TMyrIRExprNode;
  LI: Integer;
  LCount: Integer;
begin
  Result := TMyrIRExpr.None();

  // Find the set type
  LTypeIndex := FindType(ATypeName);
  if LTypeIndex < 0 then
  begin
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_IR_UNKNOWN_TYPE, RSIRUnknownSetType, [ATypeName]);
    Exit;
  end;

  LEntry := FTypes[LTypeIndex];
  if LEntry.Kind <> tkSet then
  begin
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_IR_TYPE_BUILD, RSIRTypeNotSet, [ATypeName]);
    Exit;
  end;

  // Validate range
  if AHigh < ALow then
  begin
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_IR_TYPE_BUILD, RSIRInvalidSetRange, [ALow, AHigh]);
    Exit;
  end;

  LNode := Default(TMyrIRExprNode);
  LNode.Kind := ekSetLiteral;
  LNode.ResultType := TMyrTypeRef.FromComposite(LTypeIndex);
  LNode.SetTypeIndex := LTypeIndex;

  // Expand range into individual elements
  LCount := AHigh - ALow + 1;
  SetLength(LNode.SetElements, LCount);
  for LI := 0 to LCount - 1 do
    LNode.SetElements[LI] := ALow + LI;

  Result := AddExpr(LNode);
end;

