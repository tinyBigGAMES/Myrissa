function TMyrCodeBuilder.Call(const AImport: TMyrImportHandle; const AArgs: array of TMyrOperand): TMyrCodeBuilder;
var
  LInstr: TMyrInstruction;
  LI: Integer;
begin
  LInstr := Default(TMyrInstruction);
  LInstr.Kind := ikCallImport;
  LInstr.ImportTarget := AImport;
  LInstr.Dest := TMyrTempHandle.Invalid();

  SetLength(LInstr.Args, Length(AArgs));
