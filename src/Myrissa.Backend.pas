{ TMyrIRExpr }
class function TMyrIRExpr.None(): TMyrIRExpr;
begin
  Result.Index := -1;
end;

function TMyrIRExpr.IsValid(): Boolean;
begin
  Result := Index >= 0;
end;

class operator TMyrIRExpr.Implicit(const AValue: Integer): TMyrIRExpr;
begin
  // This creates a placeholder - actual conversion happens in context
  Result.Index := -AValue - 1000000;  // Encode as negative with offset
end;

class operator TMyrIRExpr.Implicit(const AValue: Int64): TMyrIRExpr;
begin
  Result.Index := -Integer(AValue) - 1000000;
end;

class operator TMyrIRExpr.Implicit(const AValue: Double): TMyrIRExpr;
begin
  // For doubles, we can't encode directly - user should use Float64()
  Result.Index := -1;
end;

{ TMyrTypeRef }
class function TMyrTypeRef.FromPrimitive(const AType: TMyrValueType): TMyrTypeRef;
begin
  Result := Default(TMyrTypeRef);
  Result.IsPrimitive := True;
  Result.Primitive := AType;
  Result.TypeIndex := -1;
end;

class function TMyrTypeRef.FromComposite(const AIndex: Integer): TMyrTypeRef;
begin
  Result := Default(TMyrTypeRef);
  Result.IsPrimitive := False;
  Result.Primitive := cvtVoid;
  Result.TypeIndex := AIndex;
end;

class function TMyrTypeRef.None(): TMyrTypeRef;
begin
  Result := Default(TMyrTypeRef);
  Result.IsPrimitive := True;
  Result.Primitive := cvtVoid;
  Result.TypeIndex := -1;
end;

function TMyrTypeRef.IsValid(): Boolean;
begin
  if IsPrimitive then
    Result := Primitive <> cvtVoid
  else
    Result := TypeIndex >= 0;
end;

function TMyrTypeRef.ToString(): string;
const
  CPrimitiveNames: array[TMyrValueType] of string = (
    'void', 'bool', 'int8', 'int16', 'int32', 'int64',
    'uint8', 'uint16', 'uint32', 'uint64',
    'float32', 'float64', 'pointer'
  );
begin
  if IsPrimitive then
    Result := CPrimitiveNames[Primitive]
  else
    Result := Format('type#%d', [TypeIndex]);
end;

class operator TMyrTypeRef.Equal(const A: TMyrTypeRef; const B: TMyrTypeRef): Boolean;
begin
  if A.IsPrimitive <> B.IsPrimitive then
    Exit(False);
  if A.IsPrimitive then
    Result := A.Primitive = B.Primitive
  else
    Result := A.TypeIndex = B.TypeIndex;
end;

class operator TMyrTypeRef.NotEqual(const A: TMyrTypeRef; const B: TMyrTypeRef): Boolean;
begin
  Result := not (A = B);
end;

constructor TMyrIR.Create();
begin
  inherited Create();

  FImports := TList<TMyrIRImport>.Create();
  FStrings := TList<TMyrIRString>.Create();
  FGlobals := TList<TMyrIRGlobal>.Create();
  FFunctions := TList<TMyrIRFunc>.Create();
  FExpressions := TList<TMyrIRExprNode>.Create();
  FTypes := TList<TMyrIRTypeEntry>.Create();
  FCurrentFunc := -1;
  FSnapshotFuncs := -1;
  FSnapshotImports := -1;
  FSnapshotStrings := -1;
  FSnapshotGlobals := -1;
  FSnapshotExprs := -1;
  FBuildingRecordIndex := -1;
  FSkipBuildingRecord := False;
  FBuildingUnionIndex := -1;
  FBuildingEnumIndex := -1;
  FNextEnumOrdinal := 0;
  FNextOverlayGroup := 0;
  FAnonUnionFieldStart := -1;
  FNextAnonRecordGroup := 0;
  FAnonRecordInUnion := False;
  FBuildingRoutineIndex := -1;

  // Wire TMyrExpr operator overloads into this IR's expression graph
  TMyrExprFactory.OnBinary   := ExprFactory_Binary;
  TMyrExprFactory.OnUnary    := ExprFactory_Unary;
  TMyrExprFactory.OnFromInt  := ExprFactory_FromInt;
  TMyrExprFactory.OnFromFlt  := ExprFactory_FromFlt;
  TMyrExprFactory.OnFromBool := ExprFactory_FromBool;
  TMyrExprFactory.OnField    := ExprFactory_Field;
  TMyrExprFactory.OnIndex    := ExprFactory_Index;

  // Set thread-local context for implicit TMyrExpr conversions
  GCbrActiveExprOwner := Self;
end;

destructor TMyrIR.Destroy();
var
  LI: Integer;
begin
  for LI := 0 to FFunctions.Count - 1 do
  begin
    FFunctions[LI].Vars.Free();
    FFunctions[LI].Stmts.Free();
  end;

  FTypes.Free();
  FExpressions.Free();
  FFunctions.Free();
  FGlobals.Free();
  FStrings.Free();
  FImports.Free();

  inherited Destroy();
end;

function TMyrIR.GetCurrentFunc(const AContext: string): TMyrIRFunc;
begin
  if (FCurrentFunc < 0) or (FCurrentFunc >= FFunctions.Count) then
  begin
    GetErrors().Add(TErrorSeverity.esFatal, MYR_ERR_IR_NO_ACTIVE_FUNCTION,
      RSIRNoActiveFunction);
  end;

  Result := FFunctions[FCurrentFunc];
end;

function TMyrIR.AddExpr(const ANode: TMyrIRExprNode): TMyrIRExpr;
var
  LNode: TMyrIRExprNode;
begin
  LNode := ANode;
  LNode.SourceFile := FCurrentSourceFile;
  LNode.SourceLine := FCurrentSourceLine;
  LNode.SourceCol := FCurrentSourceColumn;
  Result.Index := FExpressions.Count;
  FExpressions.Add(LNode);
end;

function TMyrIR.DoResolveCallResultType(const AFuncName: string): TMyrTypeRef;
var
  LIndex: Integer;
begin
  // A defined function carries its return type directly. ReturnTypeRef is
  // populated for primitives and composites alike (see Func/Returns), so it
  // is the single source and needs no fallback to ReturnType.
  LIndex := FindLocalFunc(AFuncName);
  if LIndex >= 0 then
    Exit(FFunctions[LIndex].ReturnTypeRef);

  // Not defined here, so it is an extern/import. The scalar ReturnType is the
  // storage class; when the declaring side recorded the composite identity
  // (SetImportReturnType), that is the answer.
  LIndex := FindImport(AFuncName);
  if LIndex >= 0 then
  begin
    if FImports[LIndex].HasReturnTypeRef then
      Exit(FImports[LIndex].ReturnTypeRef);
    Exit(TMyrTypeRef.FromPrimitive(FImports[LIndex].ReturnType));
  end;

  // Neither resolves - unknown stays unknown.
  Result := TMyrTypeRef.None();
end;

function TMyrIR.DoResolveIndirectResultType(const AFuncPtr: Integer): TMyrTypeRef;
var
  LPtrType: TMyrTypeRef;
  LTypeEntry: TMyrIRTypeEntry;
begin
  if (AFuncPtr < 0) or (AFuncPtr >= FExpressions.Count) then
    Exit(TMyrTypeRef.None());

  LPtrType := FExpressions[AFuncPtr].ResultType;

  // The return type is only recoverable when the pointer expression carries a
  // composite ROUTINE type. A plain cvtPointer - which is what FuncAddr
  // produces - describes the storage, not the signature, so it cannot answer.
  if (not LPtrType.IsPrimitive) and (LPtrType.TypeIndex >= 0) and
     (LPtrType.TypeIndex < FTypes.Count) then
  begin
    LTypeEntry := FTypes[LPtrType.TypeIndex];
    if LTypeEntry.Kind = tkRoutine then
      Exit(LTypeEntry.RoutineType.ReturnType);
  end;

  Result := TMyrTypeRef.None();
end;

function TMyrIR.DoPrimitiveIntWidth(const AType: TMyrValueType): Integer;
begin
  // Width in bits, or 0 for anything that is not an integer. cvtBoolean is
  // deliberately NOT an integer here - it must not win a promotion.
  case AType of
    cvtInt8,  cvtUInt8:  Result := 8;
    cvtInt16, cvtUInt16: Result := 16;
    cvtInt32, cvtUInt32: Result := 32;
    cvtInt64, cvtUInt64: Result := 64;
  else
    Result := 0;
  end;
end;

function TMyrIR.DoPromoteNumericTypes(const ALeft, ARight: TMyrTypeRef): TMyrTypeRef;
var
  LLeftWidth: Integer;
  LRightWidth: Integer;
  LLeftUnsigned: Boolean;
  LRightUnsigned: Boolean;
begin
  // An unknown operand poisons the result. Defaulting to int64 here would
  // turn a silent no-op into a silent corruption.
  if (not ALeft.IsPrimitive) or (not ARight.IsPrimitive) then
    Exit(TMyrTypeRef.None());

  // 1 - float64 dominates everything.
  if (ALeft.Primitive = cvtFloat64) or (ARight.Primitive = cvtFloat64) then
    Exit(TMyrTypeRef.FromPrimitive(cvtFloat64));

  // 2 - float32, only when no float64 is present.
  if (ALeft.Primitive = cvtFloat32) or (ARight.Primitive = cvtFloat32) then
    Exit(TMyrTypeRef.FromPrimitive(cvtFloat32));

  LLeftWidth := DoPrimitiveIntWidth(ALeft.Primitive);
  LRightWidth := DoPrimitiveIntWidth(ARight.Primitive);

  // 3 - both integer: the wider wins; on a tie, unsigned wins.
  if (LLeftWidth > 0) and (LRightWidth > 0) then
  begin
    if LLeftWidth > LRightWidth then
      Exit(ALeft);
    if LRightWidth > LLeftWidth then
      Exit(ARight);

    LLeftUnsigned := ALeft.Primitive in [cvtUInt8, cvtUInt16, cvtUInt32, cvtUInt64];
    LRightUnsigned := ARight.Primitive in [cvtUInt8, cvtUInt16, cvtUInt32, cvtUInt64];
    if LLeftUnsigned then
      Exit(ALeft);
    if LRightUnsigned then
      Exit(ARight);
    Exit(ALeft);
  end;

  // 4 - pointer arithmetic. Reached only when rule 3 declined, so this is
  // pointer combined with an integer or with another pointer.
  if (ALeft.Primitive = cvtPointer) or (ARight.Primitive = cvtPointer) then
    Exit(TMyrTypeRef.FromPrimitive(cvtPointer));

  // 5 - anything else stays unknown.
  Result := TMyrTypeRef.None();
end;

function TMyrIR.DoResolveBinaryResultType(const AOp: TMyrIROpKind; const ALeft, ARight: Integer): TMyrTypeRef;
var
  LLeftType: TMyrTypeRef;
  LRightType: TMyrTypeRef;
begin
  // Comparisons and logical connectives yield a boolean whatever they consume,
  // so they resolve without an operand lookup.
  case AOp of
    TMyrIROpKind.opCmpEq, TMyrIROpKind.opCmpNe, TMyrIROpKind.opCmpLt, TMyrIROpKind.opCmpLe, TMyrIROpKind.opCmpGt, TMyrIROpKind.opCmpGe,
    TMyrIROpKind.opUCmpLt, TMyrIROpKind.opUCmpLe, TMyrIROpKind.opUCmpGt, TMyrIROpKind.opUCmpGe,
    TMyrIROpKind.opFCmpEq, TMyrIROpKind.opFCmpNe, TMyrIROpKind.opFCmpLt, TMyrIROpKind.opFCmpLe, TMyrIROpKind.opFCmpGt, TMyrIROpKind.opFCmpGe,
    TMyrIROpKind.opAnd, TMyrIROpKind.opOr:
      Exit(TMyrTypeRef.FromPrimitive(cvtBoolean));

    // Float arithmetic is float64 by construction - the float opcodes are
    // only selected once both operands have been widened.
    TMyrIROpKind.opFAdd, TMyrIROpKind.opFSub, TMyrIROpKind.opFMul, TMyrIROpKind.opFDiv:
      Exit(TMyrTypeRef.FromPrimitive(cvtFloat64));
  end;

  if (ALeft < 0) or (ALeft >= FExpressions.Count) then
    Exit(TMyrTypeRef.None());
  LLeftType := FExpressions[ALeft].ResultType;

  // Shifts take their type from the LEFT operand alone. The count does not
  // participate, so it is resolved before the right operand is even read.
  if AOp in [TMyrIROpKind.opShl, TMyrIROpKind.opShr] then
    Exit(LLeftType);

  if (ARight < 0) or (ARight >= FExpressions.Count) then
    Exit(TMyrTypeRef.None());
  LRightType := FExpressions[ARight].ResultType;

  case AOp of
    TMyrIROpKind.opAdd, TMyrIROpKind.opSub, TMyrIROpKind.opMul, TMyrIROpKind.opDiv, TMyrIROpKind.opMod, TMyrIROpKind.opUDiv, TMyrIROpKind.opUMod,
    TMyrIROpKind.opBitAnd, TMyrIROpKind.opBitOr, TMyrIROpKind.opBitXor:
      Exit(DoPromoteNumericTypes(LLeftType, LRightType));
  end;

  // Set operations are not in the lattice and stay unknown, exactly as they
  // are today. Typing them is a separate decision, not an improvisation here.
  Result := TMyrTypeRef.None();
end;

function TMyrIR.MakeBinaryExpr(const ALeft, ARight: TMyrIRExpr; const AOp: TMyrIROpKind): TMyrIRExpr;
var
  LNode: TMyrIRExprNode;
begin
  LNode := Default(TMyrIRExprNode);
  LNode.Kind := ekBinary;
  LNode.Op := AOp;
  LNode.Left := ALeft.Index;
  LNode.Right := ARight.Index;
  LNode.ResultType := DoResolveBinaryResultType(AOp, ALeft.Index, ARight.Index);
  Result := AddExpr(LNode);
end;

function TMyrIR.DoResolveUnaryResultType(const AOp: TMyrIROpKind; const AOperand: Integer): TMyrTypeRef;
var
  LOperandType: TMyrTypeRef;
  LTypeEntry: TMyrIRTypeEntry;
begin
  // Conversions and logical negation are fixed by the OP alone - the operand
  // does not participate, so these resolve without a lookup.
  case AOp of
    TMyrIROpKind.opIntToFloat,
    TMyrIROpKind.opUIntToFloat,
    TMyrIROpKind.opFloat32ToFloat64:
      Exit(TMyrTypeRef.FromPrimitive(cvtFloat64));

    TMyrIROpKind.opFloatToInt:
      Exit(TMyrTypeRef.FromPrimitive(cvtInt64));

    TMyrIROpKind.opFloatToUInt:
      Exit(TMyrTypeRef.FromPrimitive(cvtUInt64));

    TMyrIROpKind.opNot:
      Exit(TMyrTypeRef.FromPrimitive(cvtBoolean));
  end;

  // Everything below derives from the operand, so it must be resolvable.
  if (AOperand < 0) or (AOperand >= FExpressions.Count) then
    Exit(TMyrTypeRef.None());

  LOperandType := FExpressions[AOperand].ResultType;

  case AOp of
    // Sign flip and bitwise complement are width- and signedness-preserving.
    TMyrIROpKind.opNeg,
    TMyrIROpKind.opFNeg,
    TMyrIROpKind.opBitNot:
      Exit(LOperandType);

    TMyrIROpKind.opDeref:
      begin
        // The pointee is only recoverable from a composite pointer entry. An
        // untyped pointer carries no target type and stays unknown.
        if (not LOperandType.IsPrimitive) and (LOperandType.TypeIndex >= 0) and
           (LOperandType.TypeIndex < FTypes.Count) then
        begin
          LTypeEntry := FTypes[LOperandType.TypeIndex];
          if LTypeEntry.Kind = tkPointer then
            Exit(LTypeEntry.PointerType.PointeeType);
        end;
        Exit(TMyrTypeRef.None());
      end;
  end;

  // Not in the lattice. Unknown must stay unknown - a confidently wrong type
  // converts a silent no-op into a silent corruption.
  Result := TMyrTypeRef.None();
end;

function TMyrIR.MakeUnaryExpr(const AValue: TMyrIRExpr; const AOp: TMyrIROpKind): TMyrIRExpr;
var
  LNode: TMyrIRExprNode;
begin
  LNode := Default(TMyrIRExprNode);
  LNode.Kind := ekUnary;
  LNode.Op := AOp;
  LNode.Left := AValue.Index;
  LNode.Right := -1;
  LNode.ResultType := DoResolveUnaryResultType(AOp, AValue.Index);
  Result := AddExpr(LNode);
end;

function TMyrIR.FindGlobal(const AName: string): Integer;
var
  LI: Integer;
begin
  for LI := 0 to FGlobals.Count - 1 do
  begin
    // Myrissa is CASE-SENSITIVE. SameText here made `foo` and `FOO` resolve to
    // whichever was declared first, silently orphaning the second global.
    if FGlobals[LI].GlobalName = AName then
      Exit(LI);
  end;
  Result := -1;
end;

function TMyrIR.FindImport(const AName: string): Integer;
var
  LI: Integer;
begin
  for LI := 0 to FImports.Count - 1 do
  begin
    if (FImports[LI].FuncName = AName) then
      Exit(LI);
  end;
  Result := -1;
end;

function TMyrIR.FindLocalFunc(const AName: string): Integer;
var
  LI: Integer;
begin
  for LI := 0 to FFunctions.Count - 1 do
  begin
    if (FFunctions[LI].FuncName = AName) then
      Exit(LI);
  end;
  Result := -1;
end;

function TMyrIR.GetPrimitiveSize(const AType: TMyrValueType): Integer;
begin
  case AType of
    cvtVoid:    Result := 0;
    cvtInt8:    Result := 1;
    cvtInt16:   Result := 2;
    cvtInt32:   Result := 4;
    cvtInt64:   Result := 8;
    cvtUInt8:   Result := 1;
    cvtUInt16:  Result := 2;
    cvtUInt32:  Result := 4;
    cvtUInt64:  Result := 8;
    cvtFloat32: Result := 4;
    cvtFloat64: Result := 8;
    cvtPointer: Result := 8;
  else
    Result := 8;
  end;
end;

function TMyrIR.BitField(const AName: string; const AType: TMyrValueType; const ABitWidth: Integer): TMyrIR;
var
  LEntry: TMyrIRTypeEntry;
  LField: TMyrIRRecordField;
  LLen: Integer;
  LTypeSize: Integer;
begin
  Result := Self;

  // BitField only valid in records
  if FBuildingRecordIndex < 0 then
  begin
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_IR_TYPE_BUILD, RSIRBitFieldNoRecord);
    Exit;
  end;

  // Validate bit width
  LTypeSize := GetPrimitiveSize(AType) * 8;  // Size in bits
  if (ABitWidth < 1) or (ABitWidth > LTypeSize) then
  begin
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_IR_TYPE_BUILD, RSIRBitFieldWidth, [LTypeSize]);
    Exit;
  end;

  LField := Default(TMyrIRRecordField);
  LField.FieldName := AName;
  LField.FieldType := TMyrTypeRef.FromPrimitive(AType);
  LField.FieldOffset := -1;  // Computed during finalization
  LField.BitWidth := ABitWidth;
  LField.BitOffset := -1;  // Computed during finalization
  LField.OverlayGroup := 0;
  LField.AnonRecordGroup := 0;

  // If inside anonymous union, mark as overlay
  if FAnonUnionFieldStart >= 0 then
    LField.OverlayGroup := FNextOverlayGroup;

  LEntry := FTypes[FBuildingRecordIndex];
  LLen := Length(LEntry.RecordType.Fields);
  SetLength(LEntry.RecordType.Fields, LLen + 1);
  LEntry.RecordType.Fields[LLen] := LField;
  FTypes[FBuildingRecordIndex] := LEntry;
end;

function TMyrIR.GetPrimitiveAlignment(const AType: TMyrValueType): Integer;
begin
  // On x64, alignment equals size for primitives (up to 8)
  Result := GetPrimitiveSize(AType);
  if Result > 8 then
    Result := 8;
end;

procedure TMyrIR.FinalizeRecordLayout(const ATypeIndex: Integer);
var
  LEntry: TMyrIRTypeEntry;
  LBaseEntry: TMyrIRTypeEntry;
  LI: Integer;
  LOffset: Integer;
  LFieldSize: Integer;
  LFieldAlign: Integer;
  LMaxAlign: Integer;
  LCurrentOverlay: Integer;
  LOverlayStart: Integer;
  LOverlayMaxSize: Integer;
  // Bit field tracking
  LBitPos: Integer;           // Current bit position within storage unit
  LBitStorageSize: Integer;   // Size of current bit storage unit in bits
  LBitStorageOffset: Integer; // Byte offset of current bit storage unit
begin
  if (ATypeIndex < 0) or (ATypeIndex >= FTypes.Count) then
    Exit;

  LEntry := FTypes[ATypeIndex];
  if LEntry.Kind <> tkRecord then
    Exit;
  if LEntry.RecordType.IsFinalized then
    Exit;

  LOffset := 0;
  LMaxAlign := 1;
  LCurrentOverlay := 0;
  LOverlayStart := 0;
  LOverlayMaxSize := 0;
  LBitPos := 0;
  LBitStorageSize := 0;
  LBitStorageOffset := -1;

  // Handle base type inheritance
  if LEntry.RecordType.BaseTypeIndex >= 0 then
  begin
    // Ensure base is finalized first
    if not FTypes[LEntry.RecordType.BaseTypeIndex].RecordType.IsFinalized then
      FinalizeRecordLayout(LEntry.RecordType.BaseTypeIndex);

    // Get base info (re-read in case it was just finalized)
    LBaseEntry := FTypes[LEntry.RecordType.BaseTypeIndex];

    // Derived starts at base size (properly aligned)
    LOffset := LBaseEntry.RecordType.TotalSize;
    LMaxAlign := LBaseEntry.RecordType.Alignment;
  end;

  // Apply explicit alignment if specified
  if LEntry.RecordType.ExplicitAlign > 0 then
  begin
    if LEntry.RecordType.ExplicitAlign > LMaxAlign then
      LMaxAlign := LEntry.RecordType.ExplicitAlign;
  end;

  for LI := 0 to Length(LEntry.RecordType.Fields) - 1 do
  begin
    // Get field size and alignment
    LFieldSize := GetTypeSize(LEntry.RecordType.Fields[LI].FieldType);
    LFieldAlign := GetTypeAlignment(LEntry.RecordType.Fields[LI].FieldType);

    // Track max alignment
    if LFieldAlign > LMaxAlign then
      LMaxAlign := LFieldAlign;

    // Handle overlay groups (anonymous unions)
    if LEntry.RecordType.Fields[LI].OverlayGroup <> LCurrentOverlay then
    begin
      // Close current bit storage unit if any
      if LBitStorageSize > 0 then
      begin
        LOffset := LBitStorageOffset + (LBitStorageSize div 8);
        LBitStorageSize := 0;
        LBitPos := 0;
        LBitStorageOffset := -1;
      end;

      // Leaving previous overlay group - advance offset by max size
      if LCurrentOverlay > 0 then
        LOffset := LOverlayStart + LOverlayMaxSize;

      // Entering new overlay group
      LCurrentOverlay := LEntry.RecordType.Fields[LI].OverlayGroup;
      if LCurrentOverlay > 0 then
      begin
        // Align for new overlay group
        if not LEntry.RecordType.IsPacked then
        begin
          if (LOffset mod LFieldAlign) <> 0 then
            LOffset := LOffset + (LFieldAlign - (LOffset mod LFieldAlign));
        end;
        LOverlayStart := LOffset;
        LOverlayMaxSize := 0;
      end;
    end;

    // Check if this is a bit field
    if LEntry.RecordType.Fields[LI].BitWidth > 0 then
    begin
      // Bit field processing
      if (LBitStorageSize = 0) or
         (LBitPos + LEntry.RecordType.Fields[LI].BitWidth > LBitStorageSize) or
         (LBitStorageSize <> LFieldSize * 8) then
      begin
        // Need new storage unit: either no current unit, won't fit, or different size
        // Close previous bit storage unit
        if LBitStorageSize > 0 then
          LOffset := LBitStorageOffset + (LBitStorageSize div 8);

        // Align for new storage unit
        if not LEntry.RecordType.IsPacked then
        begin
          if (LOffset mod LFieldAlign) <> 0 then
            LOffset := LOffset + (LFieldAlign - (LOffset mod LFieldAlign));
        end;

        // Start new bit storage unit
        LBitStorageOffset := LOffset;
        LBitStorageSize := LFieldSize * 8;
        LBitPos := 0;
      end;

      // Place bit field
      LEntry.RecordType.Fields[LI].FieldOffset := LBitStorageOffset;
      LEntry.RecordType.Fields[LI].BitOffset := LBitPos;
      LBitPos := LBitPos + LEntry.RecordType.Fields[LI].BitWidth;

      // Track overlay size if in overlay
      if LCurrentOverlay > 0 then
      begin
        if LFieldSize > LOverlayMaxSize then
          LOverlayMaxSize := LFieldSize;
      end;
    end
    else if LCurrentOverlay > 0 then
    begin
      // Close current bit storage unit if any
      if LBitStorageSize > 0 then
      begin
        LOffset := LBitStorageOffset + (LBitStorageSize div 8);
        LBitStorageSize := 0;
        LBitPos := 0;
        LBitStorageOffset := -1;
      end;

      // Inside overlay group - all fields share the same start offset
      LEntry.RecordType.Fields[LI].FieldOffset := LOverlayStart;
      LEntry.RecordType.Fields[LI].BitOffset := 0;
      if LFieldSize > LOverlayMaxSize then
        LOverlayMaxSize := LFieldSize;
    end
    else
    begin
      // Close current bit storage unit if any
      if LBitStorageSize > 0 then
      begin
        LOffset := LBitStorageOffset + (LBitStorageSize div 8);
        LBitStorageSize := 0;
        LBitPos := 0;
        LBitStorageOffset := -1;
      end;

      // Normal field - align and advance
      if not LEntry.RecordType.IsPacked then
      begin
        if (LOffset mod LFieldAlign) <> 0 then
          LOffset := LOffset + (LFieldAlign - (LOffset mod LFieldAlign));
      end;

      LEntry.RecordType.Fields[LI].FieldOffset := LOffset;
      LEntry.RecordType.Fields[LI].BitOffset := 0;
      LOffset := LOffset + LFieldSize;
    end;
  end;

  // Close final bit storage unit if any
  if LBitStorageSize > 0 then
    LOffset := LBitStorageOffset + (LBitStorageSize div 8);

  // Close final overlay group if any
  if LCurrentOverlay > 0 then
    LOffset := LOverlayStart + LOverlayMaxSize;

  // Apply explicit alignment if specified
  if LEntry.RecordType.ExplicitAlign > 0 then
  begin
    if LEntry.RecordType.ExplicitAlign > LMaxAlign then
      LMaxAlign := LEntry.RecordType.ExplicitAlign;
  end;

  // Pad total size to alignment
  if not LEntry.RecordType.IsPacked then
  begin
    if (LOffset mod LMaxAlign) <> 0 then
      LOffset := LOffset + (LMaxAlign - (LOffset mod LMaxAlign));
  end;

  // Ensure alignment is at least explicit alignment
  if LEntry.RecordType.ExplicitAlign > LMaxAlign then
    LMaxAlign := LEntry.RecordType.ExplicitAlign;

  LEntry.RecordType.TotalSize := LOffset;
  LEntry.RecordType.Alignment := LMaxAlign;
  LEntry.RecordType.IsFinalized := True;

  FTypes[ATypeIndex] := LEntry;
end;

procedure TMyrIR.FinalizeUnionLayout(const ATypeIndex: Integer);
var
  LEntry: TMyrIRTypeEntry;
  LI: Integer;
  LFieldSize: Integer;
  LFieldAlign: Integer;
  LMaxSize: Integer;
  LMaxAlign: Integer;
  LCurrentGroup: Integer;
  LGroupOffset: Integer;
  LGroupSize: Integer;
begin
  if (ATypeIndex < 0) or (ATypeIndex >= FTypes.Count) then
    Exit;

  LEntry := FTypes[ATypeIndex];
  if LEntry.Kind <> tkUnion then
    Exit;
  if LEntry.UnionType.IsFinalized then
    Exit;

  LMaxSize := 0;
  LMaxAlign := 1;
  LCurrentGroup := 0;
  LGroupOffset := 0;
  LGroupSize := 0;

  for LI := 0 to Length(LEntry.UnionType.Fields) - 1 do
  begin
    // Get field size and alignment
    LFieldSize := GetTypeSize(LEntry.UnionType.Fields[LI].FieldType);
    LFieldAlign := GetTypeAlignment(LEntry.UnionType.Fields[LI].FieldType);

    // Track max alignment for union overall
    if LFieldAlign > LMaxAlign then
      LMaxAlign := LFieldAlign;

    // Handle anonymous record groups
    if LEntry.UnionType.Fields[LI].AnonRecordGroup <> LCurrentGroup then
    begin
      // Closing previous group - add its size to max
      if LCurrentGroup > 0 then
      begin
        if LGroupSize > LMaxSize then
          LMaxSize := LGroupSize;
      end;

      // Starting new group
      LCurrentGroup := LEntry.UnionType.Fields[LI].AnonRecordGroup;
      LGroupOffset := 0;
      LGroupSize := 0;
    end;

    if LCurrentGroup > 0 then
    begin
      // Inside anonymous record - sequential layout within group
      // Align within group
      if (LGroupOffset mod LFieldAlign) <> 0 then
        LGroupOffset := LGroupOffset + (LFieldAlign - (LGroupOffset mod LFieldAlign));

      LEntry.UnionType.Fields[LI].FieldOffset := LGroupOffset;
      LGroupOffset := LGroupOffset + LFieldSize;
      LGroupSize := LGroupOffset;  // Group size grows
    end
    else
    begin
      // Normal union field - offset 0
      LEntry.UnionType.Fields[LI].FieldOffset := 0;
      if LFieldSize > LMaxSize then
        LMaxSize := LFieldSize;
    end;
  end;

  // Close final group if any
  if LCurrentGroup > 0 then
  begin
    if LGroupSize > LMaxSize then
      LMaxSize := LGroupSize;
  end;

  // Pad total size to alignment
  if (LMaxSize mod LMaxAlign) <> 0 then
    LMaxSize := LMaxSize + (LMaxAlign - (LMaxSize mod LMaxAlign));

  LEntry.UnionType.TotalSize := LMaxSize;
  LEntry.UnionType.Alignment := LMaxAlign;
  LEntry.UnionType.IsFinalized := True;

  FTypes[ATypeIndex] := LEntry;
end;

function TMyrIR.FindVarType(const AVarName: string): TMyrTypeRef;
var
  LFunc: TMyrIRFunc;
  LI: Integer;
begin
  Result := TMyrTypeRef.None();

  // Search function locals first
  if FCurrentFunc >= 0 then
  begin
    LFunc := FFunctions[FCurrentFunc];
    for LI := 0 to LFunc.Vars.Count - 1 do
    begin
      if LFunc.Vars[LI].VarName = AVarName then
      begin
        Result := LFunc.Vars[LI].VarTypeRef;
        Exit;
      end;
    end;
  end;

  // Search globals if not found in locals
  for LI := 0 to FGlobals.Count - 1 do
  begin
    if FGlobals[LI].GlobalName = AVarName then
    begin
      Result := FGlobals[LI].GlobalTypeRef;
      Exit;
    end;
  end;

  // Search imports if not found in globals (for external variables)
  for LI := 0 to FImports.Count - 1 do
  begin
    if (FImports[LI].FuncName = AVarName) then
    begin
      Result := TMyrTypeRef.FromPrimitive(FImports[LI].ReturnType);
      Exit;
    end;
  end;
end;

function TMyrIR.DefineRecord(const AName: string; const AIsPacked: Boolean;
  const AExplicitAlign: Integer; const ABaseTypeName: string): TMyrIR;
var
  LEntry: TMyrIRTypeEntry;
  LBaseIndex: Integer;
begin
  Result := Self;

  // Skip if type already exists (idempotent)
  if FindType(AName) >= 0 then
  begin
    FSkipBuildingRecord := True;
    Exit;
  end;

  FSkipBuildingRecord := False;

  if FBuildingRecordIndex >= 0 then
  begin
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_IR_TYPE_BUILD, RSIRAlreadyBuildingRecord);
    Exit;
  end;

  // Resolve base type if specified
  LBaseIndex := -1;
  if ABaseTypeName <> '' then
  begin
    LBaseIndex := FindType(ABaseTypeName);
    if LBaseIndex < 0 then
    begin
      if Assigned(FErrors) then
        FErrors.Add(esError, MYR_ERR_IR_UNKNOWN_TYPE, RSIRUnknownBaseType, [ABaseTypeName]);
      Exit;
    end;
    // Verify base is a record
    if FTypes[LBaseIndex].Kind <> tkRecord then
    begin
      if Assigned(FErrors) then
        FErrors.Add(esError, MYR_ERR_IR_TYPE_BUILD, RSIRBaseNotRecord, [ABaseTypeName]);
      Exit;
    end;
  end;

  LEntry := Default(TMyrIRTypeEntry);
  LEntry.Kind := tkRecord;
  LEntry.RecordType.TypeName := AName;
  LEntry.RecordType.IsPacked := AIsPacked;
  LEntry.RecordType.ExplicitAlign := AExplicitAlign;
  LEntry.RecordType.BaseTypeIndex := LBaseIndex;
  LEntry.RecordType.IsFinalized := False;
  SetLength(LEntry.RecordType.Fields, 0);

  FBuildingRecordIndex := FTypes.Count;
  FTypes.Add(LEntry);
end;

function TMyrIR.Field(const AName: string; const AType: TMyrValueType): TMyrIR;
var
  LEntry: TMyrIRTypeEntry;
  LField: TMyrIRRecordField;
  LLen: Integer;
begin
  Result := Self;

  // Skip if DefineRecord was skipped (type already exists)
  if FSkipBuildingRecord then
    Exit;

  LField := Default(TMyrIRRecordField);
  LField.FieldName := AName;
  LField.FieldType := TMyrTypeRef.FromPrimitive(AType);
  LField.FieldOffset := -1;  // Computed during finalization
  LField.OverlayGroup := 0;  // Normal field by default
  LField.AnonRecordGroup := 0;  // Normal field by default

  if FBuildingRecordIndex >= 0 then
  begin
    // If inside anonymous union, mark as overlay
    if FAnonUnionFieldStart >= 0 then
      LField.OverlayGroup := FNextOverlayGroup;

    LEntry := FTypes[FBuildingRecordIndex];
    LLen := Length(LEntry.RecordType.Fields);
    SetLength(LEntry.RecordType.Fields, LLen + 1);
    LEntry.RecordType.Fields[LLen] := LField;
    FTypes[FBuildingRecordIndex] := LEntry;
  end
  else if FBuildingUnionIndex >= 0 then
  begin
    // If inside anonymous record, mark with group
    if FAnonRecordInUnion then
      LField.AnonRecordGroup := FNextAnonRecordGroup;

    LEntry := FTypes[FBuildingUnionIndex];
    LLen := Length(LEntry.UnionType.Fields);
    SetLength(LEntry.UnionType.Fields, LLen + 1);
    LEntry.UnionType.Fields[LLen] := LField;
    FTypes[FBuildingUnionIndex] := LEntry;
  end
  else
  begin
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_IR_TYPE_BUILD, RSIRNotBuildingRecordUnion);
    Exit;
  end;
end;

function TMyrIR.Field(const AName: string; const ATypeName: string): TMyrIR;
var
  LEntry: TMyrIRTypeEntry;
  LField: TMyrIRRecordField;
  LLen: Integer;
  LTypeIndex: Integer;
begin
  Result := Self;

  // Skip if DefineRecord was skipped (type already exists)
  if FSkipBuildingRecord then
    Exit;

  if (FBuildingRecordIndex < 0) and (FBuildingUnionIndex < 0) then
  begin
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_IR_TYPE_BUILD, RSIRNotBuildingRecordUnion);
    Exit;
  end;

  LTypeIndex := FindType(ATypeName);
  if LTypeIndex < 0 then
  begin
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_IR_UNKNOWN_TYPE, RSIRUnknownType, [ATypeName]);
    Exit;
  end;

  LField := Default(TMyrIRRecordField);
  LField.FieldName := AName;
  LField.FieldType := TMyrTypeRef.FromComposite(LTypeIndex);
  LField.FieldOffset := -1;
  LField.OverlayGroup := 0;  // Normal field by default
  LField.AnonRecordGroup := 0;  // Normal field by default

  if FBuildingRecordIndex >= 0 then
  begin
    // If inside anonymous union, mark as overlay
    if FAnonUnionFieldStart >= 0 then
      LField.OverlayGroup := FNextOverlayGroup;

    LEntry := FTypes[FBuildingRecordIndex];
    LLen := Length(LEntry.RecordType.Fields);
    SetLength(LEntry.RecordType.Fields, LLen + 1);
    LEntry.RecordType.Fields[LLen] := LField;
    FTypes[FBuildingRecordIndex] := LEntry;
  end
  else
  begin
    // If inside anonymous record, mark with group
    if FAnonRecordInUnion then
      LField.AnonRecordGroup := FNextAnonRecordGroup;

    LEntry := FTypes[FBuildingUnionIndex];
    LLen := Length(LEntry.UnionType.Fields);
    SetLength(LEntry.UnionType.Fields, LLen + 1);
    LEntry.UnionType.Fields[LLen] := LField;
    FTypes[FBuildingUnionIndex] := LEntry;
  end;
end;

function TMyrIR.BeginRecord(): TMyrIR;
begin
  Result := Self;

  // BeginRecord inside a union = anonymous record (sequential fields)
  if FBuildingUnionIndex >= 0 then
  begin
    if FAnonRecordInUnion then
    begin
      if Assigned(FErrors) then
        FErrors.Add(esError, MYR_ERR_IR_TYPE_BUILD, RSIRAlreadyAnonRecord);
      Exit;
    end;

    // Start new anonymous record group
    System.Inc(FNextAnonRecordGroup);
    FAnonRecordInUnion := True;
  end
  else
  begin
    // Not inside a union - error (use DefineRecord for named records)
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_IR_TYPE_BUILD, RSIRBeginRecordNeedsUnion);
    Exit;
  end;
end;

function TMyrIR.EndRecord(): TMyrIR;
begin
  Result := Self;

  // Skip if DefineRecord was skipped (type already exists)
  if FSkipBuildingRecord then
  begin
    FSkipBuildingRecord := False;
    Exit;
  end;

  // Check if we're closing an anonymous record inside a union
  if (FBuildingUnionIndex >= 0) and FAnonRecordInUnion then
  begin
    // Close anonymous record - reset tracking
    FAnonRecordInUnion := False;
    Exit;
  end;

  // Otherwise closing a named record
  if FBuildingRecordIndex < 0 then
  begin
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_IR_TYPE_BUILD, RSIRNotBuildingRecord);
    Exit;
  end;

  FinalizeRecordLayout(FBuildingRecordIndex);
  FBuildingRecordIndex := -1;
end;

function TMyrIR.DefineUnion(const AName: string): TMyrIR;
var
  LEntry: TMyrIRTypeEntry;
begin
  Result := Self;

  if FBuildingUnionIndex >= 0 then
  begin
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_IR_TYPE_BUILD, RSIRAlreadyBuildingUnion);
    Exit;
  end;

  LEntry := Default(TMyrIRTypeEntry);
  LEntry.Kind := tkUnion;
  LEntry.UnionType.TypeName := AName;
  LEntry.UnionType.IsFinalized := False;
  SetLength(LEntry.UnionType.Fields, 0);

  FBuildingUnionIndex := FTypes.Count;
  FTypes.Add(LEntry);
end;

function TMyrIR.BeginUnion(): TMyrIR;
var
  LEntry: TMyrIRTypeEntry;
begin
  Result := Self;

  // BeginUnion inside a record = anonymous union (overlay fields)
  if FBuildingRecordIndex >= 0 then
  begin
    if FAnonUnionFieldStart >= 0 then
    begin
      if Assigned(FErrors) then
        FErrors.Add(esError, MYR_ERR_IR_TYPE_BUILD, RSIRAlreadyAnonUnion);
      Exit;
    end;

    // Start new overlay group
    System.Inc(FNextOverlayGroup);
    LEntry := FTypes[FBuildingRecordIndex];
    FAnonUnionFieldStart := Length(LEntry.RecordType.Fields);
  end
  else
  begin
    // Not inside a record - error (use DefineUnion for named unions)
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_IR_TYPE_BUILD, RSIRBeginUnionNeedsRecord);
    Exit;
  end;
end;

function TMyrIR.EndUnion(): TMyrIR;
begin
  Result := Self;

  // Check if we're closing an anonymous union inside a record
  if (FBuildingRecordIndex >= 0) and (FAnonUnionFieldStart >= 0) then
  begin
    // Close anonymous union - reset tracking
    FAnonUnionFieldStart := -1;
    Exit;
  end;

  // Otherwise closing a named union
  if FBuildingUnionIndex < 0 then
  begin
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_IR_TYPE_BUILD, RSIRNotBuildingUnion);
    Exit;
  end;

  FinalizeUnionLayout(FBuildingUnionIndex);
  FBuildingUnionIndex := -1;
end;

function TMyrIR.DefineArray(const AName: string; const AElementType: TMyrValueType;
  const ALowBound: Integer; const AHighBound: Integer): TMyrIR;
