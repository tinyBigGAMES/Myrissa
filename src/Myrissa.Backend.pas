type
  // Loop context for break/continue support in SSA lowering
  TMyrSSALoopKind = (slkWhile, slkFor, slkRepeat);
  TMyrSSALoopCtx = record
    Kind: TMyrSSALoopKind;
    HeaderBlock: Integer;   // while/for: header (condition), repeat: body start
    LatchBlock: Integer;    // while: header, for: -1 (inline increment), repeat: latch
    EndBlock: Integer;      // exit target for break
    ForVar: string;         // for loops: counter variable name
    ForDownTo: Boolean;     // for loops: direction flag
  end;

{ InstrTakesOp1AsLocation }
// sikAddressOf consumes Op1 as a STORAGE LOCATION -- the stack slot of a
// named local -- and not as a value. Every other opcode in TMyrSSAInstrKind
// consumes its operands as values, which is why a blanket use-replacement
// is correct everywhere else.
//
// Any pass that substitutes a use MUST consult this before rewriting Op1.
// Rewriting it retargets the address at a different slot, or at something
// that has no slot at all, and the substitution also drops the last use of
// the original variable, so Dead Code Elimination then removes the store
// that initialised it. The result is a load from an uninitialised slot.
//
// Op2 needs no equivalent test: no instruction kind consumes Op2 as a
// location. sikFieldAddr and sikIndexAddr take Op1 as a POINTER VALUE
// produced by a preceding sikAddressOf, sikAssign or sikLoad, so they are
// substitutable and are deliberately absent from this test.
function InstrTakesOp1AsLocation(const AKind: TMyrSSAInstrKind): Boolean;
begin
  Result := (AKind = sikAddressOf);
end;

