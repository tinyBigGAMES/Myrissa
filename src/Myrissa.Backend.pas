  // Helper: Load operand into register for function argument
  procedure LoadOperandToReg(const AOp: TMyrOperand; const AReg: Byte);
  begin
    case AOp.Kind of
      okImmediate:
        begin
          if AOp.ImmFloat <> 0.0 then
            EmitMovRegImm64(AReg, UInt64(PInt64(@AOp.ImmFloat)^))
          else if (AOp.ImmInt >= 0) and (AOp.ImmInt <= $FFFFFFFF) then
            EmitMovRegImm32(AReg, Cardinal(AOp.ImmInt))
          else
            EmitMovRegImm64(AReg, UInt64(AOp.ImmInt));
        end;

      okData:
        begin
          // LEA reg, [RIP+offset_to_rdata]
          // Offset will be fixed up later
          AProduct.DataFixups.Add(TPair<Cardinal, Integer>.Create(AProduct.TextSection.Size, AOp.DataHandle.Index));
          EmitLeaRipRel(AReg, 0);  // Placeholder displacement
        end;

      okGlobal:
        begin
          // LEA reg, [RIP+offset_to_data]
          // Offset will be fixed up later (points to writable .data section)
          AProduct.GlobalFixups.Add(TPair<Cardinal, Integer>.Create(AProduct.TextSection.Size, AOp.DataHandle.Index));
          EmitLeaRipRel(AReg, 0);  // Placeholder displacement
        end;

      okLocal:
        begin
          // Load from stack: MOV reg, [RBP-offset]
          if AOp.LocalHandle.IsParam then
          begin
            EmitMovRegRbpDisp(AReg, GetParamOffset(AOp.LocalHandle.Index));
            // By-ref param: slot holds a pointer, dereference it
            if LFunc.Params[AOp.LocalHandle.Index].IsByRef then
              EmitMovRegMemReg(AReg, AReg);
          end
          else
            EmitMovRegRbpDisp(AReg, GetLocalOffset(AOp.LocalHandle.Index));
        end;

      okTemp:
        begin
          // Load from stack: MOV reg, [RBP-offset]
          EmitMovRegRbpDisp(AReg, GetTempOffset(AOp.TempHandle.Index));
        end;

      okFunc:
        begin
          // LEA reg, [RIP+offset_to_func]
          // Offset will be fixed up later
          AProduct.FuncAddrFixups.Add(TPair<Cardinal, Integer>.Create(AProduct.TextSection.Size, AOp.FuncHandle.Index));
          EmitLeaRipRel(AReg, 0);  // Placeholder displacement
        end;

      okImport:
        begin
          // Imported variable address. Both forms are 7 bytes with disp32
          // at +3, so the writers' fixup arithmetic is shared:
          //   dynamic: MOV reg,[RIP+slot]  -- load the address from the IAT/GOT
          //   static:  LEA reg,[RIP+data]  -- the variable is merged .data
          //            (an object consumer's linker will not rewrite opcodes)
          AProduct.ImportVarFixups.Add(TPair<Cardinal, Integer>.Create(AProduct.TextSection.Size, AOp.ImportHandle.Index));
          if FImports.GetEntryByIndex(AOp.ImportHandle.Index).IsStatic then
            EmitLeaRipRel(AReg, 0)   // Placeholder displacement
          else
            EmitMovRipRel(AReg, 0);  // Placeholder displacement
        end;
    else
      EmitXorRegReg(AReg);
    end;
  end;

  // SSE Helpers: Float register operations (XMM0/XMM1)
  procedure EmitMovsdXmmMem(const AXmm: Byte; const ABaseReg: Byte; const ADisp: Int32);
  begin
    // F2 REX.W 0F 10 ModRM disp32 — MOVSD xmm, [base+disp32]
    EmitByte($F2);
    EmitRex(True, AXmm >= 8, False, ABaseReg >= 8);
    EmitByte($0F);
    EmitByte($10);
    EmitModRM(2, AXmm and 7, ABaseReg and 7);
    EmitInt32(ADisp);
  end;

  procedure EmitMovsdMemXmm(const ABaseReg: Byte; const ADisp: Int32; const AXmm: Byte);
  begin
    // F2 REX.W 0F 11 ModRM disp32 — MOVSD [base+disp32], xmm
    EmitByte($F2);
    EmitRex(True, AXmm >= 8, False, ABaseReg >= 8);
    EmitByte($0F);
    EmitByte($11);
    EmitModRM(2, AXmm and 7, ABaseReg and 7);
    EmitInt32(ADisp);
  end;

  procedure EmitMovqXmmReg(const AXmm: Byte; const AReg: Byte);
  begin
    // 66 REX.W 0F 6E ModRM — MOVQ xmm, r64
    EmitByte($66);
    EmitRex(True, AXmm >= 8, False, AReg >= 8);
    EmitByte($0F);
    EmitByte($6E);
    EmitModRM(3, AXmm and 7, AReg and 7);
  end;

  procedure EmitAddsdXmmXmm(const ADest, ASrc: Byte);
  begin
    // F2 0F 58 ModRM — ADDSD xmm, xmm
    EmitByte($F2);
    if (ADest >= 8) or (ASrc >= 8) then
      EmitRex(False, ADest >= 8, False, ASrc >= 8);
    EmitByte($0F);
    EmitByte($58);
    EmitModRM(3, ADest and 7, ASrc and 7);
  end;

  procedure EmitSubsdXmmXmm(const ADest, ASrc: Byte);
  begin
    // F2 0F 5C ModRM — SUBSD xmm, xmm
    EmitByte($F2);
    if (ADest >= 8) or (ASrc >= 8) then
      EmitRex(False, ADest >= 8, False, ASrc >= 8);
    EmitByte($0F);
    EmitByte($5C);
    EmitModRM(3, ADest and 7, ASrc and 7);
  end;

  // Helper: COMISD xmm, xmm (ordered compare, sets CF/ZF/PF). 4 bytes for
  // XMM0-7. Unordered (NaN) sets CF, so a following JAE is NOT taken.
  procedure EmitComisdXmmXmm(const ADest, ASrc: Byte);
  begin
    // 66 0F 2F ModRM — COMISD xmm, xmm
    EmitByte($66);
    if (ADest >= 8) or (ASrc >= 8) then
      EmitRex(False, ADest >= 8, False, ASrc >= 8);
    EmitByte($0F);
    EmitByte($2F);
    EmitModRM(3, ADest and 7, ASrc and 7);
  end;

  // Helper: JAE rel8 (jump if above or equal, unsigned / CF clear). 2 bytes.
  procedure EmitJaeRel8(const ADisp: Int8);
  begin
    EmitByte($73);  // JAE rel8
    EmitByte(Byte(ADisp));
  end;

  // Helper: BTC reg64, imm8 (complement one bit). 5 bytes. Used to put back
  // the 2^63 that the float-to-uint fixup subtracted before converting - the
  // converted value is known to be below 2^63, so bit 63 is clear and
  // complementing it is exactly an add of 2^63.
  procedure EmitBtcRegImm8(const AReg: Byte; const ABit: Byte);
  begin
    EmitRex(True, False, False, AReg >= 8);
    EmitByte($0F);
    EmitByte($BA);  // group 8, /7 = BTC
    EmitModRM(3, 7, AReg and 7);
    EmitByte(ABit);
  end;

  procedure EmitMulsdXmmXmm(const ADest, ASrc: Byte);
  begin
    // F2 0F 59 ModRM — MULSD xmm, xmm
    EmitByte($F2);
    if (ADest >= 8) or (ASrc >= 8) then
      EmitRex(False, ADest >= 8, False, ASrc >= 8);
    EmitByte($0F);
    EmitByte($59);
    EmitModRM(3, ADest and 7, ASrc and 7);
  end;

  procedure EmitDivsdXmmXmm(const ADest, ASrc: Byte);
  begin
    // F2 0F 5E ModRM — DIVSD xmm, xmm
    EmitByte($F2);
    if (ADest >= 8) or (ASrc >= 8) then
      EmitRex(False, ADest >= 8, False, ASrc >= 8);
    EmitByte($0F);
    EmitByte($5E);
    EmitModRM(3, ADest and 7, ASrc and 7);
  end;

  procedure LoadOperandToXmm(const AOp: TMyrOperand; const AXmm: Byte);
  begin
    case AOp.Kind of
      okImmediate:
        begin
          // Load float bits as int64 into RAX, then MOVQ to XMM
          EmitMovRegImm64(REG_RAX, UInt64(PInt64(@AOp.ImmFloat)^));
          EmitMovqXmmReg(AXmm, REG_RAX);
        end;
      okLocal:
        begin
          if AOp.LocalHandle.IsParam then
            EmitMovsdXmmMem(AXmm, REG_RBP, GetParamOffset(AOp.LocalHandle.Index))
          else
            EmitMovsdXmmMem(AXmm, REG_RBP, GetLocalOffset(AOp.LocalHandle.Index));
        end;
      okTemp:
        EmitMovsdXmmMem(AXmm, REG_RBP, GetTempOffset(AOp.TempHandle.Index));
    else
      begin
        // Fallback: load to RAX via integer path, then move to XMM
        LoadOperandToReg(AOp, REG_RAX);
        EmitMovqXmmReg(AXmm, REG_RAX);
      end;
    end;
  end;

  procedure StoreTempFromXmm(const ATempIdx: Integer; const AXmm: Byte);
  begin
    EmitMovsdMemXmm(REG_RBP, GetTempOffset(ATempIdx), AXmm);
  end;

  // Helper: Load call argument to register, handling large struct params
  // Win64 ABI: Large structs (>8 bytes) are passed by pointer
  procedure LoadCallArgToReg(const AOp: TMyrOperand; const AReg: Byte;
    const ATargetFuncIndex: Integer; const AArgIndex: Integer);
  var
    LNeedsAddress: Boolean;
    LLocalInfo: TMyrLocalInfo;
    LTargetFunc: TMyrFuncInfo;
  begin
    LNeedsAddress := False;
    
    // Check if target parameter is by-ref (var param) — caller passes address
    if (ATargetFuncIndex >= 0) and (AOp.Kind = okLocal) then
    begin
      LTargetFunc := FCode.GetFunc(ATargetFuncIndex);
      if (AArgIndex >= 0) and (AArgIndex < Length(LTargetFunc.Params)) and
         LTargetFunc.Params[AArgIndex].IsByRef then
      begin
        if AOp.LocalHandle.IsParam and LFunc.Params[AOp.LocalHandle.Index].IsByRef then
        begin
          // Source is also a by-ref param — pass its pointer through (no deref)
          EmitMovRegRbpDisp(AReg, GetParamOffset(AOp.LocalHandle.Index));
          Exit;
        end
        else
        begin
          // Source is a local or value param — pass its address
          LNeedsAddress := True;
        end;
      end;
    end;
    
    // Check if source is a local struct that needs its address passed
    // Win64 ABI: structs >8 bytes are passed by pointer
    if (not LNeedsAddress) and (AOp.Kind = okLocal) and (not AOp.LocalHandle.IsParam) then
    begin
      LLocalInfo := LFunc.Locals[AOp.LocalHandle.Index];
      if (LLocalInfo.LocalType = cvtVoid) and (LLocalInfo.LocalSize > 8) then
        LNeedsAddress := True;
    end;
    
    if LNeedsAddress then
    begin
      if AOp.LocalHandle.IsParam then
        EmitLeaRegRbpDisp(AReg, GetParamOffset(AOp.LocalHandle.Index))
      else if LFunc.Locals[AOp.LocalHandle.Index].LocalSize > 8 then
        EmitLeaRegRbpDisp(AReg, GetLocalOffset(AOp.LocalHandle.Index)
          - LFunc.Locals[AOp.LocalHandle.Index].LocalSize + 8)
      else
        EmitLeaRegRbpDisp(AReg, GetLocalOffset(AOp.LocalHandle.Index));
    end
    else
      LoadOperandToReg(AOp, AReg);
  end;

  // Helper: Store operand to stack argument slot (for args 5+)
  // Win64 ABI: stack args go to [RSP+32], [RSP+40], etc.
  procedure StoreOperandToStackArg(const AOp: TMyrOperand; const AArgIndex: Integer);
  var
    LStackOffset: Int32;
  begin
    // Calculate stack offset: shadow space (32) + arg index * 8
    LStackOffset := 32 + (AArgIndex - 4) * 8;
    
    case AOp.Kind of
      okImmediate:
        begin
          // Load immediate to RAX, then store to stack
          if (AOp.ImmInt >= 0) and (AOp.ImmInt <= $FFFFFFFF) then
            EmitMovRegImm32(REG_RAX, Cardinal(AOp.ImmInt))
          else
            EmitMovRegImm64(REG_RAX, UInt64(AOp.ImmInt));
          EmitMovRspDispReg(LStackOffset, REG_RAX);
        end;

      okData:
        begin
          // LEA RAX, [RIP+offset], then store to stack
          AProduct.DataFixups.Add(TPair<Cardinal, Integer>.Create(AProduct.TextSection.Size, AOp.DataHandle.Index));
          EmitLeaRipRel(REG_RAX, 0);  // Placeholder
          EmitMovRspDispReg(LStackOffset, REG_RAX);
        end;

      okGlobal:
        begin
          // LEA RAX, [RIP+offset to .data], then store to stack
          AProduct.GlobalFixups.Add(TPair<Cardinal, Integer>.Create(AProduct.TextSection.Size, AOp.DataHandle.Index));
          EmitLeaRipRel(REG_RAX, 0);  // Placeholder
          EmitMovRspDispReg(LStackOffset, REG_RAX);
        end;

      okLocal:
        begin
          // Load local to RAX, then store to stack
          if AOp.LocalHandle.IsParam then
            EmitMovRegRbpDisp(REG_RAX, GetParamOffset(AOp.LocalHandle.Index))
          else
            EmitMovRegRbpDisp(REG_RAX, GetLocalOffset(AOp.LocalHandle.Index));
          EmitMovRspDispReg(LStackOffset, REG_RAX);
        end;

      okTemp:
        begin
          // Load temp to RAX, then store to stack
          EmitMovRegRbpDisp(REG_RAX, GetTempOffset(AOp.TempHandle.Index));
          EmitMovRspDispReg(LStackOffset, REG_RAX);
        end;
    else
      // Zero the slot
      EmitXorRegReg(REG_RAX);
      EmitMovRspDispReg(LStackOffset, REG_RAX);
    end;
  end;

  // SysV ABI: True if the operand carries a float value. Temps and locals do
  // not carry ValueType on the operand itself; temps resolve through the
  // per-function LTempIsFloat map (see ComputeTempFloatMapSysV), locals and
  // params resolve through the function's declared types.
  function OperandIsFloatSysV(const AOp: TMyrOperand): Boolean;
  begin
    case AOp.Kind of
      okTemp:
        Result := (AOp.TempHandle.Index >= 0) and
                  (AOp.TempHandle.Index < Length(LTempIsFloat)) and
                  LTempIsFloat[AOp.TempHandle.Index];
      okLocal:
        begin
          if AOp.LocalHandle.IsParam then
            Result := (AOp.LocalHandle.Index >= 0) and
                      (AOp.LocalHandle.Index < Length(LFunc.Params)) and
                      (LFunc.Params[AOp.LocalHandle.Index].ParamType in [cvtFloat32, cvtFloat64])
          else
            Result := (AOp.LocalHandle.Index >= 0) and
                      (AOp.LocalHandle.Index < Length(LFunc.Locals)) and
                      (LFunc.Locals[AOp.LocalHandle.Index].LocalType in [cvtFloat32, cvtFloat64]);
        end;
    else
      Result := AOp.ValueType in [cvtFloat32, cvtFloat64];
    end;
  end;

  // SysV ABI: One linear pass over the current function's instructions to
  // infer which temps hold float values. Needed because TMyrOperand.FromTemp
  // does not carry a ValueType, but SysV classification (int regs vs XMM)
  // requires it for variadic extras. Program order approximates dominance:
  // a temp is defined before it is used.
  procedure ComputeTempFloatMapSysV();
  var
    LT: Integer;
    LIsF: Boolean;
    LTInstr: TMyrInstruction;
  begin
    SetLength(LTempIsFloat, LFunc.TempCount);
    for LT := 0 to High(LTempIsFloat) do
      LTempIsFloat[LT] := False;

    for LT := 0 to High(LFunc.Instructions) do
    begin
      LTInstr := LFunc.Instructions[LT];
      if not LTInstr.Dest.IsValid() then
        Continue;

      case LTInstr.Kind of
        ikFAdd, ikFSub, ikFMul, ikFDiv, ikFNeg,
        ikIntToFloat, ikUIntToFloat, ikFloat32ToFloat64:
          LIsF := True;
        ikFloatToInt, ikFloatToUInt,
        ikUDiv, ikUMod,
        ikBitAnd, ikBitOr, ikBitXor, ikBitNot, ikShl, ikShr,
        ikCmpEq, ikCmpNe, ikCmpLt, ikCmpLe, ikCmpGt, ikCmpGe,
        ikUCmpLt, ikUCmpLe, ikUCmpGt, ikUCmpGe,
        ikFCmpEq, ikFCmpNe, ikFCmpLt, ikFCmpLe, ikFCmpGt, ikFCmpGe,
        ikVaCount, ikSyscall:
          LIsF := False;
        ikAdd, ikSub, ikMul, ikDiv, ikMod:
          // Integer arithmetic normally yields int, BUT the IR uses
          // ikAdd(value, 0) as a copy idiom - a float value copied this
          // way must stay classified as float. Inherit from operands.
          LIsF := OperandIsFloatSysV(LTInstr.Op1) or OperandIsFloatSysV(LTInstr.Op2);
        ikCallImport:
          LIsF := FImports.GetEntryByIndex(LTInstr.ImportTarget.Index).ReturnType in [cvtFloat32, cvtFloat64];
        ikCall:
          LIsF := FCode.GetFunc(LTInstr.FuncTarget.Index).ReturnType in [cvtFloat32, cvtFloat64];
        ikLoadPtr:
          LIsF := LTInstr.MemIsFloat;
      else
        // Copy-like instructions (ikLoad, moves): inherit from the source
        LIsF := OperandIsFloatSysV(LTInstr.Op1);
      end;

      if (LTInstr.Dest.Index >= 0) and (LTInstr.Dest.Index < Length(LTempIsFloat)) then
        LTempIsFloat[LTInstr.Dest.Index] := LIsF;
    end;
  end;

  // SysV ABI: stack args go to [RSP+0], [RSP+8], etc. ASlot is the
  // zero-based stack slot, NOT the argument index.
  procedure StoreOperandToStackArgSysV(const AOp: TMyrOperand; const ASlot: Integer);
  var
    LStackOffset: Int32;
  begin
    LStackOffset := ASlot * 8;

    case AOp.Kind of
      okImmediate:
        begin
          // Load immediate to RAX, then store to stack
          if (AOp.ImmInt >= 0) and (AOp.ImmInt <= $FFFFFFFF) then
            EmitMovRegImm32(REG_RAX, Cardinal(AOp.ImmInt))
          else
            EmitMovRegImm64(REG_RAX, UInt64(AOp.ImmInt));
          EmitMovRspDispReg(LStackOffset, REG_RAX);
        end;

      okData:
        begin
          // LEA RAX, [RIP+offset], then store to stack
          AProduct.DataFixups.Add(TPair<Cardinal, Integer>.Create(AProduct.TextSection.Size, AOp.DataHandle.Index));
          EmitLeaRipRel(REG_RAX, 0);  // Placeholder
          EmitMovRspDispReg(LStackOffset, REG_RAX);
        end;

      okGlobal:
        begin
          // LEA RAX, [RIP+offset to .data], then store to stack
          AProduct.GlobalFixups.Add(TPair<Cardinal, Integer>.Create(AProduct.TextSection.Size, AOp.DataHandle.Index));
          EmitLeaRipRel(REG_RAX, 0);  // Placeholder
          EmitMovRspDispReg(LStackOffset, REG_RAX);
        end;

      okLocal:
        begin
          // Load local to RAX, then store to stack
          if AOp.LocalHandle.IsParam then
            EmitMovRegRbpDisp(REG_RAX, GetParamOffset(AOp.LocalHandle.Index))
          else
            EmitMovRegRbpDisp(REG_RAX, GetLocalOffset(AOp.LocalHandle.Index));
          EmitMovRspDispReg(LStackOffset, REG_RAX);
        end;

      okTemp:
        begin
          // Load temp to RAX, then store to stack
          EmitMovRegRbpDisp(REG_RAX, GetTempOffset(AOp.TempHandle.Index));
          EmitMovRspDispReg(LStackOffset, REG_RAX);
        end;
    else
      // Zero the slot
      EmitXorRegReg(REG_RAX);
      EmitMovRspDispReg(LStackOffset, REG_RAX);
    end;
  end;

  // SysV x86-64 argument passing for import calls (linux64). Integer args
  // fill RDI,RSI,RDX,RCX,R8,R9; float args fill XMM0-XMM7 on an
  // independent counter. Overflow of either class spills to the stack at
  // RSP+0 upward, in original argument order. AL must hold the number of
  // XMM registers used before a variadic callee is entered.
  procedure EmitImportArgsSysV(const AInstr: TMyrInstruction);
  const
    SYSV_INT_REGS: array[0..5] of Byte = (REG_RDI, REG_RSI, REG_RDX, REG_RCX, REG_R8, REG_R9);
  var
    LK: Integer;
    LIntIdx: Integer;
    LFloatIdx: Integer;
    LStackSlot: Integer;
    LIsFloat: array of Boolean;
    LEntry: TMyrImportEntry;
    LDeclared: Integer;
  begin
    LEntry := FImports.GetEntryByIndex(AInstr.ImportTarget.Index);
    LDeclared := Length(LEntry.ParamTypes);

    // Pass 1 - classify every argument. Declared params classify by the
    // import signature; variadic extras classify via OperandIsFloatSysV
    // (operand ValueType for immediates/data, LTempIsFloat map for temps,
    // declared types for locals/params).
    SetLength(LIsFloat, Length(AInstr.Args));
    for LK := 0 to High(AInstr.Args) do
    begin
      if LK < LDeclared then
        LIsFloat[LK] := LEntry.ParamTypes[LK] in [cvtFloat32, cvtFloat64]
      else
        LIsFloat[LK] := OperandIsFloatSysV(AInstr.Args[LK]);
    end;

    // Pass 2a - stack spills first (RAX is scratch and must not yet hold AL).
    LIntIdx := 0;
    LFloatIdx := 0;
    LStackSlot := 0;
    for LK := 0 to High(AInstr.Args) do
    begin
      if LIsFloat[LK] then
      begin
        if LFloatIdx < 8 then
          Inc(LFloatIdx)
        else
        begin
          StoreOperandToStackArgSysV(AInstr.Args[LK], LStackSlot);
          Inc(LStackSlot);
        end;
      end
      else
      begin
        if LIntIdx < 6 then
          Inc(LIntIdx)
        else
        begin
          StoreOperandToStackArgSysV(AInstr.Args[LK], LStackSlot);
          Inc(LStackSlot);
        end;
      end;
    end;

    // Pass 2b - register args. Floats load through RAX then MOVQ to XMMn;
    // declared float32 params are narrowed with CVTSD2SS (modrm C0 + n*9
    // encodes XMMn,XMMn). Variadic float extras stay float64 - C default
    // argument promotion makes every vararg float a double.
    LIntIdx := 0;
    LFloatIdx := 0;
    for LK := 0 to High(AInstr.Args) do
    begin
      if LIsFloat[LK] then
      begin
        if LFloatIdx < 8 then
        begin
          LoadOperandToReg(AInstr.Args[LK], REG_RAX);
          EmitMovqXmmReg(LFloatIdx, REG_RAX);
          if (LK < LDeclared) and (LEntry.ParamTypes[LK] = cvtFloat32) then
          begin
            // CVTSD2SS XMMn, XMMn
            EmitByte($F2); EmitByte($0F); EmitByte($5A);
            EmitByte($C0 + Byte(LFloatIdx) * 9);
          end;
          Inc(LFloatIdx);
        end;
      end
      else
      begin
        if LIntIdx < 6 then
        begin
          LoadOperandToReg(AInstr.Args[LK], SYSV_INT_REGS[LIntIdx]);
          Inc(LIntIdx);
        end;
      end;
    end;

    // AL = number of XMM registers used. Emitted LAST because RAX was the
    // float scratch above. mov eax,imm32 zeroes the upper bits and sets AL.
    // TMyrImportEntry carries no variadic flag, so AL is set unconditionally:
    // RAX is caller-saved scratch, harmless for non-variadic callees and
    // mandatory for variadic ones (glibc reads AL to save XMM regs).
    EmitMovRegImm32(REG_RAX, Cardinal(LFloatIdx));
  end;

  // Helper: Store call argument to stack slot, handling large struct params
  // Win64 ABI: Large structs (>8 bytes) are passed by pointer
  // ASlotIndex is the OUTGOING slot position and AParamIndex is the callee's
  // parameter position. They are equal for an ordinary call, but a large-struct
  // return puts a hidden pointer in slot 0 and shifts every slot down by one,
  // so the two must be supplied separately or the param lookup below reads the
  // wrong parameter.
  procedure StoreCallArgToStack(const AOp: TMyrOperand; const ASlotIndex: Integer;
    const AParamIndex: Integer; const ATargetFuncIndex: Integer);
  var
    LStackOffset: Int32;
    LTargetFunc: TMyrFuncInfo;
    LNeedsAddress: Boolean;
  begin
    LStackOffset := 32 + (ASlotIndex - 4) * 8;
    LNeedsAddress := False;
    
    // Check if target param expects a large struct (passed by pointer)
    if ATargetFuncIndex >= 0 then
    begin
      LTargetFunc := FCode.GetFunc(ATargetFuncIndex);
      if (AParamIndex >= 0) and (AParamIndex < Length(LTargetFunc.Params)) then
      begin
        // Large struct param (>8 bytes): callee expects a pointer
        if LTargetFunc.Params[AParamIndex].ParamSize > 8 then
        begin
          // Source is a local variable (not a param): pass its address
          if (AOp.Kind = okLocal) and (not AOp.LocalHandle.IsParam) then
            LNeedsAddress := True;
        end;
      end;
    end;
    
    if LNeedsAddress then
    begin
      // LEA RAX, [RBP-offset] to get address of local struct, then store to stack
      EmitLeaRegRbpDisp(REG_RAX, GetLocalOffset(AOp.LocalHandle.Index));
      EmitMovRspDispReg(LStackOffset, REG_RAX);
    end
    else
      StoreOperandToStackArg(AOp, ASlotIndex);
  end;

begin
  Result := False;
  LJumpFixups := TList<TPair<Cardinal, Integer>>.Create();
  // linux64 try/except: label-index -> scope-index maps, filled per function
  LTryBeginMap := TDictionary<Integer, Integer>.Create();
  LEndMap := TDictionary<Integer, Integer>.Create();
  try
    // STEP 1: Build .rdata section (read-only data: strings, constants)
    if FData.GetSize() > 0 then
      AProduct.RDataSection.WriteBuffer(FData.GetDataPointer()^, FData.GetSize());
    // Ensure section has at least 1 byte (PE requires non-zero SizeOfRawData)
    if AProduct.RDataSection.Size = 0 then
      AProduct.RDataSection.WriteData(Byte(0));
    AlignStream(AProduct.RDataSection, 16);

    // STEP 1b: Build .data section (writable data: globals)
    if FGlobals.GetSize() > 0 then
      AProduct.DataSection.WriteBuffer(FGlobals.GetDataPointer()^, FGlobals.GetSize());
    // Ensure section has at least 1 byte (PE requires non-zero SizeOfRawData)
    if AProduct.DataSection.Size = 0 then
      AProduct.DataSection.WriteData(Byte(0));
    AlignStream(AProduct.DataSection, 16);

    // STEP 1c: Check for SEH and import __C_specific_handler if needed
    // Scan all functions to see if any have exception scopes
    AProduct.HasSEH := False;
    for LI := 0 to FCode.GetFuncCount() - 1 do
    begin
      LFunc := FCode.GetFunc(LI);
      if Length(LFunc.ExceptionScopes) > 0 then
      begin
        AProduct.HasSEH := True;
        Break;
      end;
    end;

    // If any function uses SEH, import __C_specific_handler from vcruntime140.dll
    LSEHHandlerImport := TMyrImportHandle.Invalid();
    LInitExceptionsIndex := -1;
    LSEHFilterIndex := -1;
    LInitSignalsIndex := -1;
    LPushFrameIdx := -1;
    LPopFrameIdx := -1;
    LPushFrameImportIdx := -1;
    LPopFrameImportIdx := -1;
    LSigsetjmpImportIdx := -1;
    // Obj mode: no IAT -- COFF writer emits an extern __C_specific_handler
    // symbol instead; do not mutate the import table.
    // linux64 has no __C_specific_handler -- exception recovery uses the
    // setjmp frame chain instead.
    if AProduct.HasSEH and (FOutputType <> otObj) and (FTarget <> tgLinux64) then
      LSEHHandlerImport := FImports.Add('vcruntime140.dll', '__C_specific_handler');

    // Resolve the runtime exception helpers by name. NOT gated on HasSEH:
    // the entry point initialises exception support unconditionally (see
    // the RT_InitExceptions call site) because a linked lib's guards use
    // this module's runtime.
    begin
      // Find Pax_InitExceptions function index for startup call
      for LI := 0 to FCode.GetFuncCount() - 1 do
      begin
        LFunc := FCode.GetFunc(LI);
        if LFunc.FuncName = RT_InitExceptions then
          LInitExceptionsIndex := LI
        else if LFunc.FuncName = RT_SEHFilter then
          LSEHFilterIndex := LI
        else if LFunc.FuncName = RT_InitSignals then
          LInitSignalsIndex := LI
        else if LFunc.FuncName = RT_PushExceptFrame then
          LPushFrameIdx := LI
        else if LFunc.FuncName = RT_PopExceptFrame then
          LPopFrameIdx := LI;
      end;

      // linux64: resolve the __sigsetjmp import index for try-begin emission,
      // and the frame helpers' import twins (externalized runtime in a lib)
      if FTarget = tgLinux64 then
      begin
        for LI := 0 to FImports.GetCount() - 1 do
        begin
          if FImports.GetEntryByIndex(LI).FuncName = '__sigsetjmp' then
            LSigsetjmpImportIdx := LI
          else if FImports.GetEntryByIndex(LI).FuncName = RT_PushExceptFrame then
            LPushFrameImportIdx := LI
          else if FImports.GetEntryByIndex(LI).FuncName = RT_PopExceptFrame then
            LPopFrameImportIdx := LI;
        end;
      end;
    end;

    // STEP 2: Gather imports by DLL (or static lib)
    // Lib search paths travel with the product so image writers can resolve
    // deferred needlib dependencies (drectve / .note.myrissa.needlib).
    AProduct.LibSearchPaths.Assign(FLibPaths);

    // Obj mode: no IAT/.idata and no static-lib resolution -- imports become
    // extern symbols + /DEFAULTLIB drectve entries in the COFF writer
    if FOutputType <> otObj then
    begin
    for LI := 0 to FImports.GetCount() - 1 do
    begin
      LEntry := FImports.GetEntryByIndex(LI);

      if LEntry.IsStatic then
      begin
        // Static import -- resolve lib path from name
        AProduct.StaticImportIndices.Add(LI);
        AProduct.StaticSymbolNames.Add(LEntry.FuncName);

        // Build lib filename: append the target's static-lib extension if none.
        // TMyrTargetInfo.FileExt is the single extension authority (win64 .lib, linux64 .a).
        LLibPath := LEntry.DllName;
        if ExtractFileExt(LLibPath) = '' then
          LLibPath := LLibPath + TMyrTargetInfo.FileExt(FTarget, otLib);

        // Resolve: absolute → use as-is; otherwise search FLibPaths then output dir
        if not TPath.IsPathRooted(LLibPath) then
        begin
          LResolvedPath := '';
          for LJ := 0 to FLibPaths.Count - 1 do
          begin
            LCandidate := TPath.Combine(FLibPaths[LJ], LLibPath);
            if FileExists(LCandidate) then
            begin
              LResolvedPath := LCandidate;
              Break;
            end;
          end;
          // Fallback: relative to output directory
          if LResolvedPath = '' then
            LResolvedPath := TPath.Combine(ExtractFilePath(FOutputPath), LLibPath);
          LLibPath := LResolvedPath;
        end;

        // One archive per lib, in first-seen order (dupIgnore only applies
        // to sorted lists, and link order must be preserved)
        if AProduct.StaticLibPaths.IndexOf(LLibPath) < 0 then
          AProduct.StaticLibPaths.Add(LLibPath);
        AProduct.HasStaticImports := True;
      end
      else
        // Dynamic imports are mapped into .idata by RebuildProductIData
        // below -- single source, shared with the PE writer's late
        // materialization rebuild.
        Continue;
    end;

    // STEP 3: Build .idata section (imports) -- single-source builder
    RebuildProductIData(AProduct, FImports);
    end;  // FOutputType <> otObj (STEP 2 + STEP 3 skipped for COFF objects)

    // STEP 4: Generate code for each function
    AProduct.EntryPointRVA := 0;

    // Initialize function offsets array
    SetLength(AProduct.FuncOffsets, FCode.GetFuncCount());
    SetLength(AProduct.FuncEndOffsets, FCode.GetFuncCount());  // For COFF .pdata
    SetLength(LAllLabelOffsets, FCode.GetFuncCount());  // For SEH SCOPE_TABLE
    SetLength(AProduct.AllLabelOffsets, FCode.GetFuncCount());  // COFF writer scope tables
    SetLength(AProduct.FuncUnwindInfoOffsets, FCode.GetFuncCount());  // Per-function UNWIND_INFO

    for LI := 0 to FCode.GetFuncCount() - 1 do
    begin
      LFunc := FCode.GetFunc(LI);

      // SysV needs per-function temp float classification for import calls
      if FTarget = tgLinux64 then
        ComputeTempFloatMapSysV();

      // Record function offset
      AProduct.FuncOffsets[LI] := AProduct.TextSection.Size;

      // Record function boundary in source map (debug mode only)
      if Assigned(FSourceMap) then
        FSourceMap.AddFunction(LI, LFunc.FuncName, Cardinal(AProduct.TextSection.Size), 0);

      // Record entry point
      // For EXE: use IsEntryPoint (main)
      // For DLL: use IsDllEntry (DllMain)
      if LFunc.IsEntryPoint and (FOutputType <> otDll) then
        AProduct.EntryPointRVA := AProduct.TextSection.Size
      else if LFunc.IsDllEntry and (FOutputType = otDll) then
        AProduct.EntryPointRVA := AProduct.TextSection.Size;

      // Initialize label offsets for this function
      SetLength(LLabelOffsets, Length(LFunc.Labels));
      for LJ := 0 to High(LLabelOffsets) do
        LLabelOffsets[LJ] := 0;

      // Calculate stack frame size:
      // Layout from RBP downward:
      //   [RBP-8..RBP-40]                          reserved base (8 alignment + 32 gap)
      //   [RBP-40-params*8..]                       saved params
      //   [after params..]                          locals
      //   [after locals..]                          temps
      //   [RSP+outgoing..RSP+outgoing+temps*8-1]   temps from RSP perspective
      //   [RSP..RSP+outgoing-1]                     outgoing arg space (shadow + stack args)
      //
      // The outgoing arg space must not overlap with temps. We scan all
      // call instructions to find the maximum argument count and reserve
      // enough space at the bottom of the frame for the callee's shadow
      // space (32 bytes minimum) plus any stack-passed arguments (args 5+).
      LLocalsSize := 0;
      for LJ := 0 to High(LFunc.Locals) do
        LLocalsSize := LLocalsSize + LFunc.Locals[LJ].LocalSize;

      // Scan for maximum outgoing call argument count
      LMaxCallArgs := 0;
      LSretSlotCount := 0;
      LMaxSretSize := 0;
      // Lockstep partner of the emission counter below: this scan assigns the
      // buffer ordinals and the ikCall emission consumes them in the same
      // instruction order. Reset here so both start from 0 per function.
      LSretCallOrdinal := 0;
      for LJ := 0 to High(LFunc.Instructions) do
      begin
        if LFunc.Instructions[LJ].Kind in [ikCallImport, ikCall, ikCallIndirect] then
        begin
          // A large-struct return consumes an extra outgoing slot, because the
          // hidden return pointer occupies RCX and shifts every real argument
          // down by one position. A direct call reads the size from the
          // callee's TMyrFuncInfo; an indirect call has none, so it carries the
          // size on the instruction (populated during SSA conversion).
          LSretTargetSize := 0;
          if LFunc.Instructions[LJ].Kind = ikCall then
            LSretTargetSize := FCode.GetFunc(
              LFunc.Instructions[LJ].FuncTarget.Index).ReturnSize
          else if LFunc.Instructions[LJ].Kind = ikCallIndirect then
            LSretTargetSize := LFunc.Instructions[LJ].ReturnSize;

          if LSretTargetSize > 8 then
          begin
            Inc(LSretSlotCount);
            // Pad each buffer to a 16-byte multiple so struct alignment holds
            LSretTargetSize := (LSretTargetSize + 15) and (not 15);
            if LSretTargetSize > LMaxSretSize then
              LMaxSretSize := LSretTargetSize;
            if Length(LFunc.Instructions[LJ].Args) + 1 > LMaxCallArgs then
              LMaxCallArgs := Length(LFunc.Instructions[LJ].Args) + 1;
          end
          else if Length(LFunc.Instructions[LJ].Args) > LMaxCallArgs then
            LMaxCallArgs := Length(LFunc.Instructions[LJ].Args);
        end;
      end;
      // Minimum 4 slots (32 bytes shadow) for any function that makes calls
      if LMaxCallArgs > 0 then
      begin
        if LMaxCallArgs < 4 then
          LMaxCallArgs := 4;
      end;
      // linux64 try/except emits runtime calls (push/pop frame, __sigsetjmp)
      // directly from codegen -- they are invisible to the IR call scan above,
      // so guarantee outgoing space when scopes exist.
      if (FTarget = tgLinux64) and (Length(LFunc.ExceptionScopes) > 0) and (LMaxCallArgs < 4) then
        LMaxCallArgs := 4;
      LOutgoingArgSpace := Cardinal(LMaxCallArgs) * 8;

      // linux64 try/except: each scope owns a 216-byte frame (PrevFrame +
      // sigjmp_buf + type) carved out of this function's stack frame,
      // placed after the temps.
      if FTarget = tgLinux64 then
        LScopeCount := Length(LFunc.ExceptionScopes)
      else
        LScopeCount := 0;

      // Caller-owned sret return buffers: one per large-struct call site,
      // never shared (nested calls would alias). They live after the temps
      // and after the linux64 exception scopes, immediately above the
      // outgoing argument space, so no existing offset helper is disturbed.
      LSretRegionSize := Cardinal(LSretSlotCount * LMaxSretSize);
      if LFunc.IsVariadic then
        LStackFrameSize := 40 + LOutgoingArgSpace + Cardinal(4 * 8) + Cardinal(LLocalsSize) + Cardinal(LFunc.TempCount * 8) + Cardinal(LScopeCount * 216) + LSretRegionSize
      else
        LStackFrameSize := 40 + LOutgoingArgSpace + Cardinal(Length(LFunc.Params) * 8) + Cardinal(LLocalsSize) + Cardinal(LFunc.TempCount * 8) + Cardinal(LScopeCount * 216) + LSretRegionSize;
      if (LStackFrameSize mod 16) <> 0 then
        LStackFrameSize := (LStackFrameSize + 15) and (not 15);  // Round up to multiple of 16

      // linux64 exception frames live after the temps: frame k occupies
      // [RBP - (LExcBase + (k+1)*216) .. RBP - (LExcBase + k*216))
      if LFunc.IsVariadic then
        LExcBase := 40 + 4 * 8
      else
        LExcBase := 40 + Length(LFunc.Params) * 8;
      LExcBase := LExcBase + LLocalsSize + LFunc.TempCount * 8;

      // linux64 try/except: map try-begin and scope-end label indices to
      // their scope index for the instruction loop
      LTryBeginMap.Clear();
      LEndMap.Clear();
      if LScopeCount > 0 then
      begin
        for LJ := 0 to LScopeCount - 1 do
        begin
          if LFunc.ExceptionScopes[LJ].TryBeginLabel.IsValid() then
            LTryBeginMap.AddOrSetValue(LFunc.ExceptionScopes[LJ].TryBeginLabel.Index, LJ);
          if LFunc.ExceptionScopes[LJ].EndLabel.IsValid() then
            LEndMap.AddOrSetValue(LFunc.ExceptionScopes[LJ].EndLabel.Index, LJ);
        end;
      end;

      // Function prologue: PUSH RBP; MOV RBP, RSP; SUB RSP, N
      EmitPushReg(REG_RBP);
      EmitMovRegReg(REG_RBP, REG_RSP);
      if LStackFrameSize > 0 then
      begin
        if LStackFrameSize > 4096 then
          EmitStackProbe_x64(AProduct.TextSection, LStackFrameSize)
        else
          EmitSubRspImm32(LStackFrameSize);
      end;

      // Save incoming parameters to stack (Win64: RCX, RDX, R8, R9)
      // For variadic functions: RCX = hidden count, then declared params
      // For large struct returns (>8 bytes): RCX = hidden return ptr, params shift
      if LFunc.IsVariadic then
      begin
        // Save ALL 4 registers for variadic functions
        // RCX = hidden count, RDX/R8/R9 could be declared params or varargs
        // We must save them all so VaArgAt can access varargs uniformly
        EmitMovRbpDispReg(-40, REG_RCX);   // Hidden count at position 0
        EmitMovRbpDispReg(-48, REG_RDX);   // Position 1 (param 0 or vararg 0)
        EmitMovRbpDispReg(-56, REG_R8);    // Position 2 (param 1 or vararg 1)
        EmitMovRbpDispReg(-64, REG_R9);    // Position 3 (param 2 or vararg 2)
        // Note: position 4+ come from caller's stack, no register save needed
      end
      else if LFunc.ReturnSize > 8 then
      begin
        // Large struct return: RCX = hidden return pointer (shifts all params)
        // Save hidden return pointer to [RBP-32]
        EmitMovRbpDispReg(-32, REG_RCX);
        // Params are shifted: RDX=param0, R8=param1, R9=param2, stack=param3+
        if Length(LFunc.Params) > 0 then
          EmitMovRbpDispReg(GetParamOffset(0), REG_RDX);
        if Length(LFunc.Params) > 1 then
          EmitMovRbpDispReg(GetParamOffset(1), REG_R8);
        if Length(LFunc.Params) > 2 then
          EmitMovRbpDispReg(GetParamOffset(2), REG_R9);
        // Large-struct return shifts params: param p (p >= 3) arrives at
        // [RBP+48+(p-3)*8]; home it to its negative slot so GetParamOffset
        // reads see it.
        for LK := 3 to High(LFunc.Params) do
        begin
          EmitMovRegRbpDisp(REG_RAX, 48 + (LK - 3) * 8);
          EmitMovRbpDispReg(GetParamOffset(LK), REG_RAX);
        end;
      end
      else
      begin
        // linux64: RT_SignalHandler is invoked BY THE KERNEL with SysV
        // argument registers (RDI/RSI/RDX), but internal homing below reads
        // the win64-style registers (RCX/RDX/R8). Shuffle SysV -> internal
        // before homing. Order matters: RDX is both a SysV source and an
        // internal destination, so it is consumed (into R8) before being
        // overwritten.
        if (FTarget = tgLinux64) and (LFunc.FuncName = RT_SignalHandler) then
        begin
          EmitMovRegReg(REG_R8, REG_RDX);
          EmitMovRegReg(REG_RDX, REG_RSI);
          EmitMovRegReg(REG_RCX, REG_RDI);
        end;
        if Length(LFunc.Params) > 0 then
          EmitMovRbpDispReg(GetParamOffset(0), REG_RCX);
        if Length(LFunc.Params) > 1 then
          EmitMovRbpDispReg(GetParamOffset(1), REG_RDX);
        if Length(LFunc.Params) > 2 then
          EmitMovRbpDispReg(GetParamOffset(2), REG_R8);
        if Length(LFunc.Params) > 3 then
          EmitMovRbpDispReg(GetParamOffset(3), REG_R9);
        // Home incoming stack parameters (5th onward): the caller placed
        // arg p at [RSP+32+(p-4)*8] before CALL, which is [RBP+48+(p-4)*8]
        // after the prologue. GetParamOffset reads every param from its
        // negative RBP slot, so stack params must be copied down or reads
        // return garbage.
        for LK := 4 to High(LFunc.Params) do
        begin
          EmitMovRegRbpDisp(REG_RAX, 48 + (LK - 4) * 8);
          EmitMovRbpDispReg(GetParamOffset(LK), REG_RAX);
        end;
      end;

      // Entry points call RT_InitExceptions() UNCONDITIONALLY -- not only
      // when this module has its own guard. A linked static lib references
      // the consumer's runtime (C model) and its guards need the TLS slot
      // and, on linux64, the signal handlers, exactly as crt0 installs them
      // for any C program. Gated by HasSEH this was "works only if the exe
      // happens to use guard" (probe_seh_exe: SIGFPE 136).
      if LInitExceptionsIndex >= 0 then
      begin
        if (LFunc.IsEntryPoint and (FOutputType <> otDll)) or
           (LFunc.IsDllEntry and (FOutputType = otDll)) then
        begin
          // CALL rel32 to Pax_InitExceptions (no arguments)
          // Record fixup: displacement is at offset 1 from current position
          AProduct.CallFixups.Add(TPair<Cardinal, Integer>.Create(AProduct.TextSection.Size + 1, LInitExceptionsIndex));
          EmitCallRel32(0);  // Placeholder displacement
          // linux64: install the signal handlers that convert hardware
          // faults into siglongjmp recovery (no arguments)
          if (FTarget = tgLinux64) and (LInitSignalsIndex >= 0) then
          begin
            AProduct.CallFixups.Add(TPair<Cardinal, Integer>.Create(AProduct.TextSection.Size + 1, LInitSignalsIndex));
            EmitCallRel32(0);  // Placeholder displacement
          end;
        end;
      end;

      // Zero-initialize composite locals (size > 8) to prevent garbage
      // pointer dereferences when struct fields are read before first assignment
      for LJ := 0 to High(LFunc.Locals) do
      begin
        if LFunc.Locals[LJ].LocalSize > 8 then
        begin
          EmitXorRegReg(REG_RAX);
          for LK := 0 to (LFunc.Locals[LJ].LocalSize div 8) - 1 do
            EmitMovRbpDispReg(GetLocalOffset(LJ) - LFunc.Locals[LJ].LocalSize + 8 + LK * 8, REG_RAX);
        end;
      end;

      // Process each instruction
      for LJ := 0 to High(LFunc.Instructions) do
      begin
        LInstr := LFunc.Instructions[LJ];

        // Record source map entry (debug mode only)
        if Assigned(FSourceMap) and (LInstr.SourceLine > 0) then
          FSourceMap.AddEntry(LInstr.SourceFile, LInstr.SourceLine, LInstr.SourceColumn,
            Cardinal(AProduct.TextSection.Size), LI);

        case LInstr.Kind of
          ikLabel:
            begin
              // Record label position
              if LInstr.LabelTarget.IsValid() then
                LLabelOffsets[LInstr.LabelTarget.Index] := AProduct.TextSection.Size;

              // linux64 try-begin: register frame + sigsetjmp recovery point
              if LInstr.LabelTarget.IsValid() and
                 LTryBeginMap.TryGetValue(LInstr.LabelTarget.Index, LScopeIdx) then
              begin
                LFrameOff := LExcBase + (LScopeIdx + 1) * 216;
                // RT_PushExceptFrame(frame) -- internal convention arg 0 = RCX.
                // Local function in an exe/dll; an import in a static lib
                // (externalized runtime), where the obj path emits CALL rel32
                // against the plain symbol exactly like any import call.
                EmitLeaRegRbpDisp(REG_RCX, -LFrameOff);
                if LPushFrameIdx >= 0 then
                  AProduct.CallFixups.Add(TPair<Cardinal, Integer>.Create(
                    AProduct.TextSection.Size + 1, LPushFrameIdx))
                else
                  AProduct.ImportFixups.Add(TPair<Cardinal, Integer>.Create(
                    AProduct.TextSection.Size, LPushFrameImportIdx));
                EmitCallRel32(0);
                // SysV import call: __sigsetjmp(jmpbuf, 1); AL = 0 (no vector args).
                // savemask = 1: the signal mask at guard entry is saved in the jmp_buf
                // so siglongjmp from RT_SignalHandler restores it. With 0 the faulting
                // signal stays blocked after the first catch and the kernel kills the
                // process on the next fault of the same kind.
                EmitLeaRegRbpDisp(REG_RDI, -(LFrameOff - 8));
                EmitMovRegImm32(REG_RSI, 1);
                EmitXorRegReg(REG_RAX);
                AProduct.ImportFixups.Add(TPair<Cardinal, Integer>.Create(
                  AProduct.TextSection.Size, LSigsetjmpImportIdx));
                EmitCallIndirectRipRel(0);
                // Nonzero return = arrived via siglongjmp: jump to except/finally
                EmitTestRegReg(REG_RAX, REG_RAX);
                if LFunc.ExceptionScopes[LScopeIdx].ExceptLabel.IsValid() then
                  LTargetLabel := LFunc.ExceptionScopes[LScopeIdx].ExceptLabel.Index
                else if LFunc.ExceptionScopes[LScopeIdx].FinallyLabel.IsValid() then
                  LTargetLabel := LFunc.ExceptionScopes[LScopeIdx].FinallyLabel.Index
                else
                  LTargetLabel := -1;
                if LTargetLabel >= 0 then
                begin
                  // JNZ rel32 is 6 bytes, displacement is at offset 2
                  LJumpFixups.Add(TPair<Cardinal, Integer>.Create(
                    AProduct.TextSection.Size + 2, LTargetLabel));
                  EmitJnzRel32(0);
                end;
              end;
              // linux64 scope end: pop the frame (local func, or import in a lib)
              if LInstr.LabelTarget.IsValid() and
                 LEndMap.TryGetValue(LInstr.LabelTarget.Index, LScopeIdx) then
              begin
                if LPopFrameIdx >= 0 then
                  AProduct.CallFixups.Add(TPair<Cardinal, Integer>.Create(
                    AProduct.TextSection.Size + 1, LPopFrameIdx))
                else
                  AProduct.ImportFixups.Add(TPair<Cardinal, Integer>.Create(
                    AProduct.TextSection.Size, LPopFrameImportIdx));
                EmitCallRel32(0);
              end;
            end;

          ikCallImport:
            begin
              // SysV marshaling for linux64 import calls that resolve to a
              // SysV entry: foreign C code, or a Myrissa .a's exported
              // thunk. A consumer-provided runtime routine (DllName = ''
              // and IsStatic, see TMyrIR.ExternalizeRuntime) resolves to the
              // host's internal-convention body on every target, so it is
              // marshaled exactly like a local call -- same as win64.
              if (FTarget = tgLinux64) and
                 not (FImports.GetEntryByIndex(LInstr.ImportTarget.Index).IsStatic and
                      (FImports.GetEntryByIndex(LInstr.ImportTarget.Index).DllName = '')) then
                EmitImportArgsSysV(LInstr)
              else
              begin
              // Win64 ABI: First 4 args in RCX/XMM0, RDX/XMM1, R8/XMM2, R9/XMM3
              // Float params go in XMM registers, integer params in GP registers
              // Store stack arguments FIRST (args 5+) using RAX as scratch
              for LK := 4 to High(LInstr.Args) do
              begin
                if (Length(FImports.GetEntryByIndex(LInstr.ImportTarget.Index).ParamTypes) > LK) and
                   (FImports.GetEntryByIndex(LInstr.ImportTarget.Index).ParamTypes[LK] in [cvtFloat32, cvtFloat64]) then
                begin
                  // Float stack arg: load to RAX, MOVQ→XMM0, CVTSD2SS, MOVSS to stack
                  LoadOperandToReg(LInstr.Args[LK], REG_RAX);
                  EmitMovqXmmReg(REG_XMM0, REG_RAX);
                  if FImports.GetEntryByIndex(LInstr.ImportTarget.Index).ParamTypes[LK] = cvtFloat32 then
                  begin
                    // CVTSD2SS XMM0, XMM0
                    EmitByte($F2); EmitByte($0F); EmitByte($5A); EmitByte($C0);
                    // MOVSS [RSP+disp32], XMM0
                    EmitByte($F3); EmitByte($0F); EmitByte($11); EmitByte($84); EmitByte($24);
                    EmitInt32(Int32(32 + (LK - 4) * 8));
                  end
                  else
                  begin
                    // MOVSD [RSP+disp32], XMM0
                    EmitByte($F2); EmitByte($0F); EmitByte($11); EmitByte($84); EmitByte($24);
                    EmitInt32(Int32(32 + (LK - 4) * 8));
                  end;
                end
                else
                  StoreOperandToStackArg(LInstr.Args[LK], LK);
              end;
              
              // Then load register arguments (float → XMM via RAX, int → GP)
              if Length(LInstr.Args) > 0 then
              begin
                if (Length(FImports.GetEntryByIndex(LInstr.ImportTarget.Index).ParamTypes) > 0) and
                   (FImports.GetEntryByIndex(LInstr.ImportTarget.Index).ParamTypes[0] in [cvtFloat32, cvtFloat64]) then
                begin
                  LoadOperandToReg(LInstr.Args[0], REG_RAX);
                  EmitMovqXmmReg(REG_XMM0, REG_RAX);
                  if FImports.GetEntryByIndex(LInstr.ImportTarget.Index).ParamTypes[0] = cvtFloat32 then
                  begin EmitByte($F2); EmitByte($0F); EmitByte($5A); EmitByte($C0); end;
                end
                else
                  LoadOperandToReg(LInstr.Args[0], REG_RCX);
              end;
              if Length(LInstr.Args) > 1 then
              begin
                if (Length(FImports.GetEntryByIndex(LInstr.ImportTarget.Index).ParamTypes) > 1) and
                   (FImports.GetEntryByIndex(LInstr.ImportTarget.Index).ParamTypes[1] in [cvtFloat32, cvtFloat64]) then
                begin
                  LoadOperandToReg(LInstr.Args[1], REG_RAX);
                  EmitMovqXmmReg(REG_XMM1, REG_RAX);
                  if FImports.GetEntryByIndex(LInstr.ImportTarget.Index).ParamTypes[1] = cvtFloat32 then
                  begin EmitByte($F2); EmitByte($0F); EmitByte($5A); EmitByte($C9); end;
                end
                else
                  LoadOperandToReg(LInstr.Args[1], REG_RDX);
              end;
              if Length(LInstr.Args) > 2 then
              begin
                if (Length(FImports.GetEntryByIndex(LInstr.ImportTarget.Index).ParamTypes) > 2) and
                   (FImports.GetEntryByIndex(LInstr.ImportTarget.Index).ParamTypes[2] in [cvtFloat32, cvtFloat64]) then
                begin
                  LoadOperandToReg(LInstr.Args[2], REG_RAX);
                  EmitMovqXmmReg(REG_XMM2, REG_RAX);
                  if FImports.GetEntryByIndex(LInstr.ImportTarget.Index).ParamTypes[2] = cvtFloat32 then
                  begin EmitByte($F2); EmitByte($0F); EmitByte($5A); EmitByte($D2); end;
                end
                else
                  LoadOperandToReg(LInstr.Args[2], REG_R8);
              end;
              if Length(LInstr.Args) > 3 then
              begin
                if (Length(FImports.GetEntryByIndex(LInstr.ImportTarget.Index).ParamTypes) > 3) and
                   (FImports.GetEntryByIndex(LInstr.ImportTarget.Index).ParamTypes[3] in [cvtFloat32, cvtFloat64]) then
                begin
                  LoadOperandToReg(LInstr.Args[3], REG_RAX);
                  EmitMovqXmmReg(REG_XMM3, REG_RAX);
                  if FImports.GetEntryByIndex(LInstr.ImportTarget.Index).ParamTypes[3] = cvtFloat32 then
                  begin EmitByte($F2); EmitByte($0F); EmitByte($5A); EmitByte($DB); end;
                end
                else
                  LoadOperandToReg(LInstr.Args[3], REG_R9);
              end;
              end;

              // Record import call fixup (offset = instruction start)
              // PE/DLL: CALL [RIP+disp] indirect through IAT (FF 15, disp at +2)
              // Obj (static AND dynamic): CALL rel32 direct (E8, disp at +1)
              //   against the PLAIN symbol name -- the convention of every C
              //   object compiled without __declspec(dllimport). Whoever
              //   defines the name wins: real code in a linked archive, the
              //   consumer's own CRT, an SDK import-lib thunk, or the
              //   short-import member bundled in Myrissa's .lib (Myrissa's
              //   own linker synthesizes the jmp-[IAT] thunk for it). This is
              //   what lets a foreign toolchain link a Myrissa .lib without
              //   being forced onto Myrissa's CRT. Address-of and data
              //   imports still go through __imp_<name> (ImportVarFixups).
              AProduct.ImportFixups.Add(TPair<Cardinal, Integer>.Create(AProduct.TextSection.Size, LInstr.ImportTarget.Index));
              // A lib build is an object build: the COFF writer is invoked
              // with otObj for both, so codegen must make the same call.
              if FOutputType in [otObj, otLib] then
                EmitCallRel32(0)             // Placeholder
              else
                EmitCallIndirectRipRel(0); // Placeholder

              // Sign-extend 32-bit return values to 64-bit
              if FImports.GetEntryByIndex(LInstr.ImportTarget.Index).ReturnType = cvtInt32 then
                EmitMovsxdRaxEax();

              // Store return value to temp if this instruction has a dest
              // Win64 ABI: floats return in XMM0, integers in RAX
              if LInstr.Dest.IsValid() then
              begin
                if FImports.GetEntryByIndex(LInstr.ImportTarget.Index).ReturnType in [cvtFloat32, cvtFloat64] then
                begin
                  // Float32 returns need promotion to float64 for VM slots
                  if FImports.GetEntryByIndex(LInstr.ImportTarget.Index).ReturnType = cvtFloat32 then
                  begin
                    // CVTSS2SD XMM0, XMM0 — promote single to double
                    EmitByte($F3); EmitByte($0F); EmitByte($5A); EmitByte($C0);
                  end;
                  StoreTempFromXmm(LInstr.Dest.Index, REG_XMM0);
                end
                else
                  StoreTempFromReg(LInstr.Dest.Index, REG_RAX);
              end;
            end;

          ikCall:
            begin
              // Call local function
              // Win64 ABI: First 4 args in RCX, RDX, R8, R9; rest on stack
              // Store stack arguments FIRST (args 5+) using RAX as scratch
              LCallRetSize := FCode.GetFunc(LInstr.FuncTarget.Index).ReturnSize;
              if LCallRetSize > 8 then
              begin
                // Large struct return: RCX carries a hidden pointer to a caller
                // owned buffer, and every real argument shifts down one slot
                // (arg 0 -> RDX, arg 1 -> R8, arg 2 -> R9, arg 3+ -> stack).
                // The callee copies the struct into the buffer and returns the
                // same pointer in RAX, so the RAX store below is still correct.
                for LK := 3 to High(LInstr.Args) do
                  StoreCallArgToStack(LInstr.Args[LK], LK + 1, LK, LInstr.FuncTarget.Index);

                if Length(LInstr.Args) > 0 then
                  LoadCallArgToReg(LInstr.Args[0], REG_RDX, LInstr.FuncTarget.Index, 0);
                if Length(LInstr.Args) > 1 then
                  LoadCallArgToReg(LInstr.Args[1], REG_R8, LInstr.FuncTarget.Index, 1);
                if Length(LInstr.Args) > 2 then
                  LoadCallArgToReg(LInstr.Args[2], REG_R9, LInstr.FuncTarget.Index, 2);

                // RCX last: the argument loads above must not clobber it.
                EmitLeaRegRbpDisp(REG_RCX, GetSretBufferOffset(LSretCallOrdinal));
                Inc(LSretCallOrdinal);
              end
              else
              begin
                for LK := 4 to High(LInstr.Args) do
                  StoreCallArgToStack(LInstr.Args[LK], LK, LK, LInstr.FuncTarget.Index);

                // Then load register arguments (with struct handling)
                if Length(LInstr.Args) > 0 then
                  LoadCallArgToReg(LInstr.Args[0], REG_RCX, LInstr.FuncTarget.Index, 0);
                if Length(LInstr.Args) > 1 then
                  LoadCallArgToReg(LInstr.Args[1], REG_RDX, LInstr.FuncTarget.Index, 1);
                if Length(LInstr.Args) > 2 then
                  LoadCallArgToReg(LInstr.Args[2], REG_R8, LInstr.FuncTarget.Index, 2);
                if Length(LInstr.Args) > 3 then
                  LoadCallArgToReg(LInstr.Args[3], REG_R9, LInstr.FuncTarget.Index, 3);
              end;

              // CALL rel32 - Record fixup
              // CALL rel32 is 5 bytes, displacement is at offset 1
              AProduct.CallFixups.Add(TPair<Cardinal, Integer>.Create(AProduct.TextSection.Size + 1, LInstr.FuncTarget.Index));
              EmitCallRel32(0);  // Placeholder

              // Store return value to temp if this instruction has a dest
              // Win64 ABI: floats return in XMM0, integers in RAX
              if LInstr.Dest.IsValid() then
              begin
                if FCode.GetFunc(LInstr.FuncTarget.Index).ReturnType in [cvtFloat32, cvtFloat64] then
                  StoreTempFromXmm(LInstr.Dest.Index, REG_XMM0)
                else
                  StoreTempFromReg(LInstr.Dest.Index, REG_RAX);
              end;
            end;

          ikCallIndirect:
            begin
              // Call through function pointer
              // Win64 ABI: First 4 args in RCX, RDX, R8, R9; rest on stack
              // Store stack arguments FIRST (args 5+) using RAX as scratch
              if LInstr.ReturnSize > 8 then
              begin
                // Large struct return through a function pointer: identical
                // convention to ikCall -- RCX carries a hidden pointer to a
                // caller-owned buffer and every real argument shifts down one
                // slot. The callee returns the same pointer in RAX, so the
                // RAX store below stays correct.
                for LK := 3 to High(LInstr.Args) do
                  StoreOperandToStackArg(LInstr.Args[LK], LK + 1);

                if Length(LInstr.Args) > 2 then
                  LoadOperandToReg(LInstr.Args[2], REG_R9);
                if Length(LInstr.Args) > 1 then
                  LoadOperandToReg(LInstr.Args[1], REG_R8);
                if Length(LInstr.Args) > 0 then
                  LoadOperandToReg(LInstr.Args[0], REG_RDX);

                // RCX last: the argument loads above must not clobber it.
                EmitLeaRegRbpDisp(REG_RCX, GetSretBufferOffset(LSretCallOrdinal));
                Inc(LSretCallOrdinal);
              end
              else
              begin
                for LK := 4 to High(LInstr.Args) do
                  StoreOperandToStackArg(LInstr.Args[LK], LK);

                // Load register arguments (uses R10/R11 to avoid clobbering)
                if Length(LInstr.Args) > 3 then
                  LoadOperandToReg(LInstr.Args[3], REG_R9);
                if Length(LInstr.Args) > 2 then
                  LoadOperandToReg(LInstr.Args[2], REG_R8);
                if Length(LInstr.Args) > 1 then
                  LoadOperandToReg(LInstr.Args[1], REG_RDX);
                if Length(LInstr.Args) > 0 then
                  LoadOperandToReg(LInstr.Args[0], REG_RCX);
              end;

              // Load function pointer into RAX (does not disturb RCX above)
              LoadOperandToReg(LInstr.Op1, REG_RAX);

              // CALL RAX
              EmitCallReg(REG_RAX);

              // Store return value to temp if this instruction has a dest
              if LInstr.Dest.IsValid() then
                StoreTempFromReg(LInstr.Dest.Index, REG_RAX);
            end;

          ikStore:
            begin
              // Store value to local/param: load value to RAX, then MOV [RBP-offset], RAX
              // Op1 = dest local, Op2 = value
              LoadOperandToReg(LInstr.Op2, REG_RAX);
              if LInstr.Op1.LocalHandle.IsParam then
              begin
                if LFunc.Params[LInstr.Op1.LocalHandle.Index].IsByRef then
                begin
                  // By-ref param: load pointer into RCX, store value through it
                  EmitMovRegRbpDisp(REG_RCX, GetParamOffset(LInstr.Op1.LocalHandle.Index));
                  EmitMovMemRegReg(REG_RCX, REG_RAX);
                end
                else
                  EmitMovRbpDispReg(GetParamOffset(LInstr.Op1.LocalHandle.Index), REG_RAX);
              end
              else
                EmitMovRbpDispReg(GetLocalOffset(LInstr.Op1.LocalHandle.Index), REG_RAX);
            end;

          ikLoad:
            begin
              // Load from local to temp: load local to RAX, store to temp
              // Dest = temp, Op1 = local
              LoadOperandToReg(LInstr.Op1, REG_RAX);
              StoreTempFromReg(LInstr.Dest.Index, REG_RAX);
            end;

          ikAddressOf:
            begin
              // Dest = address of local/param slot (always LEA)
              // Op1 = local handle
              if LInstr.Op1.LocalHandle.IsParam then
                EmitLeaRegRbpDisp(REG_RAX, GetParamOffset(LInstr.Op1.LocalHandle.Index))
              else
              begin
                // For composite locals (>8 bytes), shift the base address down
                // by (localSize - 8) so struct fields extending upward via
                // positive offsets stay within the allocated slot.
                if LFunc.Locals[LInstr.Op1.LocalHandle.Index].LocalSize > 8 then
                  EmitLeaRegRbpDisp(REG_RAX, GetLocalOffset(LInstr.Op1.LocalHandle.Index)
                    - LFunc.Locals[LInstr.Op1.LocalHandle.Index].LocalSize + 8)
                else
                  EmitLeaRegRbpDisp(REG_RAX, GetLocalOffset(LInstr.Op1.LocalHandle.Index));
              end;
              StoreTempFromReg(LInstr.Dest.Index, REG_RAX);
            end;

          ikBlockCopy:
            begin
              // Whole-object move: CopySize bytes from [Op2] to [Op1].
              //
              // RSI and RDI are callee-saved under BOTH the Win64 and the
              // SysV ABIs, and REP MOVSB destroys both plus RCX. Unlike the
              // sret epilogue - which runs when nothing is live - this
              // instruction can appear anywhere in a function body, so RCX
              // may hold a live allocated temp. All three are pushed and
              // popped, balanced, around the copy.
              //
              // The direction flag is DF=0 by ABI contract at every function
              // boundary and Myrissa never sets it, so no CLD is emitted -
              // the sret path at ikReturnValue already relies on this.
              EmitPushReg(REG_RSI);
              EmitPushReg(REG_RDI);
              EmitPushReg(REG_RCX);
              LoadOperandToReg(LInstr.Op2, REG_RSI);   // source address
              LoadOperandToReg(LInstr.Op1, REG_RDI);   // destination address
              EmitMovRegImm32(REG_RCX, Cardinal(LInstr.CopySize));
              EmitRepMovsb();
              EmitPopReg(REG_RCX);
              EmitPopReg(REG_RDI);
              EmitPopReg(REG_RSI);
            end;

          ikLoadPtr:
            begin
              // Dest = value at pointer Op1 (sized by MemSize)
              LoadOperandToReg(LInstr.Op1, REG_RAX);
              if LInstr.MemIsFloat and (LInstr.MemSize = 4) then
              begin
                // Float32 field: movss xmm0,[rax]; cvtss2sd xmm0,xmm0; movq rax,xmm0
                EmitByte($F3); EmitByte($0F); EmitByte($10); EmitByte($00);
                EmitByte($F3); EmitByte($0F); EmitByte($5A); EmitByte($C0);
                EmitByte($66); EmitByte($48); EmitByte($0F); EmitByte($7E); EmitByte($C0);
              end
              else
              begin
                case LInstr.MemSize of
                  1: begin
                       if LInstr.MemIsSigned then
                       begin
                         // movsx rax, byte [rax] -- sign-extend 8-bit
                         EmitRex(True, False, False, False);
                         EmitByte($0F); EmitByte($BE);
                         EmitModRM(0, REG_RAX and 7, REG_RAX and 7);
                       end
                       else
                       begin
                         // movzx eax, byte [rax] -- zero-extend 8-bit
                         EmitByte($0F); EmitByte($B6);
                         EmitModRM(0, REG_RAX and 7, REG_RAX and 7);
                       end;
                     end;
                  2: begin
                       if LInstr.MemIsSigned then
                       begin
                         // movsx rax, word [rax] -- sign-extend 16-bit
                         EmitRex(True, False, False, False);
                         EmitByte($0F); EmitByte($BF);
                         EmitModRM(0, REG_RAX and 7, REG_RAX and 7);
                       end
                       else
                       begin
                         // movzx eax, word [rax] -- zero-extend 16-bit
                         EmitByte($0F); EmitByte($B7);
                         EmitModRM(0, REG_RAX and 7, REG_RAX and 7);
                       end;
                     end;
                  4: begin
                       if LInstr.MemIsSigned then
                       begin
                         // movsxd rax, dword [rax] -- sign-extend 32-bit
                         EmitRex(True, False, False, False);
                         EmitByte($63);
                         EmitModRM(0, REG_RAX and 7, REG_RAX and 7);
                       end
                       else
                       begin
                         // mov eax, [rax] -- 32-bit, implicit zero-extend to 64
                         EmitByte($8B);
                         EmitModRM(0, REG_RAX and 7, REG_RAX and 7);
                       end;
                     end;
                else
                  EmitMovRegMemReg(REG_RAX, REG_RAX);  // mov rax, [rax] — full 64-bit
                end;
              end;
              StoreTempFromReg(LInstr.Dest.Index, REG_RAX);
            end;

          ikStorePtr:
            begin
              // Store Op2 to address in Op1 (sized by MemSize)
              LoadOperandToReg(LInstr.Op1, REG_RAX);
              LoadOperandToReg(LInstr.Op2, REG_RCX);
              if LInstr.MemIsFloat and (LInstr.MemSize = 4) then
              begin
                // Float32 field: movq xmm0,rcx; cvtsd2ss xmm0,xmm0; movss [rax],xmm0
                EmitByte($66); EmitByte($48); EmitByte($0F); EmitByte($6E); EmitByte($C1);
                EmitByte($F2); EmitByte($0F); EmitByte($5A); EmitByte($C0);
                EmitByte($F3); EmitByte($0F); EmitByte($11); EmitByte($00);
              end
              else
              begin
                case LInstr.MemSize of
                  1: begin
                       // mov [rax], cl — store 8-bit
                       EmitByte($88);
                       EmitModRM(0, REG_RCX and 7, REG_RAX and 7);
                     end;
                  2: begin
                       // mov [rax], cx — store 16-bit
                       EmitByte($66); EmitByte($89);
                       EmitModRM(0, REG_RCX and 7, REG_RAX and 7);
                     end;
                  4: begin
                       // mov [rax], ecx — store 32-bit
                       EmitByte($89);
                       EmitModRM(0, REG_RCX and 7, REG_RAX and 7);
                     end;
                else
                  EmitMovMemRegReg(REG_RAX, REG_RCX);  // mov [rax], rcx — full 64-bit
                end;
              end;
            end;

          ikAdd:
            begin
              // Dest = Op1 + Op2
              LoadOperandToReg(LInstr.Op1, REG_RAX);
              LoadOperandToReg(LInstr.Op2, REG_RCX);
              EmitAddRegReg(REG_RAX, REG_RCX);
              StoreTempFromReg(LInstr.Dest.Index, REG_RAX);
            end;

          ikSub:
            begin
              // Dest = Op1 - Op2
              LoadOperandToReg(LInstr.Op1, REG_RAX);
              LoadOperandToReg(LInstr.Op2, REG_RCX);
              EmitSubRegReg(REG_RAX, REG_RCX);
              StoreTempFromReg(LInstr.Dest.Index, REG_RAX);
            end;

          ikMul:
            begin
              // Dest = Op1 * Op2
              LoadOperandToReg(LInstr.Op1, REG_RAX);
              LoadOperandToReg(LInstr.Op2, REG_RCX);
              EmitImulRegReg(REG_RAX, REG_RCX);
              StoreTempFromReg(LInstr.Dest.Index, REG_RAX);
            end;

          ikDiv:
            begin
              // Dest = Op1 / Op2 (signed)
              LoadOperandToReg(LInstr.Op1, REG_RAX);
              LoadOperandToReg(LInstr.Op2, REG_RCX);
              EmitCqo();  // Sign-extend RAX into RDX:RAX
              EmitIdivReg(REG_RCX);  // RAX = quotient, RDX = remainder
              StoreTempFromReg(LInstr.Dest.Index, REG_RAX);
            end;

          ikMod:
            begin
              // Dest = Op1 mod Op2 (signed remainder)
              LoadOperandToReg(LInstr.Op1, REG_RAX);
              LoadOperandToReg(LInstr.Op2, REG_RCX);
              EmitCqo();  // Sign-extend RAX into RDX:RAX
              EmitIdivReg(REG_RCX);  // RAX = quotient, RDX = remainder
              StoreTempFromReg(LInstr.Dest.Index, REG_RDX);  // Remainder is in RDX
            end;

          ikUDiv:
            begin
              // Dest = Op1 div Op2 (unsigned)
              LoadOperandToReg(LInstr.Op1, REG_RAX);
              LoadOperandToReg(LInstr.Op2, REG_RCX);
              EmitXorRegReg(REG_RDX);  // Zero-extend, NOT sign-extend
              EmitDivReg(REG_RCX);     // RAX = quotient, RDX = remainder
              StoreTempFromReg(LInstr.Dest.Index, REG_RAX);
            end;

          ikUMod:
            begin
              // Dest = Op1 mod Op2 (unsigned remainder)
              LoadOperandToReg(LInstr.Op1, REG_RAX);
              LoadOperandToReg(LInstr.Op2, REG_RCX);
              EmitXorRegReg(REG_RDX);  // Zero-extend, NOT sign-extend
              EmitDivReg(REG_RCX);     // RAX = quotient, RDX = remainder
              StoreTempFromReg(LInstr.Dest.Index, REG_RDX);  // Remainder is in RDX
            end;

          ikFAdd:
            begin
              LoadOperandToXmm(LInstr.Op1, REG_XMM0);
              LoadOperandToXmm(LInstr.Op2, REG_XMM1);
              EmitAddsdXmmXmm(REG_XMM0, REG_XMM1);
              StoreTempFromXmm(LInstr.Dest.Index, REG_XMM0);
            end;

          ikFSub:
            begin
              LoadOperandToXmm(LInstr.Op1, REG_XMM0);
              LoadOperandToXmm(LInstr.Op2, REG_XMM1);
              EmitSubsdXmmXmm(REG_XMM0, REG_XMM1);
              StoreTempFromXmm(LInstr.Dest.Index, REG_XMM0);
            end;

          ikFMul:
            begin
              LoadOperandToXmm(LInstr.Op1, REG_XMM0);
              LoadOperandToXmm(LInstr.Op2, REG_XMM1);
              EmitMulsdXmmXmm(REG_XMM0, REG_XMM1);
              StoreTempFromXmm(LInstr.Dest.Index, REG_XMM0);
            end;

          ikFDiv:
            begin
              LoadOperandToXmm(LInstr.Op1, REG_XMM0);
              LoadOperandToXmm(LInstr.Op2, REG_XMM1);
              EmitDivsdXmmXmm(REG_XMM0, REG_XMM1);
              StoreTempFromXmm(LInstr.Dest.Index, REG_XMM0);
            end;

          ikFNeg:
            begin
              // Negate: 0.0 - value
              LoadOperandToXmm(LInstr.Op1, REG_XMM0);  // Op1 = 0.0
              LoadOperandToXmm(LInstr.Op2, REG_XMM1);  // Op2 = value
              EmitSubsdXmmXmm(REG_XMM0, REG_XMM1);
              StoreTempFromXmm(LInstr.Dest.Index, REG_XMM0);
            end;

          ikIntToFloat:
            begin
              // CVTSI2SD xmm0, rax — int64 in GPR to float64 in XMM
              LoadOperandToReg(LInstr.Op1, REG_RAX);
              EmitByte($F2); EmitByte($48); EmitByte($0F); EmitByte($2A);
              EmitModRM(3, REG_XMM0 and 7, REG_RAX and 7);
              StoreTempFromXmm(LInstr.Dest.Index, REG_XMM0);
            end;

          ikUIntToFloat:
            begin
              // Unsigned int64 to float64. CVTSI2SD is SIGNED, so a value with
              // bit 63 set would convert to a negative double. Below 2^63 the
              // signed conversion is already correct; at or above it, halve the
              // value with round-to-odd ((v shr 1) or (v and 1)), convert, then
              // double the result. The or-ed low bit preserves the sticky bit -
              // a plain v shr 1 discards it and double-rounds.
              LoadOperandToReg(LInstr.Op1, REG_RAX);

              EmitTestRegReg(REG_RAX, REG_RAX);                 // 3 bytes
              EmitJsRel8(7);                                    // 2 bytes - skip to fixup

              // Signed path: value < 2^63, convert directly.
              EmitByte($F2); EmitByte($48); EmitByte($0F); EmitByte($2A);
              EmitModRM(3, REG_XMM0 and 7, REG_RAX and 7);      // 5 bytes total
              EmitJmpRel8(22);                                  // 2 bytes - skip fixup

              // Fixup path: value >= 2^63.
              EmitMovRegReg(REG_RCX, REG_RAX);                  // 3 bytes
              EmitShrRegOne(REG_RCX);                           // 3 bytes
              EmitAndRegImm8(REG_RAX, 1);                       // 4 bytes
              EmitOrRegReg(REG_RCX, REG_RAX);                   // 3 bytes
              EmitByte($F2); EmitByte($48); EmitByte($0F); EmitByte($2A);
              EmitModRM(3, REG_XMM0 and 7, REG_RCX and 7);      // 5 bytes total
              EmitAddsdXmmXmm(REG_XMM0, REG_XMM0);              // 4 bytes = 22

              StoreTempFromXmm(LInstr.Dest.Index, REG_XMM0);
            end;

          ikFloatToInt:
            begin
              // CVTTSD2SI rax, xmm0 — float64 in XMM to int64 in GPR (truncation)
              LoadOperandToXmm(LInstr.Op1, REG_XMM0);
              EmitByte($F2); EmitByte($48); EmitByte($0F); EmitByte($2C);
              EmitModRM(3, REG_RAX and 7, REG_XMM0 and 7);
              StoreTempFromReg(LInstr.Dest.Index, REG_RAX);
            end;

          ikFloatToUInt:
            begin
              // float64 to unsigned int64. CVTTSD2SI is SIGNED and returns the
              // integer indefinite value ($8000000000000000) for anything at or
              // above 2^63. Below that threshold the signed truncation is
              // already correct; at or above it, subtract 2^63, truncate the
              // remainder (now in signed range), then put the 2^63 back by
              // complementing bit 63.
              LoadOperandToXmm(LInstr.Op1, REG_XMM0);

              // XMM1 := 2^63 as a double ($43E0000000000000).
              EmitMovRegImm64(REG_RCX, UInt64($43E0000000000000));  // 10 bytes
              EmitMovqXmmReg(REG_XMM1, REG_RCX);                    // 5 bytes

              EmitComisdXmmXmm(REG_XMM0, REG_XMM1);                 // 4 bytes
              EmitJaeRel8(7);                                       // 2 bytes

              // Signed path: value < 2^63 (and NaN, which leaves CF set).
              EmitByte($F2); EmitByte($48); EmitByte($0F); EmitByte($2C);
              EmitModRM(3, REG_RAX and 7, REG_XMM0 and 7);          // 5 bytes total
              EmitJmpRel8(14);                                      // 2 bytes

              // Fixup path: value >= 2^63.
              EmitSubsdXmmXmm(REG_XMM0, REG_XMM1);                  // 4 bytes
              EmitByte($F2); EmitByte($48); EmitByte($0F); EmitByte($2C);
              EmitModRM(3, REG_RAX and 7, REG_XMM0 and 7);          // 5 bytes total
              EmitBtcRegImm8(REG_RAX, 63);                          // 5 bytes = 14

              StoreTempFromReg(LInstr.Dest.Index, REG_RAX);
            end;

          ikFloat32ToFloat64:
            begin
              // CVTSS2SD xmm0, xmm0 — float32 to float64
              LoadOperandToXmm(LInstr.Op1, REG_XMM0);
              EmitByte($F3); EmitByte($0F); EmitByte($5A); EmitByte($C0);
              StoreTempFromXmm(LInstr.Dest.Index, REG_XMM0);
            end;

          ikBitAnd:
            begin
              // Dest = Op1 and Op2
              LoadOperandToReg(LInstr.Op1, REG_RAX);
              LoadOperandToReg(LInstr.Op2, REG_RCX);
              EmitAndRegReg(REG_RAX, REG_RCX);
              StoreTempFromReg(LInstr.Dest.Index, REG_RAX);
            end;

          ikBitOr:
            begin
              // Dest = Op1 or Op2
              LoadOperandToReg(LInstr.Op1, REG_RAX);
              LoadOperandToReg(LInstr.Op2, REG_RCX);
              EmitOrRegReg(REG_RAX, REG_RCX);
              StoreTempFromReg(LInstr.Dest.Index, REG_RAX);
            end;

          ikBitXor:
            begin
              // Dest = Op1 xor Op2
              LoadOperandToReg(LInstr.Op1, REG_RAX);
              LoadOperandToReg(LInstr.Op2, REG_RCX);
              EmitXorRegReg64(REG_RAX, REG_RCX);
              StoreTempFromReg(LInstr.Dest.Index, REG_RAX);
            end;

          ikBitNot:
            begin
              // Dest = not Op1
              LoadOperandToReg(LInstr.Op1, REG_RAX);
              EmitNotReg(REG_RAX);
              StoreTempFromReg(LInstr.Dest.Index, REG_RAX);
            end;

          ikShl:
            begin
              // Dest = Op1 shl Op2
              LoadOperandToReg(LInstr.Op1, REG_RAX);
              LoadOperandToReg(LInstr.Op2, REG_RCX);  // Shift count must be in CL
              EmitShlRegCl(REG_RAX);
              StoreTempFromReg(LInstr.Dest.Index, REG_RAX);
            end;

          ikShr:
            begin
              // Dest = Op1 shr Op2
              LoadOperandToReg(LInstr.Op1, REG_RAX);
              LoadOperandToReg(LInstr.Op2, REG_RCX);  // Shift count must be in CL
              EmitShrRegCl(REG_RAX);
              StoreTempFromReg(LInstr.Dest.Index, REG_RAX);
            end;

          ikCmpEq:
            begin
              // Dest = Op1 = Op2
              LoadOperandToReg(LInstr.Op1, REG_RAX);
              LoadOperandToReg(LInstr.Op2, REG_RCX);
              EmitCmpRegReg(REG_RAX, REG_RCX);
              EmitSete();
              EmitMovzxEaxAl();
              StoreTempFromReg(LInstr.Dest.Index, REG_RAX);
            end;

          ikCmpNe:
            begin
              // Dest = Op1 <> Op2
              LoadOperandToReg(LInstr.Op1, REG_RAX);
              LoadOperandToReg(LInstr.Op2, REG_RCX);
              EmitCmpRegReg(REG_RAX, REG_RCX);
              EmitSetne();
              EmitMovzxEaxAl();
              StoreTempFromReg(LInstr.Dest.Index, REG_RAX);
            end;

          ikCmpLt:
            begin
              // Dest = Op1 < Op2
              LoadOperandToReg(LInstr.Op1, REG_RAX);
              LoadOperandToReg(LInstr.Op2, REG_RCX);
              EmitCmpRegReg(REG_RAX, REG_RCX);
              EmitSetl();
              EmitMovzxEaxAl();
              StoreTempFromReg(LInstr.Dest.Index, REG_RAX);
            end;

          ikCmpLe:
            begin
              // Dest = Op1 <= Op2
              LoadOperandToReg(LInstr.Op1, REG_RAX);
              LoadOperandToReg(LInstr.Op2, REG_RCX);
              EmitCmpRegReg(REG_RAX, REG_RCX);
              EmitSetle();
              EmitMovzxEaxAl();
              StoreTempFromReg(LInstr.Dest.Index, REG_RAX);
            end;

          ikCmpGt:
            begin
              // Dest = Op1 > Op2
              LoadOperandToReg(LInstr.Op1, REG_RAX);
              LoadOperandToReg(LInstr.Op2, REG_RCX);
              EmitCmpRegReg(REG_RAX, REG_RCX);
              EmitSetg();
              EmitMovzxEaxAl();
              StoreTempFromReg(LInstr.Dest.Index, REG_RAX);
            end;

          ikCmpGe:
            begin
              // Dest = Op1 >= Op2
              LoadOperandToReg(LInstr.Op1, REG_RAX);
              LoadOperandToReg(LInstr.Op2, REG_RCX);
              EmitCmpRegReg(REG_RAX, REG_RCX);
              EmitSetge();
              EmitMovzxEaxAl();
              StoreTempFromReg(LInstr.Dest.Index, REG_RAX);
            end;

          // Unsigned comparisons — same CMP, unsigned-condition SETcc.
          // CMP sets CF/ZF for unsigned ordering and OF/SF for signed; only
          // the SETcc differs between the two families.
          ikUCmpLt:
            begin
              // Dest = uint64(Op1) < uint64(Op2)
              LoadOperandToReg(LInstr.Op1, REG_RAX);
              LoadOperandToReg(LInstr.Op2, REG_RCX);
              EmitCmpRegReg(REG_RAX, REG_RCX);
              EmitSetb();
              EmitMovzxEaxAl();
              StoreTempFromReg(LInstr.Dest.Index, REG_RAX);
            end;

          ikUCmpLe:
            begin
              // Dest = uint64(Op1) <= uint64(Op2)
              LoadOperandToReg(LInstr.Op1, REG_RAX);
              LoadOperandToReg(LInstr.Op2, REG_RCX);
              EmitCmpRegReg(REG_RAX, REG_RCX);
              EmitSetbe();
              EmitMovzxEaxAl();
              StoreTempFromReg(LInstr.Dest.Index, REG_RAX);
            end;

          ikUCmpGt:
            begin
              // Dest = uint64(Op1) > uint64(Op2)
              LoadOperandToReg(LInstr.Op1, REG_RAX);
              LoadOperandToReg(LInstr.Op2, REG_RCX);
              EmitCmpRegReg(REG_RAX, REG_RCX);
              EmitSeta();
              EmitMovzxEaxAl();
              StoreTempFromReg(LInstr.Dest.Index, REG_RAX);
            end;

          ikUCmpGe:
            begin
              // Dest = uint64(Op1) >= uint64(Op2)
              LoadOperandToReg(LInstr.Op1, REG_RAX);
              LoadOperandToReg(LInstr.Op2, REG_RCX);
              EmitCmpRegReg(REG_RAX, REG_RCX);
              EmitSetae();
              EmitMovzxEaxAl();
              StoreTempFromReg(LInstr.Dest.Index, REG_RAX);
            end;

          // Float comparisons — UCOMISD-based, NaN-correct
          ikFCmpEq:
            begin
              // Dest = float(Op1) = float(Op2), false for NaN
              LoadOperandToXmm(LInstr.Op1, REG_XMM0);
              LoadOperandToXmm(LInstr.Op2, REG_XMM1);
              EmitUcomisdXmmXmm(REG_XMM0, REG_XMM1);
              EmitSete();           // AL = (ZF=1) — equal or NaN
              EmitSetnpCl();        // CL = (PF=0) — not NaN
              EmitByte($20); EmitByte($C8);  // AND AL, CL
              EmitMovzxEaxAl();
              StoreTempFromReg(LInstr.Dest.Index, REG_RAX);
            end;

          ikFCmpNe:
            begin
              // Dest = float(Op1) <> float(Op2), true for NaN
              LoadOperandToXmm(LInstr.Op1, REG_XMM0);
              LoadOperandToXmm(LInstr.Op2, REG_XMM1);
              EmitUcomisdXmmXmm(REG_XMM0, REG_XMM1);
              EmitSetne();          // AL = (ZF=0) — not equal (but 0 for NaN)
              EmitSetpCl();         // CL = (PF=1) — NaN
              EmitByte($08); EmitByte($C8);  // OR AL, CL
              EmitMovzxEaxAl();
              StoreTempFromReg(LInstr.Dest.Index, REG_RAX);
            end;

          ikFCmpLt:
            begin
              // Dest = float(Op1) < float(Op2)
              // Swap operands: UCOMISD(Op2, Op1), then SETA (b > a → a < b)
              LoadOperandToXmm(LInstr.Op2, REG_XMM0);
              LoadOperandToXmm(LInstr.Op1, REG_XMM1);
              EmitUcomisdXmmXmm(REG_XMM0, REG_XMM1);
              EmitSeta();
              EmitMovzxEaxAl();
              StoreTempFromReg(LInstr.Dest.Index, REG_RAX);
            end;

          ikFCmpLe:
            begin
              // Dest = float(Op1) <= float(Op2)
              // Swap operands: UCOMISD(Op2, Op1), then SETAE (b >= a → a <= b)
              LoadOperandToXmm(LInstr.Op2, REG_XMM0);
              LoadOperandToXmm(LInstr.Op1, REG_XMM1);
              EmitUcomisdXmmXmm(REG_XMM0, REG_XMM1);
              EmitSetae();
              EmitMovzxEaxAl();
              StoreTempFromReg(LInstr.Dest.Index, REG_RAX);
            end;

          ikFCmpGt:
            begin
              // Dest = float(Op1) > float(Op2)
              LoadOperandToXmm(LInstr.Op1, REG_XMM0);
              LoadOperandToXmm(LInstr.Op2, REG_XMM1);
              EmitUcomisdXmmXmm(REG_XMM0, REG_XMM1);
              EmitSeta();
              EmitMovzxEaxAl();
              StoreTempFromReg(LInstr.Dest.Index, REG_RAX);
            end;

          ikFCmpGe:
            begin
              // Dest = float(Op1) >= float(Op2)
              LoadOperandToXmm(LInstr.Op1, REG_XMM0);
              LoadOperandToXmm(LInstr.Op2, REG_XMM1);
              EmitUcomisdXmmXmm(REG_XMM0, REG_XMM1);
              EmitSetae();
              EmitMovzxEaxAl();
              StoreTempFromReg(LInstr.Dest.Index, REG_RAX);
            end;

          ikJump:
            begin
              // Unconditional jump to label
              // Record fixup: code offset -> label index
              // JMP rel32 is 5 bytes, displacement is at offset 1
              LJumpFixups.Add(TPair<Cardinal, Integer>.Create(AProduct.TextSection.Size + 1, LInstr.LabelTarget.Index));
              EmitJmpRel32(0);  // Placeholder
            end;

          ikJumpIf:
            begin
              // Jump if condition is true (non-zero)
              LoadOperandToReg(LInstr.Op1, REG_RAX);
              EmitTestRegReg(REG_RAX, REG_RAX);
              // JNZ rel32 is 6 bytes, displacement is at offset 2
              LJumpFixups.Add(TPair<Cardinal, Integer>.Create(AProduct.TextSection.Size + 2, LInstr.LabelTarget.Index));
              EmitJnzRel32(0);  // Placeholder
            end;

          ikJumpIfNot:
            begin
              // Jump if condition is false (zero)
              LoadOperandToReg(LInstr.Op1, REG_RAX);
              EmitTestRegReg(REG_RAX, REG_RAX);
              // JZ rel32 is 6 bytes, displacement is at offset 2
              LJumpFixups.Add(TPair<Cardinal, Integer>.Create(AProduct.TextSection.Size + 2, LInstr.LabelTarget.Index));
              EmitJzRel32(0);  // Placeholder
            end;

          ikVaCount:
            begin
              // Load hidden vararg count from [RBP-40] (always at fixed position)
              EmitMovRegRbpDisp(REG_RAX, -40);
              StoreTempFromReg(LInstr.Dest.Index, REG_RAX);
            end;

          ikVaArgAt:
            begin
              // Load vararg at index from stack
              // Layout: [RBP-40] = hidden count
              //         [RBP-48] = declared param 0 (if any)
              //         ...
              //         [RBP-(40 + (NumParams+1)*8)] = first vararg (index 0)
              // For args >= 4 total position: caller's stack at [RBP+16+pos*8]
              //
              // Calculate actual position = NumParams + 1 + index
              // If position < 4: use [RBP - (40 + position * 8)]
              // If position >= 4: use [RBP + 16 + position * 8]
              
              // Load index into RAX
              LoadOperandToReg(LInstr.Op1, REG_RAX);
              
              // Add (NumParams + 1) to get actual position
              // NumParams = Length(LFunc.Params) (declared params, not counting hidden count)
              EmitAddRaxImm32(Length(LFunc.Params) + 1);
              
              // Now RAX = actual position
              // Compare with 4 to determine which stack region
              EmitCmpRaxImm32(4);
              
              // Save position in R10 for later use
              EmitMovRegReg(REG_R10, REG_RAX);
              
              // JGE rel8 to stack args path (jump +N bytes forward)
              // Register arg path code size: ~20 bytes
              EmitJgeRel8(20);
              
              // === Register arg path: [RBP - (40 + pos * 8)] ===
              // RAX still has position
              EmitShlRaxImm8(3);          // RAX = pos * 8
              EmitAddRaxImm32(40);        // RAX = 40 + pos * 8
              EmitNegRax();               // RAX = -(40 + pos * 8)
              EmitMovRegRbpPlusRax(REG_RAX);  // RAX = [RBP + RAX]
              EmitJmpRel8(18);            // Jump over stack arg path (18 bytes)
              
              // === Stack arg path: [RBP + 16 + pos * 8] ===
              // Position 4 → [RBP+48], Position 5 → [RBP+56], etc.
              // Restore position from R10
              EmitMovRegReg(REG_RAX, REG_R10);
              EmitShlRaxImm8(3);          // RAX = pos * 8
              EmitAddRaxImm32(16);        // RAX = pos * 8 + 16
              EmitMovRegRbpPlusRax(REG_RAX);  // RAX = [RBP + RAX]
              
              // Store result
              StoreTempFromReg(LInstr.Dest.Index, REG_RAX);
            end;

          ikSyscall:
            begin
              // Linux x86_64 syscall ABI: args in RDI, RSI, RDX, R10, R8, R9.
              // Args load BEFORE the number so an operand load cannot clobber RAX.
              if Length(LInstr.Args) > 0 then LoadOperandToReg(LInstr.Args[0], REG_RDI);
              if Length(LInstr.Args) > 1 then LoadOperandToReg(LInstr.Args[1], REG_RSI);
              if Length(LInstr.Args) > 2 then LoadOperandToReg(LInstr.Args[2], REG_RDX);
              if Length(LInstr.Args) > 3 then LoadOperandToReg(LInstr.Args[3], REG_R10);
              if Length(LInstr.Args) > 4 then LoadOperandToReg(LInstr.Args[4], REG_R8);
              if Length(LInstr.Args) > 5 then LoadOperandToReg(LInstr.Args[5], REG_R9);

              // Syscall number goes in RAX
              LoadOperandToReg(LInstr.Op1, REG_RAX);

              EmitByte($0F);              // syscall
              EmitByte($05);

              // Kernel returns result in RAX
              if LInstr.Dest.IsValid() then
                StoreTempFromReg(LInstr.Dest.Index, REG_RAX);
            end;

          ikReturn:
            begin
              // Epilogue: MOV RSP, RBP; POP RBP; RET
              EmitMovRegReg(REG_RSP, REG_RBP);
              EmitPopReg(REG_RBP);
              EmitRet();
            end;

          ikReturnValue:
            begin
              if LFunc.ReturnSize > 8 then
              begin
                // Large struct return: copy to hidden return pointer.
                // RSI and RDI are CALLEE-SAVED on Win64, and the rep movsb
                // below destroys both, so preserve them across the copy or
                // every large-struct-returning routine corrupts its caller.
                // Balanced before the RSP teardown, so the frame is unaffected.
                EmitPushReg(REG_RSI);
                EmitPushReg(REG_RDI);
                // RSI = source address (the local struct)
                if LInstr.Op1.Kind = okLocal then
                begin
                  if LInstr.Op1.LocalHandle.IsParam then
                    EmitLeaRegRbpDisp(REG_RSI, GetParamOffset(LInstr.Op1.LocalHandle.Index))
                  else if LFunc.Locals[LInstr.Op1.LocalHandle.Index].LocalSize > 8 then
                    EmitLeaRegRbpDisp(REG_RSI, GetLocalOffset(LInstr.Op1.LocalHandle.Index)
                      - LFunc.Locals[LInstr.Op1.LocalHandle.Index].LocalSize + 8)
                  else
                    EmitLeaRegRbpDisp(REG_RSI, GetLocalOffset(LInstr.Op1.LocalHandle.Index));
                end
                else
                  LoadOperandToReg(LInstr.Op1, REG_RSI);  // Fallback: assume it's a pointer
                // RDI = hidden return pointer from [RBP-32]
                EmitMovRegRbpDisp(REG_RDI, -32);
                // RCX = byte count
                EmitMovRegImm32(REG_RCX, Cardinal(LFunc.ReturnSize));
                // Copy bytes
                EmitRepMovsb();
                // Restore the callee-saved registers consumed by rep movsb
                EmitPopReg(REG_RDI);
                EmitPopReg(REG_RSI);
                // Return the hidden pointer in RAX
                EmitMovRegRbpDisp(REG_RAX, -32);
              end
              else
              begin
                // Small return value: load into appropriate register
                // Win64 ABI: floats return in XMM0, integers in RAX
                if LFunc.ReturnType in [cvtFloat32, cvtFloat64] then
                  LoadOperandToXmm(LInstr.Op1, REG_XMM0)
                else
                  LoadOperandToReg(LInstr.Op1, REG_RAX);
              end;
              // Epilogue: MOV RSP, RBP; POP RBP; RET
              EmitMovRegReg(REG_RSP, REG_RBP);
              EmitPopReg(REG_RBP);
              EmitRet();
            end;

          // TODO: Implement other instructions
        end;
      end;

      // Ensure function ends properly (for functions without explicit return)
      // Check if we need to add an implicit epilogue
      if Length(LFunc.Instructions) > 0 then
      begin
        if not (LFunc.Instructions[High(LFunc.Instructions)].Kind in [ikReturn, ikReturnValue]) then
        begin
          // Function doesn't end with explicit return - add epilogue
          EmitMovRegReg(REG_RSP, REG_RBP);
          EmitPopReg(REG_RBP);
          EmitRet();
        end;
      end
      else
      begin
        // Empty function - add epilogue
        EmitMovRegReg(REG_RSP, REG_RBP);
        EmitPopReg(REG_RBP);
        EmitRet();
      end;

      // Record function end offset (before alignment padding; COFF .pdata)
      AProduct.FuncEndOffsets[LI] := AProduct.TextSection.Size;

      // Backpatch jump targets within this function
      for LK := 0 to LJumpFixups.Count - 1 do
      begin
        LCodeOffset := LJumpFixups[LK].Key;
        LDataIndex := LJumpFixups[LK].Value;  // Label index
        // Calculate relative displacement: target - (instruction end)
        // The displacement is relative to the instruction after the jump
        // For JMP rel32: next instruction is at LCodeOffset + 4
        // For Jcc rel32: next instruction is at LCodeOffset + 4
        LDisp := Int32(LLabelOffsets[LDataIndex]) - Int32(LCodeOffset + 4);
        AProduct.TextSection.Position := LCodeOffset;
        AProduct.TextSection.WriteData(LDisp);
      end;
      LJumpFixups.Clear();
      AProduct.TextSection.Position := AProduct.TextSection.Size;

      // Save label offsets for SEH SCOPE_TABLE generation
      LAllLabelOffsets[LI] := Copy(LLabelOffsets);
      AProduct.AllLabelOffsets[LI] := LAllLabelOffsets[LI];  // COFF writer scope tables

      // Update function end offset in source map (debug mode only)
      if Assigned(FSourceMap) then
        FSourceMap.UpdateFunctionEnd(LI, Cardinal(AProduct.TextSection.Size));

      AlignStream(AProduct.TextSection, 16);
    end;

    // Backpatch local function calls (cross-function)
    for LI := 0 to AProduct.CallFixups.Count - 1 do
    begin
      LCodeOffset := AProduct.CallFixups[LI].Key;
      LDataIndex := AProduct.CallFixups[LI].Value;  // Function index
      // Calculate relative displacement: target - (instruction end)
      // CALL rel32: next instruction is at LCodeOffset + 4
      LDisp := Int32(AProduct.FuncOffsets[LDataIndex]) - Int32(LCodeOffset + 4);
      AProduct.TextSection.Position := LCodeOffset;
      AProduct.TextSection.WriteData(LDisp);
    end;
    AProduct.TextSection.Position := AProduct.TextSection.Size;

    // Ensure we have some code
    if AProduct.TextSection.Size = 0 then
    begin
      if Assigned(FErrors) then
        FErrors.Add(esError, MYR_ERR_CODEGEN_NO_CODE, RSCodegenNoCode);
      Status('Error: No code generated');
      Exit;
    end;

    // Generate UNWIND_INFO for all functions (needed by all output paths)
    // Obj mode (obj AND lib -- a lib build is an object build): unwind info
    // + SEH scope tables are emitted into .xdata by the COFF writer (with
    // relocations), never into text -- pass is done here
    if FOutputType in [otObj, otLib] then
    begin
      Result := True;
      Exit;
    end;

    // Initialize per-function UNWIND_INFO offset tracking
    for LI := 0 to FCode.GetFuncCount() - 1 do
      AProduct.FuncUnwindInfoOffsets[LI] := 0;

    // If any function uses SEH, generate a dispatcher thunk that jumps to
    // __C_specific_handler via IAT. This thunk is shared by all SEH functions.
    AProduct.SEHThunkOffset := 0;
    if AProduct.HasSEH then
    begin
      AlignStream(AProduct.TextSection, 4);
      AProduct.SEHThunkOffset := AProduct.TextSection.Size;
      // JMP qword ptr [RIP+disp32]: FF 25 xx xx xx xx
      AProduct.TextSection.WriteData(Byte($FF));
      AProduct.TextSection.WriteData(Byte($25));
      AProduct.TextSection.WriteData(Cardinal(0));  // Placeholder displacement
      // Add fixup for the thunk's displacement
      AProduct.ImportFixups.Add(TPair<Cardinal, Integer>.Create(AProduct.SEHThunkOffset, LSEHHandlerImport.Index));
    end;

    // Generate shared basic UNWIND_INFO (for functions without exception scopes)
    AlignStream(AProduct.TextSection, 4);
    AProduct.UnwindInfoRVA := AProduct.TextSection.Size;
    AProduct.TextSection.WriteBuffer(UNWIND_INFO[0], SizeOf(UNWIND_INFO));

    // For each function with exception scopes, generate per-function UNWIND_INFO + SCOPE_TABLE
    for LI := 0 to FCode.GetFuncCount() - 1 do
    begin
      LFunc := FCode.GetFunc(LI);
      LScopeCount := Length(LFunc.ExceptionScopes);

      if LScopeCount = 0 then
      begin
        // No exception scopes - use shared basic UNWIND_INFO
        AProduct.FuncUnwindInfoOffsets[LI] := AProduct.UnwindInfoRVA;
      end
      else
      begin
        // Has exception scopes - generate per-function UNWIND_INFO with SEH handler
        AlignStream(AProduct.TextSection, 4);
        AProduct.FuncUnwindInfoOffsets[LI] := AProduct.TextSection.Size;

        // UNWIND_INFO with UNW_FLAG_EHANDLER (0x01)
        AProduct.TextSection.WriteData(Byte($09));  // Version=1, Flags=UNW_FLAG_EHANDLER
        AProduct.TextSection.WriteData(Byte($04));  // SizeOfProlog=4
        AProduct.TextSection.WriteData(Byte($02));  // CountOfCodes=2
        AProduct.TextSection.WriteData(Byte($05));  // FrameRegister=RBP(5), FrameOffset=0
        // Unwind codes
        AProduct.TextSection.WriteData(Byte($04));  // Offset 4: UWOP_SET_FPREG
        AProduct.TextSection.WriteData(Byte($03));
        AProduct.TextSection.WriteData(Byte($01));  // Offset 1: UWOP_PUSH_NONVOL RBP
        AProduct.TextSection.WriteData(Byte($50));
        // ExceptionHandler RVA - offset within .text pointing to SEH thunk
        AProduct.SEHHandlerFixups.Add(AProduct.TextSection.Size);  // Track for EXE fixup
        AProduct.TextSection.WriteData(Cardinal(AProduct.SEHThunkOffset));

        // SCOPE_TABLE for __C_specific_handler
        AProduct.SEHScopeTableFixups.Add(TPair<Cardinal, Integer>.Create(AProduct.TextSection.Size, LScopeCount));
        AProduct.TextSection.WriteData(Cardinal(LScopeCount));

        // ScopeRecord[Count]: BeginAddress, EndAddress, HandlerAddress, JumpTarget
        for LJ := 0 to LScopeCount - 1 do
        begin
          LScope := LFunc.ExceptionScopes[LJ];

          // BeginAddress
          if (LScope.TryBeginLabel.Index >= 0) and
             (LScope.TryBeginLabel.Index < Length(LAllLabelOffsets[LI])) then
            AProduct.TextSection.WriteData(Cardinal(LAllLabelOffsets[LI][LScope.TryBeginLabel.Index]))
          else
            AProduct.TextSection.WriteData(Cardinal(AProduct.FuncOffsets[LI]));

          // EndAddress
          if LScope.ExceptLabel.Index >= 0 then
          begin
            if LScope.ExceptLabel.Index < Length(LAllLabelOffsets[LI]) then
              AProduct.TextSection.WriteData(Cardinal(LAllLabelOffsets[LI][LScope.ExceptLabel.Index]))
            else
              AProduct.TextSection.WriteData(Cardinal(AProduct.FuncOffsets[LI]));
          end
          else if LScope.FinallyLabel.Index >= 0 then
          begin
            if LScope.FinallyLabel.Index < Length(LAllLabelOffsets[LI]) then
              AProduct.TextSection.WriteData(Cardinal(LAllLabelOffsets[LI][LScope.FinallyLabel.Index]))
            else
              AProduct.TextSection.WriteData(Cardinal(AProduct.FuncOffsets[LI]));
          end
          else
            AProduct.TextSection.WriteData(Cardinal(AProduct.FuncOffsets[LI]));

          // HandlerAddress: filter for __except, 0 for __finally
          // Image mode: filter is a local function. Object mode: this .text
          // table is superseded by the writer's .xdata table, and the filter
          // is an import with no local offset -- write 0, never index by -1.
          if (LScope.ExceptLabel.Index >= 0) and (LSEHFilterIndex >= 0) then
            AProduct.TextSection.WriteData(Cardinal(AProduct.FuncOffsets[LSEHFilterIndex]))
          else
            AProduct.TextSection.WriteData(Cardinal(0));

          // JumpTarget
          if LScope.ExceptLabel.Index >= 0 then
          begin
            if LScope.ExceptLabel.Index < Length(LAllLabelOffsets[LI]) then
              AProduct.TextSection.WriteData(Cardinal(LAllLabelOffsets[LI][LScope.ExceptLabel.Index]))
            else
              AProduct.TextSection.WriteData(Cardinal(AProduct.FuncOffsets[LI]));
          end
          else if LScope.FinallyLabel.Index >= 0 then
          begin
            if LScope.FinallyLabel.Index < Length(LAllLabelOffsets[LI]) then
              AProduct.TextSection.WriteData(Cardinal(LAllLabelOffsets[LI][LScope.FinallyLabel.Index]))
            else
              AProduct.TextSection.WriteData(Cardinal(AProduct.FuncOffsets[LI]));
          end
          else
            AProduct.TextSection.WriteData(Cardinal(AProduct.FuncOffsets[LI]));
        end;
      end;
    end;

    Result := True;
  finally
    LEndMap.Free();
    LTryBeginMap.Free();
    LJumpFixups.Free();
  end;
end;

function TMyrCodegen.GeneratePE(): TBytes;
var
  LProduct: TMyrBuildProduct;
  LWriter: TMyrPEWriter;
begin
  Result := nil;
  LProduct := TMyrBuildProduct.Create();
  try
    if not EmitMachineCode(LProduct) then
      Exit;
    LProduct.HostGlobals.AddRange(FCompileHostGlobals);

    LWriter := TMyrPEWriter.Create();
    try
      LWriter.SetErrors(FErrors);
      LWriter.SetStatusCallback(FStatusCallback.Callback, FStatusCallback.UserData);
      LWriter.Init(FCode, FCompilePublicGlobals, FLinkedLibs, FLinkedObjs,
        FOutputPath, GetDumpIR());
      Result := LWriter.WriteImage(LProduct, FData, FGlobals, FImports, FExports,
        FOutputType, FSubsystem);
      FTextRVA := LProduct.TextRVA;  // Save for debug info emission
      FDataRVA := LProduct.DataRVA;  // Save for debug info emission
    finally
      LWriter.Free();
    end;
  finally
    LProduct.Free();
  end;
end;

