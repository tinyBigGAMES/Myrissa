{ TMyrSSAOperand.IsCallTarget }
function TMyrSSAOperand.IsCallTarget(): Boolean;
begin
  Result := Kind in [sokFunc, sokImport];
end;

function TMyrSSAOperand.ToString(): string;
begin
  case Kind of
    sokNone: Result := 'none';
    sokImmediate:
    begin
      if ImmIsFloat then
        Result := FloatToStr(ImmFloat)
      else
        Result := IntToStr(ImmInt);
    end;
    sokVar: Result := Var_.ToString();
    sokData: Result := Format('data_%d', [DataIndex]);
    sokGlobal: Result := Format('global_%d', [GlobalIndex]);
    sokImport: Result := Format('import_%d', [ImportIndex]);
    sokFunc: Result := Format('func_%d', [FuncIndex]);
    sokBlock: Result := Format('block_%d', [BlockIndex]);
    sokLocalIndex: Result := Format('local_%d', [LocalIndex]);
  else
    Result := '?';
  end;
end;

function TMyrSSAOperand.ToStringUnsigned(): string;
begin
  // Same as ToString, except an integer immediate is rendered with unsigned
  // ordering. Without this the dump shows uint64 literals at or above 2^63 as
  // their negative Int64 bit pattern (18446744073709551615 prints as -1),
  // which reads as a codegen fault when the codegen is in fact correct.
  if (Kind = sokImmediate) and (not ImmIsFloat) then
    Result := UIntToStr(UInt64(ImmInt))
  else
    Result := ToString();
end;

