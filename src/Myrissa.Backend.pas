function TMyrCodegen.FindStaticLib(const AName: string): Boolean;
var
  LLibPath: string;
  LI: Integer;
begin
  // Probe lib search paths for the target's static library form of AName.
  // Mirrors the build-time static resolution walk in the import gathering.
  Result := False;

  LLibPath := AName;
  if ExtractFileExt(LLibPath) = '' then
    LLibPath := LLibPath + TMyrTargetInfo.FileExt(FTarget, otLib);

  if TPath.IsPathRooted(LLibPath) then
  begin
    Result := FileExists(LLibPath);
    Exit;
  end;

  for LI := 0 to FLibPaths.Count - 1 do
  begin
    if FileExists(TPath.Combine(FLibPaths[LI], LLibPath)) then
    begin
      Result := True;
      Exit;
    end;
  end;
end;

function TMyrCodegen.StaticLibHasSymbol(const AName: string;
  const ASymbolName: string): Boolean;
var
  LLibPath: string;
  LResolved: string;
  LI: Integer;
  LLinker: TMyrLinker;
begin
  // Same resolution walk as FindStaticLib, then a read-only parse of the
  // archive's symbol table. Nothing is linked; the linker is discarded.
  Result := False;

  LLibPath := AName;
  if ExtractFileExt(LLibPath) = '' then
    LLibPath := LLibPath + TMyrTargetInfo.FileExt(FTarget, otLib);

  LResolved := '';
  if TPath.IsPathRooted(LLibPath) then
  begin
    if FileExists(LLibPath) then
      LResolved := LLibPath;
  end
  else
  begin
    for LI := 0 to FLibPaths.Count - 1 do
    begin
      if FileExists(TPath.Combine(FLibPaths[LI], LLibPath)) then
      begin
        LResolved := TPath.Combine(FLibPaths[LI], LLibPath);
        Break;
      end;
    end;
  end;
  if LResolved = '' then
    Exit;

  if FTarget = tgLinux64 then
    LLinker := TMyrELFLinker.Create()
  else
    LLinker := TMyrCOFFLinker.Create();
  try
    LLinker.SetStatusCallback(FStatusCallback.Callback, FStatusCallback.UserData);
    LLinker.SetErrors(FErrors);
    LLinker.AddLibraryFile(LResolved, False);
    Result := LLinker.HasSymbol(ASymbolName);
  finally
    LLinker.Free();
  end;
end;

function TMyrCodegen.FindSharedLib(const AName: string): string;
var
  LI: Integer;
  LFiles: TArray<string>;
begin
  // Probe lib search paths for the linux64 shared-library form of AName.
  // Returns the actual filename found (which becomes the DT_NEEDED entry,
  // matching the file @copydll places beside the exe via DT_RUNPATH=$ORIGIN),
  // or '' when no lib search path holds a candidate. Preference per path:
  //   lib<name>.so.<ver>  (versioned runtime soname, highest sorted)
  //   lib<name>.so
  //   <name>.so
  Result := '';
  if FTarget <> tgLinux64 then
    Exit;

  for LI := 0 to FLibPaths.Count - 1 do
  begin
    if not TDirectory.Exists(FLibPaths[LI]) then
      Continue;

    // Versioned soname: lib<name>.so.*
    LFiles := TDirectory.GetFiles(FLibPaths[LI], 'lib' + AName + '.so.*');
    if Length(LFiles) > 0 then
    begin
      TArray.Sort<string>(LFiles);
      // TPath.GetFileName, not ExtractFileName: the lib path arrives with
      // forward slashes (ResolvePath), and ExtractFileName on Windows only
      // splits on '\' and ':' -- it returned '/Dev/.../libraylib.so.550',
      // which then became DT_NEEDED and the loader looked for that path.
      Exit(TPath.GetFileName(LFiles[High(LFiles)]));
    end;

    if FileExists(TPath.Combine(FLibPaths[LI], 'lib' + AName + '.so')) then
      Exit('lib' + AName + '.so');

    if FileExists(TPath.Combine(FLibPaths[LI], AName + '.so')) then
      Exit(AName + '.so');
  end;

  // No lib path matched -- if the name has no extension, assume <name>.so.
  // DT_RUNPATH=$ORIGIN ensures the loader finds it beside the exe.
  if not AName.Contains('.') then
    Result := AName + '.so';
end;

procedure TMyrCodegen.PreBuild();
begin
  // CreateDirInPath detects a filename by its extension; a linux64 exe has
  // none, so pass a temp one purely so the parent directory gets created.
  if TPath.HasExtension(FOutputPath) then
    TUtils.CreateDirInPath(FOutputPath)
  else
    TUtils.CreateDirInPath(FOutputPath + '.tmp');
end;

procedure TMyrCodegen.PostBuild();
begin
  // Emit debug info sidecar file (PE debug mode only)
  if Assigned(FSourceMap) and (FOutputType in [otExe, otDll]) and
     (FSourceMap.GetEntryCount() > 0) then
  begin
    try
      FSourceMap.SaveToFile(ChangeFileExt(FOutputPath, MYR_DBGFILE_EXT), FTextRVA, FDataRVA);
      Status('Debug info written: %s',
        [ChangeFileExt(FOutputPath, MYR_DBGFILE_EXT).Replace('\', '/')]);
    except
      on E: Exception do
        Status('Warning: Failed to write debug info: %s', [E.Message]);
    end;
  end;
end;

procedure TMyrCodegen.PrepareSystem();
begin
  // Register system library search paths
  AddLibPath(TUtils.ResolvePath(LIB_PATH_SYSTEM));
end;

function TMyrCodegen.Build(): Boolean;
var
  LData: TBytes;
  LStream: TFileStream;
begin
  Result := False;

  if FOutputPath = '' then
  begin
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_BACKEND_OUTPUT_PATH, RSBackendOutputPath);
    Status('Error: Output path not specified');
    Exit;
  end;

  PreBuild();

  LData := BuildToMemory();
  if Length(LData) = 0 then
  begin
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_BACKEND_BUILD_FAILED, RSBackendBuildFailed);
    Status('Error: Build failed - no output generated');
    Exit;
  end;

  try
    LStream := TFileStream.Create(FOutputPath, fmCreate);
    try
      LStream.WriteBuffer(LData[0], Length(LData));
    finally
      LStream.Free();
    end;
    Result := True;
    Status('Build successful: %s', [FOutputPath.Replace('\', '/')]);

    PostBuild();

  except
    on E: Exception do
    begin
      if Assigned(FErrors) then
        FErrors.Add(esError, MYR_ERR_BACKEND_WRITE_FAILED, RSBackendWriteFailed, [E.Message]);
      Status('Error writing output: %s', [E.Message]);
    end;
  end;
end;

procedure TMyrCodegen.SetErrors(const AErrors: TErrors);
begin
  inherited SetErrors(AErrors);

  if Assigned(FCode) then
    FCode.SetErrors(AErrors);
end;

