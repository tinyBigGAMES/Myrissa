function TMyrCodegen.BuildToMemory(): TBytes;
begin
  // linux64: exe and dll route to the ELF writer (ET_EXEC / ET_DYN);
  // obj and lib land with the ET_REL and ar writers (PLAN-Linux64OutputKinds).
  if FTarget = tgLinux64 then
  begin
    if FOutputType in [otExe, otDll] then
      Result := GenerateELF()
    else if FOutputType = otObj then
      Result := GenerateELFObj()
    else if FOutputType = otLib then
      Result := GenerateELFLib()
    else
    begin
      if Assigned(FErrors) then
        FErrors.Add(esError, MYR_ERR_CODEGEN_LINUX_KIND,
          RSCodegenLinuxKind, []);
      SetLength(Result, 0);
    end;
    Exit;
  end;

  case FOutputType of
    otExe, otDll:
      Result := GeneratePE();
    otObj:
      Result := GenerateCOFF();
    otLib:
      Result := GenerateLib();
  else
    SetLength(Result, 0);
  end;
end;

function TMyrCodegen.Run(): Cardinal;
begin
  if FOutputType <> otExe then
    Exit(ERROR_BAD_FORMAT);

  try
    if FTarget = tgLinux64 then
      Result := TUtils.RunElf(FOutputPath, TPath.GetDirectoryName(FOutputPath))
    else
      Result := TUtils.RunPE(FOutputPath, '', TPath.GetDirectoryName(FOutputPath));
  except
    on E: Exception do
    begin
      if Assigned(FErrors) then
        FErrors.Add(esError, MYR_ERR_CODEGEN_RUN_FAILED, RSCodegenRunFailed, [E.Message]);
      Status('Run failed: %s', [E.Message]);
      Result := ERROR_FILE_NOT_FOUND;
    end;
  end;
end;

