{ TMyrBuildProduct }
constructor TMyrBuildProduct.Create();
begin
  inherited Create();

  TextSection := TMemoryStream.Create();
  RDataSection := TMemoryStream.Create();
  DataSection := TMemoryStream.Create();
  IDataSection := TMemoryStream.Create();

  ImportFixups := TList<TPair<Cardinal, Integer>>.Create();
  CallFixups := TList<TPair<Cardinal, Integer>>.Create();
  DataFixups := TList<TPair<Cardinal, Integer>>.Create();
  GlobalFixups := TList<TPair<Cardinal, Integer>>.Create();
  FuncAddrFixups := TList<TPair<Cardinal, Integer>>.Create();
  ImportVarFixups := TList<TPair<Cardinal, Integer>>.Create();
  DllImportThunkFixups := TList<TPair<Cardinal, Integer>>.Create();
  RelativeSites := TList<TPair<Cardinal, UInt64>>.Create();

  SEHHandlerFixups := TList<Cardinal>.Create();
  SEHScopeTableFixups := TList<TPair<Cardinal, Integer>>.Create();

  ImportDlls := TStringList.Create();
  ImportDlls.CaseSensitive := False;
  ImportDlls.Duplicates := dupIgnore;
  ImportsByDll := TObjectList<TStringList>.Create(True);
  IATEntries := TList<Cardinal>.Create();

  StaticImportIndices := TList<Integer>.Create();
  StaticSymbolNames := TStringList.Create();
  StaticLibPaths := TStringList.Create();
  StaticLibPaths.CaseSensitive := False;
  StaticLibPaths.Duplicates := dupIgnore;
  StaticObjPaths := TStringList.Create();
  StaticObjPaths.CaseSensitive := False;
  StaticObjPaths.Duplicates := dupIgnore;
  StaticImportResolved := TDictionary<Integer, Cardinal>.Create();
  StaticDataImportResolved := TDictionary<Integer, Cardinal>.Create();
  LibSearchPaths := TStringList.Create();
  LibSearchPaths.CaseSensitive := False;
  LibSearchPaths.Duplicates := dupIgnore;
  HostGlobals := TList<TPair<string, Cardinal>>.Create();

  Linker := nil;
  HasSEH := False;
  HasImports := False;
  HasStaticImports := False;
  EntryPointRVA := 0;
  SEHThunkOffset := 0;
  UnwindInfoRVA := 0;
  HintNamesOffset := 0;
  INTOffset := 0;
  IATOffset := 0;
  DllNamesOffset := 0;
  ExternalTextBase := 0;
  ExternalRDataBase := 0;
  ExternalDataBase := 0;
  TextRVA := 0;
  DataRVA := 0;
  ArgcGlobalIndex := -1;
  ArgvGlobalIndex := -1;
end;

destructor TMyrBuildProduct.Destroy();
begin
  Linker.Free();
  HostGlobals.Free();
  LibSearchPaths.Free();
  StaticDataImportResolved.Free();
  StaticImportResolved.Free();
  StaticObjPaths.Free();
  StaticLibPaths.Free();
  StaticSymbolNames.Free();
  StaticImportIndices.Free();
  IATEntries.Free();
  ImportsByDll.Free();
  ImportDlls.Free();
  SEHScopeTableFixups.Free();
  SEHHandlerFixups.Free();
  DllImportThunkFixups.Free();
  RelativeSites.Free();
  ImportVarFixups.Free();
  FuncAddrFixups.Free();
  GlobalFixups.Free();
  DataFixups.Free();
  CallFixups.Free();
  ImportFixups.Free();
  IDataSection.Free();
  DataSection.Free();
  RDataSection.Free();
  TextSection.Free();

  inherited Destroy();
end;

