    function SetReturnType(const AType: TMyrValueType; const ASize: Integer; const AAlignment: Integer): TMyrCodeBuilder; overload;
    function SetIsVariadic(const AValue: Boolean): TMyrCodeBuilder;
    function EndProc(): TMyrCodeBuilder;

    // Parameters and Locals
    function AddParam(const AName: string; const AType: TMyrValueType; const AIsByRef: Boolean = False): TMyrLocalHandle; overload;
    function AddParam(const AName: string; const ASize: Integer; const AAlignment: Integer; const AIsByRef: Boolean = False): TMyrLocalHandle; overload;
    function AddLocal(const AName: string; const AType: TMyrValueType): TMyrLocalHandle; overload;
    function AddLocal(const AName: string; const ASize: Integer): TMyrLocalHandle; overload;
    function AddLocal(const AName: string; const ASize: Integer; const AAlignment: Integer): TMyrLocalHandle; overload;

    // Labels
    function DefineLabel(const AName: string = ''): TMyrLabelHandle;
    function MarkLabel(const ALabel: TMyrLabelHandle): TMyrCodeBuilder;

    // Exception Scopes (for SEH)
    procedure AddExceptionScope(
      const ATryBegin: TMyrLabelHandle;
      const ATryEnd: TMyrLabelHandle;
      const AExcept: TMyrLabelHandle;
      const AFinally: TMyrLabelHandle;
      const AEnd: TMyrLabelHandle
    );

    // Function Calls
    function Call(const AImport: TMyrImportHandle): TMyrCodeBuilder; overload;
    function Call(const AImport: TMyrImportHandle; const AArgs: array of TMyrOperand): TMyrCodeBuilder; overload;
    function Call(const AFunc: TMyrFuncHandle): TMyrCodeBuilder; overload;
    function Call(const AFunc: TMyrFuncHandle; const AArgs: array of TMyrOperand): TMyrCodeBuilder; overload;

    function CallFunc(const AImport: TMyrImportHandle): TMyrTempHandle; overload;
    function CallFunc(const AImport: TMyrImportHandle; const AArgs: array of TMyrOperand): TMyrTempHandle; overload;
    function CallFunc(const AFunc: TMyrFuncHandle): TMyrTempHandle; overload;
    function CallFunc(const AFunc: TMyrFuncHandle; const AArgs: array of TMyrOperand): TMyrTempHandle; overload;

    // Indirect calls (through function pointer)
    function CallIndirect(const AFuncPtr: TMyrOperand): TMyrCodeBuilder; overload;
    function CallIndirect(const AFuncPtr: TMyrOperand; const AArgs: array of TMyrOperand): TMyrCodeBuilder; overload;
    function CallIndirectFunc(const AFuncPtr: TMyrOperand): TMyrTempHandle; overload;
    function CallIndirectFunc(const AFuncPtr: TMyrOperand; const AArgs: array of TMyrOperand): TMyrTempHandle; overload;
    // AReturnSize is the callee's return size in bytes; > 8 selects the
    // hidden-return-pointer (sret) convention. Pass 0 when not a composite.
    function CallIndirectFunc(const AFuncPtr: TMyrOperand;
      const AArgs: array of TMyrOperand; const AReturnSize: Integer): TMyrTempHandle; overload;

    // Function address
    function LoadFuncAddr(const AFuncIndex: Integer): TMyrTempHandle;

    // Return
    function Return(): TMyrCodeBuilder; overload;
    function Return(const AValue: TMyrOperand): TMyrCodeBuilder; overload;
    function BlockCopy(const ADest: TMyrOperand; const ASrc: TMyrOperand;
      const ASize: Integer): TMyrCodeBuilder;

    // Arithmetic
    function OpAdd(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
    function OpSub(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
    function OpMul(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
    function OpDiv(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
    function OpMod(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
    function OpUDiv(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
    function OpUMod(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
    function OpFAdd(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
    function OpFSub(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
    function OpFMul(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
    function OpFDiv(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
    function OpFNeg(const AValue: TMyrOperand): TMyrTempHandle;

    // Type Conversion
    function OpIntToFloat(const AValue: TMyrOperand): TMyrTempHandle;
    function OpUIntToFloat(const AValue: TMyrOperand): TMyrTempHandle;
    function OpFloatToInt(const AValue: TMyrOperand): TMyrTempHandle;
    function OpFloatToUInt(const AValue: TMyrOperand): TMyrTempHandle;
    function OpFloat32ToFloat64(const AValue: TMyrOperand): TMyrTempHandle;

    // Bitwise
    function OpAnd(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
    function OpOr(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
    function OpXor(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
    function OpNot(const AValue: TMyrOperand): TMyrTempHandle;
    function OpShl(const AValue, ACount: TMyrOperand): TMyrTempHandle;
    function OpShr(const AValue, ACount: TMyrOperand): TMyrTempHandle;

    // Comparison
    function CmpEq(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
    function CmpNe(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
    function CmpLt(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
    function CmpLe(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
    function CmpGt(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
    function CmpGe(const ALeft, ARight: TMyrOperand): TMyrTempHandle;

    // Unsigned relational forms. Equality is sign-agnostic - use CmpEq/CmpNe.
    function UCmpLt(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
    function UCmpLe(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
    function UCmpGt(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
    function UCmpGe(const ALeft, ARight: TMyrOperand): TMyrTempHandle;

    // Float Comparison
    function FCmpEq(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
    function FCmpNe(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
    function FCmpLt(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
    function FCmpLe(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
    function FCmpGt(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
    function FCmpGe(const ALeft, ARight: TMyrOperand): TMyrTempHandle;

    // Set Operations
    function OpSetLiteral(const AElements: array of Integer; const ALowBound: Integer; const AStorageSize: Integer): TMyrTempHandle;
    function OpSetUnion(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
    function OpSetDiff(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
    function OpSetInter(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
    function OpSetIn(const AElement, ASet: TMyrOperand; const ALowBound: Integer): TMyrTempHandle;
    function OpSetEq(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
    function OpSetNe(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
    function OpSetSubset(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
    function OpSetSuperset(const ALeft, ARight: TMyrOperand): TMyrTempHandle;

    // Variadic Intrinsics
    function VaCount(): TMyrTempHandle;
    function VaArgAt(const AIndex: TMyrOperand; const AType: TMyrValueType): TMyrTempHandle;

    // System Call Intrinsic (Linux x86_64)
    function SyscallOp(const ANumber: TMyrOperand; const AArgs: array of TMyrOperand): TMyrTempHandle;

    // Memory Operations
    function Store(const ADest: TMyrLocalHandle; const AValue: TMyrOperand): TMyrCodeBuilder;
    function Load(const ASrc: TMyrLocalHandle): TMyrTempHandle;
    function StorePtr(const APtr, AValue: TMyrOperand; const AMemSize: Integer = 0; const AMemIsFloat: Boolean = False): TMyrCodeBuilder;
    function LoadPtr(const APtr: TMyrOperand; const AMemSize: Integer = 0; const AMemIsFloat: Boolean = False; const AMemIsSigned: Boolean = False): TMyrTempHandle;
    function AddressOf(const ALocal: TMyrLocalHandle): TMyrTempHandle;

    // Control Flow
    function Jump(const ALabel: TMyrLabelHandle): TMyrCodeBuilder;
    function JumpIf(const ACond: TMyrOperand; const ALabel: TMyrLabelHandle): TMyrCodeBuilder;
    function JumpIfNot(const ACond: TMyrOperand; const ALabel: TMyrLabelHandle): TMyrCodeBuilder;

    // Source Location (for debugger)
    procedure SetSourceLocation(const ALine: Integer; const AColumn: Integer; const AFile: string = '');

    // Query
    function GetFuncCount(): Integer;
    function GetFunc(const AIndex: Integer): TMyrFuncInfo;
    function GetFuncHandle(const AName: string): TMyrFuncHandle;
    function GetCurrentFuncHandle(): TMyrFuncHandle;

    procedure Clear();
  end;

type
  { TMyrBuildProduct }
  // Target-neutral output of the shared machine-code pass. Owns all
  // contained objects; ownership of individual members may be transferred
  // (e.g. to the in-memory image builder) by taking the reference and setting the field to nil.
  TMyrBuildProduct = class(TBaseObject)
  public
    // Code
    TextSection: TMemoryStream;             // machine code (text bytes)
    FuncOffsets: TArray<Cardinal>;          // func index -> offset in text
    FuncEndOffsets: TArray<Cardinal>;       // func index -> end offset in text (COFF .pdata)
    AllLabelOffsets: TArray<TArray<Cardinal>>; // per-func label offsets (COFF SEH scope tables)
    FuncUnwindInfoOffsets: TArray<Cardinal>;// per-func UNWIND_INFO offsets in text
    EntryPointRVA: Cardinal;                // entry offset within text

    // Data sections built by the pass
    RDataSection: TMemoryStream;            // read-only data (FData + external)
    DataSection: TMemoryStream;             // writable globals (FGlobals + external)
    IDataSection: TMemoryStream;            // import directory (layout pre-computed)

    // Fixups (text offsets -> target index/offset)
    ImportFixups: TList<TPair<Cardinal, Integer>>;        // CALL [RIP+x] -> import index
    CallFixups: TList<TPair<Cardinal, Integer>>;          // CALL rel32 -> func index (backpatched)
    DataFixups: TList<TPair<Cardinal, Integer>>;          // RIP-rel -> .rdata offset
    GlobalFixups: TList<TPair<Cardinal, Integer>>;        // RIP-rel -> .data offset
    FuncAddrFixups: TList<TPair<Cardinal, Integer>>;      // 64-bit func address slots
    ImportVarFixups: TList<TPair<Cardinal, Integer>>;     // imported variable refs
    DllImportThunkFixups: TList<TPair<Cardinal, Integer>>;// DLL import thunk sites
    // Absolute (R_X86_64_64) sites applied inside a shared object: (site
    // RVA, link-time value). Each becomes one R_X86_64_RELATIVE in .rela.dyn.
    RelativeSites: TList<TPair<Cardinal, UInt64>>;

    // SEH (win64 only; unused on linux64)
    HasSEH: Boolean;
    SEHThunkOffset: Cardinal;               // shared __C_specific_handler thunk offset
    UnwindInfoRVA: Cardinal;                // shared basic UNWIND_INFO offset
    SEHHandlerFixups: TList<Cardinal>;      // ExceptionHandler RVA slots in text
    SEHScopeTableFixups: TList<TPair<Cardinal, Integer>>; // SCOPE_TABLE sites

    // Import layout (computed by the pass)
    HasImports: Boolean;
    ImportDlls: TStringList;                // unique DLL names
    ImportsByDll: TObjectList<TStringList>; // per-DLL import name lists
    IATEntries: TList<Cardinal>;            // flattened IAT entry order
    HintNamesOffset: Cardinal;
    INTOffset: Cardinal;
    IATOffset: Cardinal;
    DllNamesOffset: Cardinal;

    // Static library linking
    HasStaticImports: Boolean;
    StaticImportIndices: TList<Integer>;
    StaticSymbolNames: TStringList;
    StaticLibPaths: TStringList;
    StaticObjPaths: TStringList;
    StaticImportResolved: TDictionary<Integer, Cardinal>;
    StaticDataImportResolved: TDictionary<Integer, Cardinal>; // import index -> offset in .data (static-lib variables)
    LibSearchPaths: TStringList;            // lib dirs for deferred needlib resolution
    ExternalTextBase: Cardinal;             // merged external .text base offset
    ExternalRDataBase: Cardinal;
    ExternalDataBase: Cardinal;
    Linker: TMyrLinker;                        // owned; nil when no static libs
    // Consumer-provided globals: IR name -> offset in DataSection. Filled by
    // the compile pass; the image writers register each with the linker as
    // a host symbol so a static lib's undefined RT_* globals bind here.
    HostGlobals: TList<TPair<string, Cardinal>>;

    // Section RVAs written back by the image writer (for debug info emission)
    TextRVA: Cardinal;
    DataRVA: Cardinal;

    // Command line storage globals, published by the machine-code pass.
    // Each value is an index into the globals TMyrDataBuilder, or -1 when the
    // global is absent (no runtime linked). linux64 consumes these in the
    // _start stub; win64 ignores them.
    ArgcGlobalIndex: Integer;
    ArgvGlobalIndex: Integer;

    constructor Create(); override;
    destructor Destroy(); override;
  end;

  { TMyrImageWriter }
  // Base class for target image formats. One descendant per target/format.
  // Init() supplies the codegen context every writer body references; the
  // writer does not own any of it.
  TMyrImageWriter = class(TBaseObject)
  protected
    FCode: TMyrCodeBuilder;
    FPublicGlobals: TList<TPair<Integer, string>>;
    FLinkedLibs: TStringList;
    FLinkedObjs: TStringList;
    FOutputPath: string;
    FDumpIR: Boolean;
    // SysV -> internal-convention entry thunk. Shared by the .so writer
    // (export thunks) and the .a writer (public routine entry points) so the
    // bytes can never diverge. Sizing and emission share DoThunkRawSize.
    function DoThunkRawSize(const AFunc: TMyrFuncInfo): Cardinal;
    function DoEmitSysVEntryThunk(const AProduct: TMyrBuildProduct;
      const AFuncIndex: Integer; const AThunkBase: Cardinal;
      const ATextRVA: Cardinal; const AThunks: TMemoryStream;
      out AThunkRVA: Cardinal): Boolean;
    // Register every routine and global this module defines with the linker
    // as host symbols, so undefined references in linked static libs (their
    // RT_* runtime calls and globals) bind to the one runtime this image
    // carries. Call after Linker.Resolve(): a lib member's own definition
    // is already in the map and keeps precedence.
    procedure DoRegisterHostSymbols(const AProduct: TMyrBuildProduct);
  public
    procedure Init(const ACode: TMyrCodeBuilder;
      const APublicGlobals: TList<TPair<Integer, string>>;
      const ALinkedLibs: TStringList;
      const ALinkedObjs: TStringList;
      const AOutputPath: string;
      const ADumpIR: Boolean);
    function WriteImage(const AProduct: TMyrBuildProduct;
      const AData: TMyrDataBuilder;
      const AGlobals: TMyrDataBuilder;
      const AImports: TMyrImportBuilder;
      const AExports: TMyrExportBuilder;
      const AOutputType: TMyrOutputType;
      const ASubsystem: TMyrSubsystem): TBytes; virtual; abstract;
  end;

{ RebuildProductIData }
// Single source for the PE import directory (.idata): descriptor table, DLL
// names, hint/name table, IAT, INT, and the per-import IATEntries map. Built
// once by TMyrCodegen after import registration, and rebuilt by the PE writer
// whenever late-materialized imports (COFF import-library records) are added
// after archive resolution -- the two call sites must never diverge, so the
// logic lives here and nowhere else. Clears and repopulates ImportDlls,
// ImportsByDll, IATEntries, IDataSection and the .idata offset fields.
procedure RebuildProductIData(const AProduct: TMyrBuildProduct;
  const AImports: TMyrImportBuilder);

const
  MYR_ERR_IR_NO_ACTIVE_FUNCTION = 'I0001';
  MYR_ERR_IR_UNKNOWN_TYPE       = 'I0002';
  MYR_ERR_IR_TYPE_BUILD         = 'I0003';
  MYR_ERR_IR_OVERLOAD_C_LINKAGE = 'I0004';
  MYR_ERR_IR_VARIADIC_OVERLOAD  = 'I0005';
  MYR_ERR_TOO_MANY_ARGS     = 'Y0001';

  // System V x86-64 passes syscall arguments in RDI, RSI, RDX, R10, R8, R9.
  MAX_SYSCALL_ARGS = 6;

type
  // Forward Declarations
  TMyrIR = class;

  { TMyrIRExpr }
  TMyrIRExpr = record
    Index: Integer;

    class function None(): TMyrIRExpr; static;
    function IsValid(): Boolean;

    class operator Implicit(const AValue: Integer): TMyrIRExpr;
    class operator Implicit(const AValue: Int64): TMyrIRExpr;
    class operator Implicit(const AValue: Double): TMyrIRExpr;
  end;

  { TMyrTypeRef }
  TMyrTypeRef = record
    IsPrimitive: Boolean;
    Primitive: TMyrValueType;    // Valid when IsPrimitive = True
    TypeIndex: Integer;          // Valid when IsPrimitive = False (index into type registry)

    class function FromPrimitive(const AType: TMyrValueType): TMyrTypeRef; static;
    class function FromComposite(const AIndex: Integer): TMyrTypeRef; static;
    class function None(): TMyrTypeRef; static;
    function IsValid(): Boolean;
    function ToString(): string;

    class operator Equal(const A: TMyrTypeRef; const B: TMyrTypeRef): Boolean;
    class operator NotEqual(const A: TMyrTypeRef; const B: TMyrTypeRef): Boolean;
  end;

  { TMyrIRCaseRange }
  // A range arm is a distinct concept from a discrete case value, so it gets
  // its own record and its own parallel array on TMyrIRStmt rather than being
  // encoded into CaseValues.
  // Fields are LowValue/HighValue - Low and High are Delphi intrinsics.
  TMyrIRCaseRange = record
    LowValue: Int64;
    HighValue: Int64;
  end;

  { TMyrIR - High-level fluent IR builder }
  TMyrIR = class(TBaseObject)
  public type

    { TMyrIRImport }
    TMyrIRImport = record
      DllName: string;
      FuncName: string;
      // Exported symbol when it differs from FuncName (re-export forwarding
      // thunks reference the import under a derived FuncName). Empty = same
      // as FuncName.
      ExternalName: string;
      ParamTypes: TArray<TMyrValueType>;
      ParamTypeRefs: TArray<TMyrTypeRef>;    // Composite-aware param types
      ParamTypeNames: TArray<string>;        // Original type name strings
      ReturnType: TMyrValueType;
      // Composite-aware return type (twin of ParamTypeRefs). Only meaningful
      // when HasReturnTypeRef is True; a Default TMyrTypeRef is indistinguishable
      // from composite #0, so the flag is the authority, never IsValid().
      ReturnTypeRef: TMyrTypeRef;
      HasReturnTypeRef: Boolean;
      IsVarArgs: Boolean;
      IsStatic: Boolean;       // True for ImportLib (static linking)
      Linkage: TMyrLinkage;  // plC = raw name, plCPP = Itanium mangled
      HostAddr: Pointer;       // non-nil = host function pointer (in-memory compilation only)
      // A call to this import never returns (RT_Halt externalized into a
      // static lib). Noreturn is a property of the callee's declared ABI,
      // not of whether its body is local, so the import carries it too.
      IsNoReturn: Boolean;
    end;

    { TMyrIRString }
    TMyrIRString = record
      Value: string;
      IsWide: Boolean;
    end;

    { TMyrIRGlobal }
    TMyrIRGlobal = record
      GlobalName: string;
      GlobalType: TMyrValueType;
      GlobalTypeRef: TMyrTypeRef;  // For composite/managed types (string)
      InitExpr: Integer;  // -1 if uninitialized
      IsPublic: Boolean;  // If True, exported in DLL .edata section
      ImportIndex: Integer;  // -1 = local storage; >=0 = index into FImports (data import via IAT)
    end;

    { TMyrIRVar }
    TMyrIRVar = record
      VarName: string;
      VarTypeRef: TMyrTypeRef;  // Supports both primitive and composite types
      IsParam: Boolean;
      IsByRef: Boolean;
    end;

    { TMyrIRExprKind }
    TMyrIRExprKind = (
      ekNone,
      ekConstInt,
      ekConstFloat,
      ekConstString,
      ekVariable,
      ekBinary,
      ekUnary,
      ekCall,
      ekFieldAccess,       // record.field
      ekArrayIndex,        // array[index]
      ekFuncAddr,          // @funcName
      ekCallIndirect,      // funcPtr(args)
      ekGetExceptionCode,  // getexceptioncode()
      ekGetExceptionMsg,   // getexceptionmessage()
      ekSetLiteral,        // {1, 3, 5..10}
      ekVaCount,           // VaCount()
      ekVaArgAt,           // VaArg(index, type)
      ekSyscall            // Syscall(number, args...)
    );

    {$SCOPEDENUMS ON}
    { TMyrIROpKind }
    TMyrIROpKind = (
      opNone,
      // Arithmetic
      opAdd,
      opSub,
      opMul,
      opDiv,
      opMod,
      // Unsigned division and remainder - IDIV sign-extends via CQO and is
      // wrong for any dividend >= 2^63. Distinct kinds, chosen by the frontend.
      opUDiv,
      opUMod,
      opNeg,
      // Float arithmetic
      opFAdd,
      opFSub,
      opFMul,
      opFDiv,
      opFNeg,
      // Type conversion
      opIntToFloat,
      opUIntToFloat,
      opFloatToInt,
      opFloatToUInt,
      opFloat32ToFloat64,
      // Bitwise
      opBitAnd,
      opBitOr,
      opBitXor,
      opBitNot,
      opShl,
      opShr,
      // Comparison
      opCmpEq,
      opCmpNe,
      opCmpLt,
      opCmpLe,
      opCmpGt,
      opCmpGe,
      // Unsigned Comparison - equality is sign-agnostic, so no opUCmpEq/Ne
      opUCmpLt,
      opUCmpLe,
      opUCmpGt,
      opUCmpGe,
      // Float Comparison
      opFCmpEq,
      opFCmpNe,
      opFCmpLt,
      opFCmpLe,
      opFCmpGt,
      opFCmpGe,
      // Logical
      opAnd,
      opOr,
      opNot,
      // Pointer
      opAddrOf,
      opDeref,
      // Set operations
      opSetUnion,     // set1 + set2
      opSetDiff,      // set1 - set2
      opSetInter,     // set1 * set2
      opSetIn,        // element in set
      opSetEq,        // set1 = set2
      opSetNe,        // set1 <> set2
      opSetSubset,    // set1 <= set2
      opSetSuperset   // set1 >= set2
    );
    {$SCOPEDENUMS OFF}

    { TMyrIRExprNode }
    TMyrIRExprNode = record
      Kind: TMyrIRExprKind;
      ResultType: TMyrTypeRef;   // Type this expression evaluates to
      ConstInt: Int64;
      ConstFloat: Double;
      StringIndex: Integer;
      VarName: string;
      Op: TMyrIROpKind;
      Left: Integer;
      Right: Integer;
      CallTarget: string;
      CallArgs: TArray<Integer>;
      // For ekFieldAccess
      ObjectExpr: Integer;       // Expression yielding record/object
      FieldName: string;         // Field name to access
      FieldOffset: Integer;      // Pre-computed byte offset
      FieldSize: Integer;        // Pre-computed field size
      BitWidth: Integer;         // 0 = full field, >0 = bit field width
      BitOffset: Integer;        // Bit position within storage unit
      // For ekArrayIndex
      ArrayExpr: Integer;        // Expression yielding array
      IndexExpr: Integer;        // Expression yielding index
      ElementSize: Integer;      // Pre-computed element size
      // For ekFuncAddr
      FuncAddrName: string;      // Name of function to take address of
      // For ekCallIndirect
      IndirectTarget: Integer;   // Expression index of function pointer
      // For set operations
      SetLowBound: Integer;      // LowBound for SetIn (element adjustment)
      // For ekSetLiteral
      SetTypeIndex: Integer;     // Index into type registry for set type
      SetElements: TArray<Integer>;  // Individual element values (adjusted by LowBound)
      // For ekVaArgAt
      VaArgIndex: Integer;       // Expression index for the arg index
      VaArgType: TMyrValueType;  // Type to read as
      // For ekSyscall
      SyscallNumber: Integer;    // Expression index for the syscall number
                                 // (arguments reuse CallArgs)
      // Source location
      SourceFile: string;
      SourceLine: Integer;
      SourceCol: Integer;
    end;

    { TMyrIRStmtKind }
    TMyrIRStmtKind = (
      skAssign,
      skBlockCopy,
      skCall,
      skReturn,
      skReturnValue,
      skWhenBegin,
      skOtherwiseBegin,
      skWhenEnd,
      skLoopBegin,
      skLoopEnd,
      skLoopBreak,
      skLoopContinue,
      skCountBegin,
      skCountEnd,
      skDoRepeatBegin,
      skDoRepeatEnd,
      skMatchBegin,
      skOn,
      skOnElse,
      skMatchEnd,
      skCallIndirect,
      skGuardBegin,
      skCatchBegin,
      skEnsureBegin,
      skGuardEnd,
      skThrow,
      skThrowCode
    );

    { TMyrIRStmt }
    TMyrIRStmt = record
      Kind: TMyrIRStmtKind;
      DestVar: string;
      DestExpr: Integer;       // For assigning to field/index expressions (-1 = use DestVar)
      Expr: Integer;
      // For skBlockCopy: byte count of a whole-object move. DestExpr holds
      // the DESTINATION address expression and Expr the SOURCE address
      // expression; both are addresses, never composite values.
      CopySize: Integer;
      CallTarget: string;
      CallArgs: TArray<Integer>;
      ForVar: string;
      ForFrom: Integer;
      ForTo: Integer;
      ForDownTo: Boolean;
      CaseValues: TArray<Int64>;      // Raw integer values for CaseOf matching
      CaseRanges: TArray<TMyrIRCaseRange>; // Inclusive low..high range arms
      // Ordering to use for compares this statement lowers (match range arms,
      // for-loop bound tests). The operands reach SSA as untyped vars, so the
      // frontend must stamp this - SSA cannot recover signedness on its own.
      IsUnsignedCompare: Boolean;
      IndirectTarget: Integer;        // Expression index for indirect calls
      RaiseMsg: Integer;              // Expression index for raise message
      RaiseCode: Integer;             // Expression index for raise code (skThrowCode only)
      SourceLine: Integer;            // Source line number (0 = not set)
      SourceColumn: Integer;          // Source column number (0 = not set)
      SourceFile: string;             // Source file path ('' = not set)
    end;

    { TMyrIRFunc }
    TMyrIRFunc = record
      FuncName: string;
      ReturnType: TMyrValueType;
      ReturnTypeRef: TMyrTypeRef;      // Named/composite return type (string, wstring, structs)
      ReturnSize: Integer;          // Size in bytes (for composite return types)
      ReturnAlignment: Integer;     // Alignment in bytes (for ABI classification)
      IsEntryPoint: Boolean;
      IsDllEntry: Boolean;        // If True, this is the DllMain entry point
      IsPublic: Boolean;          // If True, export this function
      Linkage: TMyrLinkage;
      ParamTypes: TArray<TMyrValueType>;  // For mangling
      Vars: TList<TMyrIRVar>;
      Stmts: TList<TMyrIRStmt>;
      IsVariadic: Boolean;        // If True, function accepts variadic args
      // If True, a call to this function never returns to the caller
      // (RT_Halt, and any future @noreturn routine). A call to a noreturn
      // function is a block TERMINATOR, the same as return: EndFunc appends
      // no implicit return after it, and cleanup passes treat it as an exit.
      // Passes must read this flag, never match on FuncName.
      IsNoReturn: Boolean;
    end;

    { TMyrBlockKind }
    TMyrBlockKind = (
      bkWhen,
      bkOtherwise,
      bkLoop,
      bkCount,
      bkRepeat,
      bkMatch,
      bkGuard,
      bkCatch,
      bkEnsure
    );

    { TMyrBlockInfo }
    TMyrBlockInfo = record
      Kind: TMyrBlockKind;
      LabelStart: TMyrLabelHandle;
      LabelEnd: TMyrLabelHandle;
      LabelElse: TMyrLabelHandle;
      ForVar: string;
      ForTo: Integer;
      ForDownTo: Boolean;
      CaseSelectorExpr: Integer;       // Expression index of case selector
      LabelNextCase: TMyrLabelHandle;  // Label for next CaseOf/CaseElse/CaseEnd
    end;

    { TMyrIRTypeKind }
    TMyrIRTypeKind = (
      tkRecord,
      tkUnion,
      tkFixedArray,
      tkDynArray,
      tkEnum,
      tkAlias,
      tkPointer,
      tkRoutine,
      tkSet
    );

    { TMyrIRRecordField }
    TMyrIRRecordField = record
      FieldName: string;
      FieldType: TMyrTypeRef;
      FieldOffset: Integer;     // Computed during finalization (byte offset)
      BitWidth: Integer;        // 0 = full width, >0 = bit field width
      BitOffset: Integer;       // Bit position within storage unit (0-63)
      OverlayGroup: Integer;    // Records: 0 = normal, >0 = overlay group (anon union)
      AnonRecordGroup: Integer; // Unions: 0 = normal, >0 = sequential group (anon record)
    end;

    { TMyrIRRecordType }
    TMyrIRRecordType = record
      TypeName: string;
      Fields: TArray<TMyrIRRecordField>;
      TotalSize: Integer;    // Computed during finalization
      Alignment: Integer;    // Computed during finalization
      ExplicitAlign: Integer; // 0 = natural, else 1/2/4/8/16
      BaseTypeIndex: Integer; // -1 = no base, else index into FTypes
      IsPacked: Boolean;
      IsFinalized: Boolean;
    end;

    //--------------------------------------------------------------------------
    { TMyrIRUnionType }
    TMyrIRUnionType = record
      TypeName: string;
      Fields: TArray<TMyrIRRecordField>;  // Reuse field type, all at offset 0
      TotalSize: Integer;              // Max field size
      Alignment: Integer;              // Max field alignment
      IsFinalized: Boolean;
    end;

    { TMyrIRFixedArrayType }
    TMyrIRFixedArrayType = record
      TypeName: string;
      ElementType: TMyrTypeRef;
      LowBound: Integer;
      HighBound: Integer;
      TotalSize: Integer;    // Computed: (High - Low + 1) * ElementSize
    end;

    { TMyrIRDynArrayType }
    TMyrIRDynArrayType = record
      TypeName: string;
      ElementType: TMyrTypeRef;
      // Runtime layout: pointer to record with Length + Data
    end;

    { TMyrIREnumValue }
    TMyrIREnumValue = record
      ValueName: string;
      OrdinalValue: Int64;
    end;

    { TMyrIREnumType }
    TMyrIREnumType = record
      TypeName: string;
      Values: TArray<TMyrIREnumValue>;
      BaseType: TMyrValueType;  // Usually vtInt32
    end;

    { TMyrIRAliasType }
    TMyrIRAliasType = record
      TypeName: string;
      AliasedType: TMyrTypeRef;
    end;

    { TMyrIRPointerType }
    TMyrIRPointerType = record
      TypeName: string;
      PointeeType: TMyrTypeRef;  // Type being pointed to (None = untyped)
      IsConst: Boolean;          // pointer to const T
    end;

    { TMyrIRRoutineType }
    TMyrIRRoutineType = record
      TypeName: string;
      ParamTypes: TArray<TMyrTypeRef>;
      ReturnType: TMyrTypeRef;
      Linkage: TMyrLinkage;
      IsVarArgs: Boolean;
    end;

    { TMyrIRSetType }
    TMyrIRSetType = record
      TypeName: string;
      LowBound: Integer;     // Minimum element value (offset)
      HighBound: Integer;    // Maximum element value
      BaseType: TMyrTypeRef; // For enum-based sets, None for integer ranges
      StorageSize: Integer;  // 1, 2, 4, or 8 bytes based on range span
    end;

    { TMyrIRTypeEntry }
    TMyrIRTypeEntry = record
      Kind: TMyrIRTypeKind;
      RecordType: TMyrIRRecordType;
      UnionType: TMyrIRUnionType;
      FixedArrayType: TMyrIRFixedArrayType;
      DynArrayType: TMyrIRDynArrayType;
      EnumType: TMyrIREnumType;
      AliasType: TMyrIRAliasType;
      PointerType: TMyrIRPointerType;
      RoutineType: TMyrIRRoutineType;
      SetType: TMyrIRSetType;
    end;

