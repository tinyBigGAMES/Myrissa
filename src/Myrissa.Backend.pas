{ TMyrTargetInfo }

class function TMyrTargetInfo.FileExt(const ATarget: TMyrTargetKind; const AOutputType: TMyrOutputType): string;
begin
  Result := '';

  case ATarget of
    tgWin64:
      case AOutputType of
        otExe: Result := '.exe';
        otDll: Result := '.dll';
        otLib: Result := '.lib';
        otObj: Result := '.obj';
      end;

    tgLinux64:
      case AOutputType of
        otExe: Result := '';
        otDll: Result := '.so';
        otLib: Result := '.a';
        otObj: Result := '.o';
      end;
  end;
end;

class function TMyrTargetInfo.TargetText(const ATarget: TMyrTargetKind): string;
begin
  Result := '';

  case ATarget of
    tgWin64:   Result := 'win64';
    tgLinux64: Result := 'linux64';
  end;
end;

{ TMyrDataHandle }
class function TMyrDataHandle.Invalid(): TMyrDataHandle;
begin
  Result.Index := -1;
end;

function TMyrDataHandle.IsValid(): Boolean;
begin
  Result := Index >= 0;
end;

class operator TMyrDataHandle.Equal(const A, B: TMyrDataHandle): Boolean;
begin
  Result := A.Index = B.Index;
end;

class operator TMyrDataHandle.NotEqual(const A, B: TMyrDataHandle): Boolean;
begin
  Result := A.Index <> B.Index;
end;

