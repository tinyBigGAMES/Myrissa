  { TMyrExpr }
  TMyrExpr = record
    Index: Integer;
    Owner: Pointer;

    // Arithmetic — returns TMyrExpr
    class operator Add(const A, B: TMyrExpr): TMyrExpr;
    class operator Subtract(const A, B: TMyrExpr): TMyrExpr;
    class operator Multiply(const A, B: TMyrExpr): TMyrExpr;
    class operator IntDivide(const A, B: TMyrExpr): TMyrExpr;
    class operator Modulus(const A, B: TMyrExpr): TMyrExpr;
    class operator Negative(const A: TMyrExpr): TMyrExpr;

    // Bitwise — returns TMyrExpr
    class operator BitwiseAnd(const A, B: TMyrExpr): TMyrExpr;
    class operator BitwiseOr(const A, B: TMyrExpr): TMyrExpr;
    class operator BitwiseXor(const A, B: TMyrExpr): TMyrExpr;
    class operator LogicalNot(const A: TMyrExpr): TMyrExpr;

    // Implicit conversions from Delphi literals
    class operator Implicit(const AValue: Int64): TMyrExpr;
    class operator Implicit(const AValue: Double): TMyrExpr;
    class operator Implicit(const AValue: Boolean): TMyrExpr;

    // Comparisons — method syntax (Delphi forces Boolean return on operators)
    function Eq(const AOther: TMyrExpr): TMyrExpr;
    function Ne(const AOther: TMyrExpr): TMyrExpr;
    function Lt(const AOther: TMyrExpr): TMyrExpr;
    function Le(const AOther: TMyrExpr): TMyrExpr;
    function Gt(const AOther: TMyrExpr): TMyrExpr;
    function Ge(const AOther: TMyrExpr): TMyrExpr;
    // Unsigned relational forms. Equality needs no unsigned variant.
    function ULt(const AOther: TMyrExpr): TMyrExpr;
    function ULe(const AOther: TMyrExpr): TMyrExpr;
    function UGt(const AOther: TMyrExpr): TMyrExpr;
    function UGe(const AOther: TMyrExpr): TMyrExpr;

    // Composite access — chained
    function Field(const AFieldName: string): TMyrExpr;
    function At(const AIndex: TMyrExpr): TMyrExpr;
  end;

  // Express Factor Callbacks
  TMyrExprBinaryFunc  = function(const AOwner: Pointer; const AOp: TMyrOpKind; const ALeft, ARight: Integer): TMyrExpr;
  TMyrExprUnaryFunc   = function(const AOwner: Pointer; const AOp: TMyrOpKind; const AOperand: Integer): TMyrExpr;
  TMyrExprFromIntFunc = function(const AOwner: Pointer; const AValue: Int64): TMyrExpr;
  TMyrExprFromFltFunc = function(const AOwner: Pointer; const AValue: Double): TMyrExpr;
  TMyrExprFromBoolFunc = function(const AOwner: Pointer; const AValue: Boolean): TMyrExpr;
  TMyrExprFieldFunc   = function(const AOwner: Pointer; const AExprIdx: Integer; const AFieldName: string): TMyrExpr;
  TMyrExprIndexFunc   = function(const AOwner: Pointer; const AArrIdx: Integer; const AIdxIdx: Integer): TMyrExpr;

  { TMyrExprFactory }
  TMyrExprFactory = record
    class var OnBinary:   TMyrExprBinaryFunc;
    class var OnUnary:    TMyrExprUnaryFunc;
    class var OnFromInt:  TMyrExprFromIntFunc;
    class var OnFromFlt:  TMyrExprFromFltFunc;
    class var OnFromBool: TMyrExprFromBoolFunc;
    class var OnField:    TMyrExprFieldFunc;
    class var OnIndex:    TMyrExprIndexFunc;
  end;

  { TMyrOperand }
  TMyrOperand = record
    Kind: TMyrOperandKind;
    ValueType: TMyrValueType;
    ImmInt: Int64;
    ImmFloat: Double;
    DataHandle: TMyrDataHandle;
    ImportHandle: TMyrImportHandle;
    LocalHandle: TMyrLocalHandle;
    TempHandle: TMyrTempHandle;
    FuncHandle: TMyrFuncHandle;

    class function None(): TMyrOperand; static;
    class function FromImm(const AValue: Int64): TMyrOperand; overload; static;
    class function FromImm(const AValue: Double): TMyrOperand; overload; static;
    class function FromData(const AHandle: TMyrDataHandle): TMyrOperand; static;
    class function FromGlobal(const AHandle: TMyrDataHandle): TMyrOperand; static;
    class function FromImport(const AHandle: TMyrImportHandle): TMyrOperand; static;
    class function FromLocal(const AHandle: TMyrLocalHandle): TMyrOperand; static;
    class function FromTemp(const AHandle: TMyrTempHandle): TMyrOperand; static;
    class function FromFunc(const AHandle: TMyrFuncHandle): TMyrOperand; static;

    class operator Implicit(const AValue: Integer): TMyrOperand;
    class operator Implicit(const AValue: Int64): TMyrOperand;
    class operator Implicit(const AValue: Cardinal): TMyrOperand;
    class operator Implicit(const AValue: UInt64): TMyrOperand;
    class operator Implicit(const AValue: Single): TMyrOperand;
    class operator Implicit(const AValue: Double): TMyrOperand;
    class operator Implicit(const AValue: TMyrDataHandle): TMyrOperand;
    class operator Implicit(const AValue: TMyrImportHandle): TMyrOperand;
    class operator Implicit(const AValue: TMyrLocalHandle): TMyrOperand;
    class operator Implicit(const AValue: TMyrTempHandle): TMyrOperand;
    class operator Implicit(const AValue: TMyrFuncHandle): TMyrOperand;
  end;

  { TMyrDataEntry }
  TMyrDataEntry = record
    Offset: Cardinal;
    Size: Cardinal;
    DataType: TMyrValueType;
  end;

  { TMyrImportEntry }
  TMyrImportEntry = record
    // Two distinct identities, deliberately separate. For an ordinary import
    // they hold the same string; a public re-export is the case where they
    // must differ.
    //   FuncName     - the symbol THIS object references (obj symtab, relocs)
    //   ExternalName - the symbol the library EXPORTS (IAT / GOT / .dynstr /
    //                  import directory / loader lookup)
    DllName: string;
    FuncName: string;
    ExternalName: string;
    IATOffset: Cardinal;
    ReturnType: TMyrValueType;
    IsStatic: Boolean;
    Linkage: TMyrLinkage;
    ParamTypes: TArray<TMyrValueType>;
    HostAddr: Pointer;           // non-nil = host function, skip DLL resolution
  end;

  { TMyrShortImportEntry }
  // One IMPORT_OBJECT record parsed from a COFF import library member
  // (the short-import format every Windows toolchain ships beside a DLL).
  // SymbolName is the import name after name-type decoding; DllName is the
  // owning DLL as recorded in the member (e.g. 'msvcrt.dll').
  TMyrShortImportEntry = record
    SymbolName: string;
    // The symbol the referencing object actually names (a forwarding thunk
    // references its import under a derived name). Equal to SymbolName for
    // ordinary import-library records.
    ReferencedName: string;
    DllName: string;
    OrdinalOrHint: Word;
    ByOrdinal: Boolean;          // True = import by ordinal (no usable name)
  end;

  { TMyrExportEntry }
  TMyrExportEntry = record
    FuncName: string;
    ExportName: string;
    FuncIndex: Integer;
  end;

  { TMyrParamInfo }
  TMyrParamInfo = record
    ParamName: string;
    ParamType: TMyrValueType;
    ParamSize: Integer;
    ParamAlignment: Integer;
    IsByRef: Boolean;
  end;

  { TMyrLocalInfo }
  TMyrLocalInfo = record
    LocalName: string;
    LocalType: TMyrValueType;
    LocalSize: Integer;
    LocalAlignment: Integer;
    StackOffset: Integer;
  end;

  { TMyrLabelInfo }
  TMyrLabelInfo = record
    LabelName: string;
    CodeOffset: Integer;
    IsDefined: Boolean;
  end;

  { TMyrInstruction }
  TMyrInstruction = record
    Kind: TMyrInstrKind;
    Dest: TMyrTempHandle;
    Op1: TMyrOperand;
    Op2: TMyrOperand;
    LabelTarget: TMyrLabelHandle;
    FuncTarget: TMyrFuncHandle;
    ImportTarget: TMyrImportHandle;
    Args: TArray<TMyrOperand>;
    MemSize: Integer;            // Memory access size (0=default 8, 1/2/4/8)
    MemIsFloat: Boolean;         // True for float32/float64 field access
    MemIsSigned: Boolean;        // True for signed integer loads (sign-extend)
    // Callee return size in bytes for an INDIRECT call (ikCallIndirect only).
    // A direct ikCall reads this from TMyrFuncInfo.ReturnSize via FuncTarget, but
    // an indirect target has no TMyrFuncInfo, so the size resolved from the
    // routine type is carried here instead. > 8 selects the hidden-return-
    // pointer (sret) convention. 0 means unknown or not a composite.
    ReturnSize: Integer;
    // Byte count for ikBlockCopy. Op1 holds the DESTINATION address and Op2
    // the SOURCE address; both must already be addresses, never composite
    // locals - the emitter does not take addresses itself. Distinct from
    // MemSize (scalar access width 1/2/4/8) and from ReturnSize (callee
    // return width): this is the size of a whole-object move.
    CopySize: Integer;
    SourceLine: Integer;         // Source line number (0 = not set)
    SourceColumn: Integer;       // Source column number (0 = not set)
    SourceFile: string;          // Source file path ('' = not set)
  end;

  { TMyrExceptionScope }
  TMyrExceptionScope = record
    TryBeginLabel: TMyrLabelHandle;
    TryEndLabel: TMyrLabelHandle;
    ExceptLabel: TMyrLabelHandle;
    FinallyLabel: TMyrLabelHandle;
    EndLabel: TMyrLabelHandle;
  end;

  { TMyrFuncInfo }
  TMyrFuncInfo = record
    FuncName: string;
    IsEntryPoint: Boolean;
    IsDllEntry: Boolean;
    IsPublic: Boolean;
    Linkage: TMyrLinkage;
    ExportName: string;
    ReturnType: TMyrValueType;
    ReturnSize: Integer;
    ReturnAlignment: Integer;
    Params: TArray<TMyrParamInfo>;
    Locals: TArray<TMyrLocalInfo>;
    Labels: TArray<TMyrLabelInfo>;
    Instructions: TArray<TMyrInstruction>;
    TempCount: Integer;
    ExceptionScopes: TArray<TMyrExceptionScope>;
    IsVariadic: Boolean;
  end;

