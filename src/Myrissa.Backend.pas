    Symbols: TArray<TMyrCOFFSymbol>;
    // /DEFAULTLIB names parsed from this object's .drectve section (no ext)
    DefaultLibs: TArray<string>;
    // DLL bindings parsed from this object's .myrissa.needdll section
    // (COFF twin of ELF .note.myrissa.needdll): referenced symbol,
    // exported symbol, owning DLL. Myrissa-only; foreign linkers discard
