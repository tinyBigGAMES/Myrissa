    FStrReleaseTarget: TMyrSSAOperand;  // Index of Pax_StrRelease function for string cleanup
    FStrAddRefTarget: TMyrSSAOperand;   // Index of RT_StrAddRef for borrowed-param returns
    FFreMemTarget: TMyrSSAOperand;     // Index of Cbr_FreeMem for raw pointer cleanup
    FDynFreeTarget: TMyrSSAOperand;    // Index of Cbr_DynFree for dynamic array cleanup
    FReportLeaksTarget: TMyrSSAOperand;  // Index of Pax_ReportLeaks function (debug only)
    FReleaseOnDetachTarget: TMyrSSAOperand;  // Index of Cbr_ReleaseOnDetach for DLL cleanup
    FFreeOnDetachTarget: TMyrSSAOperand;  // Index of Cbr_FreeOnDetach for DLL wstring cleanup
    FDynFreeOnDetachTarget: TMyrSSAOperand;  // Index of Cbr_DynFreeOnDetach for DLL dynarray cleanup
    FArrayReleaseTarget: TMyrSSAOperand;  // Index of RT_ArrayRelease for fixed managed arrays
    FArrayReleaseOnDetachTarget: TMyrSSAOperand;  // Index of RT_ArrayReleaseOnDetach for DLL fixed managed arrays
    FDynLenTarget: TMyrSSAOperand;  // Index of RT_DynLen - runtime element count for dynarrays of managed elements
    FArrayReleaseCompositeTarget: TMyrSSAOperand;  // Index of RT_ArrayReleaseComposite - walks arrays of COMPOSITE elements via a per-type thunk
    FArrayReleaseCompositeOnDetachTarget: TMyrSSAOperand;  // Index of RT_ArrayReleaseCompositeOnDetach - DLL detach twin of the composite walker
    FExpressionCache: TDictionary<Integer, TMyrSSAVar>;  // Cache for converted expressions per function
    // Captured from the IR at build time for function-level DCE. Functions at
    // index >= FUserFuncCount are the injected runtime. When this module links
    // static libraries it is their runtime provider and must keep every
    // runtime routine alive: a lib's undefined RT_* references are only
    // discovered at link time, after DCE has run.
