{ TMyrSSAConstantFolding }
constructor TMyrSSAConstantFolding.Create();
begin
  inherited Create(spkConstantFolding, 'Constant Folding');
end;

procedure TMyrSSAConstantFolding.Run(const AFunc: TMyrSSAFunc);
var
  LBlockIdx: Integer;
  LInstrIdx: Integer;
  LBlock: TMyrSSABlock;
  LInstr: TMyrSSAInstr;
  LVal1: Int64;
  LVal2: Int64;
  LResult: Int64;
  LChanged: Boolean;
  LF1: Double;
  LF2: Double;
  LFResult: Double;
  LFoldsToInt: Boolean;
begin
  // Iterate all blocks and instructions
  for LBlockIdx := 0 to AFunc.GetBlockCount() - 1 do
  begin
    LBlock := AFunc.GetBlock(LBlockIdx);
    
    for LInstrIdx := 0 to LBlock.GetInstructionCount() - 1 do
    begin
      LInstr := LBlock.GetInstruction(LInstrIdx);
      LChanged := False;
      
      // Check if both operands are immediate INTEGER constants. The float
      // guard is load-bearing: this branch folds off ImmInt, which is not the
      // value of a float immediate. Arithmetic opcodes can carry float values
      // (the copy idiom lowers as add(value, 0)), so kind alone is not enough.
      if (LInstr.Op1.Kind = sokImmediate) and (LInstr.Op2.Kind = sokImmediate) and
         (not LInstr.Op1.ImmIsFloat) and (not LInstr.Op2.ImmIsFloat) then
      begin
        LVal1 := LInstr.Op1.ImmInt;
        LVal2 := LInstr.Op2.ImmInt;
        LResult := 0;
        
        case LInstr.Kind of
          sikAdd:
            begin
              LResult := LVal1 + LVal2;
              LChanged := True;
            end;
          sikSub:
            begin
              LResult := LVal1 - LVal2;
              LChanged := True;
            end;
          sikMul:
            begin
              LResult := LVal1 * LVal2;
              LChanged := True;
            end;
          sikDiv:
            begin
              if LVal2 <> 0 then
              begin
                LResult := LVal1 div LVal2;
                LChanged := True;
              end;
            end;
          sikMod:
            begin
              if LVal2 <> 0 then
              begin
                LResult := LVal1 mod LVal2;
                LChanged := True;
              end;
            end;
          sikUDiv:
            begin
              // LVal1/LVal2 are Int64; the UInt64 casts are what make this an
              // unsigned fold rather than a signed one on the same bits.
              if LVal2 <> 0 then
              begin
                LResult := Int64(UInt64(LVal1) div UInt64(LVal2));
                LChanged := True;
              end;
            end;
          sikUMod:
            begin
              if LVal2 <> 0 then
              begin
                LResult := Int64(UInt64(LVal1) mod UInt64(LVal2));
                LChanged := True;
              end;
            end;
          sikBitAnd:
            begin
              LResult := LVal1 and LVal2;
              LChanged := True;
            end;
          sikBitOr:
            begin
              LResult := LVal1 or LVal2;
              LChanged := True;
            end;
          sikBitXor:
            begin
              LResult := LVal1 xor LVal2;
              LChanged := True;
            end;
          sikShl:
            begin
              LResult := LVal1 shl LVal2;
              LChanged := True;
            end;
          sikShr:
            begin
              LResult := LVal1 shr LVal2;
              LChanged := True;
            end;
          sikCmpEq:
            begin
              if LVal1 = LVal2 then LResult := 1 else LResult := 0;
              LChanged := True;
            end;
          sikCmpNe:
            begin
              if LVal1 <> LVal2 then LResult := 1 else LResult := 0;
              LChanged := True;
            end;
          sikCmpLt:
            begin
              if LVal1 < LVal2 then LResult := 1 else LResult := 0;
              LChanged := True;
            end;
          sikCmpLe:
            begin
              if LVal1 <= LVal2 then LResult := 1 else LResult := 0;
              LChanged := True;
            end;
          sikCmpGt:
            begin
              if LVal1 > LVal2 then LResult := 1 else LResult := 0;
              LChanged := True;
            end;
          sikCmpGe:
            begin
              if LVal1 >= LVal2 then LResult := 1 else LResult := 0;
              LChanged := True;
            end;
          // Unsigned folds reinterpret the same 64-bit patterns as UInt64.
          // LVal1/LVal2 are Int64, so the cast is mandatory - without it
          // these would silently fold with signed ordering.
          sikUCmpLt:
            begin
              if UInt64(LVal1) < UInt64(LVal2) then LResult := 1 else LResult := 0;
              LChanged := True;
            end;
          sikUCmpLe:
            begin
              if UInt64(LVal1) <= UInt64(LVal2) then LResult := 1 else LResult := 0;
              LChanged := True;
            end;
          sikUCmpGt:
            begin
              if UInt64(LVal1) > UInt64(LVal2) then LResult := 1 else LResult := 0;
              LChanged := True;
            end;
          sikUCmpGe:
            begin
              if UInt64(LVal1) >= UInt64(LVal2) then LResult := 1 else LResult := 0;
              LChanged := True;
            end;
        end;
        
        // Replace with assignment of constant result
        if LChanged then
        begin
          LInstr.Kind := sikAssign;
          LInstr.Op1 := TMyrSSAOperand.FromImm(LResult);
          LInstr.Op2 := TMyrSSAOperand.None();
          LBlock.SetInstruction(LInstrIdx, LInstr);
        end;
      end
      // Handle unary ops with single immediate INTEGER operand
      else if (LInstr.Op1.Kind = sokImmediate) and (LInstr.Op2.Kind = sokNone) and
              (not LInstr.Op1.ImmIsFloat) then
      begin
        LVal1 := LInstr.Op1.ImmInt;
        LResult := 0;
        
        case LInstr.Kind of
          sikNeg:
            begin
              LResult := -LVal1;
              LChanged := True;
            end;
          sikBitNot:
            begin
              LResult := not LVal1;
              LChanged := True;
            end;
        end;
        
        if LChanged then
        begin
          LInstr.Kind := sikAssign;
          LInstr.Op1 := TMyrSSAOperand.FromImm(LResult);
          LBlock.SetInstruction(LInstrIdx, LInstr);
        end;
      end;

      // Float constant folding (binary: both imm; unary: op1 imm, op2 none)
      if (not LChanged) and
         (LInstr.Op1.Kind = sokImmediate) and
         ((LInstr.Op2.Kind = sokImmediate) or (LInstr.Op2.Kind = sokNone)) and
         (LInstr.Kind in [sikFAdd, sikFSub, sikFMul, sikFDiv, sikFNeg,
                          sikFCmpEq, sikFCmpNe, sikFCmpLt, sikFCmpLe,
                          sikFCmpGt, sikFCmpGe,
                          sikNeg]) then
      begin
        LF1 := LInstr.Op1.ImmFloat;
        LF2 := LInstr.Op2.ImmFloat;
        LFResult := 0.0;
        LResult := 0;
        // Comparisons yield an integer 0/1, not a float, so the writeback
        // below has to know which kind of immediate it is producing.
        LFoldsToInt := False;

        case LInstr.Kind of
          sikFAdd:
            begin
              LFResult := LF1 + LF2;
              LChanged := True;
            end;
          sikFSub:
            begin
              LFResult := LF1 - LF2;
              LChanged := True;
            end;
          sikFMul:
            begin
              LFResult := LF1 * LF2;
              LChanged := True;
            end;
          sikFDiv:
            begin
              if LF2 <> 0.0 then
              begin
                LFResult := LF1 / LF2;
                LChanged := True;
              end;
            end;
          sikFNeg,
          sikNeg:
            begin
              LFResult := -LF1;
              LChanged := True;
            end;
          // Comparison folds. Delphi's Double operators implement IEEE NaN
          // behaviour already (ordered tests against NaN are False, <> is
          // True), matching the UCOMISD sequences the emitter generates.
          sikFCmpEq:
            begin
              if LF1 = LF2 then LResult := 1 else LResult := 0;
              LFoldsToInt := True;
              LChanged := True;
            end;
          sikFCmpNe:
            begin
              if LF1 <> LF2 then LResult := 1 else LResult := 0;
              LFoldsToInt := True;
              LChanged := True;
            end;
          sikFCmpLt:
            begin
              if LF1 < LF2 then LResult := 1 else LResult := 0;
              LFoldsToInt := True;
              LChanged := True;
            end;
          sikFCmpLe:
            begin
              if LF1 <= LF2 then LResult := 1 else LResult := 0;
              LFoldsToInt := True;
              LChanged := True;
            end;
          sikFCmpGt:
            begin
              if LF1 > LF2 then LResult := 1 else LResult := 0;
              LFoldsToInt := True;
              LChanged := True;
            end;
          sikFCmpGe:
            begin
              if LF1 >= LF2 then LResult := 1 else LResult := 0;
              LFoldsToInt := True;
              LChanged := True;
            end;
        end;

        if LChanged then
        begin
          LInstr.Kind := sikAssign;
          if LFoldsToInt then
            LInstr.Op1 := TMyrSSAOperand.FromImm(LResult)
          else
            LInstr.Op1 := TMyrSSAOperand.FromImm(LFResult);
          LInstr.Op2 := TMyrSSAOperand.None();
          LBlock.SetInstruction(LInstrIdx, LInstr);
        end;
      end;
    end;
  end;
end;

{ TMyrSSAConstantPropagation }
constructor TMyrSSAConstantPropagation.Create();
begin
  inherited Create(spkConstantPropagation, 'Constant Propagation');
end;

procedure TMyrSSAConstantPropagation.Run(const AFunc: TMyrSSAFunc);
var
  LBlockIdx: Integer;
  LInstrIdx: Integer;
  LBlock: TMyrSSABlock;
  LInstr: TMyrSSAInstr;
  LConstants: TDictionary<string, TMyrSSAOperand>;  // Maps var name to constant operand
  LVarKey: string;
  LConstOp: TMyrSSAOperand;
  LChanged: Boolean;
  LArgIdx: Integer;
begin
  LConstants := TDictionary<string, TMyrSSAOperand>.Create();
  try
    // Pass 1: Collect all variables that are assigned constant values
    for LBlockIdx := 0 to AFunc.GetBlockCount() - 1 do
    begin
      LBlock := AFunc.GetBlock(LBlockIdx);
      
      for LInstrIdx := 0 to LBlock.GetInstructionCount() - 1 do
      begin
        LInstr := LBlock.GetInstruction(LInstrIdx);
        
        // Check for: var = immediate
        if (LInstr.Kind = sikAssign) and 
           (LInstr.Dest.IsValid()) and 
           (LInstr.Op1.Kind = sokImmediate) then
        begin
          LVarKey := LInstr.Dest.ToString();
          LConstants.AddOrSetValue(LVarKey, LInstr.Op1);
        end;
      end;
    end;
    
    // Pass 2: Replace variable uses with constants where possible
    for LBlockIdx := 0 to AFunc.GetBlockCount() - 1 do
    begin
      LBlock := AFunc.GetBlock(LBlockIdx);
      
      for LInstrIdx := 0 to LBlock.GetInstructionCount() - 1 do
      begin
        LInstr := LBlock.GetInstruction(LInstrIdx);
        LChanged := False;
        
        // Replace Op1 if it's a known constant.
        // Never rewrite an operand consumed as a storage location: addrof
        // of an immediate has no meaning. See InstrTakesOp1AsLocation.
        if (LInstr.Op1.Kind = sokVar) and
           (not InstrTakesOp1AsLocation(LInstr.Kind)) then
        begin
          LVarKey := LInstr.Op1.Var_.ToString();
          if LConstants.TryGetValue(LVarKey, LConstOp) then
          begin
            LInstr.Op1 := LConstOp;
            LChanged := True;
          end;
        end;
        
        // Replace Op2 if it's a known constant
        if (LInstr.Op2.Kind = sokVar) then
        begin
          LVarKey := LInstr.Op2.Var_.ToString();
          if LConstants.TryGetValue(LVarKey, LConstOp) then
          begin
            LConstOp.ElementSize := LInstr.Op2.ElementSize;
            LConstOp.FieldName := LInstr.Op2.FieldName;
            LConstOp.BitWidth := LInstr.Op2.BitWidth;
            LConstOp.BitOffset := LInstr.Op2.BitOffset;
            LInstr.Op2 := LConstOp;
            LChanged := True;
          end;
        end;
        
        // Replace call arguments if they're known constants
        for LArgIdx := 0 to High(LInstr.CallArgs) do
        begin
          if LInstr.CallArgs[LArgIdx].Kind = sokVar then
          begin
            LVarKey := LInstr.CallArgs[LArgIdx].Var_.ToString();
            if LConstants.TryGetValue(LVarKey, LConstOp) then
            begin
              LInstr.CallArgs[LArgIdx] := LConstOp;
              LChanged := True;
            end;
          end;
        end;
        
        if LChanged then
          LBlock.SetInstruction(LInstrIdx, LInstr);
      end;
    end;
    
  finally
    LConstants.Free();
  end;
end;

{ TMyrSSADeadCodeElimination }
constructor TMyrSSADeadCodeElimination.Create();
begin
  inherited Create(spkDeadCodeElimination, 'Dead Code Elimination');
end;

procedure TMyrSSADeadCodeElimination.Run(const AFunc: TMyrSSAFunc);
var
  LBlockIdx: Integer;
  LInstrIdx: Integer;
  LBlock: TMyrSSABlock;
  LInstr: TMyrSSAInstr;
  LUsedVars: TDictionary<string, Boolean>;
  LArgIdx: Integer;
  LPhiIdx: Integer;
  LVarKey: string;
  LToRemove: TList<Integer>;
  LI: Integer;
  LIsManagedLocal: Boolean;
begin
  LUsedVars := TDictionary<string, Boolean>.Create();
  try
    // Pass 1: Collect all used variables
    for LBlockIdx := 0 to AFunc.GetBlockCount() - 1 do
    begin
      LBlock := AFunc.GetBlock(LBlockIdx);
      
      for LInstrIdx := 0 to LBlock.GetInstructionCount() - 1 do
      begin
        LInstr := LBlock.GetInstruction(LInstrIdx);
        
        // Mark Op1 as used if it's a variable
        if LInstr.Op1.Kind = sokVar then
          LUsedVars.AddOrSetValue(LInstr.Op1.Var_.ToString(), True);
        
        // Mark Op2 as used if it's a variable
        if LInstr.Op2.Kind = sokVar then
          LUsedVars.AddOrSetValue(LInstr.Op2.Var_.ToString(), True);
        
        // Mark call arguments as used
        for LArgIdx := 0 to High(LInstr.CallArgs) do
        begin
          if LInstr.CallArgs[LArgIdx].Kind = sokVar then
            LUsedVars.AddOrSetValue(LInstr.CallArgs[LArgIdx].Var_.ToString(), True);
        end;
        
        // Mark phi operands as used
        for LPhiIdx := 0 to High(LInstr.PhiEntries) do
          LUsedVars.AddOrSetValue(LInstr.PhiEntries[LPhiIdx].Var_.ToString(), True);
      end;
    end;
    
    // Pass 2: Remove instructions that define unused variables
    for LBlockIdx := 0 to AFunc.GetBlockCount() - 1 do
    begin
      LBlock := AFunc.GetBlock(LBlockIdx);
      LToRemove := TList<Integer>.Create();
      try
        for LInstrIdx := 0 to LBlock.GetInstructionCount() - 1 do
        begin
          LInstr := LBlock.GetInstruction(LInstrIdx);
          
          // Skip instructions that don't define a variable
          if not LInstr.Dest.IsValid() then
            Continue;
          
          // Skip calls and syscalls (have side effects)
          if LInstr.Kind in [sikCall, sikCallAssign, sikSyscall] then
            Continue;
          
          // Skip control flow
          if LInstr.Kind in [sikJump, sikJumpIf, sikJumpIfNot, sikReturn, sikReturnValue] then
            Continue;
          
          // Check if the destination is used
          LVarKey := LInstr.Dest.ToString();
          if not LUsedVars.ContainsKey(LVarKey) then
          begin
            // A def is only dead if nothing observes it. Two observers live
            // OUTSIDE this function's SSA and are invisible to the use-scan
            // above:
            //   - managed locals: exit cleanup reads their stack slots via
            //     sikLoad(localIndex), not via an SSA use.
            //   - by-ref (var) params: the def is a store through the caller's
            //     pointer (codegen ikStore -> [ptr]). The caller reads it.
            // Both must survive DCE regardless of in-function uses.
            LIsManagedLocal := False;
            for LI := 0 to AFunc.GetLocalCount() - 1 do
            begin
              if (AFunc.GetLocal(LI).LocalName = LInstr.Dest.BaseName) and
                 (AFunc.GetLocal(LI).IsManaged or AFunc.GetLocal(LI).IsByRef) then
              begin
                LIsManagedLocal := True;
                Break;
              end;
            end;

            if not LIsManagedLocal then
              LToRemove.Add(LInstrIdx);
          end;
        end;
        
        // Remove dead instructions (in reverse order to preserve indices)
        for LI := LToRemove.Count - 1 downto 0 do
        begin
          // Convert to NOP instead of removing to avoid index issues
          LInstr := LBlock.GetInstruction(LToRemove[LI]);
          LInstr.Kind := sikNop;
          LInstr.Dest := TMyrSSAVar.None();
          LInstr.Op1 := TMyrSSAOperand.None();
          LInstr.Op2 := TMyrSSAOperand.None();
          LBlock.SetInstruction(LToRemove[LI], LInstr);
        end;
        
      finally
        LToRemove.Free();
      end;
    end;
    
  finally
    LUsedVars.Free();
  end;
end;

{ TMyrSSACopyPropagation }
constructor TMyrSSACopyPropagation.Create();
begin
  inherited Create(spkCopyPropagation, 'Copy Propagation', 2);  // Level 2
end;

procedure TMyrSSACopyPropagation.Run(const AFunc: TMyrSSAFunc);
var
  LBlockIdx: Integer;
  LInstrIdx: Integer;
  LBlock: TMyrSSABlock;
  LInstr: TMyrSSAInstr;
  LCopies: TDictionary<string, TMyrSSAOperand>;  // Maps dest to source
  LVarKey: string;
  LSourceOp: TMyrSSAOperand;
  LChanged: Boolean;
  LArgIdx: Integer;
begin
  LCopies := TDictionary<string, TMyrSSAOperand>.Create();
  try
    // Pass 1: Collect all copy instructions (x = y where y is a var or immediate)
    for LBlockIdx := 0 to AFunc.GetBlockCount() - 1 do
    begin
      LBlock := AFunc.GetBlock(LBlockIdx);
      
      for LInstrIdx := 0 to LBlock.GetInstructionCount() - 1 do
      begin
        LInstr := LBlock.GetInstruction(LInstrIdx);
        
        // Check for: dest = var (simple copy)
        // Skip emitter-materialized temps (__t*) — the emitter creates these
        // to ensure values survive across function call boundaries. Propagating
        // them away causes the codegen to lose spill slots for values that must
        // live across calls (e.g., string comparison results).
        if (LInstr.Kind = sikAssign) and 
           (LInstr.Dest.IsValid()) and 
           (LInstr.Op1.Kind = sokVar) and
           (not LInstr.Dest.BaseName.StartsWith('__t')) then
        begin
          LVarKey := LInstr.Dest.ToString();
          LCopies.AddOrSetValue(LVarKey, LInstr.Op1);
        end;
      end;
    end;

    // Pass 1b: An address-taken variable is NOT a valid copy source. Once
    // addrof(x) exists, x can be rewritten through memory (RT_StrAssign
    // stores the new string through &x), so "x = y" stops being an
    // invariant past that point. Propagating later reads of x to y then
    // reads the OLD value -- for a managed string, the already-released
    // rec. InstrTakesOp1AsLocation only protects the addrof operand
    // itself; this removes x from the candidate set entirely.
    // Repro: probe_b linux64 -opt full segfaulted (win64 survived by heap
    // luck), because s_0 = _t_2 was propagated into RT_StrData(s_0) and
    // RT_StrRelease(s_0) after RT_StrAssign(&s_0, ...) had replaced it.
    for LBlockIdx := 0 to AFunc.GetBlockCount() - 1 do
    begin
      LBlock := AFunc.GetBlock(LBlockIdx);

      for LInstrIdx := 0 to LBlock.GetInstructionCount() - 1 do
      begin
        LInstr := LBlock.GetInstruction(LInstrIdx);
        if (LInstr.Kind = sikAddressOf) and (LInstr.Op1.Kind = sokVar) then
          LCopies.Remove(LInstr.Op1.Var_.ToString());
      end;
    end;
    
    // Pass 2: Replace uses of copied variables with their sources
    for LBlockIdx := 0 to AFunc.GetBlockCount() - 1 do
    begin
      LBlock := AFunc.GetBlock(LBlockIdx);
      
      for LInstrIdx := 0 to LBlock.GetInstructionCount() - 1 do
      begin
        LInstr := LBlock.GetInstruction(LInstrIdx);
        LChanged := False;
        
        // Replace Op1 if it's a copied variable.
        // Never rewrite an operand consumed as a storage location: the
        // address of a variable is not the address of whatever that
        // variable was copied from. See InstrTakesOp1AsLocation.
        if (LInstr.Op1.Kind = sokVar) and
           (not InstrTakesOp1AsLocation(LInstr.Kind)) then
        begin
          LVarKey := LInstr.Op1.Var_.ToString();
          if LCopies.TryGetValue(LVarKey, LSourceOp) then
          begin
            LInstr.Op1 := LSourceOp;
            LChanged := True;
          end;
        end;
        
        // Replace Op2 if it's a copied variable
        if (LInstr.Op2.Kind = sokVar) then
        begin
          LVarKey := LInstr.Op2.Var_.ToString();
          if LCopies.TryGetValue(LVarKey, LSourceOp) then
          begin
            LSourceOp.ElementSize := LInstr.Op2.ElementSize;
            LSourceOp.FieldName := LInstr.Op2.FieldName;
            LSourceOp.BitWidth := LInstr.Op2.BitWidth;
            LSourceOp.BitOffset := LInstr.Op2.BitOffset;
            LInstr.Op2 := LSourceOp;
            LChanged := True;
          end;
        end;
        
        // Replace call arguments
        for LArgIdx := 0 to High(LInstr.CallArgs) do
        begin
          if LInstr.CallArgs[LArgIdx].Kind = sokVar then
          begin
            LVarKey := LInstr.CallArgs[LArgIdx].Var_.ToString();
            if LCopies.TryGetValue(LVarKey, LSourceOp) then
            begin
              LInstr.CallArgs[LArgIdx] := LSourceOp;
              LChanged := True;
            end;
          end;
        end;
        
        if LChanged then
          LBlock.SetInstruction(LInstrIdx, LInstr);
      end;
    end;
    
  finally
    LCopies.Free();
  end;
end;

{ TMyrSSACommonSubexprElim }
constructor TMyrSSACommonSubexprElim.Create();
begin
  inherited Create(spkCommonSubexprElim, 'Common Subexpression Elimination', 2);  // Level 2
end;

procedure TMyrSSACommonSubexprElim.Run(const AFunc: TMyrSSAFunc);
var
  LBlockIdx: Integer;
  LInstrIdx: Integer;
  LBlock: TMyrSSABlock;
  LInstr: TMyrSSAInstr;
  LExprMap: TDictionary<string, TMyrSSAVar>;  // Maps expression key to result var
  LExprBlockMap: TDictionary<string, Integer>;  // Maps expression key to defining block
  LExprKey: string;
  LExistingVar: TMyrSSAVar;
  LDefBlockIdx: Integer;

  // Check whether block ADomIdx dominates block ATargetIdx by walking the
  // immediate-dominator chain from the target up to the root.
  function BlockDominates(const ADomIdx: Integer; const ATargetIdx: Integer): Boolean;
  var
    LCur: Integer;
  begin
    LCur := ATargetIdx;
    while LCur >= 0 do
    begin
      if LCur = ADomIdx then
        Exit(True);
      LCur := AFunc.GetBlock(LCur).GetImmediateDominator();
    end;
    Result := False;
  end;

begin
  LExprMap := TDictionary<string, TMyrSSAVar>.Create();
  LExprBlockMap := TDictionary<string, Integer>.Create();
  try
    for LBlockIdx := 0 to AFunc.GetBlockCount() - 1 do
    begin
      LBlock := AFunc.GetBlock(LBlockIdx);
      
      for LInstrIdx := 0 to LBlock.GetInstructionCount() - 1 do
      begin
        LInstr := LBlock.GetInstruction(LInstrIdx);
        
        // Only handle binary arithmetic/comparison ops
        if not (LInstr.Kind in [sikAdd, sikSub, sikMul, sikDiv, sikMod,
                                sikUDiv, sikUMod,
                                sikFAdd, sikFSub, sikFMul, sikFDiv,
                                sikBitAnd, sikBitOr, sikBitXor, sikShl, sikShr,
                                sikCmpEq, sikCmpNe, sikCmpLt, sikCmpLe, sikCmpGt, sikCmpGe,
                                sikUCmpLt, sikUCmpLe, sikUCmpGt, sikUCmpGe,
                                sikFCmpEq, sikFCmpNe, sikFCmpLt, sikFCmpLe, sikFCmpGt, sikFCmpGe]) then
          Continue;
        
        // Build expression key: "op:operand1:operand2"
        LExprKey := Format('%d:%s:%s', [
          Ord(LInstr.Kind),
          LInstr.Op1.ToString(),
          LInstr.Op2.ToString()
        ]);
        
        // Reuse a cached result only when its defining block dominates us
        if LExprMap.TryGetValue(LExprKey, LExistingVar) and
           LExprBlockMap.TryGetValue(LExprKey, LDefBlockIdx) and
           BlockDominates(LDefBlockIdx, LBlockIdx) then
        begin
          // Replace with copy from existing result
          LInstr.Kind := sikAssign;
          LInstr.Op1 := TMyrSSAOperand.FromVar(LExistingVar);
          LInstr.Op2 := TMyrSSAOperand.None();
          LBlock.SetInstruction(LInstrIdx, LInstr);
        end
        else if not LExprMap.ContainsKey(LExprKey) then
        begin
          // Record this expression (first occurrence wins)
          LExprMap.Add(LExprKey, LInstr.Dest);
          LExprBlockMap.Add(LExprKey, LBlockIdx);
        end;
      end;
    end;
    
  finally
    LExprBlockMap.Free();
    LExprMap.Free();
  end;
end;

{ TMyrSSAStringCleanup }
constructor TMyrSSAStringCleanup.Create(const ASSABuilder: TMyrSSABuilder; const AIR: TMyrIR);
begin
  inherited Create(spkStringCleanup, 'String Cleanup', 0);  // Level 0 = always run
  FSSABuilder := ASSABuilder;
  FIR := AIR;
  FThunkCache := TDictionary<Integer, Integer>.Create();
end;

destructor TMyrSSAStringCleanup.Destroy();
begin
  FThunkCache.Free();
  inherited Destroy();
end;

function TMyrSSAStringCleanup.DoGetCompositeThunkIdx(const ATypeRef: TMyrTypeRef;
  const AStrRelease: TMyrSSAOperand; const AFreeMem: TMyrSSAOperand;
  const ADynFree: TMyrSSAOperand): Integer;
var
  LThunkFunc: TMyrSSAFunc;
  LBlock: TMyrSSABlock;
  LLoadInstr: TMyrSSAInstr;
  LRetInstr: TMyrSSAInstr;
  LInstrIdx: Integer;
  LThunkIdx: Integer;
  LNoPrefix: TMyrSSAOperand;
begin
  Result := -1;

  if not Assigned(FIR) or not Assigned(FSSABuilder) then
    Exit;

  // A primitive has no members to walk, so it never gets a thunk.
  if ATypeRef.IsPrimitive then
    Exit;

  if (ATypeRef.TypeIndex < 0) or (ATypeRef.TypeIndex >= FIR.GetTypeCount()) then
    Exit;

  // No managed members means nothing to release. Returning -1 here is what
  // stops the caller emitting a walk over an array that does not need one.
  if not FIR.IsManagedType(ATypeRef) then
    Exit;

  // One thunk per element TYPE, reused across every array of that type.
  if FThunkCache.TryGetValue(ATypeRef.TypeIndex, LThunkIdx) then
  begin
    Result := LThunkIdx;
    Exit;
  end;

  LThunkFunc := TMyrSSAFunc.Create(Format('RT_ReleaseThunk_%d', [ATypeRef.TypeIndex]));
  LThunkFunc.SetReturnType(cvtVoid);
  LThunkFunc.SetIsEntryPoint(False);
  LThunkFunc.SetIsDllEntry(False);
  // Deliberately NOT public. The thunk is reached only through sikFuncAddr, and
  // dead-function elimination already marks address-taken functions live and
  // remaps their indices, so it survives without being exported.
  LThunkFunc.SetIsPublic(False);

  // Single parameter: the ADDRESS of one element.
  LThunkFunc.AddLocal('APtr', TMyrTypeRef.FromPrimitive(cvtPointer), 8, 8,
    True, False, False);

  LThunkFunc.CreateBlock('entry');
  LThunkFunc.SetCurrentBlock(0);
  LBlock := LThunkFunc.GetCurrentBlock();
  if not Assigned(LBlock) then
  begin
    LThunkFunc.Free();
    Exit;
  end;

  LInstrIdx := 0;
  LNoPrefix := Default(TMyrSSAOperand);

  // Load the incoming element address out of its parameter slot.
  LLoadInstr := Default(TMyrSSAInstr);
  LLoadInstr.Kind := sikLoad;
  LLoadInstr.Dest := LThunkFunc.NewVersion('_p');
  LLoadInstr.Op1 := TMyrSSAOperand.FromLocalIndex(0);
  LBlock.InsertInstructionAt(LInstrIdx, LLoadInstr);
  Inc(LInstrIdx);

  // The member walk is DoEmitCompositeRelease, deliberately reused rather than
  // reimplemented, so records, nested arrays and aliases behave identically
  // inside a thunk and outside one. Arbitrary nesting works by construction,
  // including an array of records that themselves hold arrays.
  DoEmitCompositeRelease(LThunkFunc, LBlock, LInstrIdx, LLoadInstr.Dest,
    ATypeRef, AStrRelease, AFreeMem, ADynFree, LNoPrefix, False);

  LRetInstr := Default(TMyrSSAInstr);
  LRetInstr.Kind := sikReturn;
  LBlock.InsertInstructionAt(LInstrIdx, LRetInstr);

  LThunkIdx := FSSABuilder.AddSynthesizedFunc(LThunkFunc);
  if LThunkIdx < 0 then
    Exit;

  FThunkCache.Add(ATypeRef.TypeIndex, LThunkIdx);
  Result := LThunkIdx;
end;

function TMyrSSAStringCleanup.DoEmitCompositeArrayWalk(const AFunc: TMyrSSAFunc;
  const ABlock: TMyrSSABlock; var AInstrIdx: Integer;
  const ABaseOperand: TMyrSSAOperand; const ACountOperand: TMyrSSAOperand;
  const AElemTypeRef: TMyrTypeRef; const AElemStride: Int64;
  const AStrRelease: TMyrSSAOperand; const AFreeMem: TMyrSSAOperand;
  const ADynFree: TMyrSSAOperand; const APrefixArg: TMyrSSAOperand;
  const AHasPrefixArg: Boolean): Boolean;
var
  LThunkIdx: Integer;
  LWalkerIdx: TMyrSSAOperand;
  LAddrInstr: TMyrSSAInstr;
  LCallInstr: TMyrSSAInstr;
begin
  Result := False;

  if AElemStride <= 0 then
    Exit;

  // The detach twin gates on fdwReason and then delegates to the plain walker,
  // so the per-type thunk is identical on both paths.
  if AHasPrefixArg then
    LWalkerIdx := FSSABuilder.GetArrayReleaseCompositeOnDetachTarget()
  else
    LWalkerIdx := FSSABuilder.GetArrayReleaseCompositeTarget();

  if not LWalkerIdx.IsCallTarget() then
    Exit;

  LThunkIdx := DoGetCompositeThunkIdx(AElemTypeRef, AStrRelease, AFreeMem,
    ADynFree);
  if LThunkIdx < 0 then
    Exit;

  // Materialize the thunk's address.
  LAddrInstr := Default(TMyrSSAInstr);
  LAddrInstr.Kind := sikFuncAddr;
  LAddrInstr.Dest := AFunc.NewVersion('_thunk');
  LAddrInstr.Op1 := TMyrSSAOperand.FromFunc(LThunkIdx);
  ABlock.InsertInstructionAt(AInstrIdx, LAddrInstr);
  Inc(AInstrIdx);

  LCallInstr := Default(TMyrSSAInstr);
  LCallInstr.Kind := sikCall;
  LCallInstr.CallTarget := LWalkerIdx;

  if AHasPrefixArg then
  begin
    // RT_ArrayReleaseCompositeOnDetach(fdwReason, ptr, count, stride, thunk)
    SetLength(LCallInstr.CallArgs, 5);
    LCallInstr.CallArgs[0] := APrefixArg;
    LCallInstr.CallArgs[1] := ABaseOperand;
    LCallInstr.CallArgs[2] := ACountOperand;
    LCallInstr.CallArgs[3] := TMyrSSAOperand.FromImm(AElemStride);
    LCallInstr.CallArgs[4] := TMyrSSAOperand.FromVar(LAddrInstr.Dest);
  end
  else
  begin
    // RT_ArrayReleaseComposite(ptr, count, stride, thunk)
    SetLength(LCallInstr.CallArgs, 4);
    LCallInstr.CallArgs[0] := ABaseOperand;
    LCallInstr.CallArgs[1] := ACountOperand;
    LCallInstr.CallArgs[2] := TMyrSSAOperand.FromImm(AElemStride);
    LCallInstr.CallArgs[3] := TMyrSSAOperand.FromVar(LAddrInstr.Dest);
  end;

  ABlock.InsertInstructionAt(AInstrIdx, LCallInstr);
  Inc(AInstrIdx);

  Result := True;
end;

function TMyrSSAStringCleanup.DoResolveLeafFuncIdx(const ATypeRef: TMyrTypeRef;
  const AStrRelease: TMyrSSAOperand; const AFreeMem: TMyrSSAOperand;
  const ADynFree: TMyrSSAOperand): TMyrSSAOperand;
begin
  Result := Default(TMyrSSAOperand);

  if not Assigned(FIR) then
    Exit;

  // wstring is tested BEFORE string to preserve the dispatch order the
  // locals/globals loops used before this helper existed.
  if FIR.IsWStringType(ATypeRef) then
    Exit(AFreeMem);

  if FIR.IsStringType(ATypeRef) then
    Exit(AStrRelease);

  // A dynarray is a releasable LEAF only while its ELEMENTS are unmanaged -
  // RT_DynFree then frees the block and nothing is left behind. When the
  // elements are themselves managed, answering with a leaf index here would
  // take DoEmitCompositeRelease's early exit and leak every element, so the
  // type is deliberately reported as a non-leaf and handled by that routine's
  // tkDynArray branch instead.
  if (not ATypeRef.IsPrimitive) and
     (ATypeRef.TypeIndex >= 0) and
     (ATypeRef.TypeIndex < FIR.GetTypeCount()) and
     (FIR.GetTypeEntry(ATypeRef.TypeIndex).Kind = TMyrIR.TMyrIRTypeKind.tkDynArray) and
     (not FIR.IsManagedType(
        FIR.GetTypeEntry(ATypeRef.TypeIndex).DynArrayType.ElementType)) then
    Exit(ADynFree);
end;

function TMyrSSAStringCleanup.DoResolveLeafKind(const ATypeRef: TMyrTypeRef): Integer;
begin
  Result := -1;

  if not Assigned(FIR) then
    Exit;

  // Same order as DoResolveLeafFuncIdx: wstring BEFORE string.
  if FIR.IsWStringType(ATypeRef) then
    Exit(1);

  if FIR.IsStringType(ATypeRef) then
    Exit(0);

  if (not ATypeRef.IsPrimitive) and
     (ATypeRef.TypeIndex >= 0) and
     (ATypeRef.TypeIndex < FIR.GetTypeCount()) and
     (FIR.GetTypeEntry(ATypeRef.TypeIndex).Kind = TMyrIR.TMyrIRTypeKind.tkDynArray) then
    Exit(2);
end;

procedure TMyrSSAStringCleanup.DoEmitLeafRelease(const AFunc: TMyrSSAFunc;
  const ABlock: TMyrSSABlock; var AInstrIdx: Integer; const ASlot: TMyrSSAOperand;
  const ATargetFunc: TMyrSSAOperand; const AMemSize: Integer;
  const APrefixArg: TMyrSSAOperand; const AHasPrefixArg: Boolean);
var
  LLoadInstr: TMyrSSAInstr;
  LReleaseInstr: TMyrSSAInstr;
begin
  if not ATargetFunc.IsCallTarget() then
    Exit;

  // Load the managed pointer out of the slot. AMemSize = 0 keeps the original
  // untyped load form used for whole-variable slots; a non-zero size is
  // required when the slot is an interior pointer from sikFieldAddr.
  LLoadInstr := Default(TMyrSSAInstr);
  LLoadInstr.Kind := sikLoad;
  LLoadInstr.Dest := AFunc.NewVersion('_t');
  LLoadInstr.Op1 := ASlot;
  if AMemSize > 0 then
    LLoadInstr.MemSize := AMemSize;
  ABlock.InsertInstructionAt(AInstrIdx, LLoadInstr);
  Inc(AInstrIdx);

  LReleaseInstr := Default(TMyrSSAInstr);
  LReleaseInstr.Kind := sikCall;
  LReleaseInstr.CallTarget := ATargetFunc;
  if AHasPrefixArg then
  begin
    // DLL detach twins: <cleanup>(fdwReason, value)
    SetLength(LReleaseInstr.CallArgs, 2);
    LReleaseInstr.CallArgs[0] := APrefixArg;
    LReleaseInstr.CallArgs[1] := TMyrSSAOperand.FromVar(LLoadInstr.Dest);
  end
  else
  begin
    SetLength(LReleaseInstr.CallArgs, 1);
    LReleaseInstr.CallArgs[0] := TMyrSSAOperand.FromVar(LLoadInstr.Dest);
  end;
  ABlock.InsertInstructionAt(AInstrIdx, LReleaseInstr);
  Inc(AInstrIdx);
end;

procedure TMyrSSAStringCleanup.DoEmitCompositeRelease(const AFunc: TMyrSSAFunc;
  const ABlock: TMyrSSABlock; var AInstrIdx: Integer; const APtrVar: TMyrSSAVar;
  const ATypeRef: TMyrTypeRef; const AStrRelease: TMyrSSAOperand;
  const AFreeMem: TMyrSSAOperand; const ADynFree: TMyrSSAOperand;
  const APrefixArg: TMyrSSAOperand; const AHasPrefixArg: Boolean);
var
  LEntry: TMyrIR.TMyrIRTypeEntry;
  LLeafFuncIdx: TMyrSSAOperand;
  LFieldAddrInstr: TMyrSSAInstr;
  LI: Integer;
  LElemKind: Integer;
  LElemCount: Int64;
  LElemStride: Int64;
  LArrayFuncIdx: TMyrSSAOperand;
  LCallInstr: TMyrSSAInstr;
  LDynLenFuncIdx: TMyrSSAOperand;
  LDataLoadInstr: TMyrSSAInstr;
  LLenCallInstr: TMyrSSAInstr;
  LFreeCallInstr: TMyrSSAInstr;
  LCompositeThunkIdx: Integer;
  LThunkAddrInstr: TMyrSSAInstr;
begin
  if not Assigned(FIR) then
    Exit;

  // Leaf reached through a field address: load through the interior pointer.
  LLeafFuncIdx := DoResolveLeafFuncIdx(ATypeRef, AStrRelease, AFreeMem,
    ADynFree);
  if LLeafFuncIdx.IsCallTarget() then
  begin
    // The load size is the TARGET's pointer width, taken from the IR type
    // system. SizeOf(Pointer) here would be the HOST compiler's pointer size,
    // which is only correct by coincidence while host and target are both
    // 64-bit and would silently emit a wrong-width load otherwise.
    DoEmitLeafRelease(AFunc, ABlock, AInstrIdx, TMyrSSAOperand.FromVar(APtrVar),
      LLeafFuncIdx, FIR.GetTypeSize(TMyrTypeRef.FromPrimitive(cvtPointer)),
      APrefixArg, AHasPrefixArg);
    Exit;
  end;

  if ATypeRef.IsPrimitive then
    Exit;

  if (ATypeRef.TypeIndex < 0) or (ATypeRef.TypeIndex >= FIR.GetTypeCount()) then
    Exit;

  LEntry := FIR.GetTypeEntry(ATypeRef.TypeIndex);

  case LEntry.Kind of
    TMyrIR.TMyrIRTypeKind.tkAlias:
      // Unwrap and re-dispatch against the same address.
      DoEmitCompositeRelease(AFunc, ABlock, AInstrIdx, APtrVar,
        LEntry.AliasType.AliasedType, AStrRelease, AFreeMem,
        ADynFree, APrefixArg, AHasPrefixArg);

    TMyrIR.TMyrIRTypeKind.tkFixedArray:
      begin
        // APtrVar holds the address of the array, which for a fixed array is
        // also the address of element zero - exactly what RT_ArrayRelease
        // walks. The release is a single counted-loop CALL, never an unrolled
        // per-element sequence: array[0..9999] of string must not emit ten
        // thousand call sites.
        LElemCount := Int64(LEntry.FixedArrayType.HighBound) -
                      Int64(LEntry.FixedArrayType.LowBound) + 1;
        if LElemCount <= 0 then
          Exit;

        LElemStride := FIR.GetTypeSize(LEntry.FixedArrayType.ElementType);
        if LElemStride <= 0 then
          Exit;

        LElemKind := DoResolveLeafKind(LEntry.FixedArrayType.ElementType);

        // A COMPOSITE element type -- a record holding managed fields, or a
        // nested array -- is not a leaf. RT_ArrayRelease cannot walk it because
        // it DEREFERENCES each slot, which is correct only when the slot itself
        // holds the managed pointer; a record element is stored inline. Such
        // arrays go through RT_ArrayReleaseComposite instead, which passes the
        // element ADDRESS to a per-type release thunk.
        // The DLL detach path uses the OnDetach twin, which gates on fdwReason
        // and then delegates to the same walker, so a composite array in a DLL
        // global releases its elements at unload exactly as in an EXE.
        if LElemKind < 0 then
        begin
          DoEmitCompositeArrayWalk(AFunc, ABlock, AInstrIdx,
            TMyrSSAOperand.FromVar(APtrVar), TMyrSSAOperand.FromImm(LElemCount),
            LEntry.FixedArrayType.ElementType, LElemStride,
            AStrRelease, AFreeMem, ADynFree, APrefixArg,
            AHasPrefixArg);
          Exit;
        end;

        if AHasPrefixArg then
          LArrayFuncIdx := FSSABuilder.GetArrayReleaseOnDetachTarget()
        else
          LArrayFuncIdx := FSSABuilder.GetArrayReleaseTarget();

        if not LArrayFuncIdx.IsCallTarget() then
          Exit;

        LCallInstr := Default(TMyrSSAInstr);
        LCallInstr.Kind := sikCall;
        LCallInstr.CallTarget := LArrayFuncIdx;

        if AHasPrefixArg then
        begin
          // DLL detach twin: RT_ArrayReleaseOnDetach(fdwReason, ptr, count,
          // stride, kind)
          SetLength(LCallInstr.CallArgs, 5);
          LCallInstr.CallArgs[0] := APrefixArg;
          LCallInstr.CallArgs[1] := TMyrSSAOperand.FromVar(APtrVar);
          LCallInstr.CallArgs[2] := TMyrSSAOperand.FromImm(LElemCount);
          LCallInstr.CallArgs[3] := TMyrSSAOperand.FromImm(LElemStride);
          LCallInstr.CallArgs[4] := TMyrSSAOperand.FromImm(Int64(LElemKind));
        end
        else
        begin
          // RT_ArrayRelease(ptr, count, stride, kind)
          SetLength(LCallInstr.CallArgs, 4);
          LCallInstr.CallArgs[0] := TMyrSSAOperand.FromVar(APtrVar);
          LCallInstr.CallArgs[1] := TMyrSSAOperand.FromImm(LElemCount);
          LCallInstr.CallArgs[2] := TMyrSSAOperand.FromImm(LElemStride);
          LCallInstr.CallArgs[3] := TMyrSSAOperand.FromImm(Int64(LElemKind));
        end;

        ABlock.InsertInstructionAt(AInstrIdx, LCallInstr);
        Inc(AInstrIdx);
      end;

    TMyrIR.TMyrIRTypeKind.tkDynArray:
      begin
        // A dynarray whose ELEMENTS are managed is deliberately not a leaf -
        // see DoResolveLeafFuncIdx. Freeing the block alone would leak every
        // element, so the elements are walked first and the block freed after.
        // The count is not statically known the way a fixed array's bounds
        // are, so it is read at runtime from the header via RT_DynLen.
        LElemKind := DoResolveLeafKind(LEntry.DynArrayType.ElementType);

        // A COMPOSITE element type is not a leaf. It is walked by
        // RT_ArrayReleaseComposite through a per-type thunk rather than by
        // RT_ArrayRelease, which dereferences each slot and so cannot reach a
        // managed field stored inline. The block itself is still freed by
        // RT_DynFree below, exactly as for a leaf element type.
        // The DLL detach path uses the OnDetach twin of whichever walker
        // applies, so composite elements are released at unload too.
        LCompositeThunkIdx := -1;
        if LElemKind < 0 then
        begin
          LCompositeThunkIdx := DoGetCompositeThunkIdx(
            LEntry.DynArrayType.ElementType, AStrRelease, AFreeMem,
            ADynFree);
          if LCompositeThunkIdx < 0 then
            Exit;
        end;

        LElemStride := FIR.GetTypeSize(LEntry.DynArrayType.ElementType);
        if LElemStride <= 0 then
          Exit;

        LDynLenFuncIdx := FSSABuilder.GetDynLenTarget();
        if not LDynLenFuncIdx.IsCallTarget() then
          Exit;

        if not ADynFree.IsCallTarget() then
          Exit;

        if LCompositeThunkIdx >= 0 then
        begin
          if AHasPrefixArg then
            LArrayFuncIdx := FSSABuilder.GetArrayReleaseCompositeOnDetachTarget()
          else
            LArrayFuncIdx := FSSABuilder.GetArrayReleaseCompositeTarget();
        end
        else if AHasPrefixArg then
          LArrayFuncIdx := FSSABuilder.GetArrayReleaseOnDetachTarget()
        else
          LArrayFuncIdx := FSSABuilder.GetArrayReleaseTarget();

        if not LArrayFuncIdx.IsCallTarget() then
          Exit;

        // APtrVar addresses the dynarray SLOT; the slot holds the data
        // pointer. Load it once and reuse it for the length, the element
        // walk and the free - reloading would re-read a freed slot.
        LDataLoadInstr := Default(TMyrSSAInstr);
        LDataLoadInstr.Kind := sikLoad;
        LDataLoadInstr.Dest := AFunc.NewVersion('_t');
        LDataLoadInstr.Op1 := TMyrSSAOperand.FromVar(APtrVar);
        LDataLoadInstr.MemSize := FIR.GetTypeSize(
          TMyrTypeRef.FromPrimitive(cvtPointer));
        ABlock.InsertInstructionAt(AInstrIdx, LDataLoadInstr);
        Inc(AInstrIdx);

        // RT_DynLen returns 0 for a nil pointer and RT_ArrayRelease returns
        // immediately on a nil base, so a dynarray that was never assigned
        // walks nothing and frees nothing.
        LLenCallInstr := Default(TMyrSSAInstr);
        LLenCallInstr.Kind := sikCallAssign;
        LLenCallInstr.Dest := AFunc.NewVersion('_t');
        LLenCallInstr.CallTarget := LDynLenFuncIdx;
        SetLength(LLenCallInstr.CallArgs, 1);
        LLenCallInstr.CallArgs[0] := TMyrSSAOperand.FromVar(LDataLoadInstr.Dest);
        ABlock.InsertInstructionAt(AInstrIdx, LLenCallInstr);
        Inc(AInstrIdx);

        LCallInstr := Default(TMyrSSAInstr);
        LCallInstr.Kind := sikCall;
        LCallInstr.CallTarget := LArrayFuncIdx;

        if LCompositeThunkIdx >= 0 then
        begin
          // The thunk address is materialized here, after the length call and
          // before the walk is inserted, so its definition dominates its use.
          LThunkAddrInstr := Default(TMyrSSAInstr);
          LThunkAddrInstr.Kind := sikFuncAddr;
          LThunkAddrInstr.Dest := AFunc.NewVersion('_thunk');
          LThunkAddrInstr.Op1 := TMyrSSAOperand.FromFunc(LCompositeThunkIdx);
          ABlock.InsertInstructionAt(AInstrIdx, LThunkAddrInstr);
          Inc(AInstrIdx);

          if AHasPrefixArg then
          begin
            // RT_ArrayReleaseCompositeOnDetach(fdwReason, ptr, count, stride,
            // thunk)
            SetLength(LCallInstr.CallArgs, 5);
            LCallInstr.CallArgs[0] := APrefixArg;
            LCallInstr.CallArgs[1] := TMyrSSAOperand.FromVar(LDataLoadInstr.Dest);
            LCallInstr.CallArgs[2] := TMyrSSAOperand.FromVar(LLenCallInstr.Dest);
            LCallInstr.CallArgs[3] := TMyrSSAOperand.FromImm(LElemStride);
            LCallInstr.CallArgs[4] := TMyrSSAOperand.FromVar(LThunkAddrInstr.Dest);
          end
          else
          begin
            // RT_ArrayReleaseComposite(ptr, count, stride, thunk)
            SetLength(LCallInstr.CallArgs, 4);
            LCallInstr.CallArgs[0] := TMyrSSAOperand.FromVar(LDataLoadInstr.Dest);
            LCallInstr.CallArgs[1] := TMyrSSAOperand.FromVar(LLenCallInstr.Dest);
            LCallInstr.CallArgs[2] := TMyrSSAOperand.FromImm(LElemStride);
            LCallInstr.CallArgs[3] := TMyrSSAOperand.FromVar(LThunkAddrInstr.Dest);
          end;
        end
        else if AHasPrefixArg then
        begin
          // DLL detach twin: RT_ArrayReleaseOnDetach(fdwReason, ptr, count,
          // stride, kind)
          SetLength(LCallInstr.CallArgs, 5);
          LCallInstr.CallArgs[0] := APrefixArg;
          LCallInstr.CallArgs[1] := TMyrSSAOperand.FromVar(LDataLoadInstr.Dest);
          LCallInstr.CallArgs[2] := TMyrSSAOperand.FromVar(LLenCallInstr.Dest);
          LCallInstr.CallArgs[3] := TMyrSSAOperand.FromImm(LElemStride);
          LCallInstr.CallArgs[4] := TMyrSSAOperand.FromImm(Int64(LElemKind));
        end
        else
        begin
          // RT_ArrayRelease(ptr, count, stride, kind)
          SetLength(LCallInstr.CallArgs, 4);
          LCallInstr.CallArgs[0] := TMyrSSAOperand.FromVar(LDataLoadInstr.Dest);
          LCallInstr.CallArgs[1] := TMyrSSAOperand.FromVar(LLenCallInstr.Dest);
          LCallInstr.CallArgs[2] := TMyrSSAOperand.FromImm(LElemStride);
          LCallInstr.CallArgs[3] := TMyrSSAOperand.FromImm(Int64(LElemKind));
        end;

        ABlock.InsertInstructionAt(AInstrIdx, LCallInstr);
        Inc(AInstrIdx);

        // Elements are released; now free the block itself. ADynFree is
        // already the detach twin when AHasPrefixArg, exactly as the leaf
        // path relies on.
        LFreeCallInstr := Default(TMyrSSAInstr);
        LFreeCallInstr.Kind := sikCall;
        LFreeCallInstr.CallTarget := ADynFree;

        if AHasPrefixArg then
        begin
          SetLength(LFreeCallInstr.CallArgs, 2);
          LFreeCallInstr.CallArgs[0] := APrefixArg;
          LFreeCallInstr.CallArgs[1] := TMyrSSAOperand.FromVar(LDataLoadInstr.Dest);
        end
        else
        begin
          SetLength(LFreeCallInstr.CallArgs, 1);
          LFreeCallInstr.CallArgs[0] := TMyrSSAOperand.FromVar(LDataLoadInstr.Dest);
        end;

        ABlock.InsertInstructionAt(AInstrIdx, LFreeCallInstr);
        Inc(AInstrIdx);
      end;

    TMyrIR.TMyrIRTypeKind.tkRecord:
      begin
        for LI := 0 to System.High(LEntry.RecordType.Fields) do
        begin
          // OverlayGroup > 0 marks an anonymous union member. Overlaid fields
          // share storage and carry no discriminant, so releasing them is not
          // decidable here - see the class declaration comment.
          if LEntry.RecordType.Fields[LI].OverlayGroup <> 0 then
            Continue;

          if not FIR.IsManagedType(LEntry.RecordType.Fields[LI].FieldType) then
            Continue;

          LFieldAddrInstr := Default(TMyrSSAInstr);
          LFieldAddrInstr.Kind := sikFieldAddr;
          LFieldAddrInstr.Dest := AFunc.NewVersion('_t');
          LFieldAddrInstr.Op1 := TMyrSSAOperand.FromVar(APtrVar);
          LFieldAddrInstr.Op2 := TMyrSSAOperand.FromImm(
            LEntry.RecordType.Fields[LI].FieldOffset);
          LFieldAddrInstr.Op2.FieldName := LEntry.RecordType.Fields[LI].FieldName;
          ABlock.InsertInstructionAt(AInstrIdx, LFieldAddrInstr);
          Inc(AInstrIdx);

          DoEmitCompositeRelease(AFunc, ABlock, AInstrIdx,
            LFieldAddrInstr.Dest, LEntry.RecordType.Fields[LI].FieldType,
            AStrRelease, AFreeMem, ADynFree, APrefixArg,
            AHasPrefixArg);
        end;
      end;
  end;
end;

procedure TMyrSSAStringCleanup.DoEmitManagedRelease(const AFunc: TMyrSSAFunc;
  const ABlock: TMyrSSABlock; var AInstrIdx: Integer; const ASlot: TMyrSSAOperand;
  const ATypeRef: TMyrTypeRef; const AStrRelease: TMyrSSAOperand;
  const AFreeMem: TMyrSSAOperand; const ADynFree: TMyrSSAOperand;
  const APrefixArg: TMyrSSAOperand; const AHasPrefixArg: Boolean);
var
  LLeafFuncIdx: TMyrSSAOperand;
  LAddrInstr: TMyrSSAInstr;
begin
  if not Assigned(FIR) then
    Exit;

  // Whole-variable leaf: keep the exact instruction form this pass emitted
  // before composites were handled, so plain string/wstring/dynarray slots
  // are byte-for-byte unchanged.
  LLeafFuncIdx := DoResolveLeafFuncIdx(ATypeRef, AStrRelease, AFreeMem,
    ADynFree);
  if LLeafFuncIdx.IsCallTarget() then
  begin
    DoEmitLeafRelease(AFunc, ABlock, AInstrIdx, ASlot, LLeafFuncIdx, 0,
      APrefixArg, AHasPrefixArg);
    Exit;
  end;

  if not FIR.IsManagedType(ATypeRef) then
    Exit;

  // Composite: take the slot address once, then walk members through it.
  // The address form is NOT uniform and getting it wrong yields a bogus base
  // whose load returns garbage - non-nil, so RT_StrRelease's nil guard does
  // not catch it and it derefs. Globals live in the data section and need an
  // LEA, which this IR spells as sikAssign over a global operand; locals need
  // a real stack sikAddressOf. This mirrors ConvertExpression's ekFieldAccess
  // branch, which makes exactly the same distinction.
  LAddrInstr := Default(TMyrSSAInstr);
  if ASlot.Kind = sokGlobal then
    LAddrInstr.Kind := sikAssign
  else
    LAddrInstr.Kind := sikAddressOf;
  LAddrInstr.Dest := AFunc.NewVersion('_t');
  LAddrInstr.Op1 := ASlot;
  ABlock.InsertInstructionAt(AInstrIdx, LAddrInstr);
  Inc(AInstrIdx);

  DoEmitCompositeRelease(AFunc, ABlock, AInstrIdx, LAddrInstr.Dest, ATypeRef,
    AStrRelease, AFreeMem, ADynFree, APrefixArg, AHasPrefixArg);
end;

procedure TMyrSSAStringCleanup.Run(const AFunc: TMyrSSAFunc);
var
  LBlockIdx: Integer;
  LInstrIdx: Integer;
  LLocalIdx: Integer;
  LGlobalIdx: Integer;
  LBlock: TMyrSSABlock;
  LInstr: TMyrSSAInstr;
  LLocal: TMyrSSALocalInfo;
  LGlobal: TMyrIR.TMyrIRGlobal;
  LManagedLocals: TList<Integer>;  // Indices of managed non-param locals
  LManagedGlobals: TList<Integer>; // Indices of managed globals
  LManagedTemps: TDictionary<string, TMyrSSAVar>;  // Temps from string-returning calls
  LRawTemps: TDictionary<string, Boolean>;      // Temps needing FreeMem instead of StrRelease
  LBorrows: TDictionary<string, string>;        // Borrower temp -> owner temp (RT_StrData interior pointers)
  LOwnerName: string;
  LSelfRetIsString: Boolean;
  LTempLastUse: TDictionary<string, Integer>;  // Temp name -> instruction index of last use
  LReleaseInstr: TMyrSSAInstr;
  LFuncIdx: TMyrSSAOperand;
  LFreeMemIdx: TMyrSSAOperand;
  LDynFreeFuncIdx: TMyrSSAOperand;
  LTargetFuncIdx: Integer;
  LTargetFunc: TMyrIR.TMyrIRFunc;
  LI: Integer;
  LJ: Integer;
  LIsEntryPoint: Boolean;
  LIsDllEntry: Boolean;
  LIsNoReturnCall: Boolean;
  LReleaseOnDetachFuncIdx: TMyrSSAOperand;
  LReasonVar: TMyrSSAVar;
  LParamCount: Integer;
  LTempName: string;
  LTempVar: TMyrSSAVar;
  LUsedVar: string;
  LInsertions: TList<TPair<Integer, TMyrSSAVar>>;
  LPair: TPair<Integer, TMyrSSAVar>;
begin
  // Get function index for Cbr_StrRelease
  LFuncIdx := Default(TMyrSSAOperand);
  LFreeMemIdx := Default(TMyrSSAOperand);
  LDynFreeFuncIdx := Default(TMyrSSAOperand);
  if Assigned(FSSABuilder) then
  begin
    LFuncIdx := FSSABuilder.GetStrReleaseTarget();
    LFreeMemIdx := FSSABuilder.GetFreeMemTarget();
    LDynFreeFuncIdx := FSSABuilder.GetDynFreeTarget();
  end;
    
  // Phase 1: Release managed temps after their last use
  if (LFuncIdx.IsCallTarget() or LFreeMemIdx.IsCallTarget()) and Assigned(FIR) then
  begin
    for LBlockIdx := 0 to AFunc.GetBlockCount() - 1 do
    begin
      LBlock := AFunc.GetBlock(LBlockIdx);
      LManagedTemps := TDictionary<string, TMyrSSAVar>.Create();
      LRawTemps := TDictionary<string, Boolean>.Create();
      LBorrows := TDictionary<string, string>.Create();
      LTempLastUse := TDictionary<string, Integer>.Create();
      try
        // First pass: find managed temps and their last use in this block
        for LInstrIdx := 0 to LBlock.GetInstructionCount() - 1 do
        begin
          LInstr := LBlock.GetInstruction(LInstrIdx);
          
          // Check if this is a call that returns a managed string or raw pointer
          if (LInstr.Kind = sikCallAssign) and (LInstr.CallTarget.Kind = sokFunc) then
          begin
            LTargetFuncIdx := LInstr.CallTarget.FuncIndex;
            if (LTargetFuncIdx >= 0) and (LTargetFuncIdx < FIR.GetFunctionCount()) then
            begin
              LTargetFunc := FIR.GetFunction(LTargetFuncIdx);
              // Runtime string functions return vtPtr but are actually managed strings
              if (LTargetFunc.FuncName = RT_StrFromLiteral) or
                 (LTargetFunc.FuncName = RT_StrConcat) or
                 (LTargetFunc.FuncName = RT_StrFromChar) or
                 FIR.IsStringType(LTargetFunc.ReturnTypeRef) then
              begin
                // This call returns a string - track the dest temp
                LTempName := LInstr.Dest.BaseName + '_' + IntToStr(LInstr.Dest.Version);
                LManagedTemps.AddOrSetValue(LTempName, LInstr.Dest);
              end
              // Raw pointer temps (need FreeMem, not StrRelease)
              else if (LTargetFunc.FuncName = RT_Utf8) or
                      (LTargetFunc.FuncName = RT_WStrConcat) or
                      (LTargetFunc.FuncName = RT_WStrFromLiteral) or
                      FIR.IsWStringType(LTargetFunc.ReturnTypeRef) then
              begin
                LTempName := LInstr.Dest.BaseName + '_' + IntToStr(LInstr.Dest.Version);
                LManagedTemps.AddOrSetValue(LTempName, LInstr.Dest);
                LRawTemps.AddOrSetValue(LTempName, True);
              end
              // RT_StrData returns an interior pointer INTO its argument's
              // buffer -- the result BORROWS the owner temp. Any later use of
              // the borrowed pointer must extend the owner's lifetime, or the
              // owner's release lands between StrData and its consumer
              // (use-after-free; segfaults on glibc, worked on win64 by luck).
              else if (LTargetFunc.FuncName = RT_StrData) and
                      (Length(LInstr.CallArgs) = 1) and
                      (LInstr.CallArgs[0].Kind = sokVar) then
              begin
                LUsedVar := LInstr.CallArgs[0].Var_.BaseName + '_' +
                  IntToStr(LInstr.CallArgs[0].Var_.Version);
                if LManagedTemps.ContainsKey(LUsedVar) then
                begin
                  LTempName := LInstr.Dest.BaseName + '_' + IntToStr(LInstr.Dest.Version);
                  LBorrows.AddOrSetValue(LTempName, LUsedVar);
                end;
              end;
            end;
          end;
          
          // Track uses of managed temps in operands.
          // Special case: if a managed temp is the source of an assignment to
          // a local variable (not a _t temp), ownership transfers to the local.
          // Remove the temp from tracking — Phase 2 handles local cleanup at
          // return. Without this, the temp gets released immediately after the
          // assignment, freeing the string the local still points to.
          if (LInstr.Kind = sikAssign) and (LInstr.Op1.Kind = sokVar) then
          begin
            LUsedVar := LInstr.Op1.Var_.BaseName + '_' + IntToStr(LInstr.Op1.Var_.Version);
            if LManagedTemps.ContainsKey(LUsedVar) then
            begin
              if not LInstr.Dest.BaseName.StartsWith('_t') then
              begin
                // Ownership transfer to local — stop tracking this temp
                LManagedTemps.Remove(LUsedVar);
                LTempLastUse.Remove(LUsedVar);
              end
              else
                LTempLastUse.AddOrSetValue(LUsedVar, LInstrIdx);
            end;
          end
          else if (LInstr.Kind = sikStore) and (LInstr.Op1.Kind = sokGlobal) and
                  (LInstr.Op2.Kind = sokVar) then
          begin
            // Ownership transfer to a GLOBAL -- global assignments lower as
            // sikStore(global, temp), not sikAssign, so this mirrors the
            // local-transfer case above. Phase 2 releases managed globals at
            // entry exit; releasing the temp here would leave the global
            // dangling (heap corruption on the next AddRef/Release).
            LUsedVar := LInstr.Op2.Var_.BaseName + '_' + IntToStr(LInstr.Op2.Var_.Version);
            if LManagedTemps.ContainsKey(LUsedVar) then
            begin
              LManagedTemps.Remove(LUsedVar);
              LTempLastUse.Remove(LUsedVar);
            end;
          end
          else
          begin
            // General Op1 tracking
            if LInstr.Op1.Kind = sokVar then
            begin
              LUsedVar := LInstr.Op1.Var_.BaseName + '_' + IntToStr(LInstr.Op1.Var_.Version);
              if LManagedTemps.ContainsKey(LUsedVar) then
                LTempLastUse.AddOrSetValue(LUsedVar, LInstrIdx);
              // A use of a borrowed interior pointer extends its owner's life
              if LBorrows.TryGetValue(LUsedVar, LOwnerName) and
                 LManagedTemps.ContainsKey(LOwnerName) then
                LTempLastUse.AddOrSetValue(LOwnerName, LInstrIdx);
            end;
          end;
          if LInstr.Op2.Kind = sokVar then
          begin
            LUsedVar := LInstr.Op2.Var_.BaseName + '_' + IntToStr(LInstr.Op2.Var_.Version);
            if LManagedTemps.ContainsKey(LUsedVar) then
              LTempLastUse.AddOrSetValue(LUsedVar, LInstrIdx);
            if LBorrows.TryGetValue(LUsedVar, LOwnerName) and
               LManagedTemps.ContainsKey(LOwnerName) then
              LTempLastUse.AddOrSetValue(LOwnerName, LInstrIdx);
          end;
          for LJ := 0 to Length(LInstr.CallArgs) - 1 do
          begin
            if LInstr.CallArgs[LJ].Kind = sokVar then
            begin
              LUsedVar := LInstr.CallArgs[LJ].Var_.BaseName + '_' + IntToStr(LInstr.CallArgs[LJ].Var_.Version);
              if LManagedTemps.ContainsKey(LUsedVar) then
                LTempLastUse.AddOrSetValue(LUsedVar, LInstrIdx);
              if LBorrows.TryGetValue(LUsedVar, LOwnerName) and
                 LManagedTemps.ContainsKey(LOwnerName) then
                LTempLastUse.AddOrSetValue(LOwnerName, LInstrIdx);
            end;
          end;
        end;
        
        // Second pass: collect insertions (process in reverse order to preserve indices)
        LInsertions := TList<TPair<Integer, TMyrSSAVar>>.Create();
        try
          for LTempName in LTempLastUse.Keys do
          begin
            if LManagedTemps.TryGetValue(LTempName, LTempVar) then
              LInsertions.Add(TPair<Integer, TMyrSSAVar>.Create(LTempLastUse[LTempName], LTempVar));
          end;
          
          // Sort by instruction index descending (insert from end to start)
          LInsertions.Sort(
            TComparer<TPair<Integer, TMyrSSAVar>>.Construct(
              function(const ALeft, ARight: TPair<Integer, TMyrSSAVar>): Integer
              begin
                Result := ARight.Key - ALeft.Key;
              end
            )
          );
          
          // Insert releases after last use
          for LPair in LInsertions do
          begin
            LTempName := LPair.Value.BaseName + '_' + IntToStr(LPair.Value.Version);
            LReleaseInstr := Default(TMyrSSAInstr);
            LReleaseInstr.Kind := sikCall;
            // Raw pointer temps use FreeMem; managed strings use StrRelease
            if LRawTemps.ContainsKey(LTempName) and LFreeMemIdx.IsCallTarget() then
              LReleaseInstr.CallTarget := LFreeMemIdx
            else
              LReleaseInstr.CallTarget := LFuncIdx;
            SetLength(LReleaseInstr.CallArgs, 1);
            LReleaseInstr.CallArgs[0] := TMyrSSAOperand.FromVar(LPair.Value);
            LBlock.InsertInstructionAt(LPair.Key + 1, LReleaseInstr);
          end;
        finally
          LInsertions.Free();
        end;
      finally
        LTempLastUse.Free();
        LBorrows.Free();
        LRawTemps.Free();
        LManagedTemps.Free();
      end;
    end;
  end;

  // Phase 1b: AddRef string PARAMS returned by value. Params are BORROWED --
  // the caller keeps ownership of the rec it passed in, yet also treats the
  // call RESULT as an owned managed temp and releases it. Returning a param
  // without an AddRef therefore double-releases the same rec (use-after-free;
  // segfaulted on glibc, survived on win64 by heap luck). Runs before Phase
  // 2's early exit so passthrough routines with no managed locals are covered.
  if Assigned(FSSABuilder) and Assigned(FIR) and
     FSSABuilder.GetStrAddRefTarget().IsCallTarget() then
  begin
    // Does THIS function return a managed string? String params lower to
    // plain cvtPointer (no TypeRef), so param types cannot be queried --
    // but a string-returning function that returns a param is necessarily
    // returning its string param, so the return type is the reliable gate.
    LSelfRetIsString := False;
    for LI := 0 to FIR.GetFunctionCount() - 1 do
    begin
      if FIR.GetFunction(LI).FuncName = AFunc.GetFuncName() then
      begin
        LSelfRetIsString := FIR.IsStringType(FIR.GetFunction(LI).ReturnTypeRef);
        Break;
      end;
    end;

    if LSelfRetIsString then
    begin
      for LBlockIdx := 0 to AFunc.GetBlockCount() - 1 do
      begin
        LBlock := AFunc.GetBlock(LBlockIdx);
        LInstrIdx := 0;
        while LInstrIdx < LBlock.GetInstructionCount() do
        begin
          LInstr := LBlock.GetInstruction(LInstrIdx);
          if (LInstr.Kind = sikReturnValue) and (LInstr.Op1.Kind = sokVar) then
          begin
            for LLocalIdx := 0 to AFunc.GetLocalCount() - 1 do
            begin
              LLocal := AFunc.GetLocal(LLocalIdx);
              if LLocal.IsParam and
                 (LLocal.LocalName = LInstr.Op1.Var_.BaseName) then
              begin
                LReleaseInstr := Default(TMyrSSAInstr);
                LReleaseInstr.Kind := sikCall;
                LReleaseInstr.CallTarget :=
                  FSSABuilder.GetStrAddRefTarget();
                SetLength(LReleaseInstr.CallArgs, 1);
                LReleaseInstr.CallArgs[0] := TMyrSSAOperand.FromVar(LInstr.Op1.Var_);
                LBlock.InsertInstructionAt(LInstrIdx, LReleaseInstr);
                Inc(LInstrIdx); // skip past the inserted AddRef to the return
                Break;
              end;
            end;
          end;
          Inc(LInstrIdx);
        end;
      end;
    end;
  end;

  // Phase 2: Collect managed locals and globals for cleanup at return
  LManagedLocals := TList<Integer>.Create();
  LManagedGlobals := TList<Integer>.Create();
  try
    for LLocalIdx := 0 to AFunc.GetLocalCount() - 1 do
    begin
      LLocal := AFunc.GetLocal(LLocalIdx);
      if LLocal.IsManaged and (not LLocal.IsParam) then
        LManagedLocals.Add(LLocalIdx);
    end;
    
    // Check if this is an entry point that needs global cleanup
    LIsEntryPoint := AFunc.GetIsEntryPoint();
    LIsDllEntry := AFunc.GetIsDllEntry();
    
    // Collect managed globals for entry points: string, wstring, AND
    // dynarray globals all hold heap allocations that must be freed at exit
    if (LIsEntryPoint or LIsDllEntry) and Assigned(FIR) then
    begin
      for LGlobalIdx := 0 to FIR.GetGlobalCount() - 1 do
      begin
        LGlobal := FIR.GetGlobal(LGlobalIdx);
        // IsManagedType recurses through records, aliases and arrays, so a
        // record global holding a string field is now collected. The
        // hand-rolled triple this replaces tested only the global's OWN type,
        // so such a global was never collected and every managed field it
        // held leaked. Locals already used IsManagedType (see AddLocal), so
        // this also removes a locals/globals asymmetry.
        if FIR.IsManagedType(LGlobal.GlobalTypeRef) then
          LManagedGlobals.Add(LGlobalIdx);
      end;
    end;
    
    // Check if there's anything to do
    // Entry points may still need to report leaks even with no managed vars
    if (LManagedLocals.Count = 0) and (LManagedGlobals.Count = 0) then
    begin
      // Nothing to clean up - but EXE entry points may still report leaks
      if not (LIsEntryPoint and Assigned(FSSABuilder) and FSSABuilder.GetReportLeaksTarget().IsCallTarget()) then
        Exit;
    end
    else if not LFuncIdx.IsCallTarget() then
      Exit;  // Have managed vars but no Pax_StrRelease - cannot emit cleanup
    
    // Iterate all blocks to find return instructions
    for LBlockIdx := 0 to AFunc.GetBlockCount() - 1 do
    begin
      LBlock := AFunc.GetBlock(LBlockIdx);
      LInstrIdx := 0;
      
      while LInstrIdx < LBlock.GetInstructionCount() do
      begin
        LInstr := LBlock.GetInstruction(LInstrIdx);
        
        // Check for return instructions OR noreturn calls (block ends with call, no successors)
        // Also detect Cbr_Halt which calls ExitProcess internally
        LIsNoReturnCall := False;
        if (LInstr.Kind = sikCall) then
        begin
          if (LBlock.GetSuccessorCount() = 0) and
             (LInstrIdx = LBlock.GetInstructionCount() - 1) then
            LIsNoReturnCall := True
          else if (LInstr.CallTarget.Kind = sokFunc) and Assigned(FIR) then
          begin
            LTargetFuncIdx := LInstr.CallTarget.FuncIndex;
            if (LTargetFuncIdx >= 0) and (LTargetFuncIdx < FIR.GetFunctionCount()) then
              LIsNoReturnCall := FIR.GetFunction(LTargetFuncIdx).IsNoReturn;
          end;
        end;
        
        if (LInstr.Kind in [sikReturn, sikReturnValue]) or LIsNoReturnCall then
        begin
          // Insert Cbr_StrRelease/Cbr_DynFree calls for each managed local BEFORE the return/noreturn call
          for LI := 0 to LManagedLocals.Count - 1 do
          begin
            LLocal := AFunc.GetLocal(LManagedLocals[LI]);

            // Do NOT release the local whose value is being RETURNED --
            // ownership transfers to the caller (the sikCallAssign result
            // is a managed temp on the caller side). Releasing it here
            // would hand the caller a freed rec/buffer.
            if (LInstr.Kind = sikReturnValue) and
               (LInstr.Op1.Kind = sokVar) and
               (LInstr.Op1.Var_.BaseName = LLocal.LocalName) then
              Continue;

            // Recursive release. Leaf slots (string/wstring/dynarray) keep the
            // original direct load(local) form; composites take the slot
            // address and walk their managed members through sikFieldAddr.
            // Previously this dispatched on the local's OWN type and defaulted
            // to StrRelease, so a record local was released as if the bytes at
            // offset 0 were a string rec.
            DoEmitManagedRelease(AFunc, LBlock, LInstrIdx,
              TMyrSSAOperand.FromLocalIndex(LManagedLocals[LI]),
              LLocal.LocalTypeRef, LFuncIdx, LFreeMemIdx, LDynFreeFuncIdx,
              TMyrSSAOperand.None(), False);
          end;
          
          // For entry points, also release managed globals
          // DLL entry uses Cbr_ReleaseOnDetach to check fdwReason before releasing
          if LIsEntryPoint then
          begin
            // EXE entry: unconditionally release all managed globals.
            // Dispatch mirrors the locals loop: wstring raw buffers get
            // FreeMem, dynarrays get DynFree, managed strings StrRelease.
            for LI := 0 to LManagedGlobals.Count - 1 do
            begin
              if not Assigned(FIR) then
                Continue;

              // Recursive release - same rationale as the locals loop above.
              LGlobal := FIR.GetGlobal(LManagedGlobals[LI]);
              DoEmitManagedRelease(AFunc, LBlock, LInstrIdx,
                TMyrSSAOperand.FromGlobal(LManagedGlobals[LI]),
                LGlobal.GlobalTypeRef, LFuncIdx, LFreeMemIdx, LDynFreeFuncIdx,
                TMyrSSAOperand.None(), False);
            end;
            
            // Call Cbr_ReportLeaks after all cleanup (debug mode only)
            // Only for EXE entry points, not DLL entries (DllMain fires on
            // both ATTACH and DETACH, which would produce duplicate reports)
            // Skip if the noreturn call is Cbr_Halt (it already calls ReportLeaks)
            if Assigned(FSSABuilder) and FSSABuilder.GetReportLeaksTarget().IsCallTarget() and (not LIsNoReturnCall) then
            begin
              LReleaseInstr := Default(TMyrSSAInstr);
              LReleaseInstr.Kind := sikCall;
              LReleaseInstr.CallTarget := FSSABuilder.GetReportLeaksTarget();
              SetLength(LReleaseInstr.CallArgs, 0);  // No arguments
              LBlock.InsertInstructionAt(LInstrIdx, LReleaseInstr);
              Inc(LInstrIdx);
            end;
          end
          else if LIsDllEntry then
          begin
            // DLL entry: use Cbr_ReleaseOnDetach which checks fdwReason
            LReleaseOnDetachFuncIdx := Default(TMyrSSAOperand);
            if Assigned(FSSABuilder) then
              LReleaseOnDetachFuncIdx := FSSABuilder.GetReleaseOnDetachTarget();
            
            if LReleaseOnDetachFuncIdx.IsCallTarget() then
            begin
              // Find fdwReason parameter (2nd parameter, index 1)
              // DllMain signature: DllMain(hinstDLL, fdwReason, lpvReserved)
              LParamCount := 0;
              LReasonVar := TMyrSSAVar.None();
              for LI := 0 to AFunc.GetLocalCount() - 1 do
              begin
                LLocal := AFunc.GetLocal(LI);
                if LLocal.IsParam then
                begin
                  if LParamCount = 1 then  // fdwReason is 2nd param (index 1)
                  begin
                    LReasonVar := TMyrSSAVar.Create(LLocal.LocalName, 0);
                    Break;
                  end;
                  Inc(LParamCount);
                end;
              end;
              
              if LReasonVar.IsValid() then
              begin
                for LI := 0 to LManagedGlobals.Count - 1 do
                begin
                  if not Assigned(FIR) then
                    Continue;

                  // Recursive release through the reason-gated detach twins.
                  // The index triple is positional (string, wstring, dynarray)
                  // exactly as on the EXE path, so the same emitter serves
                  // both; only the routines and the extra fdwReason argument
                  // differ. FSSABuilder is known assigned here because
                  // LReleaseOnDetachFuncIdx could not otherwise be >= 0.
                  LGlobal := FIR.GetGlobal(LManagedGlobals[LI]);
                  DoEmitManagedRelease(AFunc, LBlock, LInstrIdx,
                    TMyrSSAOperand.FromGlobal(LManagedGlobals[LI]),
                    LGlobal.GlobalTypeRef, LReleaseOnDetachFuncIdx,
                    FSSABuilder.GetFreeOnDetachTarget(),
                    FSSABuilder.GetDynFreeOnDetachTarget(),
                    TMyrSSAOperand.FromVar(LReasonVar), True);
                end;
              end;
            end;
          end;
          
          // Skip past the return instruction itself
          Inc(LInstrIdx);
        end
        else
          Inc(LInstrIdx);
      end;
    end;
    
  finally
    LManagedLocals.Free();
    LManagedGlobals.Free();
  end;
end;

{ TMyrSSABuilder }
constructor TMyrSSABuilder.Create();
begin
  inherited Create();
  
  FOptions := TMyrSSAOptions.Release();
  FFunctions := TObjectList<TMyrSSAFunc>.Create(True);
  FCurrentFuncIndex := -1;
  FPasses := TObjectList<TMyrSSAPass>.Create(True);
  FExpressionCache := TDictionary<Integer, TMyrSSAVar>.Create();
  
  // Add default optimization passes (order matters!)
  // Level 1: Constant propagation, constant folding, DCE
  // Level 2: + Copy propagation, CSE
  FPasses.Add(TMyrSSAConstantPropagation.Create());   // Level 1
  FPasses.Add(TMyrSSAConstantFolding.Create());       // Level 1
  FPasses.Add(TMyrSSACopyPropagation.Create());       // Level 2
  FPasses.Add(TMyrSSACommonSubexprElim.Create());     // Level 2
  FPasses.Add(TMyrSSACopyPropagation.Create());       // Level 2 - run again to propagate CSE copies
  FPasses.Add(TMyrSSADeadCodeElimination.Create());   // Level 1 (always last)
end;

destructor TMyrSSABuilder.Destroy();
begin
  FExpressionCache.Free();
  FPasses.Free();
  FFunctions.Free();
  
  inherited Destroy();
end;

procedure TMyrSSABuilder.SetOptions(const AOptions: TMyrSSAOptions);
begin
  FOptions := AOptions;
end;

function TMyrSSABuilder.GetOptions(): TMyrSSAOptions;
begin
  Result := FOptions;
end;

procedure TMyrSSABuilder.BuildFrom(const AIR: TMyrIR; const ADebug: Boolean);
var
  LI: Integer;
  LJ: Integer;
  LFunc: TMyrIR.TMyrIRFunc;
  LSSAFunc: TMyrSSAFunc;
  LVar: TMyrIR.TMyrIRVar;
  LVarSize: Integer;
  LVarAlign: Integer;
  LImport: TMyrIR.TMyrIRImport;
  LStr: TMyrIR.TMyrIRString;
  LStrCleanup: TMyrSSAStringCleanup;
begin
  Clear();

  Status('SSA: Building from high-level IR (%d functions)', [AIR.GetFunctionCount()]);

  // Facts DCE needs after the IR is gone (see FUserFuncCount)
  FUserFuncCount := AIR.GetUserFuncCount();
  FIsRuntimeProvider := AIR.HasStaticImports();
  
  // Step 1: Initialize import tracking
  FStrReleaseTarget := Default(TMyrSSAOperand);
  FStrAddRefTarget := Default(TMyrSSAOperand);
  FFreMemTarget := Default(TMyrSSAOperand);
  FDynFreeTarget := Default(TMyrSSAOperand);
  FReportLeaksTarget := Default(TMyrSSAOperand);
  FReleaseOnDetachTarget := Default(TMyrSSAOperand);
  FFreeOnDetachTarget := Default(TMyrSSAOperand);
  FDynFreeOnDetachTarget := Default(TMyrSSAOperand);
  FArrayReleaseTarget := Default(TMyrSSAOperand);
  FArrayReleaseOnDetachTarget := Default(TMyrSSAOperand);
  FDynLenTarget := Default(TMyrSSAOperand);
  FArrayReleaseCompositeTarget := Default(TMyrSSAOperand);
  FArrayReleaseCompositeOnDetachTarget := Default(TMyrSSAOperand);
  for LI := 0 to AIR.GetImportCount() - 1 do
  begin
    LImport := AIR.GetImport(LI);
    Status(ADebug, 'SSA: Import[%d]: %s.%s', [LI, LImport.DllName, LImport.FuncName]);
  end;

  // Step 2: Log string constants
  for LI := 0 to AIR.GetStringCount() - 1 do
  begin
    LStr := AIR.GetString(LI);
    Status(ADebug, 'SSA: String[%d]: "%s"', [LI, LStr.Value.Replace(#13, '\r').Replace(#10, '\n')]);
  end;

  // Step 3: Convert each function
  for LI := 0 to AIR.GetFunctionCount() - 1 do
  begin
    LFunc := AIR.GetFunction(LI);
    Status(ADebug, 'SSA: Converting function: %s', [LFunc.FuncName]);
    
    // Create SSA function
    LSSAFunc := TMyrSSAFunc.Create(LFunc.FuncName);
    LSSAFunc.SetReturnType(LFunc.ReturnType, LFunc.ReturnSize, LFunc.ReturnAlignment);
    LSSAFunc.SetIsEntryPoint(LFunc.IsEntryPoint);
    LSSAFunc.SetIsDllEntry(LFunc.IsDllEntry);
    LSSAFunc.SetIsPublic(LFunc.IsPublic);
    LSSAFunc.SetLinkage(LFunc.Linkage);
    LSSAFunc.SetIsVariadic(LFunc.IsVariadic);
    
    // Add params and locals
    for LJ := 0 to LFunc.Vars.Count - 1 do
    begin
      LVar := LFunc.Vars[LJ];
      // Calculate size and alignment for this variable
      if LVar.VarTypeRef.IsPrimitive then
      begin
        LVarSize := 8;   // All primitives use 8 bytes on stack (aligned)
        LVarAlign := 8;  // Primitives align to 8 bytes
      end
      else
      begin
        LVarSize := AIR.GetTypeSize(LVar.VarTypeRef);       // Get composite type size
        LVarAlign := AIR.GetTypeAlignment(LVar.VarTypeRef); // Get composite type alignment
      end;
      LSSAFunc.AddLocal(LVar.VarName, LVar.VarTypeRef, LVarSize, LVarAlign, LVar.IsParam, AIR.IsManagedType(LVar.VarTypeRef), LVar.IsByRef);
    end;
    
    // Create entry block
    LSSAFunc.CreateBlock('entry');
    LSSAFunc.SetCurrentBlock(0);
    
    // Clear expression cache for this function
    FExpressionCache.Clear();
    
    // Convert statements to SSA
    ConvertStatements(AIR, LI, LSSAFunc);
    
    // SSA construction: compute dominators, insert phi nodes, rename
    ComputeDominators(LSSAFunc);
    ComputeDominanceFrontiers(LSSAFunc);
    InsertPhiNodes(LSSAFunc);
    RenameVariables(LSSAFunc);
    
    // Add function to list
    FFunctions.Add(LSSAFunc);
    
    // Track runtime helper targets for the string cleanup pass.
    // Each target is recorded as TMyrSSAOperand.FromFunc so that the cleanup
    // pass can emit calls without knowing whether the helper is a local
    // function or an import (the import case is handled in the post-loop scan).
    if LFunc.FuncName = RT_StrRelease then
      FStrReleaseTarget := TMyrSSAOperand.FromFunc(FFunctions.Count - 1);
    if LFunc.FuncName = RT_StrAddRef then
      FStrAddRefTarget := TMyrSSAOperand.FromFunc(FFunctions.Count - 1);
    if LFunc.FuncName = RT_FreeMem then
      FFreMemTarget := TMyrSSAOperand.FromFunc(FFunctions.Count - 1);
    if LFunc.FuncName = RT_DynFree then
      FDynFreeTarget := TMyrSSAOperand.FromFunc(FFunctions.Count - 1);
    if LFunc.FuncName = RT_ReportLeaks then
      FReportLeaksTarget := TMyrSSAOperand.FromFunc(FFunctions.Count - 1);
    if LFunc.FuncName = RT_ReleaseOnDetach then
      FReleaseOnDetachTarget := TMyrSSAOperand.FromFunc(FFunctions.Count - 1);
    if LFunc.FuncName = RT_FreeOnDetach then
      FFreeOnDetachTarget := TMyrSSAOperand.FromFunc(FFunctions.Count - 1);
    if LFunc.FuncName = RT_DynFreeOnDetach then
      FDynFreeOnDetachTarget := TMyrSSAOperand.FromFunc(FFunctions.Count - 1);
    if LFunc.FuncName = RT_ArrayRelease then
      FArrayReleaseTarget := TMyrSSAOperand.FromFunc(FFunctions.Count - 1);
    if LFunc.FuncName = RT_ArrayReleaseOnDetach then
      FArrayReleaseOnDetachTarget := TMyrSSAOperand.FromFunc(FFunctions.Count - 1);
    if LFunc.FuncName = RT_DynLen then
      FDynLenTarget := TMyrSSAOperand.FromFunc(FFunctions.Count - 1);
    if LFunc.FuncName = RT_ArrayReleaseComposite then
      FArrayReleaseCompositeTarget := TMyrSSAOperand.FromFunc(FFunctions.Count - 1);
    if LFunc.FuncName = RT_ArrayReleaseCompositeOnDetach then
      FArrayReleaseCompositeOnDetachTarget := TMyrSSAOperand.FromFunc(FFunctions.Count - 1);
  end;

  // Post-loop: any target still sokNone might be an import (lib consumer case).
  // Scan IR imports and resolve by name so the cleanup pass works identically
  // whether the helper is a local function or an imported symbol.
  for LI := 0 to AIR.GetImportCount() - 1 do
  begin
    LImport := AIR.GetImport(LI);
    if (not FStrReleaseTarget.IsCallTarget()) and (LImport.FuncName = RT_StrRelease) then
      FStrReleaseTarget := TMyrSSAOperand.FromImport(LI);
    if (not FStrAddRefTarget.IsCallTarget()) and (LImport.FuncName = RT_StrAddRef) then
      FStrAddRefTarget := TMyrSSAOperand.FromImport(LI);
    if (not FFreMemTarget.IsCallTarget()) and (LImport.FuncName = RT_FreeMem) then
      FFreMemTarget := TMyrSSAOperand.FromImport(LI);
    if (not FDynFreeTarget.IsCallTarget()) and (LImport.FuncName = RT_DynFree) then
      FDynFreeTarget := TMyrSSAOperand.FromImport(LI);
    if (not FReportLeaksTarget.IsCallTarget()) and (LImport.FuncName = RT_ReportLeaks) then
      FReportLeaksTarget := TMyrSSAOperand.FromImport(LI);
    if (not FReleaseOnDetachTarget.IsCallTarget()) and (LImport.FuncName = RT_ReleaseOnDetach) then
      FReleaseOnDetachTarget := TMyrSSAOperand.FromImport(LI);
    if (not FFreeOnDetachTarget.IsCallTarget()) and (LImport.FuncName = RT_FreeOnDetach) then
      FFreeOnDetachTarget := TMyrSSAOperand.FromImport(LI);
    if (not FDynFreeOnDetachTarget.IsCallTarget()) and (LImport.FuncName = RT_DynFreeOnDetach) then
      FDynFreeOnDetachTarget := TMyrSSAOperand.FromImport(LI);
    if (not FArrayReleaseTarget.IsCallTarget()) and (LImport.FuncName = RT_ArrayRelease) then
      FArrayReleaseTarget := TMyrSSAOperand.FromImport(LI);
    if (not FArrayReleaseOnDetachTarget.IsCallTarget()) and (LImport.FuncName = RT_ArrayReleaseOnDetach) then
      FArrayReleaseOnDetachTarget := TMyrSSAOperand.FromImport(LI);
    if (not FDynLenTarget.IsCallTarget()) and (LImport.FuncName = RT_DynLen) then
      FDynLenTarget := TMyrSSAOperand.FromImport(LI);
    if (not FArrayReleaseCompositeTarget.IsCallTarget()) and (LImport.FuncName = RT_ArrayReleaseComposite) then
      FArrayReleaseCompositeTarget := TMyrSSAOperand.FromImport(LI);
    if (not FArrayReleaseCompositeOnDetachTarget.IsCallTarget()) and (LImport.FuncName = RT_ArrayReleaseCompositeOnDetach) then
      FArrayReleaseCompositeOnDetachTarget := TMyrSSAOperand.FromImport(LI);
  end;

  // Step 4: Run mandatory string cleanup pass
  if FStrReleaseTarget.IsCallTarget() then
  begin
    Status('SSA: Running string cleanup pass');
    LStrCleanup := TMyrSSAStringCleanup.Create(Self, AIR);
    try
      for LI := 0 to FFunctions.Count - 1 do
        LStrCleanup.Run(FFunctions[LI]);
    finally
      LStrCleanup.Free();
    end;
  end;
  
  Status('SSA: Conversion complete (%d functions)', [FFunctions.Count]);
end;

function TMyrSSABuilder.DoEmitArrayBaseAddr(
  const AIR: TMyrIR;
  const AArrayExprIndex: Integer;
  const ASSAFunc: TMyrSSAFunc
): TMyrSSAVar;
// Single authority for deriving the BASE ADDRESS of an indexable expression.
// Extracted from the skAssign dest = ekArrayIndex branch so that the
// dest = ekFieldAccess branch can index through a dynarray FIELD without a
// further copy of the tkDynArray test. Four copies of that test is why the
// dynarray-through-a-field defect had four independent sites.
//
// A composite-typed simple VARIABLE is the only shape whose base address is
// not already the value of the expression. Every other shape (pointers, field
// accesses, nested indexing) yields the base directly from ConvertExpression,
// which applies the dynarray data-pointer load itself.
var
  LArrayExpr: TMyrIR.TMyrIRExprNode;
  LGlobalIdx: Integer;
  LInstr: TMyrSSAInstr;
begin
  LArrayExpr := AIR.GetExpression(AArrayExprIndex);

  if (LArrayExpr.Kind = TMyrIR.TMyrIRExprKind.ekVariable) and
     (not LArrayExpr.ResultType.IsPrimitive) then
  begin
    // Dynamic arrays: value IS the data pointer, no addrof needed
    if (LArrayExpr.ResultType.TypeIndex >= 0) and
       (AIR.GetTypeEntry(LArrayExpr.ResultType.TypeIndex).Kind = TMyrIR.TMyrIRTypeKind.tkDynArray) then
    begin
      Result := ConvertExpression(AIR, AArrayExprIndex, ASSAFunc);
      Exit;
    end;

    // Fixed array: check if global or local
    LGlobalIdx := AIR.FindGlobal(LArrayExpr.VarName);
    if LGlobalIdx >= 0 then
    begin
      // Global array: pass .data address directly
      Result := ASSAFunc.NewVersion('_t');
      LInstr := Default(TMyrSSAInstr);
      LInstr.Kind := sikAssign;
      LInstr.Dest := Result;
      LInstr.Op1 := TMyrSSAOperand.FromGlobal(LGlobalIdx);
      ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
      Exit;
    end;

    // Local array: emit AddressOf to get stack address
    Result := ASSAFunc.NewVersion('_t');
    LInstr := Default(TMyrSSAInstr);
    LInstr.Kind := sikAddressOf;
    LInstr.Dest := Result;
    LInstr.Op1 := TMyrSSAOperand.FromVar(ASSAFunc.CurrentVersion(LArrayExpr.VarName));
    LInstr.Op1.Var_.BaseName := LArrayExpr.VarName;
    ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
    Exit;
  end;

  // For other expressions (pointers, field accesses, etc.), convert normally
  Result := ConvertExpression(AIR, AArrayExprIndex, ASSAFunc);
end;

procedure TMyrSSABuilder.ConvertStatements(
  const AIR: TMyrIR;
  const AFuncIndex: Integer;
  const ASSAFunc: TMyrSSAFunc
);
var
  LFunc: TMyrIR.TMyrIRFunc;
  LStmt: TMyrIR.TMyrIRStmt;
  LI: Integer;
  LInstr: TMyrSSAInstr;
  LDestVar: TMyrSSAVar;
  LExprVar: TMyrSSAVar;
  LCondVar: TMyrSSAVar;
  LArgVar: TMyrSSAVar;
  LLeftVar: TMyrSSAVar;
  LRightVar: TMyrSSAVar;
  LTempVar: TMyrSSAVar;
  LRangeLoVar: TMyrSSAVar;   // skOn range arm: result of selector >= LowValue
  LRangeHiVar: TMyrSSAVar;   // skOn range arm: result of selector <= HighValue
  LDestExprNode: TMyrIR.TMyrIRExprNode;
  LObjectExpr: TMyrIR.TMyrIRExprNode;
  LBlockStack: TStack<Integer>;  // Stack of block indices for control flow
  LForVarStack: TStack<string>;   // Stack of for-loop variable names
  LForDownToStack: TStack<Boolean>; // Stack of for-loop direction flags
  LLoopCtxStack: TStack<TMyrSSALoopCtx>; // Loop context for break/continue
  LLoopCtx: TMyrSSALoopCtx;
  LForVar: string;
  LIsDownTo: Boolean;
  LThenBlock: Integer;
  LElseBlock: Integer;
  LEndBlock: Integer;
  LLoopBlock: Integer;
  LBodyBlock: Integer;
  LLatchBlock: Integer;
  LArgIdx: Integer;
  LFuncIdx: Integer;
  LCallArgs: TArray<TMyrSSAOperand>;
  LCurrentBlockId: Integer;
  LHeaderBlock: Integer;
  LPatchIdx: Integer;
  // Exception handling
  LTryBlock: Integer;
  LExceptBlock: Integer;
  LFinallyBlock: Integer;
  LTryEndBlock: Integer;
  LExcScope: TMyrSSAExceptionScope;
  // Variadic call handling
  LTargetFunc: TMyrIR.TMyrIRFunc;
  LFixedParamCount: Integer;
  LVarArgCount: Integer;
  LJ: Integer;
  LImportIdx: Integer;
  // For by-reference parameter detection in field access
  LIsParam: Boolean;
  LIsAggregateParam: Boolean;
  LLocalSize: Integer;
  LLocalIdx: Integer;
  LLocalInfo: TMyrSSALocalInfo;
  LByRefInstr: TMyrSSAInstr;
  LArgExpr: TMyrIR.TMyrIRExprNode;
  LGlobalIdx: Integer;
  // Statement-call overload resolution
  LStmtArgTypes: TArray<TMyrTypeRef>;
begin
  LFunc := AIR.GetFunction(AFuncIndex);
  LBlockStack := TStack<Integer>.Create();
  LForVarStack := TStack<string>.Create();
  LForDownToStack := TStack<Boolean>.Create();
  LLoopCtxStack := TStack<TMyrSSALoopCtx>.Create();
  try
    // Inject runtime startup calls for EXE entry points only.
    // DLL entries get their lifecycle from AddDllEntry in the runtime.
    if LFunc.IsEntryPoint and (not LFunc.IsDllEntry) then
    begin
      SetLength(LCallArgs, 0);

      LFuncIdx := FindLocalFuncByName(AIR, RT_InitExceptions);
      if LFuncIdx >= 0 then
      begin
        LInstr := Default(TMyrSSAInstr);
        LInstr.Kind := sikCall;
        LInstr.CallArgs := LCallArgs;
        LInstr.CallTarget := TMyrSSAOperand.FromFunc(LFuncIdx);
        ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
      end;

      LFuncIdx := FindLocalFuncByName(AIR, RT_InitConsole);
      if LFuncIdx >= 0 then
      begin
        LInstr := Default(TMyrSSAInstr);
        LInstr.Kind := sikCall;
        LInstr.CallArgs := LCallArgs;
        LInstr.CallTarget := TMyrSSAOperand.FromFunc(LFuncIdx);
        ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
      end;

      LFuncIdx := FindLocalFuncByName(AIR, RT_InitCommandLine);
      if LFuncIdx >= 0 then
      begin
        LInstr := Default(TMyrSSAInstr);
        LInstr.Kind := sikCall;
        LInstr.CallArgs := LCallArgs;
        LInstr.CallTarget := TMyrSSAOperand.FromFunc(LFuncIdx);
        ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
      end;

      // Module init functions
      for LJ := 0 to AIR.GetFunctionCount() - 1 do
      begin
        if AIR.GetFunction(LJ).FuncName.StartsWith(RT_ModuleInit + '_') then
        begin
          LInstr := Default(TMyrSSAInstr);
          LInstr.Kind := sikCall;
          LInstr.CallArgs := LCallArgs;
          LInstr.CallTarget := TMyrSSAOperand.FromFunc(LJ);
          ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
        end;
      end;

      // Register module finalize functions
      LFuncIdx := FindLocalFuncByName(AIR, RT_RegisterFinalizer);
      if LFuncIdx >= 0 then
      begin
        for LJ := 0 to AIR.GetFunctionCount() - 1 do
        begin
          if AIR.GetFunction(LJ).FuncName.StartsWith(RT_ModuleFinalize + '_') then
          begin
            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikFuncAddr;
            LInstr.Dest := ASSAFunc.NewVersion('_t');
            LInstr.Op1 := TMyrSSAOperand.FromFunc(LJ);
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);

            SetLength(LCallArgs, 1);
            LCallArgs[0] := TMyrSSAOperand.FromVar(LInstr.Dest);
            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikCall;
            LInstr.CallArgs := LCallArgs;
            LInstr.CallTarget := TMyrSSAOperand.FromFunc(LFuncIdx);
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            SetLength(LCallArgs, 0);
          end;
        end;
      end;
    end;

    for LI := 0 to LFunc.Stmts.Count - 1 do
    begin
      LStmt := LFunc.Stmts[LI];
      
      // Propagate source location to all SSA instructions from this statement
      if LStmt.SourceLine > 0 then
        ASSAFunc.GetCurrentBlock().SetSourceLocation(LStmt.SourceLine, LStmt.SourceColumn, LStmt.SourceFile);

      case LStmt.Kind of
        TMyrIR.TMyrIRStmtKind.skAssign:
          begin
            // Convert source expression
            LExprVar := ConvertExpression(AIR, LStmt.Expr, ASSAFunc);
            
            // Check if destination is an expression (field/index access)
            if LStmt.DestExpr >= 0 then
            begin
              // Get destination expression
              LDestExprNode := AIR.GetExpression(LStmt.DestExpr);
              
              if LDestExprNode.Kind = TMyrIR.TMyrIRExprKind.ekFieldAccess then
              begin
                // Field access: compute address and store
                // Get the inner object expression
                LObjectExpr := AIR.GetExpression(LDestExprNode.ObjectExpr);
                
                // For variable expressions with composite types, we need the address
                if (LObjectExpr.Kind = TMyrIR.TMyrIRExprKind.ekVariable) and 
                   (not LObjectExpr.ResultType.IsPrimitive) then
                begin
                  // Check if this is a parameter passed by reference (composite > 8 bytes)
                  // Win64 ABI: Large structs are passed by pointer, so param value IS the address
                  LIsParam := False;
                  LIsAggregateParam := False;
                  LLocalSize := 0;
                  for LLocalIdx := 0 to ASSAFunc.GetLocalCount() - 1 do
                  begin
                    LLocalInfo := ASSAFunc.GetLocal(LLocalIdx);
                    if LLocalInfo.LocalName = LObjectExpr.VarName then
                    begin
                      LIsParam := LLocalInfo.IsParam;
                      LLocalSize := LLocalInfo.LocalSize;
                      LIsAggregateParam := LLocalInfo.IsParam and
                        DoIsAggregateTypeRef(AIR, LLocalInfo.LocalTypeRef);
                      Break;
                    end;
                  end;
                  
                  // Check if this is a global variable first
                  LArgIdx := AIR.FindGlobal(LObjectExpr.VarName);
                  if LArgIdx >= 0 then
                  begin
                    // Global variable - sokGlobal operand IS the address (backend emits LEA)
                    LLeftVar := ASSAFunc.NewVersion('_t');
                    LInstr := Default(TMyrSSAInstr);
                    LInstr.Kind := sikAssign;
                    LInstr.Dest := LLeftVar;
                    LInstr.Op1 := TMyrSSAOperand.FromGlobal(LArgIdx);
                    ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
                  end
                  else
                  begin
                    // Emit AddressOf instruction to get local's/param's stack address
                    LLeftVar := ASSAFunc.NewVersion('_t');
                    LInstr := Default(TMyrSSAInstr);
                    LInstr.Kind := sikAddressOf;
                    LInstr.Dest := LLeftVar;
                    LInstr.Op1 := TMyrSSAOperand.FromVar(ASSAFunc.CurrentVersion(LObjectExpr.VarName));
                    // If no version exists yet (first use of composite var), create version 0
                    if not LInstr.Op1.Var_.IsValid() then
                      LInstr.Op1 := TMyrSSAOperand.FromVar(ASSAFunc.NewVersion(LObjectExpr.VarName));
                    LInstr.Op1.Var_.BaseName := LObjectExpr.VarName;
                    ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
                    
                    if LIsAggregateParam then
                    begin
                      // By-reference parameter: param slot contains pointer to struct
                      // Load the pointer value from the param slot
                      LTempVar := LLeftVar;
                      LLeftVar := ASSAFunc.NewVersion('_t');
                      LInstr := Default(TMyrSSAInstr);
                      LInstr.Kind := sikLoad;
                      LInstr.Dest := LLeftVar;
                      LInstr.Op1 := TMyrSSAOperand.FromVar(LTempVar);
                      ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
                    end;
                  end;
                end
                else if (LObjectExpr.Kind = TMyrIR.TMyrIRExprKind.ekUnary) and
                        (LObjectExpr.Op = TMyrIR.TMyrIROpKind.opDeref) then
                begin
                  // For Deref(ptr, TypeName), we want just the pointer value as base.
                  // Don't generate a load - convert only the inner pointer expression.
                  LLeftVar := ConvertExpression(AIR, LObjectExpr.Left, ASSAFunc);
                end
                else if LObjectExpr.Kind = TMyrIR.TMyrIRExprKind.ekArrayIndex then
                begin
                  // DEFECT: record.arrayField[i].stringField := "..." faulted
                  // 0xC0000005. The object here is an ARRAY INDEX, so the base
                  // for the sikFieldAddr below must be the ELEMENT ADDRESS.
                  // Without this case the generic else ran ConvertExpression on
                  // the ekArrayIndex node, which yields the element VALUE, and
                  // sikFieldAddr then added the field offset to that value as
                  // though it were an address.
                  //
                  // The earlier dynarray-through-a-field fix covered the READ
                  // path (ConvertExpression, ekFieldAccess) only. This is the
                  // WRITE path and was never reached by it.
                  //
                  // Base derivation is delegated to DoEmitArrayBaseAddr so the
                  // tkDynArray test stays in one place.
                  //
                  // Repros: temp\probe_vpkiso5d.myr (local outer),
                  //         temp\probe_vpkiso5e.myr (global outer).
                  LLeftVar := DoEmitArrayBaseAddr(AIR, LObjectExpr.ArrayExpr, ASSAFunc);
                  LRightVar := ConvertExpression(AIR, LObjectExpr.IndexExpr, ASSAFunc);

                  LTempVar := ASSAFunc.NewVersion('_t');
                  LInstr := Default(TMyrSSAInstr);
                  LInstr.Kind := sikIndexAddr;
                  LInstr.Dest := LTempVar;
                  LInstr.Op1 := TMyrSSAOperand.FromVar(LLeftVar);
                  LInstr.Op2 := TMyrSSAOperand.FromVar(LRightVar);
                  LInstr.Op2.ElementSize := LObjectExpr.ElementSize;
                  ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);

                  LLeftVar := LTempVar;
                end
                else
                begin
                  // For other expressions (pointers, etc.), convert normally
                  LLeftVar := ConvertExpression(AIR, LDestExprNode.ObjectExpr, ASSAFunc);
                end;
                
                // Compute field address
                LTempVar := ASSAFunc.NewVersion('_t');
                LInstr := Default(TMyrSSAInstr);
                LInstr.Kind := sikFieldAddr;
                LInstr.Dest := LTempVar;
                LInstr.Op1 := TMyrSSAOperand.FromVar(LLeftVar);
                LInstr.Op2 := TMyrSSAOperand.FromImm(LDestExprNode.FieldOffset);
                LInstr.Op2.FieldName := LDestExprNode.FieldName;
                ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
                
                // Check if this is a bit field
                if LDestExprNode.BitWidth > 0 then
                begin
                  // Bit field write: read-modify-write
                  // 1. Load current storage unit value
                  LLeftVar := LTempVar;  // Address
                  LRightVar := ASSAFunc.NewVersion('_t');
                  LInstr := Default(TMyrSSAInstr);
                  LInstr.Kind := sikLoad;
                  LInstr.Dest := LRightVar;
                  LInstr.Op1 := TMyrSSAOperand.FromVar(LLeftVar);
                  ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
                  
                  // 2. Clear target bits: current & ~(mask << BitOffset)
                  // mask = (1 << BitWidth) - 1
                  // clearMask = ~(mask << BitOffset)
                  LTempVar := ASSAFunc.NewVersion('_t');
                  LInstr := Default(TMyrSSAInstr);
                  LInstr.Kind := sikBitAnd;
                  LInstr.Dest := LTempVar;
                  LInstr.Op1 := TMyrSSAOperand.FromVar(LRightVar);
                  LInstr.Op2 := TMyrSSAOperand.FromImm(not (((Int64(1) shl LDestExprNode.BitWidth) - 1) shl LDestExprNode.BitOffset));
                  ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
                  
                  // 3. Mask new value to BitWidth bits
                  LRightVar := ASSAFunc.NewVersion('_t');
                  LInstr := Default(TMyrSSAInstr);
                  LInstr.Kind := sikBitAnd;
                  LInstr.Dest := LRightVar;
                  LInstr.Op1 := TMyrSSAOperand.FromVar(LExprVar);
                  LInstr.Op2 := TMyrSSAOperand.FromImm((Int64(1) shl LDestExprNode.BitWidth) - 1);
                  ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
                  
                  // 4. Shift new value left by BitOffset
                  if LDestExprNode.BitOffset > 0 then
                  begin
                    LExprVar := LRightVar;
                    LRightVar := ASSAFunc.NewVersion('_t');
                    LInstr := Default(TMyrSSAInstr);
                    LInstr.Kind := sikShl;
                    LInstr.Dest := LRightVar;
                    LInstr.Op1 := TMyrSSAOperand.FromVar(LExprVar);
                    LInstr.Op2 := TMyrSSAOperand.FromImm(LDestExprNode.BitOffset);
                    ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
                  end;
                  
                  // 5. OR the shifted value into cleared storage
                  LExprVar := ASSAFunc.NewVersion('_t');
                  LInstr := Default(TMyrSSAInstr);
                  LInstr.Kind := sikBitOr;
                  LInstr.Dest := LExprVar;
                  LInstr.Op1 := TMyrSSAOperand.FromVar(LTempVar);
                  LInstr.Op2 := TMyrSSAOperand.FromVar(LRightVar);
                  ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
                  
                  // 6. Store the combined value back
                  LInstr := Default(TMyrSSAInstr);
                  LInstr.Kind := sikStore;
                  LInstr.Op1 := TMyrSSAOperand.FromVar(LLeftVar);  // Original address
                  LInstr.Op2 := TMyrSSAOperand.FromVar(LExprVar);
                  ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
                end
                else
                begin
                  // Normal field: direct store (sized for sub-register fields)
                  LInstr := Default(TMyrSSAInstr);
                  LInstr.Kind := sikStore;
                  LInstr.Op1 := TMyrSSAOperand.FromVar(LTempVar);
                  LInstr.Op2 := TMyrSSAOperand.FromVar(LExprVar);
                  LInstr.MemSize := LDestExprNode.FieldSize;
                  LInstr.MemIsFloat := LDestExprNode.ResultType.IsPrimitive and
                    (LDestExprNode.ResultType.Primitive in [cvtFloat32, cvtFloat64]);
                  ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
                end;
              end
              else if LDestExprNode.Kind = TMyrIR.TMyrIRExprKind.ekArrayIndex then
              begin
                // Array index: compute element address and store
                // Get the array expression node
                LObjectExpr := AIR.GetExpression(LDestExprNode.ArrayExpr);
                
                // For variable expressions with composite types (arrays), we need the address
                if (LObjectExpr.Kind = TMyrIR.TMyrIRExprKind.ekVariable) and 
                   (not LObjectExpr.ResultType.IsPrimitive) then
                begin
                  // Dynamic arrays: value IS the data pointer, no addrof needed
                  if (LObjectExpr.ResultType.TypeIndex >= 0) and
                     (AIR.GetTypeEntry(LObjectExpr.ResultType.TypeIndex).Kind = TMyrIR.TMyrIRTypeKind.tkDynArray) then
                  begin
                    LLeftVar := ConvertExpression(AIR, LDestExprNode.ArrayExpr, ASSAFunc);
                  end
                  else
                  begin
                    // Fixed array: check if global or local
                    LGlobalIdx := AIR.FindGlobal(LObjectExpr.VarName);
                    if LGlobalIdx >= 0 then
                    begin
                      // Global array: pass .data address directly
                      LLeftVar := ASSAFunc.NewVersion('_t');
                      LInstr := Default(TMyrSSAInstr);
                      LInstr.Kind := sikAssign;
                      LInstr.Dest := LLeftVar;
                      LInstr.Op1 := TMyrSSAOperand.FromGlobal(LGlobalIdx);
                      ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
                    end
                    else
                    begin
                      // Local array: emit AddressOf to get stack address
                      LLeftVar := ASSAFunc.NewVersion('_t');
                      LInstr := Default(TMyrSSAInstr);
                      LInstr.Kind := sikAddressOf;
                      LInstr.Dest := LLeftVar;
                      LInstr.Op1 := TMyrSSAOperand.FromVar(ASSAFunc.CurrentVersion(LObjectExpr.VarName));
                      LInstr.Op1.Var_.BaseName := LObjectExpr.VarName;
                      ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
                    end;
                  end;
                end
                else
                begin
                  // For other expressions (pointers, etc.), convert normally
                  LLeftVar := ConvertExpression(AIR, LDestExprNode.ArrayExpr, ASSAFunc);
                end;
                
                LRightVar := ConvertExpression(AIR, LDestExprNode.IndexExpr, ASSAFunc);
                
                // Compute element address
                LTempVar := ASSAFunc.NewVersion('_t');
                LInstr := Default(TMyrSSAInstr);
                LInstr.Kind := sikIndexAddr;
                LInstr.Dest := LTempVar;
                LInstr.Op1 := TMyrSSAOperand.FromVar(LLeftVar);
                LInstr.Op2 := TMyrSSAOperand.FromVar(LRightVar);
                LInstr.Op2.ElementSize := LDestExprNode.ElementSize;
                ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
                
                // Store value to element address (sized to element)
                LInstr := Default(TMyrSSAInstr);
                LInstr.Kind := sikStore;
                LInstr.Op1 := TMyrSSAOperand.FromVar(LTempVar);
                LInstr.Op2 := TMyrSSAOperand.FromVar(LExprVar);
                LInstr.MemSize := LDestExprNode.ElementSize;
                LInstr.MemIsFloat := LDestExprNode.ResultType.IsPrimitive and
                  (LDestExprNode.ResultType.Primitive in [cvtFloat32, cvtFloat64]);
                ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
              end
              else if (LDestExprNode.Kind = TMyrIR.TMyrIRExprKind.ekUnary) and 
                      (LDestExprNode.Op = TMyrIR.TMyrIROpKind.opDeref) then
              begin
                // Deref: convert pointer expression and store to it
                LLeftVar := ConvertExpression(AIR, LDestExprNode.Left, ASSAFunc);
                
                // Store value to dereferenced address
                LInstr := Default(TMyrSSAInstr);
                LInstr.Kind := sikStore;
                LInstr.Op1 := TMyrSSAOperand.FromVar(LLeftVar);
                LInstr.Op2 := TMyrSSAOperand.FromVar(LExprVar);
                // Set MemSize based on the deref's declared type for correct
                // store width (SetVal(Deref(ptr, cvtUInt8), v) must store 1 byte)
                if LDestExprNode.ResultType.IsPrimitive then
                begin
                  case LDestExprNode.ResultType.Primitive of
                    cvtInt8, cvtUInt8:   LInstr.MemSize := 1;
                    cvtInt16, cvtUInt16: LInstr.MemSize := 2;
                    cvtInt32, cvtUInt32, cvtFloat32: LInstr.MemSize := 4;
                  else
                    LInstr.MemSize := 0;
                  end;
                  LInstr.MemIsFloat := LDestExprNode.ResultType.Primitive in [cvtFloat32, cvtFloat64];
                end;
                ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
              end;
            end
            else
            begin
              // Aggregate destination: whole-object move. Source is already an
              // address (ekVariable rule); destination address comes from the
              // same resolver. This is TinyCC's vstore for VT_STRUCT: memmove.
              LDestExprNode := AIR.GetExpression(LStmt.Expr);
              if DoIsAggregateTypeRef(AIR, LDestExprNode.ResultType) then
              begin
                LDestVar := DoEmitAggregateAddr(AIR, LStmt.DestVar, ASSAFunc);
                LInstr := Default(TMyrSSAInstr);
                LInstr.Kind := sikBlockCopy;
                LInstr.Op1 := TMyrSSAOperand.FromVar(LDestVar);
                LInstr.Op2 := TMyrSSAOperand.FromVar(LExprVar);
                LInstr.CopySize := AIR.GetTypeSize(LDestExprNode.ResultType);
                ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
              end
              else
              begin
              // Check if destination is a global variable
              // (function-scope locals/params shadow same-named globals)
              if ASSAFunc.HasLocalDecl(LStmt.DestVar) then
                LArgIdx := -1
              else
                LArgIdx := AIR.FindGlobal(LStmt.DestVar);
              if LArgIdx >= 0 then
              begin
                // Global variable - emit store to global address
                LInstr := Default(TMyrSSAInstr);
                LInstr.Kind := sikStore;
                LInstr.Op1 := TMyrSSAOperand.FromGlobal(LArgIdx);
                LInstr.Op2 := TMyrSSAOperand.FromVar(LExprVar);
                // Set MemSize and MemIsFloat based on global's type
                case AIR.GetGlobal(LArgIdx).GlobalType of
                  cvtInt8, cvtUInt8:   LInstr.MemSize := 1;
                  cvtInt16, cvtUInt16: LInstr.MemSize := 2;
                  cvtInt32, cvtUInt32, cvtFloat32: LInstr.MemSize := 4;
                else
                  LInstr.MemSize := 0;
                end;
                LInstr.MemIsFloat := AIR.GetGlobal(LArgIdx).GlobalType in [cvtFloat32, cvtFloat64];
                ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
              end
              else
              begin
                // Local variable - assign to new version
                LDestVar := ASSAFunc.NewVersion(LStmt.DestVar);
                
                LInstr := Default(TMyrSSAInstr);
                LInstr.Kind := sikAssign;
                LInstr.Dest := LDestVar;
                LInstr.Op1 := TMyrSSAOperand.FromVar(LExprVar);
                ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
              end;
              end;  // non-aggregate
            end;
          end;
          
        TMyrIR.TMyrIRStmtKind.skCall:
          begin
            // Convert call arguments
            SetLength(LCallArgs, Length(LStmt.CallArgs));
            for LArgIdx := 0 to High(LStmt.CallArgs) do
            begin
              LArgVar := ConvertExpression(AIR, LStmt.CallArgs[LArgIdx], ASSAFunc);
              LCallArgs[LArgIdx] := TMyrSSAOperand.FromVar(LArgVar);
            end;
            
            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikCall;
            LInstr.CallArgs := LCallArgs;

            // Build argument types array for overload resolution
            // (mirrors the sikCallAssign expression path)
            SetLength(LStmtArgTypes, Length(LStmt.CallArgs));
            for LArgIdx := 0 to High(LStmt.CallArgs) do
            begin
              LArgExpr := AIR.GetExpression(LStmt.CallArgs[LArgIdx]);
              LStmtArgTypes[LArgIdx] := LArgExpr.ResultType;
            end;

            // Check if this is a local function call first
            // Try signature-based lookup for overload resolution,
            // then arg-count match, then name-only fallback
            LFuncIdx := FindLocalFuncBySignature(AIR, LStmt.CallTarget, LStmtArgTypes);
            if LFuncIdx < 0 then
              LFuncIdx := FindLocalFuncByArgCount(AIR, LStmt.CallTarget, Length(LStmt.CallArgs));
            if LFuncIdx < 0 then
              LFuncIdx := FindLocalFuncByName(AIR, LStmt.CallTarget);
            if LFuncIdx >= 0 then
            begin
              LInstr.CallTarget := TMyrSSAOperand.FromFunc(LFuncIdx);
              
              // For by-ref params, emit AddressOf and replace arg with address
              LTargetFunc := AIR.GetFunction(LFuncIdx);
              LJ := 0;
              for LArgIdx := 0 to LTargetFunc.Vars.Count - 1 do
              begin
                if LTargetFunc.Vars[LArgIdx].IsParam then
                begin
                  if LTargetFunc.Vars[LArgIdx].IsByRef and (LJ < Length(LCallArgs)) then
                  begin
                    // Check if the argument is a global variable
                    LArgExpr := AIR.GetExpression(LStmt.CallArgs[LJ]);
                    LGlobalIdx := -1;
                    if LArgExpr.Kind = TMyrIR.TMyrIRExprKind.ekVariable then
                      LGlobalIdx := AIR.FindGlobal(LArgExpr.VarName);
                    if LGlobalIdx >= 0 then
                    begin
                      // Global variable: pass global address directly (LEA from .data)
                      LTempVar := ASSAFunc.NewVersion('_t');
                      LByRefInstr := Default(TMyrSSAInstr);
                      LByRefInstr.Kind := sikAssign;
                      LByRefInstr.Dest := LTempVar;
                      LByRefInstr.Op1 := TMyrSSAOperand.FromGlobal(LGlobalIdx);
                      ASSAFunc.GetCurrentBlock().AddInstruction(LByRefInstr);
                      LCallArgs[LJ] := TMyrSSAOperand.FromVar(LTempVar);
                    end
                    else if (LArgExpr.Kind = TMyrIR.TMyrIRExprKind.ekFieldAccess) and
                            (not LTargetFunc.Vars[LArgIdx].VarTypeRef.IsPrimitive) then
                    begin
                      // COMPOSITE record FIELD argument. Nothing to do: the
                      // operand ALREADY holds the field's address, because a
                      // composite field access lowers to fieldaddr, which is
                      // an address and not a load.
                      //
                      // Taking sikAddressOf here handed the callee the address
                      // of the TEMP holding that address; the callee then read
                      // the temp as the record base. Access violation on win64,
                      // proven by probe_vpk8/9/10.
                      //
                      // A bare local is unaffected - there the operand really
                      // is a stack slot, so the branch below stays correct.
                      //
                      // Deliberately scoped: ekFieldAccess only, COMPOSITE
                      // params only. A scalar var param receives a LOADED value
                      // here, which is a different defect shape and is not
                      // addressed by this change. ekArrayIndex is the obvious
                      // sibling and is excluded until it has a failing case.
                    end
                    else if (LArgExpr.Kind = TMyrIR.TMyrIRExprKind.ekUnary) and
                            (LArgExpr.Op = TMyrIR.TMyrIROpKind.opAddrOf) then
                    begin
                      // ALREADY AN ADDRESS. Nothing to do.
                      //
                      // DoEmitCallArg in Myrissa.Frontend.Emitter.pas (~3331)
                      // routes a composite 'var' argument through
                      // DoResolveCompositeAddr, which yields AddrOf(slot) for a
                      // local and the slot's VALUE for a large param. Either
                      // way the operand IS the object's address.
                      //
                      // Taking sikAddressOf over it handed the callee the
                      // address of a TEMP holding the address, which the callee
                      // then read as the record base. Verified by
                      // temp\probe_setlenvar.myr, which emitted
                      // addrof(addrof(bag_0)) before this branch existed.
                    end
                    else if (LArgExpr.Kind = TMyrIR.TMyrIRExprKind.ekVariable) and
                            ASSAFunc.IsByRefParam(LArgExpr.VarName) then
                    begin
                      // FORWARDED BY-REF PARAM. The slot's VALUE already IS
                      // the object's address, so the operand passes through
                      // untouched. Wrapping sikAddressOf here handed the
                      // callee the address of the POINTER; its field stores
                      // then landed relative to an 8-byte slot and smashed
                      // the caller's frame (probe_vpkwr11: Outer(var r) ->
                      // Inner(var r) lost the write; VpkPackBegin ->
                      // VpkWriteBytes(APacker) AV'd the same way).
                    end
                    else if DoIsAggregateTypeRef(AIR, LArgExpr.ResultType) then
                    begin
                      // AGGREGATE. The ekVariable rule already produced its
                      // address; wrapping sikAddressOf here would hand the
                      // callee the address of the temp -- the exact defect the
                      // three branches above were written to prevent.
                    end
                    else
                    begin
                      // Scalar local: take address of the local's stack slot
                      LTempVar := ASSAFunc.NewVersion('_t');
                      LByRefInstr := Default(TMyrSSAInstr);
                      LByRefInstr.Kind := sikAddressOf;
                      LByRefInstr.Dest := LTempVar;
                      LByRefInstr.Op1 := LCallArgs[LJ];
                      ASSAFunc.GetCurrentBlock().AddInstruction(LByRefInstr);
                      LCallArgs[LJ] := TMyrSSAOperand.FromVar(LTempVar);
                    end;
                  end;
                  Inc(LJ);
                end;
              end;
              LInstr.CallArgs := LCallArgs;

              // For internal variadic functions, prepend vararg count
              if LTargetFunc.IsVariadic then
              begin
                // Count fixed params in target function
                LFixedParamCount := 0;
                for LJ := 0 to LTargetFunc.Vars.Count - 1 do
                  if LTargetFunc.Vars[LJ].IsParam then
                    Inc(LFixedParamCount);
                
                // Calculate vararg count
                LVarArgCount := Length(LStmt.CallArgs) - LFixedParamCount;
                if LVarArgCount < 0 then
                  LVarArgCount := 0;
                
                // Prepend count to args array
                SetLength(LCallArgs, Length(LCallArgs) + 1);
                for LArgIdx := High(LCallArgs) downto 1 do
                  LCallArgs[LArgIdx] := LCallArgs[LArgIdx - 1];
                LCallArgs[0] := TMyrSSAOperand.FromImm(LVarArgCount);
                LInstr.CallArgs := LCallArgs;
              end;
            end
            else
            begin
              // Try signature-based lookup for overloaded imports,
              // then arg-count match, then name-only fallback
              LImportIdx := FindImportBySignature(AIR, LStmt.CallTarget, LStmtArgTypes);
              if LImportIdx < 0 then
                LImportIdx := FindImportByArgCount(AIR, LStmt.CallTarget, Length(LStmt.CallArgs));
              if LImportIdx < 0 then
                LImportIdx := FindImportByName(AIR, LStmt.CallTarget);
              if LImportIdx < 0 then
              begin
                if Assigned(FErrors) then
                  FErrors.Add(LStmt.SourceFile, LStmt.SourceLine, LStmt.SourceColumn,
                    esError, MYR_ERR_SSA_UNKNOWN_FUNCTION, RSSSAUnknownFunction,
                    [LStmt.CallTarget, ASSAFunc.GetFuncName()]);
                Exit;
              end;
              LInstr.CallTarget := TMyrSSAOperand.FromImport(LImportIdx);
            end;
            
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
          end;
          
        TMyrIR.TMyrIRStmtKind.skCallIndirect:
          begin
            // Convert the function pointer expression
            LExprVar := ConvertExpression(AIR, LStmt.IndirectTarget, ASSAFunc);
            
            // Convert call arguments
            SetLength(LCallArgs, Length(LStmt.CallArgs));
            for LArgIdx := 0 to High(LStmt.CallArgs) do
            begin
              LArgVar := ConvertExpression(AIR, LStmt.CallArgs[LArgIdx], ASSAFunc);
              LCallArgs[LArgIdx] := TMyrSSAOperand.FromVar(LArgVar);
            end;
            
            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikIndirectCall;
            LInstr.Op1 := TMyrSSAOperand.FromVar(LExprVar);  // Function pointer
            LInstr.CallArgs := LCallArgs;
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
          end;

        TMyrIR.TMyrIRStmtKind.skReturn:
          begin
            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikReturn;
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
          end;
          
        TMyrIR.TMyrIRStmtKind.skReturnValue:
          begin
            LExprVar := ConvertExpression(AIR, LStmt.Expr, ASSAFunc);

            // Small aggregate return (<= 8 bytes): the C ABI returns it
            // PACKED in RAX, and every gate below 8 bytes is non-sret. The
            // expression is an ADDRESS (aggregate rule), so load the bytes.
            // Larger aggregates take the sret path, which wants the address.
            if DoIsAggregateTypeRef(AIR, LFunc.ReturnTypeRef) and
               (LFunc.ReturnSize > 0) and (LFunc.ReturnSize <= 8) then
            begin
              LTempVar := ASSAFunc.NewVersion('_t');
              LInstr := Default(TMyrSSAInstr);
              LInstr.Kind := sikLoad;
              LInstr.Dest := LTempVar;
              LInstr.Op1 := TMyrSSAOperand.FromVar(LExprVar);
              LInstr.MemSize := LFunc.ReturnSize;
              ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
              LExprVar := LTempVar;
            end;

            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikReturnValue;
            LInstr.Op1 := TMyrSSAOperand.FromVar(LExprVar);
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
          end;
          
        TMyrIR.TMyrIRStmtKind.skBlockCopy:
          begin
            // Whole-object move. DestExpr and Expr are both ADDRESS
            // expressions; no destination var is produced, so DCE leaves
            // this instruction alone (it skips instructions whose Dest is
            // invalid) while still marking both operands as used.
            LDestVar := ConvertExpression(AIR, LStmt.DestExpr, ASSAFunc);
            LExprVar := ConvertExpression(AIR, LStmt.Expr, ASSAFunc);

            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikBlockCopy;
            LInstr.Op1 := TMyrSSAOperand.FromVar(LDestVar);
            LInstr.Op2 := TMyrSSAOperand.FromVar(LExprVar);
            LInstr.CopySize := LStmt.CopySize;
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
          end;

        TMyrIR.TMyrIRStmtKind.skWhenBegin:
          begin
            LCurrentBlockId := ASSAFunc.GetCurrentBlock().GetBlockId();
            
            // Evaluate condition
            LCondVar := ConvertExpression(AIR, LStmt.Expr, ASSAFunc);
            
            // Create then and end blocks
            LThenBlock := ASSAFunc.CreateBlock('if_then');
            LEndBlock := ASSAFunc.CreateBlock('if_end');
            
            // Add edges: current -> then (the false edge will be added later)
            ASSAFunc.GetBlock(LCurrentBlockId).AddSuccessor(LThenBlock);
            ASSAFunc.GetBlock(LThenBlock).AddPredecessor(LCurrentBlockId);
            
            // Jump to then block if condition true
            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikJumpIf;
            LInstr.Op1 := TMyrSSAOperand.FromVar(LCondVar);
            LInstr.Op2 := TMyrSSAOperand.FromBlock(LThenBlock);
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            
            // Jump to end block if condition false (may be patched to else by skOtherwiseBegin)
            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikJump;
            LInstr.Op1 := TMyrSSAOperand.FromBlock(LEndBlock);
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            
            // Add edge: current -> end (false path, may be updated if else exists)
            ASSAFunc.GetBlock(LCurrentBlockId).AddSuccessor(LEndBlock);
            ASSAFunc.GetBlock(LEndBlock).AddPredecessor(LCurrentBlockId);
            
            // Push condition block id and end block for later
            LBlockStack.Push(LCurrentBlockId);  // Need this to patch the jump if else exists
            LBlockStack.Push(LEndBlock);
            
            // Continue in then block
            ASSAFunc.SetCurrentBlock(LThenBlock);
          end;
          
        TMyrIR.TMyrIRStmtKind.skOtherwiseBegin:
          begin
            LCurrentBlockId := ASSAFunc.GetCurrentBlock().GetBlockId();
            
            // Pop end block and condition block from stack
            LEndBlock := LBlockStack.Pop();
            LHeaderBlock := LBlockStack.Pop();  // This is the condition block
            
            // Jump to end from current (then) block
            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikJump;
            LInstr.Op1 := TMyrSSAOperand.FromBlock(LEndBlock);
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            
            // Add edge: then -> end
            ASSAFunc.GetBlock(LCurrentBlockId).AddSuccessor(LEndBlock);
            ASSAFunc.GetBlock(LEndBlock).AddPredecessor(LCurrentBlockId);
            
            // Create else block
            LElseBlock := ASSAFunc.CreateBlock('if_else');
            
            // Patch the condition block's Jump instruction to point to else instead of end
            // The Jump is the last instruction in the condition block
            LPatchIdx := ASSAFunc.GetBlock(LHeaderBlock).GetInstructionCount() - 1;
            LInstr := ASSAFunc.GetBlock(LHeaderBlock).GetInstruction(LPatchIdx);
            if LInstr.Kind = sikJump then
            begin
              LInstr.Op1 := TMyrSSAOperand.FromBlock(LElseBlock);
              ASSAFunc.GetBlock(LHeaderBlock).SetInstruction(LPatchIdx, LInstr);
            end;
            
            // Update edges: remove condition -> end, add condition -> else
            // Note: We can't easily remove edges, so we'll have duplicate edges
            // The dominator algorithm handles this, but let's add the correct edge
            ASSAFunc.GetBlock(LHeaderBlock).AddSuccessor(LElseBlock);
            ASSAFunc.GetBlock(LElseBlock).AddPredecessor(LHeaderBlock);
            
            // Push only end block back (marker that else was processed)
            LBlockStack.Push(-1);  // Marker: else exists
            LBlockStack.Push(LEndBlock);
            
            // Continue in else block
            ASSAFunc.SetCurrentBlock(LElseBlock);
          end;
          
        TMyrIR.TMyrIRStmtKind.skWhenEnd:
          begin
            LCurrentBlockId := ASSAFunc.GetCurrentBlock().GetBlockId();
            
            // Pop end block
            LEndBlock := LBlockStack.Pop();
            
            // Pop marker (else was processed)
            LBlockStack.Pop();
            
            // Jump to end block from current
            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikJump;
            LInstr.Op1 := TMyrSSAOperand.FromBlock(LEndBlock);
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            
            // Add edge: current -> end
            ASSAFunc.GetBlock(LCurrentBlockId).AddSuccessor(LEndBlock);
            ASSAFunc.GetBlock(LEndBlock).AddPredecessor(LCurrentBlockId);
            
            // If LHeaderBlock is -1, else was processed (nothing more to do)
            // If LHeaderBlock >= 0, it's the condition block ID (no else case)
            // In no-else case, the condition->end edge was already added in skWhenBegin
            
            // Continue in end block
            ASSAFunc.SetCurrentBlock(LEndBlock);
          end;
          
        TMyrIR.TMyrIRStmtKind.skLoopBegin:
          begin
            LCurrentBlockId := ASSAFunc.GetCurrentBlock().GetBlockId();
            
            // Create header, body and end blocks
            LLoopBlock := ASSAFunc.CreateBlock('while_header');
            LBodyBlock := ASSAFunc.CreateBlock('while_body');
            LEndBlock := ASSAFunc.CreateBlock('while_end');
            
            // Add edge: entry -> header
            ASSAFunc.GetBlock(LCurrentBlockId).AddSuccessor(LLoopBlock);
            ASSAFunc.GetBlock(LLoopBlock).AddPredecessor(LCurrentBlockId);
            
            // Jump to header from entry
            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikJump;
            LInstr.Op1 := TMyrSSAOperand.FromBlock(LLoopBlock);
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            
            // Switch to header: evaluate condition
            ASSAFunc.SetCurrentBlock(LLoopBlock);
            LCondVar := ConvertExpression(AIR, LStmt.Expr, ASSAFunc);
            
            // Add edges: header -> body (true), header -> end (false)
            ASSAFunc.GetBlock(LLoopBlock).AddSuccessor(LBodyBlock);
            ASSAFunc.GetBlock(LLoopBlock).AddSuccessor(LEndBlock);
            ASSAFunc.GetBlock(LBodyBlock).AddPredecessor(LLoopBlock);
            ASSAFunc.GetBlock(LEndBlock).AddPredecessor(LLoopBlock);
            
            // Jump to body if true
            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikJumpIf;
            LInstr.Op1 := TMyrSSAOperand.FromVar(LCondVar);
            LInstr.Op2 := TMyrSSAOperand.FromBlock(LBodyBlock);
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            
            // Jump to end if false
            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikJump;
            LInstr.Op1 := TMyrSSAOperand.FromBlock(LEndBlock);
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            
            // Push loop header and end for WhileEnd
            LBlockStack.Push(LEndBlock);
            LBlockStack.Push(LLoopBlock);

            // Push loop context for break/continue
            LLoopCtx := Default(TMyrSSALoopCtx);
            LLoopCtx.Kind := slkWhile;
            LLoopCtx.HeaderBlock := LLoopBlock;
            LLoopCtx.LatchBlock := LLoopBlock;  // continue jumps to header
            LLoopCtx.EndBlock := LEndBlock;
            LLoopCtxStack.Push(LLoopCtx);
            
            // Continue in body
            ASSAFunc.SetCurrentBlock(LBodyBlock);
          end;
          
        TMyrIR.TMyrIRStmtKind.skLoopEnd:
          begin
            LCurrentBlockId := ASSAFunc.GetCurrentBlock().GetBlockId();
            
            // Pop header and end blocks
            LLoopBlock := LBlockStack.Pop();
            LEndBlock := LBlockStack.Pop();
            LLoopCtxStack.Pop();
            
            // Add edge: body -> header (back edge)
            ASSAFunc.GetBlock(LCurrentBlockId).AddSuccessor(LLoopBlock);
            ASSAFunc.GetBlock(LLoopBlock).AddPredecessor(LCurrentBlockId);
            
            // Jump back to header
            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikJump;
            LInstr.Op1 := TMyrSSAOperand.FromBlock(LLoopBlock);
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            
            // Continue in end block
            ASSAFunc.SetCurrentBlock(LEndBlock);
          end;
          
        TMyrIR.TMyrIRStmtKind.skCountBegin:
          begin
            LCurrentBlockId := ASSAFunc.GetCurrentBlock().GetBlockId();
            
            // Evaluate from and to expressions in current block (before loop)
            LExprVar := ConvertExpression(AIR, LStmt.ForFrom, ASSAFunc);
            LRightVar := ConvertExpression(AIR, LStmt.ForTo, ASSAFunc);
            
            // Assign loop variable = from value
            LDestVar := ASSAFunc.NewVersion(LStmt.ForVar);
            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikAssign;
            LInstr.Dest := LDestVar;
            LInstr.Op1 := TMyrSSAOperand.FromVar(LExprVar);
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            
            // Create header, body, and end blocks
            LLoopBlock := ASSAFunc.CreateBlock('for_header');
            LBodyBlock := ASSAFunc.CreateBlock('for_body');
            LEndBlock := ASSAFunc.CreateBlock('for_end');
            
            // Add edge: current -> header
            ASSAFunc.GetBlock(LCurrentBlockId).AddSuccessor(LLoopBlock);
            ASSAFunc.GetBlock(LLoopBlock).AddPredecessor(LCurrentBlockId);
            
            // Jump to header
            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikJump;
            LInstr.Op1 := TMyrSSAOperand.FromBlock(LLoopBlock);
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            
            // Switch to header block: emit comparison
            ASSAFunc.SetCurrentBlock(LLoopBlock);
            
            // Compare loop variable with to-value
            LCondVar := ASSAFunc.NewVersion('_t');
            LInstr := Default(TMyrSSAInstr);
            if not LStmt.ForDownTo then
            begin
              if LStmt.IsUnsignedCompare then
                LInstr.Kind := sikUCmpLe  // forVar <= to (ascending, unsigned)
              else
                LInstr.Kind := sikCmpLe;  // forVar <= to (ascending)
            end
            else
            begin
              if LStmt.IsUnsignedCompare then
                LInstr.Kind := sikUCmpGe  // forVar >= to (descending, unsigned)
              else
                LInstr.Kind := sikCmpGe;  // forVar >= to (descending)
            end;
            LInstr.Dest := LCondVar;
            LInstr.Op1 := TMyrSSAOperand.FromVar(ASSAFunc.CurrentVersion(LStmt.ForVar));
            LInstr.Op2 := TMyrSSAOperand.FromVar(LRightVar);
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            
            // Add edges: header -> body (true), header -> end (false)
            ASSAFunc.GetBlock(LLoopBlock).AddSuccessor(LBodyBlock);
            ASSAFunc.GetBlock(LLoopBlock).AddSuccessor(LEndBlock);
            ASSAFunc.GetBlock(LBodyBlock).AddPredecessor(LLoopBlock);
            ASSAFunc.GetBlock(LEndBlock).AddPredecessor(LLoopBlock);
            
            // Branch: if condition true -> body, else -> end
            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikJumpIf;
            LInstr.Op1 := TMyrSSAOperand.FromVar(LCondVar);
            LInstr.Op2 := TMyrSSAOperand.FromBlock(LBodyBlock);
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            
            // Fall through to end
            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikJump;
            LInstr.Op1 := TMyrSSAOperand.FromBlock(LEndBlock);
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            
            // Push blocks and loop info for ForEnd
            LBlockStack.Push(LEndBlock);
            LBlockStack.Push(LLoopBlock);
            LForVarStack.Push(LStmt.ForVar);
            LForDownToStack.Push(LStmt.ForDownTo);

            // Push loop context for break/continue
            LLoopCtx := Default(TMyrSSALoopCtx);
            LLoopCtx.Kind := slkFor;
            LLoopCtx.HeaderBlock := LLoopBlock;
            LLoopCtx.LatchBlock := -1;  // for: inline increment at continue site
            LLoopCtx.EndBlock := LEndBlock;
            LLoopCtx.ForVar := LStmt.ForVar;
            LLoopCtx.ForDownTo := LStmt.ForDownTo;
            LLoopCtxStack.Push(LLoopCtx);
            
            // Continue in body block
            ASSAFunc.SetCurrentBlock(LBodyBlock);
          end;
          
        TMyrIR.TMyrIRStmtKind.skCountEnd:
          begin
            LCurrentBlockId := ASSAFunc.GetCurrentBlock().GetBlockId();
            
            // Pop loop info
            LLoopBlock := LBlockStack.Pop();
            LEndBlock := LBlockStack.Pop();
            LForVar := LForVarStack.Pop();
            LIsDownTo := LForDownToStack.Pop();
            LLoopCtxStack.Pop();
            
            // Increment (or decrement) loop variable
            LTempVar := ASSAFunc.NewVersion('_t');
            LInstr := Default(TMyrSSAInstr);
            if not LIsDownTo then
              LInstr.Kind := sikAdd
            else
              LInstr.Kind := sikSub;
            LInstr.Dest := LTempVar;
            LInstr.Op1 := TMyrSSAOperand.FromVar(ASSAFunc.CurrentVersion(LForVar));
            LInstr.Op2 := TMyrSSAOperand.FromImm(Int64(1));
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            
            // Assign new version of loop variable
            LDestVar := ASSAFunc.NewVersion(LForVar);
            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikAssign;
            LInstr.Dest := LDestVar;
            LInstr.Op1 := TMyrSSAOperand.FromVar(LTempVar);
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            
            // Add edge: body -> header (back edge)
            ASSAFunc.GetBlock(LCurrentBlockId).AddSuccessor(LLoopBlock);
            ASSAFunc.GetBlock(LLoopBlock).AddPredecessor(LCurrentBlockId);
            
            // Jump back to header
            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikJump;
            LInstr.Op1 := TMyrSSAOperand.FromBlock(LLoopBlock);
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            
            // Continue in end block
            ASSAFunc.SetCurrentBlock(LEndBlock);
          end;
          
        TMyrIR.TMyrIRStmtKind.skDoRepeatBegin:
          begin
            LCurrentBlockId := ASSAFunc.GetCurrentBlock().GetBlockId();
            
            // Create body, latch (condition check), and end blocks
            LBodyBlock := ASSAFunc.CreateBlock('repeat_body');
            LLatchBlock := ASSAFunc.CreateBlock('repeat_latch');
            LEndBlock := ASSAFunc.CreateBlock('repeat_end');
            
            // Add edge: entry -> body
            ASSAFunc.GetBlock(LCurrentBlockId).AddSuccessor(LBodyBlock);
            ASSAFunc.GetBlock(LBodyBlock).AddPredecessor(LCurrentBlockId);
            
            // Jump to body
            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikJump;
            LInstr.Op1 := TMyrSSAOperand.FromBlock(LBodyBlock);
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            
            // Push body block for RepeatEnd (existing stack contract)
            LBlockStack.Push(LEndBlock);
            LBlockStack.Push(LLatchBlock);
            LBlockStack.Push(LBodyBlock);

            // Push loop context for break/continue
            LLoopCtx := Default(TMyrSSALoopCtx);
            LLoopCtx.Kind := slkRepeat;
            LLoopCtx.HeaderBlock := LBodyBlock;
            LLoopCtx.LatchBlock := LLatchBlock;
            LLoopCtx.EndBlock := LEndBlock;
            LLoopCtxStack.Push(LLoopCtx);
            
            // Continue in body
            ASSAFunc.SetCurrentBlock(LBodyBlock);
          end;
          
        TMyrIR.TMyrIRStmtKind.skDoRepeatEnd:
          begin
            LCurrentBlockId := ASSAFunc.GetCurrentBlock().GetBlockId();
            
            // Pop blocks (pushed in order: end, latch, body)
            LBodyBlock := LBlockStack.Pop();
            LLatchBlock := LBlockStack.Pop();
            LEndBlock := LBlockStack.Pop();
            LLoopCtxStack.Pop();

            // Jump from body end to latch (condition check)
            ASSAFunc.GetBlock(LCurrentBlockId).AddSuccessor(LLatchBlock);
            ASSAFunc.GetBlock(LLatchBlock).AddPredecessor(LCurrentBlockId);

            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikJump;
            LInstr.Op1 := TMyrSSAOperand.FromBlock(LLatchBlock);
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);

            // Switch to latch block: evaluate until condition
            ASSAFunc.SetCurrentBlock(LLatchBlock);
            LCondVar := ConvertExpression(AIR, LStmt.Expr, ASSAFunc);
            
            // Add edges: latch -> body (back edge if false), latch -> end (if true)
            ASSAFunc.GetBlock(LLatchBlock).AddSuccessor(LBodyBlock);
            ASSAFunc.GetBlock(LLatchBlock).AddSuccessor(LEndBlock);
            ASSAFunc.GetBlock(LBodyBlock).AddPredecessor(LLatchBlock);
            ASSAFunc.GetBlock(LEndBlock).AddPredecessor(LLatchBlock);
            
            // Jump back to body if condition false (until = exit when true)
            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikJumpIfNot;
            LInstr.Op1 := TMyrSSAOperand.FromVar(LCondVar);
            LInstr.Op2 := TMyrSSAOperand.FromBlock(LBodyBlock);
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            
            // Jump to end if condition true
            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikJump;
            LInstr.Op1 := TMyrSSAOperand.FromBlock(LEndBlock);
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            
            // Continue in end block
            ASSAFunc.SetCurrentBlock(LEndBlock);
          end;

        TMyrIR.TMyrIRStmtKind.skLoopBreak:
          begin
            LCurrentBlockId := ASSAFunc.GetCurrentBlock().GetBlockId();
            LLoopCtx := LLoopCtxStack.Peek();

            // Jump to end block (exit the loop)
            ASSAFunc.GetBlock(LCurrentBlockId).AddSuccessor(LLoopCtx.EndBlock);
            ASSAFunc.GetBlock(LLoopCtx.EndBlock).AddPredecessor(LCurrentBlockId);

            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikJump;
            LInstr.Op1 := TMyrSSAOperand.FromBlock(LLoopCtx.EndBlock);
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);

            // Create unreachable continuation block (code after break)
            LBodyBlock := ASSAFunc.CreateBlock('after_break');
            ASSAFunc.SetCurrentBlock(LBodyBlock);
          end;

        TMyrIR.TMyrIRStmtKind.skLoopContinue:
          begin
            LCurrentBlockId := ASSAFunc.GetCurrentBlock().GetBlockId();
            LLoopCtx := LLoopCtxStack.Peek();

            if LLoopCtx.Kind = slkFor then
            begin
              // For loops: emit increment before jumping to header
              LTempVar := ASSAFunc.NewVersion('_t');
              LInstr := Default(TMyrSSAInstr);
              if not LLoopCtx.ForDownTo then
                LInstr.Kind := sikAdd
              else
                LInstr.Kind := sikSub;
              LInstr.Dest := LTempVar;
              LInstr.Op1 := TMyrSSAOperand.FromVar(ASSAFunc.CurrentVersion(LLoopCtx.ForVar));
              LInstr.Op2 := TMyrSSAOperand.FromImm(Int64(1));
              ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);

              LDestVar := ASSAFunc.NewVersion(LLoopCtx.ForVar);
              LInstr := Default(TMyrSSAInstr);
              LInstr.Kind := sikAssign;
              LInstr.Dest := LDestVar;
              LInstr.Op1 := TMyrSSAOperand.FromVar(LTempVar);
              ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);

              // Jump to header (condition check)
              ASSAFunc.GetBlock(LCurrentBlockId).AddSuccessor(LLoopCtx.HeaderBlock);
              ASSAFunc.GetBlock(LLoopCtx.HeaderBlock).AddPredecessor(LCurrentBlockId);

              LInstr := Default(TMyrSSAInstr);
              LInstr.Kind := sikJump;
              LInstr.Op1 := TMyrSSAOperand.FromBlock(LLoopCtx.HeaderBlock);
              ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            end
            else if LLoopCtx.Kind = slkRepeat then
            begin
              // Repeat loops: jump to latch (condition check)
              ASSAFunc.GetBlock(LCurrentBlockId).AddSuccessor(LLoopCtx.LatchBlock);
              ASSAFunc.GetBlock(LLoopCtx.LatchBlock).AddPredecessor(LCurrentBlockId);

              LInstr := Default(TMyrSSAInstr);
              LInstr.Kind := sikJump;
              LInstr.Op1 := TMyrSSAOperand.FromBlock(LLoopCtx.LatchBlock);
              ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            end
            else
            begin
              // While loops: jump to header (condition re-check)
              ASSAFunc.GetBlock(LCurrentBlockId).AddSuccessor(LLoopCtx.HeaderBlock);
              ASSAFunc.GetBlock(LLoopCtx.HeaderBlock).AddPredecessor(LCurrentBlockId);

              LInstr := Default(TMyrSSAInstr);
              LInstr.Kind := sikJump;
              LInstr.Op1 := TMyrSSAOperand.FromBlock(LLoopCtx.HeaderBlock);
              ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            end;

            // Create unreachable continuation block (code after continue)
            LBodyBlock := ASSAFunc.CreateBlock('after_continue');
            ASSAFunc.SetCurrentBlock(LBodyBlock);
          end;
          
        TMyrIR.TMyrIRStmtKind.skMatchBegin:
          begin
            // Evaluate selector
            LCondVar := ConvertExpression(AIR, LStmt.Expr, ASSAFunc);
            
            // Create end block
            LEndBlock := ASSAFunc.CreateBlock('case_end');
            
            // Push: end block, selector expression index, marker (-1 = first case)
            LBlockStack.Push(LEndBlock);
            LBlockStack.Push(LStmt.Expr);
            LBlockStack.Push(-1);
          end;
          
        TMyrIR.TMyrIRStmtKind.skOn:
          begin
            LCurrentBlockId := ASSAFunc.GetCurrentBlock().GetBlockId();
            
            // Pop state
            LPatchIdx := LBlockStack.Pop();
            LHeaderBlock := LBlockStack.Pop();
            LEndBlock := LBlockStack.Pop();
            
            // End previous body if not first CaseOf
            if LPatchIdx >= 0 then
            begin
              LInstr := Default(TMyrSSAInstr);
              LInstr.Kind := sikJump;
              LInstr.Op1 := TMyrSSAOperand.FromBlock(LEndBlock);
              ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
              
              ASSAFunc.GetBlock(LCurrentBlockId).AddSuccessor(LEndBlock);
              ASSAFunc.GetBlock(LEndBlock).AddPredecessor(LCurrentBlockId);
              
              ASSAFunc.SetCurrentBlock(LPatchIdx);
            end;
            
            // Create body and next test blocks
            LBodyBlock := ASSAFunc.CreateBlock('case_body');
            LThenBlock := ASSAFunc.CreateBlock('case_test');
            
            // Re-evaluate selector
            LCondVar := ConvertExpression(AIR, LHeaderBlock, ASSAFunc);
            
            // For each value: compare and jump to body if match
            for LArgIdx := 0 to High(LStmt.CaseValues) do
            begin
              // CaseValues contains raw integers, not expression indices
              // Create comparison: selector == caseValue
              LDestVar := ASSAFunc.NewVersion('_casecmp');
              LInstr := Default(TMyrSSAInstr);
              LInstr.Kind := sikCmpEq;
              LInstr.Dest := LDestVar;
              LInstr.Op1 := TMyrSSAOperand.FromVar(LCondVar);
              LInstr.Op2 := TMyrSSAOperand.FromImm(LStmt.CaseValues[LArgIdx]);
              ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
              
              LInstr := Default(TMyrSSAInstr);
              LInstr.Kind := sikJumpIf;
              LInstr.Op1 := TMyrSSAOperand.FromVar(LDestVar);
              LInstr.Op2 := TMyrSSAOperand.FromBlock(LBodyBlock);
              ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
              
              ASSAFunc.GetCurrentBlock().AddSuccessor(LBodyBlock);
              ASSAFunc.GetBlock(LBodyBlock).AddPredecessor(ASSAFunc.GetCurrentBlock().GetBlockId());
            end;
            
            // For each range: test low <= selector <= high, jump to body if inside.
            // Comparisons are documented to yield 0 or 1, so a bitwise AND of the
            // two compare results is a correct boolean AND. This keeps a range arm
            // at three instructions plus a branch, with no extra basic blocks.
            for LArgIdx := 0 to High(LStmt.CaseRanges) do
            begin
              // selector >= LowValue
              LRangeLoVar := ASSAFunc.NewVersion('_caserangelo');
              LInstr := Default(TMyrSSAInstr);
              if LStmt.IsUnsignedCompare then
                LInstr.Kind := sikUCmpGe
              else
                LInstr.Kind := sikCmpGe;
              LInstr.Dest := LRangeLoVar;
              LInstr.Op1 := TMyrSSAOperand.FromVar(LCondVar);
              LInstr.Op2 := TMyrSSAOperand.FromImm(LStmt.CaseRanges[LArgIdx].LowValue);
              ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);

              // selector <= HighValue
              LRangeHiVar := ASSAFunc.NewVersion('_caserangehi');
              LInstr := Default(TMyrSSAInstr);
              if LStmt.IsUnsignedCompare then
                LInstr.Kind := sikUCmpLe
              else
                LInstr.Kind := sikCmpLe;
              LInstr.Dest := LRangeHiVar;
              LInstr.Op1 := TMyrSSAOperand.FromVar(LCondVar);
              LInstr.Op2 := TMyrSSAOperand.FromImm(LStmt.CaseRanges[LArgIdx].HighValue);
              ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);

              // Both conditions true = selector is inside the range
              LDestVar := ASSAFunc.NewVersion('_caserangein');
              LInstr := Default(TMyrSSAInstr);
              LInstr.Kind := sikBitAnd;
              LInstr.Dest := LDestVar;
              LInstr.Op1 := TMyrSSAOperand.FromVar(LRangeLoVar);
              LInstr.Op2 := TMyrSSAOperand.FromVar(LRangeHiVar);
              ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);

              LInstr := Default(TMyrSSAInstr);
              LInstr.Kind := sikJumpIf;
              LInstr.Op1 := TMyrSSAOperand.FromVar(LDestVar);
              LInstr.Op2 := TMyrSSAOperand.FromBlock(LBodyBlock);
              ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);

              ASSAFunc.GetCurrentBlock().AddSuccessor(LBodyBlock);
              ASSAFunc.GetBlock(LBodyBlock).AddPredecessor(ASSAFunc.GetCurrentBlock().GetBlockId());
            end;

            // Fall through to next test
            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikJump;
            LInstr.Op1 := TMyrSSAOperand.FromBlock(LThenBlock);
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            
            ASSAFunc.GetCurrentBlock().AddSuccessor(LThenBlock);
            ASSAFunc.GetBlock(LThenBlock).AddPredecessor(ASSAFunc.GetCurrentBlock().GetBlockId());
            
            // Push state
            LBlockStack.Push(LEndBlock);
            LBlockStack.Push(LHeaderBlock);
            LBlockStack.Push(LThenBlock);
            
            ASSAFunc.SetCurrentBlock(LBodyBlock);
          end;
          
        TMyrIR.TMyrIRStmtKind.skOnElse:
          begin
            LCurrentBlockId := ASSAFunc.GetCurrentBlock().GetBlockId();
            
            LPatchIdx := LBlockStack.Pop();
            LBlockStack.Pop();
            LEndBlock := LBlockStack.Pop();
            
            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikJump;
            LInstr.Op1 := TMyrSSAOperand.FromBlock(LEndBlock);
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            
            ASSAFunc.GetBlock(LCurrentBlockId).AddSuccessor(LEndBlock);
            ASSAFunc.GetBlock(LEndBlock).AddPredecessor(LCurrentBlockId);
            
            LElseBlock := ASSAFunc.CreateBlock('case_else');
            
            ASSAFunc.SetCurrentBlock(LPatchIdx);
            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikJump;
            LInstr.Op1 := TMyrSSAOperand.FromBlock(LElseBlock);
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            
            ASSAFunc.GetBlock(LPatchIdx).AddSuccessor(LElseBlock);
            ASSAFunc.GetBlock(LElseBlock).AddPredecessor(LPatchIdx);
            
            LBlockStack.Push(LEndBlock);
            LBlockStack.Push(-2);
            LBlockStack.Push(-2);
            
            ASSAFunc.SetCurrentBlock(LElseBlock);
          end;
          
        TMyrIR.TMyrIRStmtKind.skMatchEnd:
          begin
            LCurrentBlockId := ASSAFunc.GetCurrentBlock().GetBlockId();
            
            LPatchIdx := LBlockStack.Pop();
            LHeaderBlock := LBlockStack.Pop();
            LEndBlock := LBlockStack.Pop();
            
            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikJump;
            LInstr.Op1 := TMyrSSAOperand.FromBlock(LEndBlock);
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            
            ASSAFunc.GetBlock(LCurrentBlockId).AddSuccessor(LEndBlock);
            ASSAFunc.GetBlock(LEndBlock).AddPredecessor(LCurrentBlockId);
            
            // If no else, previous test falls through to end
            if (LPatchIdx >= 0) and (LHeaderBlock >= 0) then
            begin
              ASSAFunc.SetCurrentBlock(LPatchIdx);
              LInstr := Default(TMyrSSAInstr);
              LInstr.Kind := sikJump;
              LInstr.Op1 := TMyrSSAOperand.FromBlock(LEndBlock);
              ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
              
              ASSAFunc.GetBlock(LPatchIdx).AddSuccessor(LEndBlock);
              ASSAFunc.GetBlock(LEndBlock).AddPredecessor(LPatchIdx);
            end;
            
            ASSAFunc.SetCurrentBlock(LEndBlock);
          end;
          
        // Exception Handling Statements
        TMyrIR.TMyrIRStmtKind.skGuardBegin:
          begin
            LCurrentBlockId := ASSAFunc.GetCurrentBlock().GetBlockId();
            
            // Create blocks: try body, except handler (placeholder), finally (placeholder), end
            LTryBlock := ASSAFunc.CreateBlock('try_body');
            LEndBlock := ASSAFunc.CreateBlock('try_end');
            
            // Jump to try body
            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikJump;
            LInstr.Op1 := TMyrSSAOperand.FromBlock(LTryBlock);
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            
            ASSAFunc.GetBlock(LCurrentBlockId).AddSuccessor(LTryBlock);
            ASSAFunc.GetBlock(LTryBlock).AddPredecessor(LCurrentBlockId);
            
            // Push: try_block, end_block, except_block (-1), finally_block (-1)
            LBlockStack.Push(LTryBlock);       // Try body start
            LBlockStack.Push(LEndBlock);       // End block
            LBlockStack.Push(-1);              // Except block (filled by skCatchBegin)
            LBlockStack.Push(-1);              // Finally block (filled by skEnsureBegin)
            
            ASSAFunc.SetCurrentBlock(LTryBlock);
          end;
          
        TMyrIR.TMyrIRStmtKind.skCatchBegin:
          begin
            LCurrentBlockId := ASSAFunc.GetCurrentBlock().GetBlockId();
            
            // Pop stack to get context
            LFinallyBlock := LBlockStack.Pop();  // Finally block (-1 or set)
            LBlockStack.Pop();                    // Except block (-1)
            LEndBlock := LBlockStack.Pop();       // End block
            LTryBlock := LBlockStack.Pop();       // Try body start
            
            // Create the except block
            LExceptBlock := ASSAFunc.CreateBlock('except_handler');
            
            // Normal path: try body jumps OVER except to end (or finally if present)
            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikJump;
            LInstr.Op1 := TMyrSSAOperand.FromBlock(LEndBlock);  // Will be patched if finally exists
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            
            ASSAFunc.GetBlock(LCurrentBlockId).AddSuccessor(LEndBlock);
            ASSAFunc.GetBlock(LEndBlock).AddPredecessor(LCurrentBlockId);
            
            // Add fake edge for CFG connectivity (SEH handles actual dispatch at runtime)
            // Without this edge, except_handler is unreachable and breaks dominator computation
            ASSAFunc.GetBlock(LCurrentBlockId).AddSuccessor(LExceptBlock);
            ASSAFunc.GetBlock(LExceptBlock).AddPredecessor(LCurrentBlockId);
            
            // Push back with except block set
            LBlockStack.Push(LTryBlock);
            LBlockStack.Push(LEndBlock);
            LBlockStack.Push(LExceptBlock);
            LBlockStack.Push(LFinallyBlock);
            LBlockStack.Push(LCurrentBlockId);  // Save try-end block for scope tracking
            
            ASSAFunc.SetCurrentBlock(LExceptBlock);
          end;
          
        TMyrIR.TMyrIRStmtKind.skEnsureBegin:
          begin
            LCurrentBlockId := ASSAFunc.GetCurrentBlock().GetBlockId();
            
            // Pop stack - might have extra item if except was processed
            if LBlockStack.Count >= 5 then
              LTryEndBlock := LBlockStack.Pop()  // Try-end block from except
            else
              LTryEndBlock := -1;
            
            LBlockStack.Pop();                    // Finally block (-1)
            LExceptBlock := LBlockStack.Pop();    // Except block (may be valid)
            LEndBlock := LBlockStack.Pop();       // End block
            LTryBlock := LBlockStack.Pop();       // Try body start
            
            // Create the finally block
            LFinallyBlock := ASSAFunc.CreateBlock('finally_handler');
            
            // Normal path jumps through finally
            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikJump;
            LInstr.Op1 := TMyrSSAOperand.FromBlock(LFinallyBlock);
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            
            ASSAFunc.GetBlock(LCurrentBlockId).AddSuccessor(LFinallyBlock);
            ASSAFunc.GetBlock(LFinallyBlock).AddPredecessor(LCurrentBlockId);
            
            // If except was present, patch its jump to also go through finally
            if (LExceptBlock >= 0) and (LTryEndBlock >= 0) then
            begin
              // Patch the jump in try-end block to go to finally instead of end
              LPatchIdx := ASSAFunc.GetBlock(LTryEndBlock).GetInstructionCount() - 1;
              LInstr := ASSAFunc.GetBlock(LTryEndBlock).GetInstruction(LPatchIdx);
              if LInstr.Kind = sikJump then
              begin
                LInstr.Op1 := TMyrSSAOperand.FromBlock(LFinallyBlock);
                ASSAFunc.GetBlock(LTryEndBlock).SetInstruction(LPatchIdx, LInstr);
                // Update edges
                ASSAFunc.GetBlock(LTryEndBlock).AddSuccessor(LFinallyBlock);
                ASSAFunc.GetBlock(LFinallyBlock).AddPredecessor(LTryEndBlock);
              end;
            end;
            
            // Push back with finally block set
            LBlockStack.Push(LTryBlock);
            LBlockStack.Push(LEndBlock);
            LBlockStack.Push(LExceptBlock);
            LBlockStack.Push(LFinallyBlock);
            if LTryEndBlock >= 0 then
              LBlockStack.Push(LTryEndBlock)
            else
              LBlockStack.Push(LCurrentBlockId);  // Save current block for scope
            
            ASSAFunc.SetCurrentBlock(LFinallyBlock);
          end;
          
        TMyrIR.TMyrIRStmtKind.skGuardEnd:
          begin
            LCurrentBlockId := ASSAFunc.GetCurrentBlock().GetBlockId();
            
            // Pop everything
            if LBlockStack.Count >= 5 then
              LTryEndBlock := LBlockStack.Pop()
            else
              LTryEndBlock := -1;
            
            LFinallyBlock := LBlockStack.Pop();
            LExceptBlock := LBlockStack.Pop();
            LEndBlock := LBlockStack.Pop();
            LTryBlock := LBlockStack.Pop();
            
            // Jump to end block
            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikJump;
            LInstr.Op1 := TMyrSSAOperand.FromBlock(LEndBlock);
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            
            ASSAFunc.GetBlock(LCurrentBlockId).AddSuccessor(LEndBlock);
            ASSAFunc.GetBlock(LEndBlock).AddPredecessor(LCurrentBlockId);
            
            // Record exception scope for backend
            LExcScope.TryBlockIndex := LTryBlock;
            LExcScope.TryEndBlockIndex := LTryEndBlock;
            LExcScope.ExceptBlockIndex := LExceptBlock;
            LExcScope.FinallyBlockIndex := LFinallyBlock;
            LExcScope.EndBlockIndex := LEndBlock;
            ASSAFunc.AddExceptionScope(LExcScope);
            
            ASSAFunc.SetCurrentBlock(LEndBlock);
          end;
          
        TMyrIR.TMyrIRStmtKind.skThrow:
          begin
            // Convert: raiseexception(msg) -> call Pax_Raise(msg)
            LExprVar := ConvertExpression(AIR, LStmt.RaiseMsg, ASSAFunc);
            
            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikCall;
            SetLength(LCallArgs, 1);
            LCallArgs[0] := TMyrSSAOperand.FromVar(LExprVar);
            LInstr.CallArgs := LCallArgs;
            LInstr.CallTarget := ResolveRuntimeTarget(AIR, RT_Raise);
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
          end;
          
        TMyrIR.TMyrIRStmtKind.skThrowCode:
          begin
            // Convert: raiseexceptioncode(code, msg) -> call Pax_RaiseCode(code, msg)
            LCondVar := ConvertExpression(AIR, LStmt.RaiseCode, ASSAFunc);
            LExprVar := ConvertExpression(AIR, LStmt.RaiseMsg, ASSAFunc);
            
            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikCall;
            SetLength(LCallArgs, 2);
            LCallArgs[0] := TMyrSSAOperand.FromVar(LCondVar);
            LCallArgs[1] := TMyrSSAOperand.FromVar(LExprVar);
            LInstr.CallArgs := LCallArgs;
            LInstr.CallTarget := ResolveRuntimeTarget(AIR, RT_RaiseCode);
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
          end;
      end;
    end;
  finally
    LLoopCtxStack.Free();
    LForDownToStack.Free();
    LForVarStack.Free();
    LBlockStack.Free();
  end;
end;

function TMyrSSABuilder.ResolveRuntimeTarget(const AIR: TMyrIR; const AName: string): TMyrSSAOperand;
var
  LIdx: Integer;
begin
  Result := Default(TMyrSSAOperand);
  LIdx := FindLocalFuncByName(AIR, AName);
  if LIdx >= 0 then
  begin
    Result := TMyrSSAOperand.FromFunc(LIdx);
    Exit;
  end;
  LIdx := FindImportByName(AIR, AName);
  if LIdx >= 0 then
    Result := TMyrSSAOperand.FromImport(LIdx);
end;

function TMyrSSABuilder.FindImportByName(const AIR: TMyrIR; const AName: string): Integer;
var
  LI: Integer;
  LImport: TMyrIR.TMyrIRImport;
begin
  for LI := 0 to AIR.GetImportCount() - 1 do
  begin
    LImport := AIR.GetImport(LI);
    if (LImport.FuncName = AName) then
      Exit(LI);
  end;
  Result := -1;
end;

function TMyrSSABuilder.FindImportBySignature(
  const AIR: TMyrIR;
  const AName: string;
  const AArgTypes: TArray<TMyrTypeRef>
): Integer;
var
  LI:      Integer;
  LJ:      Integer;
  LImport: TMyrIR.TMyrIRImport;
  LMatch:  Boolean;
begin
  for LI := 0 to AIR.GetImportCount() - 1 do
  begin
    LImport := AIR.GetImport(LI);
    if not (LImport.FuncName = AName) then
      Continue;

    // Check param count
    if Length(LImport.ParamTypes) <> Length(AArgTypes) then
      Continue;

    // Compare each param type
    LMatch := True;
    for LJ := 0 to High(AArgTypes) do
    begin
      if AArgTypes[LJ].IsPrimitive then
      begin
        if AArgTypes[LJ].Primitive <> LImport.ParamTypes[LJ] then
        begin
          LMatch := False;
          Break;
        end;
      end
      else
      begin
        // Composite type vs primitive — no match
        LMatch := False;
        Break;
      end;
    end;

    if LMatch then
      Exit(LI);
  end;
  Result := -1;
end;

function TMyrSSABuilder.FindImportByArgCount(const AIR: TMyrIR; const AName: string;
  const AArgCount: Integer): Integer;
var
  LI: Integer;
  LImport: TMyrIR.TMyrIRImport;
begin
  for LI := 0 to AIR.GetImportCount() - 1 do
  begin
    LImport := AIR.GetImport(LI);
    if (LImport.FuncName = AName) and
       (Length(LImport.ParamTypes) = AArgCount) then
      Exit(LI);
  end;
  Result := -1;
end;

function TMyrSSABuilder.FindLocalFuncByName(const AIR: TMyrIR; const AName: string): Integer;
var
  LI: Integer;
  LFunc: TMyrIR.TMyrIRFunc;
begin
  for LI := 0 to AIR.GetFunctionCount() - 1 do
  begin
    LFunc := AIR.GetFunction(LI);
    if (LFunc.FuncName = AName) then
      Exit(LI);
  end;
  Result := -1;
end;

function TMyrSSABuilder.FindLocalFuncByArgCount(const AIR: TMyrIR;
  const AName: string; const AArgCount: Integer): Integer;
var
  LI: Integer;
  LJ: Integer;
  LFunc: TMyrIR.TMyrIRFunc;
  LParamCount: Integer;
begin
  for LI := 0 to AIR.GetFunctionCount() - 1 do
  begin
    LFunc := AIR.GetFunction(LI);
    if not (LFunc.FuncName = AName) then
      Continue;
    LParamCount := 0;
    for LJ := 0 to LFunc.Vars.Count - 1 do
      if LFunc.Vars[LJ].IsParam then
        Inc(LParamCount);
    if LParamCount = AArgCount then
      Exit(LI);
  end;
  Result := -1;
end;

function TMyrSSABuilder.FindLocalFuncBySignature(
  const AIR: TMyrIR;
  const AName: string;
  const AArgTypes: TArray<TMyrTypeRef>
): Integer;
var
  LI: Integer;
  LJ: Integer;
  LFunc: TMyrIR.TMyrIRFunc;
  LFuncParams: TArray<TMyrTypeRef>;
  LParamCount: Integer;
  LMatch: Boolean;
begin
  for LI := 0 to AIR.GetFunctionCount() - 1 do
  begin
    LFunc := AIR.GetFunction(LI);
    if not (LFunc.FuncName = AName) then
      Continue;

    // Extract param types from function
    LParamCount := 0;
    for LJ := 0 to LFunc.Vars.Count - 1 do
    begin
      if LFunc.Vars[LJ].IsParam then
        Inc(LParamCount);
    end;

    // Check param count match
    if LParamCount <> Length(AArgTypes) then
      Continue;

    // Build param type array
    SetLength(LFuncParams, LParamCount);
    LParamCount := 0;
    for LJ := 0 to LFunc.Vars.Count - 1 do
    begin
      if LFunc.Vars[LJ].IsParam then
      begin
        LFuncParams[LParamCount] := LFunc.Vars[LJ].VarTypeRef;
        Inc(LParamCount);
      end;
    end;

    // Compare types
    LMatch := True;
    for LJ := 0 to High(AArgTypes) do
    begin
      if LFuncParams[LJ] <> AArgTypes[LJ] then
      begin
        LMatch := False;
        Break;
      end;
    end;

    if LMatch then
      Exit(LI);
  end;
  Result := -1;
end;

function TMyrSSABuilder.DoIsAggregateTypeRef(const AIR: TMyrIR; const ATypeRef: TMyrTypeRef): Boolean;
begin
  // An AGGREGATE is storage that lives in place: record, union, fixed array.
  // string / wstring / dynarray are also non-primitive TypeRefs but their slot
  // holds a POINTER to heap data (see the ekFieldAccess load rule); they are
  // NOT aggregates and must keep the scalar load path.
  Result := False;
  if ATypeRef.IsPrimitive then
    Exit;
  if ATypeRef.TypeIndex < 0 then
    Exit;
  Result := AIR.GetTypeEntry(ATypeRef.TypeIndex).Kind in
    [TMyrIR.TMyrIRTypeKind.tkRecord, TMyrIR.TMyrIRTypeKind.tkUnion, TMyrIR.TMyrIRTypeKind.tkFixedArray];
end;

{ TMyrSSABuilder.DoEmitAggregateAddr }
function TMyrSSABuilder.DoEmitAggregateAddr(
  const AIR: TMyrIR;
  const AVarName: string;
  const ASSAFunc: TMyrSSAFunc
): TMyrSSAVar;
var
  LGlobalIdx: Integer;
  LLocalIdx: Integer;
  LSlotAddr: TMyrSSAVar;
  LInstr: TMyrSSAInstr;
begin
  // The ONE place that turns a named aggregate variable into its address.
  // This is TinyCC's gaddrof: same result for every storage class.
  //   global          -> sokGlobal IS the .data address (codegen emits LEA)
  //   local           -> LEA of the stack slot
  //   param (any)     -> the slot holds a POINTER to the object, so LEA the
  //                      slot then load it. Byref and by-value aggregate
  //                      params are identical here: under the uniform rule
  //                      the caller always passes an address.
  // Function-scope locals/params shadow same-named globals.
  if ASSAFunc.HasLocalDecl(AVarName) then
    LGlobalIdx := -1
  else
    LGlobalIdx := AIR.FindGlobal(AVarName);

  if LGlobalIdx >= 0 then
  begin
    Result := ASSAFunc.NewVersion('_t');
    LInstr := Default(TMyrSSAInstr);
    LInstr.Kind := sikAssign;
    LInstr.Dest := Result;
    LInstr.Op1 := TMyrSSAOperand.FromGlobal(LGlobalIdx);
    ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
    Exit;
  end;

  // Address of the slot itself
  LSlotAddr := ASSAFunc.NewVersion('_t');
  LInstr := Default(TMyrSSAInstr);
  LInstr.Kind := sikAddressOf;
  LInstr.Dest := LSlotAddr;
  LInstr.Op1 := TMyrSSAOperand.FromVar(ASSAFunc.CurrentVersion(AVarName));
  // First use of a composite local: create version 0
  if not LInstr.Op1.Var_.IsValid() then
    LInstr.Op1 := TMyrSSAOperand.FromVar(ASSAFunc.NewVersion(AVarName));
  LInstr.Op1.Var_.BaseName := AVarName;
  ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);

  LLocalIdx := ASSAFunc.FindLocalIndex(AVarName);
  if (LLocalIdx >= 0) and ASSAFunc.GetLocal(LLocalIdx).IsParam then
  begin
    // Param slot holds the object's address: load it
    Result := ASSAFunc.NewVersion('_t');
    LInstr := Default(TMyrSSAInstr);
    LInstr.Kind := sikLoad;
    LInstr.Dest := Result;
    LInstr.Op1 := TMyrSSAOperand.FromVar(LSlotAddr);
    ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
  end
  else
    Result := LSlotAddr;
end;

{ TMyrSSABuilder.DoSpillSmallAggregateResult }
function TMyrSSABuilder.DoSpillSmallAggregateResult(
  const AIR: TMyrIR;
  const AResultVar: TMyrSSAVar;
  const ATypeRef: TMyrTypeRef;
  const ASSAFunc: TMyrSSAFunc
): TMyrSSAVar;
var
  LSize: Integer;
  LName: string;
  LAddr: TMyrSSAVar;
  LInstr: TMyrSSAInstr;
begin
  // A call that returns an aggregate of <= 8 bytes delivers it PACKED in
  // RAX (C ABI; the sret gates only fire above 8). The aggregate rule says
  // every aggregate expression is an ADDRESS, so give the bytes a home: an
  // anonymous local of the aggregate's type, store RAX into it, yield the
  // address. This is what Win64 C compilers do at the same point. Larger
  // aggregates already come back as the sret buffer address; pass through.
  Result := AResultVar;
  if not DoIsAggregateTypeRef(AIR, ATypeRef) then
    Exit;
  LSize := AIR.GetTypeSize(ATypeRef);
  if (LSize <= 0) or (LSize > 8) then
    Exit;

  LName := '_ret' + IntToStr(ASSAFunc.GetLocalCount());
  ASSAFunc.AddLocal(LName, ATypeRef, LSize, AIR.GetTypeAlignment(ATypeRef), False);

  LAddr := ASSAFunc.NewVersion('_t');
  LInstr := Default(TMyrSSAInstr);
  LInstr.Kind := sikAddressOf;
  LInstr.Dest := LAddr;
  LInstr.Op1 := TMyrSSAOperand.FromVar(ASSAFunc.NewVersion(LName));
  LInstr.Op1.Var_.BaseName := LName;
  ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);

  LInstr := Default(TMyrSSAInstr);
  LInstr.Kind := sikStore;
  LInstr.Op1 := TMyrSSAOperand.FromVar(LAddr);
  LInstr.Op2 := TMyrSSAOperand.FromVar(AResultVar);
  LInstr.MemSize := LSize;
  ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);

  Result := LAddr;
end;

function TMyrSSABuilder.ConvertExpression(
  const AIR: TMyrIR;
  const AExprIndex: Integer;
  const ASSAFunc: TMyrSSAFunc
): TMyrSSAVar;
var
  LExpr: TMyrIR.TMyrIRExprNode;
  LObjectExpr: TMyrIR.TMyrIRExprNode;
  LInnerExpr: TMyrIR.TMyrIRExprNode;
  LArgExpr: TMyrIR.TMyrIRExprNode;
  LInstr: TMyrSSAInstr;
  LLeftVar: TMyrSSAVar;
  LRightVar: TMyrSSAVar;
  LResultVar: TMyrSSAVar;
  LArgVar: TMyrSSAVar;
  LArgIdx: Integer;
  LFuncIndex: Integer;
  LCallArgs: TArray<TMyrSSAOperand>;
  LArgTypes: TArray<TMyrTypeRef>;
  // Variadic call handling
  LTargetFunc: TMyrIR.TMyrIRFunc;
  LFixedParamCount: Integer;
  LVarArgCount: Integer;
  LJ: Integer;
  LImportIdx: Integer;
  // For by-reference parameter detection in field access
  LIsParam: Boolean;
  LIsAggregateParam: Boolean;
  LLocalSize: Integer;
  LLocalIdx: Integer;
  LLocalInfo: TMyrSSALocalInfo;
  LTempVar: TMyrSSAVar;
  LByRefInstr: TMyrSSAInstr;
  LGlobalIdx: Integer;
begin
  if AExprIndex < 0 then
  begin
    Result := TMyrSSAVar.None();
    Exit;
  end;
  
  // Check cache first - if already converted, return cached result
  if FExpressionCache.TryGetValue(AExprIndex, Result) then
    Exit;
  
  LExpr := AIR.GetExpression(AExprIndex);
  
  case LExpr.Kind of
    TMyrIR.TMyrIRExprKind.ekConstInt:
      begin
        // Create temp variable and assign constant
        LResultVar := ASSAFunc.NewVersion('_t');
        
        LInstr := Default(TMyrSSAInstr);
        LInstr.Kind := sikAssign;
        LInstr.Dest := LResultVar;
        LInstr.Op1 := TMyrSSAOperand.FromImm(LExpr.ConstInt);
        ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
        
        Result := LResultVar;
      end;
      
    TMyrIR.TMyrIRExprKind.ekConstFloat:
      begin
        LResultVar := ASSAFunc.NewVersion('_t');
        
        LInstr := Default(TMyrSSAInstr);
        LInstr.Kind := sikAssign;
        LInstr.Dest := LResultVar;
        LInstr.Op1 := TMyrSSAOperand.FromImm(LExpr.ConstFloat);
        ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
        
        Result := LResultVar;
      end;
      
    TMyrIR.TMyrIRExprKind.ekConstString:
      begin
        LResultVar := ASSAFunc.NewVersion('_t');
        
        LInstr := Default(TMyrSSAInstr);
        LInstr.Kind := sikAssign;
        LInstr.Dest := LResultVar;
        LInstr.Op1 := TMyrSSAOperand.FromData(LExpr.StringIndex);
        ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
        
        Result := LResultVar;
      end;
      
    TMyrIR.TMyrIRExprKind.ekVariable:
      begin
        // Aggregates (record/union/fixed array) are ALWAYS represented by
        // their address. See R6: TinyCC never loads a struct into a register,
        // and neither does this converter. Every consumer of an aggregate
        // expects an address (field access, block copy, byref, sret).
        if DoIsAggregateTypeRef(AIR, LExpr.ResultType) then
          Result := DoEmitAggregateAddr(AIR, LExpr.VarName, ASSAFunc)
        else
        begin
        // Function-scope locals/params shadow same-named globals
        if ASSAFunc.HasLocalDecl(LExpr.VarName) then
          LArgIdx := -1
        else
          LArgIdx := AIR.FindGlobal(LExpr.VarName);
        if LArgIdx >= 0 then
        begin
          // Global variable - emit load from global address
          LResultVar := ASSAFunc.NewVersion('_t');
          
          LInstr := Default(TMyrSSAInstr);
          LInstr.Kind := sikLoad;
          LInstr.Dest := LResultVar;
          LInstr.Op1 := TMyrSSAOperand.FromGlobal(LArgIdx);
          // Set MemSize based on type for correct load width
          if LExpr.ResultType.IsPrimitive then
          begin
            case LExpr.ResultType.Primitive of
              cvtInt8, cvtUInt8:   LInstr.MemSize := 1;
              cvtInt16, cvtUInt16: LInstr.MemSize := 2;
              cvtInt32, cvtUInt32, cvtFloat32: LInstr.MemSize := 4;
            else
              LInstr.MemSize := 0;  // 0 = full 64-bit (default)
            end;
            LInstr.MemIsFloat := LExpr.ResultType.Primitive in [cvtFloat32, cvtFloat64];
            LInstr.MemIsSigned := LExpr.ResultType.Primitive in [cvtInt8, cvtInt16, cvtInt32];
          end
          else
          begin
            // Composite type — load full 8 bytes (global slots are 8-byte aligned)
            LInstr.MemSize := 0;
          end;
          ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
          
          Result := LResultVar;
        end
        else
        begin
          // Check if it's an imported variable (from DLL)
          LArgIdx := AIR.FindImport(LExpr.VarName);
          if LArgIdx >= 0 then
          begin
            // Imported variable — double indirection through IAT
            // Step 1: Load the variable's address from the IAT slot
            LResultVar := ASSAFunc.NewVersion('_t');
            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikAssign;
            LInstr.Dest := LResultVar;
            LInstr.Op1 := TMyrSSAOperand.FromImport(LArgIdx);
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);

            // Step 2: Dereference the pointer to get the actual value
            LLeftVar := LResultVar;
            LResultVar := ASSAFunc.NewVersion('_t');
            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikLoad;
            LInstr.Dest := LResultVar;
            LInstr.Op1 := TMyrSSAOperand.FromVar(LLeftVar);
            // Set MemSize based on variable type
            case LExpr.ResultType.Primitive of
              cvtInt8, cvtUInt8:   LInstr.MemSize := 1;
              cvtInt16, cvtUInt16: LInstr.MemSize := 2;
              cvtInt32, cvtUInt32, cvtFloat32: LInstr.MemSize := 4;
            else
              LInstr.MemSize := 0;  // 0 = full 64-bit (default)
            end;
            LInstr.MemIsFloat := LExpr.ResultType.Primitive in [cvtFloat32, cvtFloat64];
            LInstr.MemIsSigned := LExpr.ResultType.Primitive in [cvtInt8, cvtInt16, cvtInt32];
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);

            Result := LResultVar;
          end
          else
          begin
            // Local variable - return current version
            Result := ASSAFunc.CurrentVersion(LExpr.VarName);
            
            // If no version exists yet (first use), create version 0
            if not Result.IsValid() then
            begin
              Result := ASSAFunc.NewVersion(LExpr.VarName);
            end;
          end;
        end;
        end;  // non-aggregate
      end;
      
    TMyrIR.TMyrIRExprKind.ekBinary:
      begin
        // Convert left and right operands
        LLeftVar := ConvertExpression(AIR, LExpr.Left, ASSAFunc);
        LRightVar := ConvertExpression(AIR, LExpr.Right, ASSAFunc);
        
        // Create result variable
        LResultVar := ASSAFunc.NewVersion('_t');
        
        // Emit binary operation
        LInstr := Default(TMyrSSAInstr);
        LInstr.Dest := LResultVar;
        LInstr.Op1 := TMyrSSAOperand.FromVar(LLeftVar);
        LInstr.Op2 := TMyrSSAOperand.FromVar(LRightVar);
        
        case LExpr.Op of
          TMyrIR.TMyrIROpKind.opAdd:    LInstr.Kind := sikAdd;
          TMyrIR.TMyrIROpKind.opSub:    LInstr.Kind := sikSub;
          TMyrIR.TMyrIROpKind.opMul:    LInstr.Kind := sikMul;
          TMyrIR.TMyrIROpKind.opDiv:    LInstr.Kind := sikDiv;
          TMyrIR.TMyrIROpKind.opMod:    LInstr.Kind := sikMod;
          TMyrIR.TMyrIROpKind.opUDiv:   LInstr.Kind := sikUDiv;
          TMyrIR.TMyrIROpKind.opUMod:   LInstr.Kind := sikUMod;
          TMyrIR.TMyrIROpKind.opFAdd:   LInstr.Kind := sikFAdd;
          TMyrIR.TMyrIROpKind.opFSub:   LInstr.Kind := sikFSub;
          TMyrIR.TMyrIROpKind.opFMul:   LInstr.Kind := sikFMul;
          TMyrIR.TMyrIROpKind.opFDiv:   LInstr.Kind := sikFDiv;
          TMyrIR.TMyrIROpKind.opBitAnd: LInstr.Kind := sikBitAnd;
          TMyrIR.TMyrIROpKind.opBitOr:  LInstr.Kind := sikBitOr;
          TMyrIR.TMyrIROpKind.opBitXor: LInstr.Kind := sikBitXor;
          TMyrIR.TMyrIROpKind.opShl:    LInstr.Kind := sikShl;
          TMyrIR.TMyrIROpKind.opShr:    LInstr.Kind := sikShr;
          TMyrIR.TMyrIROpKind.opCmpEq:  LInstr.Kind := sikCmpEq;
          TMyrIR.TMyrIROpKind.opCmpNe:  LInstr.Kind := sikCmpNe;
          TMyrIR.TMyrIROpKind.opCmpLt:  LInstr.Kind := sikCmpLt;
          TMyrIR.TMyrIROpKind.opCmpLe:  LInstr.Kind := sikCmpLe;
          TMyrIR.TMyrIROpKind.opCmpGt:  LInstr.Kind := sikCmpGt;
          TMyrIR.TMyrIROpKind.opCmpGe:  LInstr.Kind := sikCmpGe;
          TMyrIR.TMyrIROpKind.opUCmpLt: LInstr.Kind := sikUCmpLt;
          TMyrIR.TMyrIROpKind.opUCmpLe: LInstr.Kind := sikUCmpLe;
          TMyrIR.TMyrIROpKind.opUCmpGt: LInstr.Kind := sikUCmpGt;
          TMyrIR.TMyrIROpKind.opUCmpGe: LInstr.Kind := sikUCmpGe;
          TMyrIR.TMyrIROpKind.opFCmpEq: LInstr.Kind := sikFCmpEq;
          TMyrIR.TMyrIROpKind.opFCmpNe: LInstr.Kind := sikFCmpNe;
          TMyrIR.TMyrIROpKind.opFCmpLt: LInstr.Kind := sikFCmpLt;
          TMyrIR.TMyrIROpKind.opFCmpLe: LInstr.Kind := sikFCmpLe;
          TMyrIR.TMyrIROpKind.opFCmpGt: LInstr.Kind := sikFCmpGt;
          TMyrIR.TMyrIROpKind.opFCmpGe: LInstr.Kind := sikFCmpGe;
          TMyrIR.TMyrIROpKind.opAnd:    LInstr.Kind := sikBitAnd;  // Logical and
          TMyrIR.TMyrIROpKind.opOr:     LInstr.Kind := sikBitOr;   // Logical or
          // Set operations
          TMyrIR.TMyrIROpKind.opSetUnion:    LInstr.Kind := sikSetUnion;
          TMyrIR.TMyrIROpKind.opSetDiff:     LInstr.Kind := sikSetDiff;
          TMyrIR.TMyrIROpKind.opSetInter:    LInstr.Kind := sikSetInter;
          TMyrIR.TMyrIROpKind.opSetIn:       LInstr.Kind := sikSetIn;
          TMyrIR.TMyrIROpKind.opSetEq:       LInstr.Kind := sikSetEq;
          TMyrIR.TMyrIROpKind.opSetNe:       LInstr.Kind := sikSetNe;
          TMyrIR.TMyrIROpKind.opSetSubset:   LInstr.Kind := sikSetSubset;
          TMyrIR.TMyrIROpKind.opSetSuperset: LInstr.Kind := sikSetSuperset;
        else
          LInstr.Kind := sikNop;
        end;
        
        // Extract LowBound for SetIn
        if LExpr.Op = TMyrIR.TMyrIROpKind.opSetIn then
        begin
          // Prefer explicit LowBound from IR expression (set by Cobra codegen)
          if LExpr.SetLowBound <> 0 then
            LInstr.SetLowBound := LExpr.SetLowBound
          else
          begin
            // Fallback: infer from right operand's set type
            var LRightExpr := AIR.GetExpression(LExpr.Right);
            if (not LRightExpr.ResultType.IsPrimitive) and (LRightExpr.ResultType.TypeIndex >= 0) then
            begin
              var LTypeEntry := AIR.GetTypeEntry(LRightExpr.ResultType.TypeIndex);
              if LTypeEntry.Kind = TMyrIR.TMyrIRTypeKind.tkSet then
                LInstr.SetLowBound := LTypeEntry.SetType.LowBound;
            end;
          end;
        end;
        
        ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
        Result := LResultVar;
      end;
      
    TMyrIR.TMyrIRExprKind.ekUnary:
      begin
        // Special handling for address-of operations
        if LExpr.Op = TMyrIR.TMyrIROpKind.opAddrOf then
        begin
          LResultVar := ASSAFunc.NewVersion('_t');
          
          if LExpr.Left < 0 then
          begin
            // AddrOf(varname) - take address of named variable
            // Check if it's a global first
            LArgIdx := AIR.FindGlobal(LExpr.VarName);
            if LArgIdx >= 0 then
            begin
              // Global variable - sokGlobal operand IS the address (backend emits LEA)
              LInstr := Default(TMyrSSAInstr);
              LInstr.Kind := sikAssign;
              LInstr.Dest := LResultVar;
              LInstr.Op1 := TMyrSSAOperand.FromGlobal(LArgIdx);
              ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            end
            else
            begin
              // Local variable - use sikAddressOf
              LInstr := Default(TMyrSSAInstr);
              LInstr.Kind := sikAddressOf;
              LInstr.Dest := LResultVar;
              LInstr.Op1 := TMyrSSAOperand.FromVar(ASSAFunc.CurrentVersion(LExpr.VarName));
              LInstr.Op1.Var_.BaseName := LExpr.VarName;
              ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            end;
          end
          else
          begin
            // AddrOfExpr(expr) - take address of expression result
            LObjectExpr := AIR.GetExpression(LExpr.Left);
            
            if LObjectExpr.Kind = TMyrIR.TMyrIRExprKind.ekFieldAccess then
            begin
              // Get address of field: compute base address + field offset
              LInnerExpr := AIR.GetExpression(LObjectExpr.ObjectExpr);

              if (LInnerExpr.Kind = TMyrIR.TMyrIRExprKind.ekVariable) and 
                 (not LInnerExpr.ResultType.IsPrimitive) then
              begin
                LLeftVar := ASSAFunc.NewVersion('_t');
                LInstr := Default(TMyrSSAInstr);

                // DYNARRAY CHECK FIRST (same rule as the read path): the
                // variable holds the DATA POINTER -- index its VALUE, never
                // the slot address. Fixed arrays keep the address forms.
                if (LInnerExpr.ResultType.TypeIndex >= 0) and
                   (AIR.GetTypeEntry(LInnerExpr.ResultType.TypeIndex).Kind = TMyrIR.TMyrIRTypeKind.tkDynArray) then
                begin
                  LArgIdx := AIR.FindGlobal(LInnerExpr.VarName);
                  if LArgIdx >= 0 then
                  begin
                    // Global dynarray: LOAD the stored data pointer
                    LInstr.Kind := sikLoad;
                    LInstr.Dest := LLeftVar;
                    LInstr.Op1 := TMyrSSAOperand.FromGlobal(LArgIdx);
                    ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
                  end
                  else
                  begin
                    // Local dynarray: variable value IS the data pointer
                    LLeftVar := ASSAFunc.CurrentVersion(LInnerExpr.VarName);
                  end;
                end
                else
                begin
                  LArgIdx := AIR.FindGlobal(LInnerExpr.VarName);
                  if LArgIdx >= 0 then
                  begin
                    LInstr.Kind := sikAssign;
                    LInstr.Dest := LLeftVar;
                    LInstr.Op1 := TMyrSSAOperand.FromGlobal(LArgIdx);
                  end
                  else
                  begin
                    LInstr.Kind := sikAddressOf;
                    LInstr.Dest := LLeftVar;
                    LInstr.Op1 := TMyrSSAOperand.FromVar(ASSAFunc.CurrentVersion(LInnerExpr.VarName));
                    LInstr.Op1.Var_.BaseName := LInnerExpr.VarName;
                  end;
                  ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);

                  // BY-REFERENCE PARAMETER. The param slot holds a POINTER to
                  // the caller's record, so the slot ADDRESS is not the object
                  // address. Load the slot to recover the real base before the
                  // field offset is applied.
                  //
                  // The read path (ekFieldAccess) and the write path (skAssign
                  // field destination) both already make this distinction, and
                  // DoResolveCompositeAddr in Myrissa.Frontend.Emitter.pas
                  // makes it too. This address path never learned it.
                  //
                  // Without the load, fieldaddr resolved to the parameter slot
                  // itself, so setlength through a var param rewrote the
                  // callee's own stack and the caller's field never changed.
                  // Verified by temp\probe_setlenvar.myr.
                  //
                  // Deliberately scoped: the ekArrayIndex twin below carries
                  // the identical shape but has no failing case yet, so it is
                  // left alone until one exists.
                  LIsParam := False;
                  LIsAggregateParam := False;
                  LLocalSize := 0;
                  for LLocalIdx := 0 to ASSAFunc.GetLocalCount() - 1 do
                  begin
                    LLocalInfo := ASSAFunc.GetLocal(LLocalIdx);
                    if LLocalInfo.LocalName = LInnerExpr.VarName then
                    begin
                      LIsParam := LLocalInfo.IsParam;
                      LLocalSize := LLocalInfo.LocalSize;
                      LIsAggregateParam := LLocalInfo.IsParam and
                        DoIsAggregateTypeRef(AIR, LLocalInfo.LocalTypeRef);
                      Break;
                    end;
                  end;

                  if LIsAggregateParam then
                  begin
                    LTempVar := LLeftVar;
                    LLeftVar := ASSAFunc.NewVersion('_t');
                    LInstr := Default(TMyrSSAInstr);
                    LInstr.Kind := sikLoad;
                    LInstr.Dest := LLeftVar;
                    LInstr.Op1 := TMyrSSAOperand.FromVar(LTempVar);
                    ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
                  end;
                end;
              end
              else if (LInnerExpr.Kind = TMyrIR.TMyrIRExprKind.ekUnary) and
                      (LInnerExpr.Op = TMyrIR.TMyrIROpKind.opDeref) then
              begin
                // For Deref(ptr, TypeName), we want just the pointer value as base.
                LLeftVar := ConvertExpression(AIR, LInnerExpr.Left, ASSAFunc);
              end
              else
              begin
                LLeftVar := ConvertExpression(AIR, LObjectExpr.ObjectExpr, ASSAFunc);
              end;
              
              // Compute field address
              LInstr := Default(TMyrSSAInstr);
              LInstr.Kind := sikFieldAddr;
              LInstr.Dest := LResultVar;
              LInstr.Op1 := TMyrSSAOperand.FromVar(LLeftVar);
              LInstr.Op2 := TMyrSSAOperand.FromImm(LObjectExpr.FieldOffset);
              LInstr.Op2.FieldName := LObjectExpr.FieldName;
              ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            end
            else if LObjectExpr.Kind = TMyrIR.TMyrIRExprKind.ekArrayIndex then
            begin
              // Get address of array element
              LInnerExpr := AIR.GetExpression(LObjectExpr.ArrayExpr);
              
              if (LInnerExpr.Kind = TMyrIR.TMyrIRExprKind.ekVariable) and 
                 (not LInnerExpr.ResultType.IsPrimitive) then
              begin
                LLeftVar := ASSAFunc.NewVersion('_t');
                LInstr := Default(TMyrSSAInstr);

                // DYNARRAY CHECK FIRST (same rule as the read path): the
                // variable holds the DATA POINTER -- index its VALUE, never
                // the slot address. Fixed arrays keep the address forms.
                if (LInnerExpr.ResultType.TypeIndex >= 0) and
                   (AIR.GetTypeEntry(LInnerExpr.ResultType.TypeIndex).Kind = TMyrIR.TMyrIRTypeKind.tkDynArray) then
                begin
                  LArgIdx := AIR.FindGlobal(LInnerExpr.VarName);
                  if LArgIdx >= 0 then
                  begin
                    // Global dynarray: LOAD the stored data pointer
                    LInstr.Kind := sikLoad;
                    LInstr.Dest := LLeftVar;
                    LInstr.Op1 := TMyrSSAOperand.FromGlobal(LArgIdx);
                    ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
                  end
                  else
                  begin
                    // Local dynarray: variable value IS the data pointer
                    LLeftVar := ASSAFunc.CurrentVersion(LInnerExpr.VarName);
                  end;
                end
                else
                begin
                  LArgIdx := AIR.FindGlobal(LInnerExpr.VarName);
                  if LArgIdx >= 0 then
                  begin
                    LInstr.Kind := sikAssign;
                    LInstr.Dest := LLeftVar;
                    LInstr.Op1 := TMyrSSAOperand.FromGlobal(LArgIdx);
                  end
                  else
                  begin
                    LInstr.Kind := sikAddressOf;
                    LInstr.Dest := LLeftVar;
                    LInstr.Op1 := TMyrSSAOperand.FromVar(ASSAFunc.CurrentVersion(LInnerExpr.VarName));
                    LInstr.Op1.Var_.BaseName := LInnerExpr.VarName;
                  end;
                  ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
                end;
              end
              else
              begin
                LLeftVar := ConvertExpression(AIR, LObjectExpr.ArrayExpr, ASSAFunc);
              end;
              
              LRightVar := ConvertExpression(AIR, LObjectExpr.IndexExpr, ASSAFunc);
              
              LInstr := Default(TMyrSSAInstr);
              LInstr.Kind := sikIndexAddr;
              LInstr.Dest := LResultVar;
              LInstr.Op1 := TMyrSSAOperand.FromVar(LLeftVar);
              LInstr.Op2 := TMyrSSAOperand.FromVar(LRightVar);
              LInstr.Op2.ElementSize := LObjectExpr.ElementSize;
              ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            end
            else if LObjectExpr.Kind = TMyrIR.TMyrIRExprKind.ekVariable then
            begin
              // Take address of a variable through expression
              LInstr := Default(TMyrSSAInstr);

              LArgIdx := AIR.FindGlobal(LObjectExpr.VarName);
              if LArgIdx >= 0 then
              begin
                LInstr.Kind := sikAssign;
                LInstr.Dest := LResultVar;
                LInstr.Op1 := TMyrSSAOperand.FromGlobal(LArgIdx);
              end
              else
              begin
                LInstr.Kind := sikAddressOf;
                LInstr.Dest := LResultVar;
                LInstr.Op1 := TMyrSSAOperand.FromVar(ASSAFunc.CurrentVersion(LObjectExpr.VarName));
                LInstr.Op1.Var_.BaseName := LObjectExpr.VarName;
              end;
              ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            end;
          end;
          
          Result := LResultVar;
        end
        else
        begin
          // Other unary operations (neg, not, deref)
          LLeftVar := ConvertExpression(AIR, LExpr.Left, ASSAFunc);
          
          LResultVar := ASSAFunc.NewVersion('_t');
          
          LInstr := Default(TMyrSSAInstr);
          LInstr.Dest := LResultVar;
          LInstr.Op1 := TMyrSSAOperand.FromVar(LLeftVar);
          
          case LExpr.Op of
            TMyrIR.TMyrIROpKind.opNeg:    LInstr.Kind := sikNeg;
            TMyrIR.TMyrIROpKind.opFNeg:   LInstr.Kind := sikFNeg;
            TMyrIR.TMyrIROpKind.opIntToFloat: LInstr.Kind := sikIntToFloat;
            TMyrIR.TMyrIROpKind.opUIntToFloat: LInstr.Kind := sikUIntToFloat;
            TMyrIR.TMyrIROpKind.opFloatToInt: LInstr.Kind := sikFloatToInt;
            TMyrIR.TMyrIROpKind.opFloatToUInt: LInstr.Kind := sikFloatToUInt;
            TMyrIR.TMyrIROpKind.opFloat32ToFloat64: LInstr.Kind := sikFloat32ToFloat64;
            TMyrIR.TMyrIROpKind.opBitNot: LInstr.Kind := sikBitNot;
            TMyrIR.TMyrIROpKind.opNot:
            begin
              LInstr.Kind := sikCmpEq;
              LInstr.Op2 := TMyrSSAOperand.FromImm(0);
            end;
            TMyrIR.TMyrIROpKind.opDeref:
            begin
              LInstr.Kind := sikLoad;
              // Set MemSize based on the deref's declared type for correct
              // load width (Deref(ptr, cvtUInt16) must load 2 bytes, etc.)
              if LExpr.ResultType.IsPrimitive then
              begin
                case LExpr.ResultType.Primitive of
                  cvtInt8, cvtUInt8:   LInstr.MemSize := 1;
                  cvtInt16, cvtUInt16: LInstr.MemSize := 2;
                  cvtInt32, cvtUInt32, cvtFloat32: LInstr.MemSize := 4;
                else
                  LInstr.MemSize := 0;  // 0 = full 64-bit (default)
                end;
                LInstr.MemIsFloat := LExpr.ResultType.Primitive in [cvtFloat32, cvtFloat64];
                LInstr.MemIsSigned := LExpr.ResultType.Primitive in [cvtInt8, cvtInt16, cvtInt32];
              end;
            end;
          else
            LInstr.Kind := sikNop;
          end;
          
          ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
          Result := LResultVar;
        end;
      end;
      
    TMyrIR.TMyrIRExprKind.ekCall:
      begin
        // Build argument types array for overload resolution
        SetLength(LArgTypes, Length(LExpr.CallArgs));
        for LArgIdx := 0 to High(LExpr.CallArgs) do
        begin
          LArgExpr := AIR.GetExpression(LExpr.CallArgs[LArgIdx]);
          LArgTypes[LArgIdx] := LArgExpr.ResultType;
        end;

        // Convert call arguments
        SetLength(LCallArgs, Length(LExpr.CallArgs));
        for LArgIdx := 0 to High(LExpr.CallArgs) do
        begin
          LArgVar := ConvertExpression(AIR, LExpr.CallArgs[LArgIdx], ASSAFunc);
          LCallArgs[LArgIdx] := TMyrSSAOperand.FromVar(LArgVar);
        end;
        
        LResultVar := ASSAFunc.NewVersion('_t');
        
        LInstr := Default(TMyrSSAInstr);
        LInstr.Kind := sikCallAssign;
        LInstr.Dest := LResultVar;
        LInstr.CallArgs := LCallArgs;
        
        // Try signature-based lookup first for overload resolution
        LFuncIndex := FindLocalFuncBySignature(AIR, LExpr.CallTarget, LArgTypes);
        if LFuncIndex < 0 then
          // Try arg-count match (handles type widening cases like Int32→Int64)
          LFuncIndex := FindLocalFuncByArgCount(AIR, LExpr.CallTarget, Length(LExpr.CallArgs));
        if LFuncIndex < 0 then
          // Fall back to name-only lookup (for non-overloaded functions)
          LFuncIndex := FindLocalFuncByName(AIR, LExpr.CallTarget);
        
        if LFuncIndex >= 0 then
        begin
          LInstr.CallTarget := TMyrSSAOperand.FromFunc(LFuncIndex);
          
          // For by-ref params, emit AddressOf and replace arg with address
          LTargetFunc := AIR.GetFunction(LFuncIndex);
          LJ := 0;
          for LArgIdx := 0 to LTargetFunc.Vars.Count - 1 do
          begin
            if LTargetFunc.Vars[LArgIdx].IsParam then
            begin
              if LTargetFunc.Vars[LArgIdx].IsByRef and (LJ < Length(LCallArgs)) then
              begin
                // Check if the argument is a global variable
                LArgExpr := AIR.GetExpression(LExpr.CallArgs[LJ]);
                LGlobalIdx := -1;
                if LArgExpr.Kind = TMyrIR.TMyrIRExprKind.ekVariable then
                  LGlobalIdx := AIR.FindGlobal(LArgExpr.VarName);
                if LGlobalIdx >= 0 then
                begin
                  // Global variable: pass global address directly (LEA from .data)
                  LTempVar := ASSAFunc.NewVersion('_t');
                  LByRefInstr := Default(TMyrSSAInstr);
                  LByRefInstr.Kind := sikAssign;
                  LByRefInstr.Dest := LTempVar;
                  LByRefInstr.Op1 := TMyrSSAOperand.FromGlobal(LGlobalIdx);
                  ASSAFunc.GetCurrentBlock().AddInstruction(LByRefInstr);
                  LCallArgs[LJ] := TMyrSSAOperand.FromVar(LTempVar);
                end
                else if (LArgExpr.Kind = TMyrIR.TMyrIRExprKind.ekFieldAccess) and
                        (not LTargetFunc.Vars[LArgIdx].VarTypeRef.IsPrimitive) then
                begin
                  // COMPOSITE record FIELD argument - already an address.
                  // Same defect and same reasoning as the statement-call path
                  // above; this is the EXPRESSION-call twin of it. Both had to
                  // change: probe_vpk9 failed through the statement path and
                  // probe_vpk10 through the expression path.
                end
                else if (LArgExpr.Kind = TMyrIR.TMyrIRExprKind.ekUnary) and
                        (LArgExpr.Op = TMyrIR.TMyrIROpKind.opAddrOf) then
                begin
                  // ALREADY AN ADDRESS. Nothing to do. EXPRESSION-call twin of
                  // the same branch in the statement-call path above; see there
                  // for the full reasoning. Both paths must carry it or the
                  // defect simply moves to whichever one is not covered.
                end
                else if (LArgExpr.Kind = TMyrIR.TMyrIRExprKind.ekVariable) and
                        ASSAFunc.IsByRefParam(LArgExpr.VarName) then
                begin
                  // FORWARDED BY-REF PARAM - already an address. EXPRESSION-
                  // call twin of the same branch in the statement-call path
                  // above; see there for the full reasoning. Both paths must
                  // carry it or the defect simply moves to whichever one is
                  // not covered.
                end
                else if DoIsAggregateTypeRef(AIR, LArgExpr.ResultType) then
                begin
                  // AGGREGATE. Already an address per the ekVariable rule.
                  // Twin of the statement-call branch above. Pass through.
                end
                else
                begin
                  // Scalar local: take address of the local's stack slot
                  LTempVar := ASSAFunc.NewVersion('_t');
                  LByRefInstr := Default(TMyrSSAInstr);
                  LByRefInstr.Kind := sikAddressOf;
                  LByRefInstr.Dest := LTempVar;
                  LByRefInstr.Op1 := LCallArgs[LJ];
                  ASSAFunc.GetCurrentBlock().AddInstruction(LByRefInstr);
                  LCallArgs[LJ] := TMyrSSAOperand.FromVar(LTempVar);
                end;
              end;
              Inc(LJ);
            end;
          end;
          LInstr.CallArgs := LCallArgs;

          // For internal variadic functions, prepend vararg count
          if LTargetFunc.IsVariadic then
          begin
            // Count fixed params in target function
            LFixedParamCount := 0;
            for LJ := 0 to LTargetFunc.Vars.Count - 1 do
              if LTargetFunc.Vars[LJ].IsParam then
                Inc(LFixedParamCount);
            
            // Calculate vararg count
            LVarArgCount := Length(LExpr.CallArgs) - LFixedParamCount;
            if LVarArgCount < 0 then
              LVarArgCount := 0;
            
            // Prepend count to args array
            SetLength(LCallArgs, Length(LCallArgs) + 1);
            for LArgIdx := High(LCallArgs) downto 1 do
              LCallArgs[LArgIdx] := LCallArgs[LArgIdx - 1];
            LCallArgs[0] := TMyrSSAOperand.FromImm(LVarArgCount);
            LInstr.CallArgs := LCallArgs;
          end;
        end
        else
        begin
          // Try signature-based import lookup first (for overloaded imports)
          LImportIdx := FindImportBySignature(AIR, LExpr.CallTarget, LArgTypes);
          if LImportIdx < 0 then
            // Try arg-count match (handles type widening cases like Int32→Int64)
            LImportIdx := FindImportByArgCount(AIR, LExpr.CallTarget, Length(LExpr.CallArgs));
          if LImportIdx < 0 then
            // Fall back to name-only lookup (for non-overloaded imports)
            LImportIdx := FindImportByName(AIR, LExpr.CallTarget);
          if LImportIdx < 0 then
          begin
            if Assigned(FErrors) then
              FErrors.Add(LExpr.SourceFile, LExpr.SourceLine, LExpr.SourceCol,
                esError, MYR_ERR_SSA_UNKNOWN_FUNCTION, RSSSAUnknownFunction,
                [LExpr.CallTarget, ASSAFunc.GetFuncName()]);
            Result := TMyrSSAVar.None();
            Exit;
          end;
          LInstr.CallTarget := TMyrSSAOperand.FromImport(LImportIdx);
        end;
        
        ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
        
        Result := LResultVar;
      end;
      
    TMyrIR.TMyrIRExprKind.ekFuncAddr:
      begin
        // Get address of a function
        LResultVar := ASSAFunc.NewVersion('_t');
        
        LInstr := Default(TMyrSSAInstr);
        LInstr.Kind := sikFuncAddr;
        LInstr.Dest := LResultVar;
        // Store function name in Op1 - will be resolved to function index at emit time
        LInstr.Op1 := TMyrSSAOperand.FromFunc(FindLocalFuncByName(AIR, LExpr.FuncAddrName));
        ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
        
        Result := LResultVar;
      end;
      
    TMyrIR.TMyrIRExprKind.ekCallIndirect:
      begin
        // Indirect call through function pointer
        // First, evaluate the function pointer expression
        LLeftVar := ConvertExpression(AIR, LExpr.IndirectTarget, ASSAFunc);
        
        // Convert call arguments
        SetLength(LCallArgs, Length(LExpr.CallArgs));
        for LArgIdx := 0 to High(LExpr.CallArgs) do
        begin
          LArgVar := ConvertExpression(AIR, LExpr.CallArgs[LArgIdx], ASSAFunc);
          LCallArgs[LArgIdx] := TMyrSSAOperand.FromVar(LArgVar);
        end;
        
        LResultVar := ASSAFunc.NewVersion('_t');
        
        LInstr := Default(TMyrSSAInstr);
        LInstr.Kind := sikIndirectCallAssign;
        LInstr.Dest := LResultVar;
        LInstr.Op1 := TMyrSSAOperand.FromVar(LLeftVar);  // Function pointer
        LInstr.CallArgs := LCallArgs;
        // Carry the callee return size down to codegen. InvokeIndirect already
        // resolved ResultType from the pointer's routine type, but an indirect
        // target has no TMyrFuncInfo, so this is the only place the size survives.
        // A primitive, pointer-slot composite, or unresolved return leaves
        // it 0, which selects the ordinary (non-sret) convention.
        if DoIsAggregateTypeRef(AIR, LExpr.ResultType) then
          LInstr.CallReturnSize := AIR.GetTypeSize(LExpr.ResultType);
        ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
        
        Result := LResultVar;
      end;
      
    TMyrIR.TMyrIRExprKind.ekFieldAccess:
      begin
        // Get the object expression node
        LObjectExpr := AIR.GetExpression(LExpr.ObjectExpr);
        
        // For variable expressions with composite types, we need the address, not the value
        if (LObjectExpr.Kind = TMyrIR.TMyrIRExprKind.ekVariable) and 
           (not LObjectExpr.ResultType.IsPrimitive) then
        begin
          // Check if this is a parameter passed by reference (composite > 8 bytes)
          // Win64 ABI: Large structs are passed by pointer, so param value IS the address
          LIsParam := False;
          LIsAggregateParam := False;
          LLocalSize := 0;
          for LLocalIdx := 0 to ASSAFunc.GetLocalCount() - 1 do
          begin
            LLocalInfo := ASSAFunc.GetLocal(LLocalIdx);
            if LLocalInfo.LocalName = LObjectExpr.VarName then
            begin
              LIsParam := LLocalInfo.IsParam;
              LLocalSize := LLocalInfo.LocalSize;
              LIsAggregateParam := LLocalInfo.IsParam and
                DoIsAggregateTypeRef(AIR, LLocalInfo.LocalTypeRef);
              Break;
            end;
          end;
          
          // Get the address of the composite variable for field access
          LLeftVar := ASSAFunc.NewVersion('_t');
          LInstr := Default(TMyrSSAInstr);

          // Check if it's a global variable (data section, use LEA)
          LArgIdx := AIR.FindGlobal(LObjectExpr.VarName);
          if LArgIdx >= 0 then
          begin
            LInstr.Kind := sikAssign;
            LInstr.Dest := LLeftVar;
            LInstr.Op1 := TMyrSSAOperand.FromGlobal(LArgIdx);
          end
          else
          begin
            // Local variable — use AddressOf to get stack address
            LInstr.Kind := sikAddressOf;
            LInstr.Dest := LLeftVar;
            LInstr.Op1 := TMyrSSAOperand.FromVar(ASSAFunc.CurrentVersion(LObjectExpr.VarName));
            // If no version exists yet (first use of composite var), create version 0
            if not LInstr.Op1.Var_.IsValid() then
              LInstr.Op1 := TMyrSSAOperand.FromVar(ASSAFunc.NewVersion(LObjectExpr.VarName));
            LInstr.Op1.Var_.BaseName := LObjectExpr.VarName;  // Store base name for local lookup
          end;
          ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
          
          if LIsAggregateParam then
          begin
            // By-reference parameter: param slot contains pointer to struct
            // Load the pointer value from the param slot
            LTempVar := LLeftVar;
            LLeftVar := ASSAFunc.NewVersion('_t');
            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikLoad;
            LInstr.Dest := LLeftVar;
            LInstr.Op1 := TMyrSSAOperand.FromVar(LTempVar);
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
          end;
        end
        else if (LObjectExpr.Kind = TMyrIR.TMyrIRExprKind.ekUnary) and
                (LObjectExpr.Op = TMyrIR.TMyrIROpKind.opDeref) then
        begin
          // For Deref(ptr, TypeName), we want just the pointer value as base.
          // Don't generate a load - convert only the inner pointer expression.
          LLeftVar := ConvertExpression(AIR, LObjectExpr.Left, ASSAFunc);
        end
        else
        begin
          // For other expressions (pointers, etc.), convert normally
          LLeftVar := ConvertExpression(AIR, LExpr.ObjectExpr, ASSAFunc);
        end;
        
        // Create temp for field address
        LResultVar := ASSAFunc.NewVersion('_t');
        
        // Emit field address calculation using pre-computed offset
        LInstr := Default(TMyrSSAInstr);
        LInstr.Kind := sikFieldAddr;
        LInstr.Dest := LResultVar;
        LInstr.Op1 := TMyrSSAOperand.FromVar(LLeftVar);
        LInstr.Op2 := TMyrSSAOperand.FromImm(LExpr.FieldOffset);  // Use pre-computed offset
        LInstr.Op2.FieldName := LExpr.FieldName;
        ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
        
        // For composite (embedded struct) fields, the fieldaddr result IS the
        // address we need for chaining further field accesses - do NOT load.
        // Only load for primitive fields to get the actual scalar value.
        //
        // string/wstring are the exception: they are pointer-sized MANAGED
        // values whose slot holds a POINTER, not embedded storage, yet their
        // TypeRef is composite (they are registered as named types so that
        // IsStringType can recognise them). Without the load the raw slot
        // ADDRESS flows into RT_StrData/RT_StrRelease, which then do header
        // arithmetic on it - an access violation. This mirrors the dynarray
        // reasoning already spelled out in the ekArrayIndex branch above.
        //
        // A DYNARRAY field is the same case and was missing here: its slot
        // holds a POINTER to the data block, not embedded storage. Without the
        // load, the field ADDRESS was used as the array base, so indexing read
        // the record's own fields - element 1 returned the NEXT field - and
        // len() read a garbage header. On win64 that corrupted the heap.
        if LExpr.ResultType.IsPrimitive or
           AIR.IsStringType(LExpr.ResultType) or
           AIR.IsWStringType(LExpr.ResultType) or
           AIR.IsDynArrayType(LExpr.ResultType) then
        begin
          LLeftVar := LResultVar;
          LResultVar := ASSAFunc.NewVersion('_t');
          
          LInstr := Default(TMyrSSAInstr);
          LInstr.Kind := sikLoad;
          LInstr.Dest := LResultVar;
          LInstr.Op1 := TMyrSSAOperand.FromVar(LLeftVar);
          LInstr.MemSize := LExpr.FieldSize;
          LInstr.MemIsFloat := LExpr.ResultType.IsPrimitive and
            (LExpr.ResultType.Primitive in [cvtFloat32, cvtFloat64]);
          // Signed narrow fields must sign-extend on load. This was missing
          // here (and in the ekArrayIndex twin above) while the variable-load
          // sites set it, so a record int32 field holding -7 read back as
          // 4294967289 through movzx/mov r32. Repro: temp\probe_i32field.myr;
          // gate: test_exe_dynfieldrec.myr "adjacent members". DEFECT 7.
          LInstr.MemIsSigned := LExpr.ResultType.IsPrimitive and
            (LExpr.ResultType.Primitive in [cvtInt8, cvtInt16, cvtInt32]);
          ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
        end;
        
        // If bit field, extract the bits
        if LExpr.BitWidth > 0 then
        begin
          // Shift right by BitOffset to move bits to position 0
          if LExpr.BitOffset > 0 then
          begin
            LLeftVar := LResultVar;
            LResultVar := ASSAFunc.NewVersion('_t');
            
            LInstr := Default(TMyrSSAInstr);
            LInstr.Kind := sikShr;
            LInstr.Dest := LResultVar;
            LInstr.Op1 := TMyrSSAOperand.FromVar(LLeftVar);
            LInstr.Op2 := TMyrSSAOperand.FromImm(LExpr.BitOffset);
            ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
          end;
          
          // Mask to extract only BitWidth bits
          LLeftVar := LResultVar;
          LResultVar := ASSAFunc.NewVersion('_t');
          
          LInstr := Default(TMyrSSAInstr);
          LInstr.Kind := sikBitAnd;
          LInstr.Dest := LResultVar;
          LInstr.Op1 := TMyrSSAOperand.FromVar(LLeftVar);
          LInstr.Op2 := TMyrSSAOperand.FromImm((Int64(1) shl LExpr.BitWidth) - 1);  // Mask with BitWidth bits
          ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
        end;
        
        Result := LResultVar;
      end;
      
    TMyrIR.TMyrIRExprKind.ekArrayIndex:
      begin
        // Get the array expression node
        LObjectExpr := AIR.GetExpression(LExpr.ArrayExpr);
        
        // For variable expressions with composite types (arrays), we need the address
        if (LObjectExpr.Kind = TMyrIR.TMyrIRExprKind.ekVariable) and 
           (not LObjectExpr.ResultType.IsPrimitive) then
        begin
          LLeftVar := ASSAFunc.NewVersion('_t');
          LInstr := Default(TMyrSSAInstr);

          // DYNARRAY CHECK FIRST: a dynarray variable (local OR global)
          // holds the DATA POINTER -- its VALUE is the index base. The
          // global address-of-slot rule below only applies to fixed
          // arrays, whose storage lives inside the slot itself. Taking
          // the global branch for a dynarray indexed the slot memory
          // instead of the heap block.
          if (LObjectExpr.ResultType.TypeIndex >= 0) and
             (AIR.GetTypeEntry(LObjectExpr.ResultType.TypeIndex).Kind = TMyrIR.TMyrIRTypeKind.tkDynArray) then
          begin
            LArgIdx := AIR.FindGlobal(LObjectExpr.VarName);
            if LArgIdx >= 0 then
            begin
              // Global dynarray: LOAD the stored data pointer
              LInstr.Kind := sikLoad;
              LInstr.Dest := LLeftVar;
              LInstr.Op1 := TMyrSSAOperand.FromGlobal(LArgIdx);
              ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            end
            else
            begin
              // Local dynarray: variable value IS the data pointer
              LLeftVar := ASSAFunc.CurrentVersion(LObjectExpr.VarName);
            end;
          end
          else
          begin
            // Check if it's a global variable first
            LArgIdx := AIR.FindGlobal(LObjectExpr.VarName);
            if LArgIdx >= 0 then
            begin
              // Global fixed array - sokGlobal operand IS the address (backend emits LEA)
              LInstr.Kind := sikAssign;
              LInstr.Dest := LLeftVar;
              LInstr.Op1 := TMyrSSAOperand.FromGlobal(LArgIdx);
              ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            end
            else
            begin
              // Fixed array local - emit AddressOf to get stack address
              LInstr.Kind := sikAddressOf;
              LInstr.Dest := LLeftVar;
              LInstr.Op1 := TMyrSSAOperand.FromVar(ASSAFunc.CurrentVersion(LObjectExpr.VarName));
              LInstr.Op1.Var_.BaseName := LObjectExpr.VarName;
              ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
            end;
          end;
        end
        else
        begin
          // For other expressions (pointers, etc.), convert normally
          LLeftVar := ConvertExpression(AIR, LExpr.ArrayExpr, ASSAFunc);
        end;
        
        // Convert index expression
        LRightVar := ConvertExpression(AIR, LExpr.IndexExpr, ASSAFunc);
        
        // Create temp for element address
        LResultVar := ASSAFunc.NewVersion('_t');
        
        // Emit index address calculation using pre-computed element size
        LInstr := Default(TMyrSSAInstr);
        LInstr.Kind := sikIndexAddr;
        LInstr.Dest := LResultVar;
        LInstr.Op1 := TMyrSSAOperand.FromVar(LLeftVar);
        LInstr.Op2 := TMyrSSAOperand.FromVar(LRightVar);
        LInstr.Op2.ElementSize := LExpr.ElementSize;  // Use pre-computed element size
        ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
        
        // For composite (embedded array/record) elements, the indexaddr result IS
        // the address we need for chaining further indexing — do NOT load.
        // Only load for primitive elements to get the actual scalar value.
        //
        // string/wstring are the exception, for the same reason as the
        // ekFieldAccess branch below: they are pointer-sized MANAGED values
        // whose slot holds a POINTER, not embedded storage, yet their TypeRef
        // is composite because they are registered as named types so
        // IsStringType can recognise them. Without the load the raw slot
        // ADDRESS flows into RT_StrData/RT_StrRelease, which then do header
        // arithmetic on it - an access violation.
        //
        // A DYNARRAY element is the same case: array[0..N] of (array of T)
        // stores a POINTER per slot, so indexing one without the load would use
        // the slot ADDRESS as the inner array's base. Paired with the identical
        // gate in the ekFieldAccess branch below.
        if LExpr.ResultType.IsPrimitive or
           AIR.IsStringType(LExpr.ResultType) or
           AIR.IsWStringType(LExpr.ResultType) or
           AIR.IsDynArrayType(LExpr.ResultType) then
        begin
          // Load scalar value from element address
          LLeftVar := LResultVar;
          LResultVar := ASSAFunc.NewVersion('_t');
          
          LInstr := Default(TMyrSSAInstr);
          LInstr.Kind := sikLoad;
          LInstr.Dest := LResultVar;
          LInstr.Op1 := TMyrSSAOperand.FromVar(LLeftVar);
          LInstr.MemSize := LExpr.ElementSize;
          LInstr.MemIsFloat := LExpr.ResultType.IsPrimitive and
            (LExpr.ResultType.Primitive in [cvtFloat32, cvtFloat64]);
          // Signed narrow elements must sign-extend on load - paired with the
          // identical fix in the ekFieldAccess branch below. DEFECT 7.
          LInstr.MemIsSigned := LExpr.ResultType.IsPrimitive and
            (LExpr.ResultType.Primitive in [cvtInt8, cvtInt16, cvtInt32]);
          ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
        end;
        
        Result := LResultVar;
      end;
      
    TMyrIR.TMyrIRExprKind.ekGetExceptionCode:
      begin
        // Call Pax_GetExceptionCode() and store result
        LResultVar := ASSAFunc.NewVersion('_t');
        
        LInstr := Default(TMyrSSAInstr);
        LInstr.Kind := sikCallAssign;
        LInstr.Dest := LResultVar;
        LInstr.CallTarget := ResolveRuntimeTarget(AIR, RT_GetExceptionCode);
        SetLength(LInstr.CallArgs, 0);
        ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
        
        Result := LResultVar;
      end;
      
    TMyrIR.TMyrIRExprKind.ekGetExceptionMsg:
      begin
        // Call Pax_GetExceptionMessage() and store result
        LResultVar := ASSAFunc.NewVersion('_t');
        
        LInstr := Default(TMyrSSAInstr);
        LInstr.Kind := sikCallAssign;
        LInstr.Dest := LResultVar;
        LInstr.CallTarget := ResolveRuntimeTarget(AIR, RT_GetExceptionMsg);
        SetLength(LInstr.CallArgs, 0);
        ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
        
        Result := LResultVar;
      end;
      
    TMyrIR.TMyrIRExprKind.ekSetLiteral:
      begin
        // Create temp variable for set value
        LResultVar := ASSAFunc.NewVersion('_t');
        
        LInstr := Default(TMyrSSAInstr);
        LInstr.Kind := sikSetLiteral;
        LInstr.Dest := LResultVar;
        LInstr.SetTypeIndex := LExpr.SetTypeIndex;
        LInstr.SetElements := Copy(LExpr.SetElements);
        // Store type info for emission phase
        LInstr.SetLowBound := AIR.GetTypeEntry(LExpr.SetTypeIndex).SetType.LowBound;
        LInstr.SetStorageSize := AIR.GetTypeEntry(LExpr.SetTypeIndex).SetType.StorageSize;
        ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
        
        Result := LResultVar;
      end;
      
    TMyrIR.TMyrIRExprKind.ekVaCount:
      begin
        // Get vararg count - backend reads from stack
        LResultVar := ASSAFunc.NewVersion('_t');
        
        LInstr := Default(TMyrSSAInstr);
        LInstr.Kind := sikVaCount;
        LInstr.Dest := LResultVar;
        ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
        
        Result := LResultVar;
      end;
      
    TMyrIR.TMyrIRExprKind.ekVaArgAt:
      begin
        // Convert index expression
        LLeftVar := ConvertExpression(AIR, LExpr.VaArgIndex, ASSAFunc);
        
        LResultVar := ASSAFunc.NewVersion('_t');
        
        LInstr := Default(TMyrSSAInstr);
        LInstr.Kind := sikVaArgAt;
        LInstr.Dest := LResultVar;
        LInstr.Op1 := TMyrSSAOperand.FromVar(LLeftVar);  // Index
        LInstr.VaArgType := LExpr.VaArgType;  // Type to read as
        ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);
        
        Result := LResultVar;
      end;

    TMyrIR.TMyrIRExprKind.ekSyscall:
      begin
        // Syscall number goes in Op1; arguments in CallArgs.
        // Argument count was validated against MAX_SYSCALL_ARGS in the IR layer.
        LLeftVar := ConvertExpression(AIR, LExpr.SyscallNumber, ASSAFunc);

        SetLength(LCallArgs, Length(LExpr.CallArgs));
        for LArgIdx := 0 to High(LExpr.CallArgs) do
        begin
          LArgVar := ConvertExpression(AIR, LExpr.CallArgs[LArgIdx], ASSAFunc);
          LCallArgs[LArgIdx] := TMyrSSAOperand.FromVar(LArgVar);
        end;

        LResultVar := ASSAFunc.NewVersion('_t');

        LInstr := Default(TMyrSSAInstr);
        LInstr.Kind := sikSyscall;
        LInstr.Dest := LResultVar;
        LInstr.Op1 := TMyrSSAOperand.FromVar(LLeftVar);
        LInstr.CallArgs := LCallArgs;
        ASSAFunc.GetCurrentBlock().AddInstruction(LInstr);

        Result := LResultVar;
      end;

  else
    Result := TMyrSSAVar.None();
  end;
  
  // A call result that is a small aggregate arrives packed in RAX; spill it
  // so the aggregate-is-an-address rule holds for every consumer.
  if (LExpr.Kind in [TMyrIR.TMyrIRExprKind.ekCall, TMyrIR.TMyrIRExprKind.ekCallIndirect]) and Result.IsValid() then
    Result := DoSpillSmallAggregateResult(AIR, Result, LExpr.ResultType, ASSAFunc);

  // Cache the result for reuse
  if Result.IsValid() then
    FExpressionCache.AddOrSetValue(AExprIndex, Result);
end;

procedure TMyrSSABuilder.ComputeDominators(const AFunc: TMyrSSAFunc);
var
  LNumBlocks: Integer;
  LDom: TArray<TList<Integer>>;  // Dom[i] = set of blocks that dominate block i
  LChanged: Boolean;
  LI: Integer;
  LJ: Integer;
  LK: Integer;
  LBlock: TMyrSSABlock;
  LNewDom: TList<Integer>;
  LIntersect: TList<Integer>;
  LFirstPred: Boolean;
begin
  LNumBlocks := AFunc.GetBlockCount();
  if LNumBlocks = 0 then
    Exit;
  
  // Initialize Dom sets
  SetLength(LDom, LNumBlocks);
  for LI := 0 to LNumBlocks - 1 do
  begin
    LDom[LI] := TList<Integer>.Create();
    if LI = 0 then
    begin
      // Entry block dominates only itself
      LDom[LI].Add(0);
    end
    else
    begin
      // All other blocks: initialize with all blocks (will be narrowed)
      for LJ := 0 to LNumBlocks - 1 do
        LDom[LI].Add(LJ);
    end;
  end;
  
  // Iterate until fixed point
  LChanged := True;
  while LChanged do
  begin
    LChanged := False;
    
    for LI := 1 to LNumBlocks - 1 do  // Skip entry block
    begin
      LBlock := AFunc.GetBlock(LI);
      if LBlock.GetPredecessorCount() = 0 then
        Continue;
      
      // Compute intersection of Dom sets of all predecessors
      LNewDom := TList<Integer>.Create();
      try
        LFirstPred := True;
        
        for LJ := 0 to LBlock.GetPredecessorCount() - 1 do
        begin
          if LFirstPred then
          begin
            // Start with first predecessor's dom set
            for LK := 0 to LDom[LBlock.GetPredecessor(LJ)].Count - 1 do
              LNewDom.Add(LDom[LBlock.GetPredecessor(LJ)][LK]);
            LFirstPred := False;
          end
          else
          begin
            // Intersect with this predecessor's dom set
            LIntersect := TList<Integer>.Create();
            try
              for LK := 0 to LNewDom.Count - 1 do
              begin
                if LDom[LBlock.GetPredecessor(LJ)].Contains(LNewDom[LK]) then
                  LIntersect.Add(LNewDom[LK]);
              end;
              LNewDom.Clear();
              for LK := 0 to LIntersect.Count - 1 do
                LNewDom.Add(LIntersect[LK]);
            finally
              LIntersect.Free();
            end;
          end;
        end;
        
        // Add self
        if not LNewDom.Contains(LI) then
          LNewDom.Add(LI);
        
        // Check if changed
        if LNewDom.Count <> LDom[LI].Count then
          LChanged := True
        else
        begin
          for LK := 0 to LNewDom.Count - 1 do
          begin
            if not LDom[LI].Contains(LNewDom[LK]) then
            begin
              LChanged := True;
              Break;
            end;
          end;
        end;
        
        // Update Dom set
        if LChanged then
        begin
          LDom[LI].Clear();
          for LK := 0 to LNewDom.Count - 1 do
            LDom[LI].Add(LNewDom[LK]);
        end;
        
      finally
        LNewDom.Free();
      end;
    end;
  end;
  
  // Compute immediate dominators from Dom sets
  for LI := 0 to LNumBlocks - 1 do
  begin
    LBlock := AFunc.GetBlock(LI);
    
    if LI = 0 then
    begin
      LBlock.SetImmediateDominator(-1);  // Entry has no dominator
    end
    else
    begin
      // Immediate dominator is the dominator closest to this block
      // (dominates this block but doesn't dominate any other dominator)
      for LJ := 0 to LDom[LI].Count - 1 do
      begin
        if LDom[LI][LJ] = LI then
          Continue;  // Skip self
        
        // Check if LDom[LI][LJ] is the immediate dominator
        // It must not dominate any other dominator (except itself)
        LFirstPred := True;  // Reuse as "is immediate" flag
        for LK := 0 to LDom[LI].Count - 1 do
        begin
          if (LDom[LI][LK] <> LI) and (LDom[LI][LK] <> LDom[LI][LJ]) then
          begin
            // Check if LDom[LI][LJ] dominates LDom[LI][LK]
            if LDom[LDom[LI][LK]].Contains(LDom[LI][LJ]) then
            begin
              LFirstPred := False;  // Not immediate
              Break;
            end;
          end;
        end;
        
        if LFirstPred then
        begin
          LBlock.SetImmediateDominator(LDom[LI][LJ]);
          // Add this block to the dominator's children
          AFunc.GetBlock(LDom[LI][LJ]).AddDominatedBlock(LI);
          Break;
        end;
      end;
    end;
  end;
  
  // Clean up
  for LI := 0 to LNumBlocks - 1 do
    LDom[LI].Free();
end;

procedure TMyrSSABuilder.ComputeDominanceFrontiers(const AFunc: TMyrSSAFunc);
var
  LI: Integer;
  LJ: Integer;
  LBlock: TMyrSSABlock;
  LPredIdx: Integer;
  LRunner: Integer;
  LIdom: Integer;
begin
  // Clear existing frontiers
  for LI := 0 to AFunc.GetBlockCount() - 1 do
    AFunc.GetBlock(LI).ClearDominanceFrontier();
  
  // For each block B with multiple predecessors (join point)
  for LI := 0 to AFunc.GetBlockCount() - 1 do
  begin
    LBlock := AFunc.GetBlock(LI);
    
    if LBlock.GetPredecessorCount() < 2 then
      Continue;
    
    // For each predecessor P of B
    for LJ := 0 to LBlock.GetPredecessorCount() - 1 do
    begin
      LPredIdx := LBlock.GetPredecessor(LJ);
      LRunner := LPredIdx;
      
      // Walk up the dominator tree from P to idom(B)
      // Adding B to the dominance frontier of each node along the way
      LIdom := LBlock.GetImmediateDominator();
      
      while (LRunner <> LIdom) and (LRunner >= 0) do
      begin
        AFunc.GetBlock(LRunner).AddDominanceFrontier(LI);
        LRunner := AFunc.GetBlock(LRunner).GetImmediateDominator();
      end;
    end;
  end;
end;

procedure TMyrSSABuilder.EliminatePhiNodes(const AFunc: TMyrSSAFunc);
var
  LI: Integer;
  LJ: Integer;
  LK: Integer;
  LM: Integer;
  LBlock: TMyrSSABlock;
  LPredBlock: TMyrSSABlock;
  LInstr: TMyrSSAInstr;
  LCopyInstr: TMyrSSAInstr;
  LTermInstr: TMyrSSAInstr;
  LPhiIndices: TList<Integer>;
  LPhiEntry: TMyrSSAPhiEntry;
begin
  // For each block, find phi nodes and convert to copies in predecessors
  for LI := 0 to AFunc.GetBlockCount() - 1 do
  begin
    LBlock := AFunc.GetBlock(LI);
    LPhiIndices := TList<Integer>.Create();
    try
      // Find all phi instructions
      for LJ := 0 to LBlock.GetInstructionCount() - 1 do
      begin
        LInstr := LBlock.GetInstruction(LJ);
        if LInstr.Kind = sikPhi then
          LPhiIndices.Add(LJ)
        else
          Break;  // Phi nodes are at the beginning
      end;
      
      // Process each phi node
      for LJ := LPhiIndices.Count - 1 downto 0 do
      begin
        LInstr := LBlock.GetInstruction(LPhiIndices[LJ]);
        
        // For each phi operand, insert a copy at end of predecessor
        for LK := 0 to High(LInstr.PhiEntries) do
        begin
          LPhiEntry := LInstr.PhiEntries[LK];
          LPredBlock := AFunc.GetBlock(LPhiEntry.BlockIndex);
          
          // Create copy instruction: dest = source
          LCopyInstr := Default(TMyrSSAInstr);
          LCopyInstr.Kind := sikAssign;
          LCopyInstr.Dest := LInstr.Dest;
          LCopyInstr.Op1 := TMyrSSAOperand.FromVar(LPhiEntry.Var_);
          
          // Insert before the terminator (jump instruction)
          // Find terminator position
          for LM := LPredBlock.GetInstructionCount() - 1 downto 0 do
          begin
            LTermInstr := LPredBlock.GetInstruction(LM);
            if LTermInstr.Kind in [sikJump, sikJumpIf, sikJumpIfNot, sikReturn, sikReturnValue] then
            begin
              LPredBlock.InsertInstructionAt(LM, LCopyInstr);
              Break;
            end;
          end;
        end;
        
        // Mark phi as nop (will be skipped during emission)
        LInstr.Kind := sikNop;
        LBlock.SetInstruction(LPhiIndices[LJ], LInstr);
      end;
      
    finally
      LPhiIndices.Free();
    end;
  end;
end;

procedure TMyrSSABuilder.InsertPhiNodes(const AFunc: TMyrSSAFunc);
var
  LVarName: string;
  LDefBlocks: TList<Integer>;       // Blocks where variable is defined
  LPhiBlocks: TDictionary<string, TList<Integer>>; // Blocks with phi for each var
  LWorkList: TList<Integer>;
  LI: Integer;
  LJ: Integer;
  LK: Integer;
  LBlock: TMyrSSABlock;
  LInstr: TMyrSSAInstr;
  LPhiInstr: TMyrSSAInstr;
  LDFBlock: Integer;
  LVarList: TList<string>;
  LBlockPhis: TList<Integer>;
begin
  // Collect all variables that are assigned
  LVarList := TList<string>.Create();
  LPhiBlocks := TDictionary<string, TList<Integer>>.Create();
  try
    // Find all assigned variables and their definition blocks
    for LI := 0 to AFunc.GetBlockCount() - 1 do
    begin
      LBlock := AFunc.GetBlock(LI);
      for LJ := 0 to LBlock.GetInstructionCount() - 1 do
      begin
        LInstr := LBlock.GetInstruction(LJ);
        if (LInstr.Kind = sikAssign) and (LInstr.Dest.BaseName <> '') and 
           (not LInstr.Dest.BaseName.StartsWith('_t')) then
        begin
          LVarName := LInstr.Dest.BaseName;
          if not LVarList.Contains(LVarName) then
            LVarList.Add(LVarName);
          LBlock.AddDefinedVar(LVarName);
        end;
      end;
    end;
    
    // For each variable, compute where phi nodes are needed
    for LI := 0 to LVarList.Count - 1 do
    begin
      LVarName := LVarList[LI];
      LPhiBlocks.Add(LVarName, TList<Integer>.Create());
      
      // Get blocks where this variable is defined
      LDefBlocks := TList<Integer>.Create();
      LWorkList := TList<Integer>.Create();
      try
        for LJ := 0 to AFunc.GetBlockCount() - 1 do
        begin
          if AFunc.GetBlock(LJ).HasDefinedVar(LVarName) then
          begin
            LDefBlocks.Add(LJ);
            LWorkList.Add(LJ);
          end;
        end;
        
        // Iterate: add phi nodes at dominance frontiers
        while LWorkList.Count > 0 do
        begin
          LJ := LWorkList[0];
          LWorkList.Delete(0);
          LBlock := AFunc.GetBlock(LJ);
          
          // For each block in dominance frontier
          for LK := 0 to LBlock.GetDominanceFrontierCount() - 1 do
          begin
            LDFBlock := LBlock.GetDominanceFrontier(LK);
            LBlockPhis := LPhiBlocks[LVarName];
            
            // If we haven't already inserted a phi here
            if not LBlockPhis.Contains(LDFBlock) then
            begin
              LBlockPhis.Add(LDFBlock);
              
              // If this block wasn't already a def block, add to worklist
              if not LDefBlocks.Contains(LDFBlock) then
              begin
                LDefBlocks.Add(LDFBlock);
                LWorkList.Add(LDFBlock);
              end;
            end;
          end;
        end;
      finally
        LWorkList.Free();
        LDefBlocks.Free();
      end;
    end;
    
    // Now actually insert phi instructions at the beginning of blocks
    for LI := 0 to LVarList.Count - 1 do
    begin
      LVarName := LVarList[LI];
      LBlockPhis := LPhiBlocks[LVarName];
      
      for LJ := 0 to LBlockPhis.Count - 1 do
      begin
        LBlock := AFunc.GetBlock(LBlockPhis[LJ]);
        
        // Create phi instruction
        LPhiInstr := Default(TMyrSSAInstr);
        LPhiInstr.Kind := sikPhi;
        LPhiInstr.Dest := TMyrSSAVar.Create(LVarName, 0); // Version assigned during rename
        
        // Pre-allocate phi entries for each predecessor
        SetLength(LPhiInstr.PhiEntries, LBlock.GetPredecessorCount());
        for LK := 0 to LBlock.GetPredecessorCount() - 1 do
        begin
          LPhiInstr.PhiEntries[LK].BlockIndex := LBlock.GetPredecessor(LK);
          LPhiInstr.PhiEntries[LK].Var_ := TMyrSSAVar.Create(LVarName, 0); // Filled during rename
        end;
        
        // Insert at beginning of block
        LBlock.InsertInstructionAt(0, LPhiInstr);
      end;
    end;
    
  finally
    // Clean up phi block lists
    for LVarName in LPhiBlocks.Keys do
      LPhiBlocks[LVarName].Free();
    LPhiBlocks.Free();
    LVarList.Free();
  end;
end;

procedure TMyrSSABuilder.RenameVariables(const AFunc: TMyrSSAFunc);
var
  LVarStacks: TDictionary<string, TStack<Integer>>;
  LVarCounters: TDictionary<string, Integer>;
  
  function GetNewVersion(const AVarName: string): Integer;
  var
    LCounter: Integer;
  begin
    if LVarCounters.TryGetValue(AVarName, LCounter) then
    begin
      Result := LCounter;
      LVarCounters[AVarName] := LCounter + 1;
    end
    else
    begin
      Result := 0;
      LVarCounters.Add(AVarName, 1);
    end;
  end;
  
  function GetCurrentVersion(const AVarName: string): Integer;
  var
    LStack: TStack<Integer>;
  begin
    if LVarStacks.TryGetValue(AVarName, LStack) and (LStack.Count > 0) then
      Result := LStack.Peek()
    else
      Result := 0;
  end;
  
  procedure PushVersion(const AVarName: string; const AVersion: Integer);
  var
    LStack: TStack<Integer>;
  begin
    if not LVarStacks.TryGetValue(AVarName, LStack) then
    begin
      LStack := TStack<Integer>.Create();
      LVarStacks.Add(AVarName, LStack);
    end;
    LStack.Push(AVersion);
  end;
  
  procedure RenameBlock(const ABlockIndex: Integer);
  var
    LBlock: TMyrSSABlock;
    LInstr: TMyrSSAInstr;
    LI: Integer;
    LJ: Integer;
    LK: Integer;
    LNewVersion: Integer;
    LPushedVars: TList<string>;
    LSuccBlock: TMyrSSABlock;
    LSuccInstr: TMyrSSAInstr;
    LPredIdx: Integer;
    LVarName: string;
    LChildIdx: Integer;
  begin
    LBlock := AFunc.GetBlock(ABlockIndex);
    LPushedVars := TList<string>.Create();
    try
      // Process each instruction in the block
      for LI := 0 to LBlock.GetInstructionCount() - 1 do
      begin
        LInstr := LBlock.GetInstruction(LI);
        
        // For phi nodes, only rename the destination
        if LInstr.Kind = sikPhi then
        begin
          LVarName := LInstr.Dest.BaseName;
          LNewVersion := GetNewVersion(LVarName);
          LInstr.Dest := TMyrSSAVar.Create(LVarName, LNewVersion);
          PushVersion(LVarName, LNewVersion);
          LPushedVars.Add(LVarName);
          LBlock.SetInstruction(LI, LInstr);
          Continue;
        end;
        
        // Rename uses (Op1, Op2) - get current version from stack.
        // Skip SSA-INTERNAL temps only: those are single-underscore ('_t',
        // '_thunk') and arrive pre-versioned. EMITTER-materialized temps
        // ('__t*', double underscore) are REAL declared locals registered
        // through AddLocal -- skipping them left their addrof operands as
        // TMyrSSAVar.None, so codegen took a garbage address and the by-value
        // composite blockcopy smashed the stack (probe_vpkwr2's AV at every
        // const-composite call argument).
        if (LInstr.Op1.Kind = sokVar) and
           ((not LInstr.Op1.Var_.BaseName.StartsWith('_')) or
            LInstr.Op1.Var_.BaseName.StartsWith('__')) then
        begin
          LVarName := LInstr.Op1.Var_.BaseName;
          LInstr.Op1.Var_ := TMyrSSAVar.Create(LVarName, GetCurrentVersion(LVarName));
        end;
        
        if (LInstr.Op2.Kind = sokVar) and
           ((not LInstr.Op2.Var_.BaseName.StartsWith('_')) or
            LInstr.Op2.Var_.BaseName.StartsWith('__')) then
        begin
          LVarName := LInstr.Op2.Var_.BaseName;
          LInstr.Op2.Var_ := TMyrSSAVar.Create(LVarName, GetCurrentVersion(LVarName));
        end;
        
        // Rename call arguments
        for LJ := 0 to High(LInstr.CallArgs) do
        begin
          if (LInstr.CallArgs[LJ].Kind = sokVar) and
             ((not LInstr.CallArgs[LJ].Var_.BaseName.StartsWith('_')) or
              LInstr.CallArgs[LJ].Var_.BaseName.StartsWith('__')) then
          begin
            LVarName := LInstr.CallArgs[LJ].Var_.BaseName;
            LInstr.CallArgs[LJ].Var_ := TMyrSSAVar.Create(LVarName, GetCurrentVersion(LVarName));
          end;
        end;
        
        // Rename definition (Dest) - create new version
        if (LInstr.Kind = sikAssign) and (LInstr.Dest.BaseName <> '') and
           ((not LInstr.Dest.BaseName.StartsWith('_')) or
            LInstr.Dest.BaseName.StartsWith('__')) then
        begin
          LVarName := LInstr.Dest.BaseName;
          LNewVersion := GetNewVersion(LVarName);
          LInstr.Dest := TMyrSSAVar.Create(LVarName, LNewVersion);
          PushVersion(LVarName, LNewVersion);
          LPushedVars.Add(LVarName);
        end;
        
        LBlock.SetInstruction(LI, LInstr);
      end;
      
      // Fill in phi operands in successor blocks
      for LI := 0 to LBlock.GetSuccessorCount() - 1 do
      begin
        LSuccBlock := AFunc.GetBlock(LBlock.GetSuccessor(LI));
        
        // Find which predecessor index we are
        LPredIdx := -1;
        for LJ := 0 to LSuccBlock.GetPredecessorCount() - 1 do
        begin
          if LSuccBlock.GetPredecessor(LJ) = ABlockIndex then
          begin
            LPredIdx := LJ;
            Break;
          end;
        end;
        
        if LPredIdx < 0 then
          Continue;
        
        // Update phi instructions
        for LJ := 0 to LSuccBlock.GetInstructionCount() - 1 do
        begin
          LSuccInstr := LSuccBlock.GetInstruction(LJ);
          if LSuccInstr.Kind <> sikPhi then
            Break; // Phi nodes are at the beginning
          
          // Find the phi entry for this predecessor
          for LK := 0 to High(LSuccInstr.PhiEntries) do
          begin
            if LSuccInstr.PhiEntries[LK].BlockIndex = ABlockIndex then
            begin
              LVarName := LSuccInstr.Dest.BaseName;
              LSuccInstr.PhiEntries[LK].Var_ := TMyrSSAVar.Create(
                LVarName, GetCurrentVersion(LVarName)
              );
              Break;
            end;
          end;
          
          LSuccBlock.SetInstruction(LJ, LSuccInstr);
        end;
      end;
      
      // Recurse to dominated blocks (children in dominator tree)
      for LI := 0 to LBlock.GetDominatedBlockCount() - 1 do
      begin
        LChildIdx := LBlock.GetDominatedBlock(LI);
        RenameBlock(LChildIdx);
      end;
      
      // Pop versions pushed in this block
      for LI := LPushedVars.Count - 1 downto 0 do
      begin
        LVarName := LPushedVars[LI];
        if LVarStacks.ContainsKey(LVarName) then
          LVarStacks[LVarName].Pop();
      end;
      
    finally
      LPushedVars.Free();
    end;
  end;
  
var
  LVarName: string;
  LI: Integer;
begin
  LVarStacks := TDictionary<string, TStack<Integer>>.Create();
  LVarCounters := TDictionary<string, Integer>.Create();
  try
    // Initialize parameters with version 0 (they come in defined)
    for LI := 0 to AFunc.GetLocalCount() - 1 do
    begin
      if AFunc.GetLocal(LI).IsParam then
      begin
        LVarName := AFunc.GetLocal(LI).LocalName;
        PushVersion(LVarName, 0);
        LVarCounters.Add(LVarName, 1);
      end;
    end;
    
    // Start renaming from entry block (block 0)
    if AFunc.GetBlockCount() > 0 then
      RenameBlock(0);
      
  finally
    // Clean up stacks
    for LVarName in LVarStacks.Keys do
      LVarStacks[LVarName].Free();
    LVarStacks.Free();
    LVarCounters.Free();
  end;
end;

procedure TMyrSSABuilder.Optimize(const ALevel: Integer);
var
  LI: Integer;
  LJ: Integer;
  LPass: TMyrSSAPass;
  LFunc: TMyrSSAFunc;
  LPassCount: Integer;
begin
  // Skip optimization if level is 0
  if ALevel = 0 then
  begin
    Status('SSA: Optimization skipped (level 0)');
    Exit;
  end;
  
  // Count how many passes will run at this level
  LPassCount := 0;
  for LI := 0 to FPasses.Count - 1 do
  begin
    if FPasses[LI].GetMinLevel() <= ALevel then
      Inc(LPassCount);
  end;
  
  Status('SSA: Running %d optimization passes (level %d)', [LPassCount, ALevel]);
  
  for LI := 0 to FPasses.Count - 1 do
  begin
    LPass := FPasses[LI];
    
    // Skip passes that require higher level
    if LPass.GetMinLevel() > ALevel then
      Continue;
    
    Status('SSA: Running pass: %s', [LPass.GetPassName()]);
    
    for LJ := 0 to FFunctions.Count - 1 do
    begin
      LFunc := FFunctions[LJ];
      LPass.Run(LFunc);
    end;
  end;

  // Function-level DCE - remove unreferenced functions
  RemoveUnreferencedFunctions();
end;

procedure TMyrSSABuilder.RemoveUnreferencedFunctions();
var
  LLive: array of Boolean;
  LIndexMap: array of Integer;  // Old index -> New index (-1 if removed)
  LChanged: Boolean;
  LI: Integer;
  LJ: Integer;
  LK: Integer;
  //LM: Integer;
  LFunc: TMyrSSAFunc;
  LBlock: TMyrSSABlock;
  LInstr: TMyrSSAInstr;
  LTargetIdx: Integer;
  LNewIdx: Integer;
  LRemovedCount: Integer;
  LNewFunctions: TObjectList<TMyrSSAFunc>;
begin
  if FFunctions.Count = 0 then
    Exit;

  // Step 1: Initialize live set - mark entry points
  SetLength(LLive, FFunctions.Count);
  for LI := 0 to FFunctions.Count - 1 do
  begin
    LFunc := FFunctions[LI];
    LLive[LI] := LFunc.GetIsEntryPoint() or LFunc.GetIsDllEntry() or LFunc.GetIsPublic();
    // Runtime provider: every runtime routine stays, a linked static lib may
    // reference any of them and that is only known at link time
    if FIsRuntimeProvider and (LI >= FUserFuncCount) then
      LLive[LI] := True;
  end;

  // Step 1b: Mark exception runtime functions as live if any function uses SEH
  for LI := 0 to FFunctions.Count - 1 do
  begin
    LFunc := FFunctions[LI];
    if LFunc.GetExceptionScopeCount() > 0 then
    begin
      // This function uses try/except/finally - mark runtime functions as live
      for LJ := 0 to FFunctions.Count - 1 do
      begin
        LFunc := FFunctions[LJ];
        if (LFunc.GetFuncName() = RT_InitExceptions) or
           (LFunc.GetFuncName() = RT_SetException) or
           (LFunc.GetFuncName() = RT_Raise) or
           (LFunc.GetFuncName() = RT_RaiseCode) or
           (LFunc.GetFuncName() = RT_GetExceptionCode) or
           (LFunc.GetFuncName() = RT_GetExceptionMsg) or
           (LFunc.GetFuncName() = RT_SEHFilter) or
           // Linux64-specific: called by backend-generated code, not IR
           (LFunc.GetFuncName() = RT_PushExceptFrame) or
           (LFunc.GetFuncName() = RT_PopExceptFrame) or
           (LFunc.GetFuncName() = RT_InitSignals) or
           (LFunc.GetFuncName() = RT_SignalHandler) or
           (LFunc.GetFuncName() = RT_GetExceptFrame) then
          LLive[LJ] := True;
      end;
      Break;  // Only need to check once
    end;
  end;

  // Step 2: Transitively mark all functions called by live functions
  repeat
    LChanged := False;

    for LI := 0 to FFunctions.Count - 1 do
    begin
      if not LLive[LI] then
        Continue;

      LFunc := FFunctions[LI];

      // Scan all blocks
      for LJ := 0 to LFunc.GetBlockCount() - 1 do
      begin
        LBlock := LFunc.GetBlock(LJ);

        // Scan all instructions
        for LK := 0 to LBlock.GetInstructionCount() - 1 do
        begin
          LInstr := LBlock.GetInstruction(LK);

          // Check for function calls
          if (LInstr.Kind in [sikCall, sikCallAssign]) and
             (LInstr.CallTarget.Kind = sokFunc) then
          begin
            LTargetIdx := LInstr.CallTarget.FuncIndex;
            if (LTargetIdx >= 0) and (LTargetIdx < Length(LLive)) and (not LLive[LTargetIdx]) then
            begin
              LLive[LTargetIdx] := True;
              LChanged := True;
            end;
          end;

          // Check for function address (indirect calls)
          if (LInstr.Kind = sikFuncAddr) and (LInstr.Op1.Kind = sokFunc) then
          begin
            LTargetIdx := LInstr.Op1.FuncIndex;
            if (LTargetIdx >= 0) and (LTargetIdx < Length(LLive)) and (not LLive[LTargetIdx]) then
            begin
              LLive[LTargetIdx] := True;
              LChanged := True;
            end;
          end;
        end;
      end;
    end;
  until not LChanged;

  // Step 3: Count removed functions and build index mapping
  LRemovedCount := 0;
  SetLength(LIndexMap, FFunctions.Count);
  LNewIdx := 0;
  for LI := 0 to FFunctions.Count - 1 do
  begin
    if LLive[LI] then
    begin
      LIndexMap[LI] := LNewIdx;
      Inc(LNewIdx);
    end
    else
    begin
      LIndexMap[LI] := -1;
      Inc(LRemovedCount);
    end;
  end;

  if LRemovedCount = 0 then
  begin
    Status('SSA: Function DCE - no unreferenced functions');
    Exit;
  end;

  Status('SSA: Function DCE - removing %d unreferenced function(s)', [LRemovedCount]);

  // Step 4: Update function indices in all remaining instructions
  for LI := 0 to FFunctions.Count - 1 do
  begin
    if not LLive[LI] then
      Continue;

    LFunc := FFunctions[LI];

    for LJ := 0 to LFunc.GetBlockCount() - 1 do
    begin
      LBlock := LFunc.GetBlock(LJ);

      for LK := 0 to LBlock.GetInstructionCount() - 1 do
      begin
        LInstr := LBlock.GetInstruction(LK);

        // Update function call targets
        if (LInstr.Kind in [sikCall, sikCallAssign]) and
           (LInstr.CallTarget.Kind = sokFunc) then
        begin
          LTargetIdx := LInstr.CallTarget.FuncIndex;
          if (LTargetIdx >= 0) and (LTargetIdx < Length(LIndexMap)) then
          begin
            LInstr.CallTarget.FuncIndex := LIndexMap[LTargetIdx];
            LBlock.SetInstruction(LK, LInstr);
          end;
        end;

        // Update function address references
        if (LInstr.Kind = sikFuncAddr) and (LInstr.Op1.Kind = sokFunc) then
        begin
          LTargetIdx := LInstr.Op1.FuncIndex;
          if (LTargetIdx >= 0) and (LTargetIdx < Length(LIndexMap)) then
          begin
            LInstr.Op1.FuncIndex := LIndexMap[LTargetIdx];
            LBlock.SetInstruction(LK, LInstr);
          end;
        end;
      end;
    end;
  end;

  // Step 5: Build new function list with only live functions
  LNewFunctions := TObjectList<TMyrSSAFunc>.Create(True);
  try
    // Iterate backwards to avoid index shifting issues when extracting
    for LI := FFunctions.Count - 1 downto 0 do
    begin
      if LLive[LI] then
      begin
        LFunc := FFunctions[LI];
        FFunctions.Extract(LFunc);  // Remove ownership without freeing
        LNewFunctions.Insert(0, LFunc);  // Insert at front to maintain order
      end;
    end;

    // Swap lists - dead functions in FFunctions will be freed
    FFunctions.Free();
    FFunctions := LNewFunctions;
    LNewFunctions := nil;  // Prevent double-free in finally
  finally
    LNewFunctions.Free();
  end;
end;

function TMyrSSABuilder.DumpSSA(): string;
var
  LFuncIdx: Integer;
  LBlockIdx: Integer;
  LInstrIdx: Integer;
  LFunc: TMyrSSAFunc;
  LBlock: TMyrSSABlock;
  LInstr: TMyrSSAInstr;
  LPhiIdx: Integer;
  LArgIdx: Integer;
  LLine: string;
  LResult: TStringBuilder;
begin
  LResult := TStringBuilder.Create();
  try
    LResult.AppendLine('=== SSA Dump ===');
    
    for LFuncIdx := 0 to FFunctions.Count - 1 do
    begin
      LFunc := FFunctions[LFuncIdx];
      LResult.AppendLine('Function: ' + LFunc.GetFuncName());
      LResult.AppendLine('  Locals: ' + IntToStr(LFunc.GetLocalCount()));
      LResult.AppendLine('  Blocks: ' + IntToStr(LFunc.GetBlockCount()));
      
      for LBlockIdx := 0 to LFunc.GetBlockCount() - 1 do
      begin
        LBlock := LFunc.GetBlock(LBlockIdx);
        LResult.AppendLine('  Block ' + IntToStr(LBlockIdx) + ' (' + LBlock.GetBlockName() + ')');
        LResult.AppendLine('    Preds: ' + IntToStr(LBlock.GetPredecessorCount()) + ', Succs: ' + IntToStr(LBlock.GetSuccessorCount()));
        LResult.AppendLine('    IDom: ' + IntToStr(LBlock.GetImmediateDominator()));
        
        for LInstrIdx := 0 to LBlock.GetInstructionCount() - 1 do
        begin
          LInstr := LBlock.GetInstruction(LInstrIdx);
          
          case LInstr.Kind of
            sikNop: LLine := 'nop';
            sikAssign: LLine := Format('%s = %s', [LInstr.Dest.ToString(), LInstr.Op1.ToString()]);
            sikAdd: LLine := Format('%s = %s + %s', [LInstr.Dest.ToString(), LInstr.Op1.ToString(), LInstr.Op2.ToString()]);
            sikSub: LLine := Format('%s = %s - %s', [LInstr.Dest.ToString(), LInstr.Op1.ToString(), LInstr.Op2.ToString()]);
            sikMul: LLine := Format('%s = %s * %s', [LInstr.Dest.ToString(), LInstr.Op1.ToString(), LInstr.Op2.ToString()]);
            sikDiv: LLine := Format('%s = %s / %s', [LInstr.Dest.ToString(), LInstr.Op1.ToString(), LInstr.Op2.ToString()]);
            sikUDiv: LLine := Format('%s = %s u/ %s', [LInstr.Dest.ToString(), LInstr.Op1.ToStringUnsigned(), LInstr.Op2.ToStringUnsigned()]);
            sikUMod: LLine := Format('%s = %s u%% %s', [LInstr.Dest.ToString(), LInstr.Op1.ToStringUnsigned(), LInstr.Op2.ToStringUnsigned()]);
            sikFAdd: LLine := Format('%s = float(%s + %s)', [LInstr.Dest.ToString(), LInstr.Op1.ToString(), LInstr.Op2.ToString()]);
            sikFSub: LLine := Format('%s = float(%s - %s)', [LInstr.Dest.ToString(), LInstr.Op1.ToString(), LInstr.Op2.ToString()]);
            sikFMul: LLine := Format('%s = float(%s * %s)', [LInstr.Dest.ToString(), LInstr.Op1.ToString(), LInstr.Op2.ToString()]);
            sikFDiv: LLine := Format('%s = float(%s / %s)', [LInstr.Dest.ToString(), LInstr.Op1.ToString(), LInstr.Op2.ToString()]);
            sikFNeg: LLine := Format('%s = float(-%s)', [LInstr.Dest.ToString(), LInstr.Op1.ToString()]);
            sikIntToFloat: LLine := Format('%s = int_to_float(%s)', [LInstr.Dest.ToString(), LInstr.Op1.ToString()]);
            sikUIntToFloat: LLine := Format('%s = uint_to_float(%s)', [LInstr.Dest.ToString(), LInstr.Op1.ToString()]);
            sikFloatToInt: LLine := Format('%s = float_to_int(%s)', [LInstr.Dest.ToString(), LInstr.Op1.ToString()]);
            sikFloatToUInt: LLine := Format('%s = float_to_uint(%s)', [LInstr.Dest.ToString(), LInstr.Op1.ToString()]);
            sikFloat32ToFloat64: LLine := Format('%s = f32_to_f64(%s)', [LInstr.Dest.ToString(), LInstr.Op1.ToString()]);
            sikCmpEq: LLine := Format('%s = %s == %s', [LInstr.Dest.ToString(), LInstr.Op1.ToString(), LInstr.Op2.ToString()]);
            sikCmpNe: LLine := Format('%s = %s != %s', [LInstr.Dest.ToString(), LInstr.Op1.ToString(), LInstr.Op2.ToString()]);
            sikCmpLt: LLine := Format('%s = %s < %s', [LInstr.Dest.ToString(), LInstr.Op1.ToString(), LInstr.Op2.ToString()]);
            sikCmpLe: LLine := Format('%s = %s <= %s', [LInstr.Dest.ToString(), LInstr.Op1.ToString(), LInstr.Op2.ToString()]);
            sikCmpGt: LLine := Format('%s = %s > %s', [LInstr.Dest.ToString(), LInstr.Op1.ToString(), LInstr.Op2.ToString()]);
            sikCmpGe: LLine := Format('%s = %s >= %s', [LInstr.Dest.ToString(), LInstr.Op1.ToString(), LInstr.Op2.ToString()]);
            sikUCmpLt: LLine := Format('%s = %s u< %s', [LInstr.Dest.ToString(), LInstr.Op1.ToStringUnsigned(), LInstr.Op2.ToStringUnsigned()]);
            sikUCmpLe: LLine := Format('%s = %s u<= %s', [LInstr.Dest.ToString(), LInstr.Op1.ToStringUnsigned(), LInstr.Op2.ToStringUnsigned()]);
            sikUCmpGt: LLine := Format('%s = %s u> %s', [LInstr.Dest.ToString(), LInstr.Op1.ToStringUnsigned(), LInstr.Op2.ToStringUnsigned()]);
            sikUCmpGe: LLine := Format('%s = %s u>= %s', [LInstr.Dest.ToString(), LInstr.Op1.ToStringUnsigned(), LInstr.Op2.ToStringUnsigned()]);
            sikFCmpEq: LLine := Format('%s = float(%s == %s)', [LInstr.Dest.ToString(), LInstr.Op1.ToString(), LInstr.Op2.ToString()]);
            sikFCmpNe: LLine := Format('%s = float(%s != %s)', [LInstr.Dest.ToString(), LInstr.Op1.ToString(), LInstr.Op2.ToString()]);
            sikFCmpLt: LLine := Format('%s = float(%s < %s)', [LInstr.Dest.ToString(), LInstr.Op1.ToString(), LInstr.Op2.ToString()]);
            sikFCmpLe: LLine := Format('%s = float(%s <= %s)', [LInstr.Dest.ToString(), LInstr.Op1.ToString(), LInstr.Op2.ToString()]);
            sikFCmpGt: LLine := Format('%s = float(%s > %s)', [LInstr.Dest.ToString(), LInstr.Op1.ToString(), LInstr.Op2.ToString()]);
            sikFCmpGe: LLine := Format('%s = float(%s >= %s)', [LInstr.Dest.ToString(), LInstr.Op1.ToString(), LInstr.Op2.ToString()]);
            sikJump: LLine := Format('jump block_%d', [LInstr.Op1.BlockIndex]);
            sikJumpIf: LLine := Format('jumpif %s block_%d', [LInstr.Op1.ToString(), LInstr.Op2.BlockIndex]);
            sikJumpIfNot: LLine := Format('jumpifnot %s block_%d', [LInstr.Op1.ToString(), LInstr.Op2.BlockIndex]);
            sikCall:
              begin
                if LInstr.CallTarget.Kind = sokFunc then
                  LLine := Format('call func_%d(', [LInstr.CallTarget.FuncIndex])
                else
                  LLine := Format('call import_%d(', [LInstr.CallTarget.ImportIndex]);
                for LArgIdx := 0 to High(LInstr.CallArgs) do
                begin
                  if LArgIdx > 0 then LLine := LLine + ', ';
                  LLine := LLine + LInstr.CallArgs[LArgIdx].ToString();
                end;
                LLine := LLine + ')';
              end;
            sikCallAssign:
              begin
                if LInstr.CallTarget.Kind = sokFunc then
                  LLine := Format('%s = call func_%d(', [LInstr.Dest.ToString(), LInstr.CallTarget.FuncIndex])
                else
                  LLine := Format('%s = call import_%d(', [LInstr.Dest.ToString(), LInstr.CallTarget.ImportIndex]);
                for LArgIdx := 0 to High(LInstr.CallArgs) do
                begin
                  if LArgIdx > 0 then LLine := LLine + ', ';
                  LLine := LLine + LInstr.CallArgs[LArgIdx].ToString();
                end;
                LLine := LLine + ')';
              end;
            sikIndirectCall:
              begin
                LLine := Format('call [%s](', [LInstr.Op1.ToString()]);
                for LArgIdx := 0 to High(LInstr.CallArgs) do
                begin
                  if LArgIdx > 0 then LLine := LLine + ', ';
                  LLine := LLine + LInstr.CallArgs[LArgIdx].ToString();
                end;
                LLine := LLine + ')';
              end;
            sikIndirectCallAssign:
              begin
                LLine := Format('%s = call [%s](', [LInstr.Dest.ToString(), LInstr.Op1.ToString()]);
                for LArgIdx := 0 to High(LInstr.CallArgs) do
                begin
                  if LArgIdx > 0 then LLine := LLine + ', ';
                  LLine := LLine + LInstr.CallArgs[LArgIdx].ToString();
                end;
                LLine := LLine + ')';
              end;
            sikReturn: LLine := 'return';
            sikReturnValue: LLine := Format('return %s', [LInstr.Op1.ToString()]);
            sikPhi:
              begin
                LLine := Format('%s = phi(', [LInstr.Dest.ToString()]);
                for LPhiIdx := 0 to High(LInstr.PhiEntries) do
                begin
                  if LPhiIdx > 0 then LLine := LLine + ', ';
                  LLine := LLine + Format('[block_%d: %s]', [
                    LInstr.PhiEntries[LPhiIdx].BlockIndex,
                    LInstr.PhiEntries[LPhiIdx].Var_.ToString()
                  ]);
                end;
                LLine := LLine + ')';
              end;
            sikLoad:
              if LInstr.MemSize > 0 then
                LLine := Format('%s = load(%s, size=%d)', [LInstr.Dest.ToString(), LInstr.Op1.ToString(), LInstr.MemSize])
              else
                LLine := Format('%s = load(%s)', [LInstr.Dest.ToString(), LInstr.Op1.ToString()]);
            sikStore:
              if LInstr.MemSize > 0 then
                LLine := Format('store(%s, %s, size=%d)', [LInstr.Op1.ToString(), LInstr.Op2.ToString(), LInstr.MemSize])
              else
                LLine := Format('store(%s, %s)', [LInstr.Op1.ToString(), LInstr.Op2.ToString()]);
            sikAddressOf: LLine := Format('%s = addrof(%s)', [LInstr.Dest.ToString(), LInstr.Op1.ToString()]);
            sikFieldAddr: LLine := Format('%s = fieldaddr(%s, %s[off=%d])', [LInstr.Dest.ToString(), LInstr.Op1.ToString(), LInstr.Op2.FieldName, LInstr.Op2.ImmInt]);
            sikIndexAddr: LLine := Format('%s = indexaddr(%s, %s, size=%d)', [LInstr.Dest.ToString(), LInstr.Op1.ToString(), LInstr.Op2.ToString(), LInstr.Op2.ElementSize]);
            sikBlockCopy: LLine := Format('blockcopy(dst=%s, src=%s, bytes=%d)', [LInstr.Op1.ToString(), LInstr.Op2.ToString(), LInstr.CopySize]);
            sikSetLiteral: LLine := Format('%s = setliteral[%d elements]', [LInstr.Dest.ToString(), Length(LInstr.SetElements)]);
            sikSetUnion: LLine := Format('%s = %s + %s', [LInstr.Dest.ToString(), LInstr.Op1.ToString(), LInstr.Op2.ToString()]);
            sikSetDiff: LLine := Format('%s = %s - %s', [LInstr.Dest.ToString(), LInstr.Op1.ToString(), LInstr.Op2.ToString()]);
            sikSetInter: LLine := Format('%s = %s * %s', [LInstr.Dest.ToString(), LInstr.Op1.ToString(), LInstr.Op2.ToString()]);
            sikSetIn: LLine := Format('%s = %s in %s', [LInstr.Dest.ToString(), LInstr.Op1.ToString(), LInstr.Op2.ToString()]);
            sikSetEq: LLine := Format('%s = %s =set %s', [LInstr.Dest.ToString(), LInstr.Op1.ToString(), LInstr.Op2.ToString()]);
            sikSetNe: LLine := Format('%s = %s <>set %s', [LInstr.Dest.ToString(), LInstr.Op1.ToString(), LInstr.Op2.ToString()]);
            sikSetSubset: LLine := Format('%s = %s <=set %s', [LInstr.Dest.ToString(), LInstr.Op1.ToString(), LInstr.Op2.ToString()]);
            sikSetSuperset: LLine := Format('%s = %s >=set %s', [LInstr.Dest.ToString(), LInstr.Op1.ToString(), LInstr.Op2.ToString()]);
            sikFuncAddr: LLine := Format('%s = funcaddr(%s)', [LInstr.Dest.ToString(), LInstr.Op1.ToString()]);
            sikMod: LLine := Format('%s = %s %% %s', [LInstr.Dest.ToString(), LInstr.Op1.ToString(), LInstr.Op2.ToString()]);
            sikNeg: LLine := Format('%s = -%s', [LInstr.Dest.ToString(), LInstr.Op1.ToString()]);
            sikBitAnd: LLine := Format('%s = %s & %s', [LInstr.Dest.ToString(), LInstr.Op1.ToString(), LInstr.Op2.ToString()]);
            sikBitOr: LLine := Format('%s = %s | %s', [LInstr.Dest.ToString(), LInstr.Op1.ToString(), LInstr.Op2.ToString()]);
            sikBitXor: LLine := Format('%s = %s ^ %s', [LInstr.Dest.ToString(), LInstr.Op1.ToString(), LInstr.Op2.ToString()]);
            sikBitNot: LLine := Format('%s = ~%s', [LInstr.Dest.ToString(), LInstr.Op1.ToString()]);
            sikShl: LLine := Format('%s = %s << %s', [LInstr.Dest.ToString(), LInstr.Op1.ToString(), LInstr.Op2.ToString()]);
            sikShr: LLine := Format('%s = %s >> %s', [LInstr.Dest.ToString(), LInstr.Op1.ToString(), LInstr.Op2.ToString()]);
            sikSyscall:
              begin
                LLine := Format('%s = syscall(%s', [LInstr.Dest.ToString(), LInstr.Op1.ToString()]);
                for LArgIdx := 0 to High(LInstr.CallArgs) do
                  LLine := LLine + ', ' + LInstr.CallArgs[LArgIdx].ToString();
                LLine := LLine + ')';
              end;
          else
            LLine := Format('unknown_%d', [Ord(LInstr.Kind)]);
          end;
          
          LResult.AppendLine('      ' + IntToStr(LInstrIdx) + ': ' + LLine);
        end;
      end;
      LResult.AppendLine('');
    end;
    
    LResult.AppendLine('=== End SSA Dump ===');
    Result := LResult.ToString();
  finally
    LResult.Free();
  end;
end;

