  MYR_ERR_ELF_OBJ_FAILED = 'E0004';

  { ELF_BASE }
  // Load address of the first segment for ET_EXEC images. ET_DYN images use
  // image base 0 so every virtual address is loader-relocatable.
  ELF_BASE = $400000;

  { ET_REL }
  // e_type values, fixed by the ELF-64 specification.
  ET_REL = 1;

  { ET_EXEC }
  ET_EXEC = 2;

  { ET_DYN }
  ET_DYN = 3;

  { ELF_PAGE }
  ELF_PAGE = $1000;

  { ELF_HEADER_SIZE }
  ELF_HEADER_SIZE = 64;

  { ELF_PHENTSIZE }
  ELF_PHENTSIZE = 56;

  { ELF_PHNUM }
  ELF_PHNUM = 3;

  { ELF_TEXT_ALIGN }
  // Text and stub are 16-byte aligned within the first segment.
  ELF_TEXT_ALIGN = 16;

  { ELF_STUB_PROLOGUE_SIZE }
  // Command line capture, emitted ahead of the call to the program entry:
  //   mov rax,[rsp]     (4)  argc
  //   lea rcx,[rip+d]   (7)  &RT_Argc
  //   mov [rcx],rax     (3)
  //   lea rax,[rsp+8]   (5)  argv base
  //   lea rcx,[rip+d]   (7)  &RT_Argv
  //   mov [rcx],rax     (3)
  ELF_STUB_PROLOGUE_SIZE = 29;

  { ELF_STUB_TAIL_RAW }
  // Static-image stub tail: call rel32 (5) + mov edi,eax (2)
  // + mov eax,imm32 (5) + syscall (2). No libc is present, so the raw
  // exit_group syscall is the only termination construct available.
  ELF_STUB_TAIL_RAW = 14;

  { ELF_STUB_TAIL_LIBC }
  // Dynamic-image stub tail: call rel32 (5) + mov edi,eax (2)
  // + CALL [RIP+disp32] into libc exit's GOT slot (6), then the raw tail's
  // exit path (mov eax,imm32 (5) + syscall (2)) as an unreachable backstop
  // so control can never fall off the end of the stub. libc exit() flushes
  // stdio and runs atexit; the raw syscall would discard buffered output.
  ELF_STUB_TAIL_LIBC = 20;

  { ELF_STUB_SIZE }
  // Static stub size. Dynamic images compute their stub size from
  // ELF_STUB_TAIL_LIBC during layout. The prologue is replaced by padding
  // when the command line globals are absent, never omitted, because the
  // stub size feeds the segment layout the displacements depend on.
  ELF_STUB_SIZE = ELF_STUB_PROLOGUE_SIZE + ELF_STUB_TAIL_RAW;

