  LFunc.IsVariadic := AValue;
  SetCurrentFunc(LFunc);
  Result := Self;
end;

function TMyrCodeBuilder.EndProc(): TMyrCodeBuilder;
var
  LFunc: TMyrFuncInfo;
begin
  // Compute ExportName based on linkage if function is public
  LFunc := GetCurrentFunc();
  if LFunc.IsPublic then
  begin
    case LFunc.Linkage of
      plC:
        // C linkage - use raw function name
        LFunc.ExportName := LFunc.FuncName;
      plCPP:
        // Default linkage - for now use raw name, mangling can be added later
        // TODO: Use TNativeABIMangler when circular dependency is resolved
        LFunc.ExportName := LFunc.FuncName;
    end;
    SetCurrentFunc(LFunc);
  end;
  
  FCurrentFunc := -1;
  Result := Self;
end;

function TMyrCodeBuilder.AddParam(const AName: string; const AType: TMyrValueType; const AIsByRef: Boolean): TMyrLocalHandle;
var
  LFunc: TMyrFuncInfo;
  LParam: TMyrParamInfo;
  LLen: Integer;
begin
  LFunc := GetCurrentFunc();

  LParam.ParamName := AName;
  LParam.ParamType := AType;
  LParam.IsByRef := AIsByRef;

  LLen := Length(LFunc.Params);
  SetLength(LFunc.Params, LLen + 1);
  LFunc.Params[LLen] := LParam;

  SetCurrentFunc(LFunc);

  Result.Index := LLen;
  Result.IsParam := True;
end;

function TMyrCodeBuilder.AddParam(const AName: string; const ASize: Integer; const AAlignment: Integer; const AIsByRef: Boolean): TMyrLocalHandle;
var
  LFunc: TMyrFuncInfo;
  LParam: TMyrParamInfo;
  LLen: Integer;
begin
  LFunc := GetCurrentFunc();

  LParam.ParamName := AName;
  LParam.ParamType := cvtVoid;  // Composite type - no primitive type
  LParam.ParamSize := ASize;
  LParam.ParamAlignment := AAlignment;
  LParam.IsByRef := AIsByRef;

  LLen := Length(LFunc.Params);
  SetLength(LFunc.Params, LLen + 1);
  LFunc.Params[LLen] := LParam;

  SetCurrentFunc(LFunc);

  Result.Index := LLen;
  Result.IsParam := True;
end;

function TMyrCodeBuilder.AddLocal(const AName: string; const AType: TMyrValueType): TMyrLocalHandle;
var
  LFunc: TMyrFuncInfo;
  LLocal: TMyrLocalInfo;
  LLen: Integer;
  LSize: Integer;
begin
  LFunc := GetCurrentFunc();

  // Calculate size based on type
  case AType of
    cvtInt8, cvtUInt8: LSize := 1;
    cvtInt16, cvtUInt16: LSize := 2;
    cvtInt32, cvtUInt32, cvtFloat32: LSize := 4;
    cvtInt64, cvtUInt64, cvtFloat64, cvtPointer: LSize := 8;
  else
    LSize := 8;  // Default to 8 bytes
  end;

  // Align size to 8 bytes for stack alignment
  LSize := ((LSize + 7) div 8) * 8;

  LLocal.LocalName := AName;
  LLocal.LocalType := AType;
  LLocal.LocalSize := LSize;
  LLocal.LocalAlignment := 8;  // All primitives align to 8 bytes
  LLocal.StackOffset := 0;  // Will be calculated during code generation

  LLen := Length(LFunc.Locals);
  SetLength(LFunc.Locals, LLen + 1);
  LFunc.Locals[LLen] := LLocal;

  SetCurrentFunc(LFunc);

  Result.Index := LLen;
  Result.IsParam := False;
end;

function TMyrCodeBuilder.AddLocal(const AName: string; const ASize: Integer): TMyrLocalHandle;
var
  LFunc: TMyrFuncInfo;
  LLocal: TMyrLocalInfo;
  LLen: Integer;
  LAlignedSize: Integer;
begin
  LFunc := GetCurrentFunc();

  // Align size to 8 bytes for stack alignment
  LAlignedSize := ((ASize + 7) div 8) * 8;

  LLocal.LocalName := AName;
  LLocal.LocalType := cvtVoid;  // Composite type
  LLocal.LocalSize := LAlignedSize;
  LLocal.LocalAlignment := 8;  // Default alignment for composite types
  LLocal.StackOffset := 0;  // Will be calculated during code generation

  LLen := Length(LFunc.Locals);
  SetLength(LFunc.Locals, LLen + 1);
  LFunc.Locals[LLen] := LLocal;

  SetCurrentFunc(LFunc);

  Result.Index := LLen;
  Result.IsParam := False;
end;

function TMyrCodeBuilder.AddLocal(const AName: string; const ASize: Integer; const AAlignment: Integer): TMyrLocalHandle;
var
  LFunc: TMyrFuncInfo;
  LLocal: TMyrLocalInfo;
  LLen: Integer;
  LAlignedSize: Integer;
begin
  LFunc := GetCurrentFunc();

  // Align size to 8 bytes for stack alignment
  LAlignedSize := ((ASize + 7) div 8) * 8;

  LLocal.LocalName := AName;
  LLocal.LocalType := cvtVoid;  // Composite type
  LLocal.LocalSize := LAlignedSize;
  LLocal.LocalAlignment := AAlignment;
  LLocal.StackOffset := 0;  // Will be calculated during code generation

  LLen := Length(LFunc.Locals);
  SetLength(LFunc.Locals, LLen + 1);
  LFunc.Locals[LLen] := LLocal;

  SetCurrentFunc(LFunc);

  Result.Index := LLen;
  Result.IsParam := False;
end;

function TMyrCodeBuilder.DefineLabel(const AName: string): TMyrLabelHandle;
var
  LFunc: TMyrFuncInfo;
  LLabel: TMyrLabelInfo;
  LLen: Integer;
begin
  LFunc := GetCurrentFunc();

  LLabel.LabelName := AName;
  LLabel.CodeOffset := -1;
  LLabel.IsDefined := False;

  LLen := Length(LFunc.Labels);
  SetLength(LFunc.Labels, LLen + 1);
  LFunc.Labels[LLen] := LLabel;

  SetCurrentFunc(LFunc);

  Result.Index := LLen;
end;

function TMyrCodeBuilder.MarkLabel(const ALabel: TMyrLabelHandle): TMyrCodeBuilder;
var
  LInstr: TMyrInstruction;
begin
  LInstr := Default(TMyrInstruction);
  LInstr.Kind := ikLabel;
  LInstr.LabelTarget := ALabel;
  AddInstr(LInstr);

  Result := Self;
end;

procedure TMyrCodeBuilder.AddExceptionScope(
  const ATryBegin: TMyrLabelHandle;
  const ATryEnd: TMyrLabelHandle;
  const AExcept: TMyrLabelHandle;
  const AFinally: TMyrLabelHandle;
  const AEnd: TMyrLabelHandle
);
var
  LFunc: TMyrFuncInfo;
  LScope: TMyrExceptionScope;
  LLen: Integer;
begin
  if FCurrentFunc < 0 then
    Exit;
  
  LScope.TryBeginLabel := ATryBegin;
  LScope.TryEndLabel := ATryEnd;
  LScope.ExceptLabel := AExcept;
  LScope.FinallyLabel := AFinally;
  LScope.EndLabel := AEnd;
  
  LFunc := FFunctions[FCurrentFunc];
  LLen := Length(LFunc.ExceptionScopes);
  SetLength(LFunc.ExceptionScopes, LLen + 1);
  LFunc.ExceptionScopes[LLen] := LScope;
  FFunctions[FCurrentFunc] := LFunc;
end;

