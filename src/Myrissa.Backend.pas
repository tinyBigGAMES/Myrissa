function TMyrIR.DefineSet(const AName: string): TMyrIR;
begin
  // Bare "set" is alias for set of 0..63
  Result := DefineSet(AName, 0, 63);
end;

function TMyrIR.DefineSet(const AName: string; const ALow: Integer; const AHigh: Integer): TMyrIR;
var
  LEntry: TMyrIRTypeEntry;
  LSpan: Integer;
begin
  Result := Self;

  // Validate range
  if AHigh < ALow then
  begin
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_IR_TYPE_BUILD, RSIRInvalidSetRange, [ALow, AHigh]);
    Exit;
  end;

  LSpan := AHigh - ALow + 1;
  if LSpan > 64 then
  begin
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_IR_TYPE_BUILD, RSIRSetRangeTooLarge, [LSpan]);
    Exit;
  end;

  LEntry := Default(TMyrIRTypeEntry);
  LEntry.Kind := tkSet;
  LEntry.SetType.TypeName := AName;
  LEntry.SetType.LowBound := ALow;
  LEntry.SetType.HighBound := AHigh;
  LEntry.SetType.BaseType := TMyrTypeRef.None();

  // On x86-64, all register-sized values need 8-byte stack slots.
  // The bit masking in OpSetLiteral handles the actual bit pattern correctly.
  LEntry.SetType.StorageSize := 8;

  FTypes.Add(LEntry);
end;

function TMyrIR.DefineSet(const AName: string; const AEnumTypeName: string): TMyrIR;
var
  LEnumIndex: Integer;
  LEnumEntry: TMyrIRTypeEntry;
  LMinOrd: System.Int64;
  LMaxOrd: System.Int64;
  LI: Integer;
  LEntry: TMyrIRTypeEntry;
  LSpan: Integer;
begin
  Result := Self;

  // Find the enum type
  LEnumIndex := FindType(AEnumTypeName);
  if LEnumIndex < 0 then
  begin
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_IR_TYPE_BUILD, RSIRUnknownEnumType, [AEnumTypeName]);
    Exit;
  end;

  LEnumEntry := FTypes[LEnumIndex];
  if LEnumEntry.Kind <> tkEnum then
  begin
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_IR_TYPE_BUILD, RSIRTypeNotEnum, [AEnumTypeName]);
    Exit;
  end;

  // Find min/max ordinal values in the enum
  if Length(LEnumEntry.EnumType.Values) = 0 then
  begin
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_IR_TYPE_BUILD, RSIREnumNoValues, [AEnumTypeName]);
    Exit;
  end;

  LMinOrd := LEnumEntry.EnumType.Values[0].OrdinalValue;
  LMaxOrd := LMinOrd;
  for LI := 1 to System.High(LEnumEntry.EnumType.Values) do
  begin
    if LEnumEntry.EnumType.Values[LI].OrdinalValue < LMinOrd then
      LMinOrd := LEnumEntry.EnumType.Values[LI].OrdinalValue;
    if LEnumEntry.EnumType.Values[LI].OrdinalValue > LMaxOrd then
      LMaxOrd := LEnumEntry.EnumType.Values[LI].OrdinalValue;
  end;

  LSpan := LMaxOrd - LMinOrd + 1;
  if LSpan > 64 then
  begin
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_IR_TYPE_BUILD, RSIREnumRangeTooLarge, [LSpan]);
    Exit;
  end;

  LEntry := Default(TMyrIRTypeEntry);
  LEntry.Kind := tkSet;
  LEntry.SetType.TypeName := AName;
  LEntry.SetType.LowBound := LMinOrd;
  LEntry.SetType.HighBound := LMaxOrd;
  LEntry.SetType.BaseType := TMyrTypeRef.FromComposite(LEnumIndex);

  // On x86-64, all register-sized values need 8-byte stack slots.
  LEntry.SetType.StorageSize := 8;

  FTypes.Add(LEntry);
end;

function TMyrIR.FindType(const AName: string): Integer;
var
  LI: Integer;
  LEntry: TMyrIRTypeEntry;
begin
  for LI := 0 to FTypes.Count - 1 do
  begin
    LEntry := FTypes[LI];
    // Myrissa is CASE-SENSITIVE, so type names compare exactly. SameText here
    // would merge `Point` and `POINT` onto whichever was registered first.
    case LEntry.Kind of
      tkRecord:     if LEntry.RecordType.TypeName = AName then Exit(LI);
      tkUnion:      if LEntry.UnionType.TypeName = AName then Exit(LI);
      tkFixedArray: if LEntry.FixedArrayType.TypeName = AName then Exit(LI);
      tkDynArray:   if LEntry.DynArrayType.TypeName = AName then Exit(LI);
      tkEnum:       if LEntry.EnumType.TypeName = AName then Exit(LI);
      tkAlias:      if LEntry.AliasType.TypeName = AName then Exit(LI);
      tkPointer:    if LEntry.PointerType.TypeName = AName then Exit(LI);
      tkRoutine:    if LEntry.RoutineType.TypeName = AName then Exit(LI);
      tkSet:        if LEntry.SetType.TypeName = AName then Exit(LI);
    end;
  end;
  Result := -1;
end;

function TMyrIR.GetTypeSize(const ATypeRef: TMyrTypeRef): Integer;
var
  LEntry: TMyrIRTypeEntry;
begin
  if ATypeRef.IsPrimitive then
    Exit(GetPrimitiveSize(ATypeRef.Primitive));

  if (ATypeRef.TypeIndex < 0) or (ATypeRef.TypeIndex >= FTypes.Count) then
    Exit(0);

  LEntry := FTypes[ATypeRef.TypeIndex];
  case LEntry.Kind of
    tkRecord:
      begin
        if not LEntry.RecordType.IsFinalized then
          FinalizeRecordLayout(ATypeRef.TypeIndex);
        Result := FTypes[ATypeRef.TypeIndex].RecordType.TotalSize;
      end;
    tkUnion:
      begin
        if not LEntry.UnionType.IsFinalized then
          FinalizeUnionLayout(ATypeRef.TypeIndex);
        Result := FTypes[ATypeRef.TypeIndex].UnionType.TotalSize;
      end;
    tkFixedArray:
      Result := LEntry.FixedArrayType.TotalSize;
    tkDynArray:
      Result := 8;  // Pointer size
    tkEnum:
      Result := GetPrimitiveSize(LEntry.EnumType.BaseType);
    tkAlias:
      Result := GetTypeSize(LEntry.AliasType.AliasedType);
    tkPointer:
      Result := 8;  // Pointer size on Win64
    tkRoutine:
      Result := 8;  // Function pointer size on Win64
    tkSet:
      Result := LEntry.SetType.StorageSize;
  else
    Result := 0;
  end;
end;

function TMyrIR.GetTypeAlignment(const ATypeRef: TMyrTypeRef): Integer;
var
  LEntry: TMyrIRTypeEntry;
begin
  if ATypeRef.IsPrimitive then
    Exit(GetPrimitiveAlignment(ATypeRef.Primitive));

  if (ATypeRef.TypeIndex < 0) or (ATypeRef.TypeIndex >= FTypes.Count) then
    Exit(1);

  LEntry := FTypes[ATypeRef.TypeIndex];
  case LEntry.Kind of
    tkRecord:
      begin
        if not LEntry.RecordType.IsFinalized then
          FinalizeRecordLayout(ATypeRef.TypeIndex);
        Result := FTypes[ATypeRef.TypeIndex].RecordType.Alignment;
      end;
    tkUnion:
      begin
        if not LEntry.UnionType.IsFinalized then
          FinalizeUnionLayout(ATypeRef.TypeIndex);
        Result := FTypes[ATypeRef.TypeIndex].UnionType.Alignment;
      end;
    tkFixedArray:
      Result := GetTypeAlignment(LEntry.FixedArrayType.ElementType);
    tkDynArray:
      Result := 8;  // Pointer alignment
    tkEnum:
      Result := GetPrimitiveAlignment(LEntry.EnumType.BaseType);
    tkAlias:
      Result := GetTypeAlignment(LEntry.AliasType.AliasedType);
    tkPointer:
      Result := 8;  // Pointer alignment on Win64
    tkRoutine:
      Result := 8;  // Function pointer alignment on Win64
    tkSet:
      Result := LEntry.SetType.StorageSize;  // Alignment matches storage size
  else
    Result := 1;
  end;
end;

function TMyrIR.TypeRef(const AName: string): TMyrTypeRef;
var
  LIndex: Integer;
begin
  LIndex := FindType(AName);
  if LIndex >= 0 then
    Result := TMyrTypeRef.FromComposite(LIndex)
  else
    Result := TMyrTypeRef.None();
end;

function TMyrIR.GetTypeCount(): Integer;
begin
  Result := FTypes.Count;
end;

function TMyrIR.GetTypeEntry(const AIndex: Integer): TMyrIRTypeEntry;
begin
  Result := FTypes[AIndex];
end;

function TMyrIR.IsStringType(const ATypeRef: TMyrTypeRef): Boolean;
var
  LEntry: TMyrIRTypeEntry;
  LTypeName: string;
begin
  Result := False;

  // Primitives are never string types
  if ATypeRef.IsPrimitive then
    Exit;

  // Check composite type
  if (ATypeRef.TypeIndex < 0) or (ATypeRef.TypeIndex >= FTypes.Count) then
    Exit;

  LEntry := FTypes[ATypeRef.TypeIndex];

  // Get the type name based on kind
  case LEntry.Kind of
    TMyrIRTypeKind.tkRecord:
      LTypeName := LEntry.RecordType.TypeName;
    TMyrIRTypeKind.tkPointer:
      LTypeName := LEntry.PointerType.TypeName;
    TMyrIRTypeKind.tkAlias:
      begin
        LTypeName := LEntry.AliasType.TypeName;
        // Also check if aliased type is string
        if not SameText(LTypeName, 'string') then
          Result := IsStringType(LEntry.AliasType.AliasedType);
        Exit;
      end;
  else
    Exit;
  end;

  Result := SameText(LTypeName, 'string');
end;

function TMyrIR.IsDynArrayType(const ATypeRef: TMyrTypeRef): Boolean;
var
  LEntry: TMyrIRTypeEntry;
begin
  Result := False;

  // Primitives are never dynamic arrays
  if ATypeRef.IsPrimitive then
    Exit;

  if (ATypeRef.TypeIndex < 0) or (ATypeRef.TypeIndex >= FTypes.Count) then
    Exit;

  LEntry := FTypes[ATypeRef.TypeIndex];

  // An alias wraps the real kind, so unwrap and re-dispatch. A declaration of
  // the form `type TNames = array of string` reaches here as tkAlias, never as
  // tkDynArray, so testing Kind alone would miss every named dynarray type.
  if LEntry.Kind = TMyrIRTypeKind.tkAlias then
  begin
    Result := IsDynArrayType(LEntry.AliasType.AliasedType);
    Exit;
  end;

  Result := LEntry.Kind = TMyrIRTypeKind.tkDynArray;
end;

function TMyrIR.IsWStringType(const ATypeRef: TMyrTypeRef): Boolean;
var
  LEntry: TMyrIRTypeEntry;
  LTypeName: string;
begin
  Result := False;

  // Primitives are never wstring types
  if ATypeRef.IsPrimitive then
    Exit;

  // Check composite type
  if (ATypeRef.TypeIndex < 0) or (ATypeRef.TypeIndex >= FTypes.Count) then
    Exit;

  LEntry := FTypes[ATypeRef.TypeIndex];

  // Get the type name based on kind
  case LEntry.Kind of
    TMyrIRTypeKind.tkRecord:
      LTypeName := LEntry.RecordType.TypeName;
    TMyrIRTypeKind.tkPointer:
      LTypeName := LEntry.PointerType.TypeName;
    TMyrIRTypeKind.tkAlias:
      begin
        LTypeName := LEntry.AliasType.TypeName;
        if not SameText(LTypeName, 'wstring') then
          Result := IsWStringType(LEntry.AliasType.AliasedType);
        Exit;
      end;
  else
    Exit;
  end;

  Result := SameText(LTypeName, 'wstring');
end;

function TMyrIR.IsManagedType(const ATypeRef: TMyrTypeRef): Boolean;
var
  LEntry: TMyrIRTypeEntry;
  LI: Integer;
begin
  // A managed type is any type that contains string references and thus
  // requires cleanup (release) when going out of scope.

  // Check if it's directly a string type
  if IsStringType(ATypeRef) then
    Exit(True);

  // Check if it's directly a wstring type (raw PWideChar, needs FreeMem)
  if IsWStringType(ATypeRef) then
    Exit(True);

  Result := False;

  // Primitives are never managed (strings are handled above via IsStringType)
  if ATypeRef.IsPrimitive then
    Exit;

  if (ATypeRef.TypeIndex < 0) or (ATypeRef.TypeIndex >= FTypes.Count) then
    Exit;

  LEntry := FTypes[ATypeRef.TypeIndex];

  case LEntry.Kind of
    tkFixedArray:
      // Array is managed if its element type is managed
      Result := IsManagedType(LEntry.FixedArrayType.ElementType);

    tkDynArray:
      // Dynamic arrays are always managed (the pointer itself needs freeing,
      // and elements may contain strings)
      Result := True;

    tkRecord:
      begin
        // Record is managed if any field is managed
        for LI := 0 to System.High(LEntry.RecordType.Fields) do
        begin
          if IsManagedType(LEntry.RecordType.Fields[LI].FieldType) then
            Exit(True);
        end;
      end;

    tkUnion:
      begin
        // Union is managed if any variant is managed
        for LI := 0 to System.High(LEntry.UnionType.Fields) do
        begin
          if IsManagedType(LEntry.UnionType.Fields[LI].FieldType) then
            Exit(True);
        end;
      end;

    tkAlias:
      Result := IsManagedType(LEntry.AliasType.AliasedType);
  end;
end;

function TMyrIR.Import(
  const ADllName: string;
  const AFuncName: string;
  const AParams: array of TMyrValueType;
  const AReturn: TMyrValueType;
  const AVarArgs: Boolean;
  const ALinkage: TMyrLinkage
): TMyrIR;
var
  LImport: TMyrIRImport;
  LI: Integer;
  LJ: Integer;
  LMatch: Boolean;
begin
  Result := Self;

  // Check for duplicate - skip if already imported
  // Must compare param types too (overloaded imports have same name)
  for LI := 0 to FImports.Count - 1 do
  begin
    if SameText(FImports[LI].DllName, ADllName) and
       (FImports[LI].FuncName = AFuncName) then
    begin
      // Same name — check if param signature also matches
      if Length(FImports[LI].ParamTypes) = Length(AParams) then
      begin
        LMatch := True;
        for LJ := 0 to Length(AParams) - 1 do
        begin
          if FImports[LI].ParamTypes[LJ] <> AParams[LJ] then
          begin
            LMatch := False;
            Break;
          end;
        end;
        if LMatch then
          Exit;  // Exact duplicate — skip
      end;
      // Same name but different params — not a duplicate, continue
    end;
  end;

  LImport := Default(TMyrIRImport);
  LImport.DllName := ADllName;
  LImport.FuncName := AFuncName;
  LImport.ReturnType := AReturn;
  LImport.IsVarArgs := AVarArgs;
  LImport.Linkage := ALinkage;

  SetLength(LImport.ParamTypes, Length(AParams));
  for LI := 0 to System.High(AParams) do
    LImport.ParamTypes[LI] := AParams[LI];

  FImports.Add(LImport);
end;

function TMyrIR.Import(
  const ADllName: string;
  const AFuncName: string;
  const AExternalName: string;
  const AParams: array of TMyrValueType;
  const AReturn: TMyrValueType;
  const AVarArgs: Boolean;
  const ALinkage: TMyrLinkage
): TMyrIR;
var
  LImport: TMyrIRImport;
  LI: Integer;
begin
  Result := Self;

  // Duplicate check on the referenced (derived) name only -- derived names
  // are unique by construction.
  for LI := 0 to FImports.Count - 1 do
  begin
    if SameText(FImports[LI].DllName, ADllName) and
       (FImports[LI].FuncName = AFuncName) then
      Exit;
  end;

  LImport := Default(TMyrIRImport);
  LImport.DllName := ADllName;
  LImport.FuncName := AFuncName;
  LImport.ExternalName := AExternalName;
  LImport.ReturnType := AReturn;
  LImport.IsVarArgs := AVarArgs;
  LImport.Linkage := ALinkage;

  SetLength(LImport.ParamTypes, Length(AParams));
  for LI := 0 to System.High(AParams) do
    LImport.ParamTypes[LI] := AParams[LI];

  FImports.Add(LImport);
end;

function TMyrIR.SetImportReturnType(const AFuncName: string; const ATypeName: string): TMyrIR;
var
  LIndex: Integer;
  LTypeIndex: Integer;
  LImport: TMyrIRImport;
begin
  Result := Self;

  LIndex := FindImport(AFuncName);
  if LIndex < 0 then
    Exit;  // Caller declares the import immediately before this; nothing to annotate

  LTypeIndex := FindType(ATypeName);
  if LTypeIndex < 0 then
  begin
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_IR_UNKNOWN_TYPE, RSIRUnknownType, [ATypeName]);
    Exit;
  end;

  LImport := FImports[LIndex];
  LImport.ReturnTypeRef := TMyrTypeRef.FromComposite(LTypeIndex);
  LImport.HasReturnTypeRef := True;
  FImports[LIndex] := LImport;
end;

function TMyrIR.ImportLib(
  const ALibName: string;
  const AFuncName: string;
  const AParams: array of TMyrValueType;
  const AReturn: TMyrValueType;
  const AVarArgs: Boolean;
  const ALinkage: TMyrLinkage
): TMyrIR;
var
  LImport: TMyrIRImport;
  LI: Integer;
  LJ: Integer;
  LMatch: Boolean;
begin
  Result := Self;

  // Check for duplicate - skip if already imported
  // Must compare param types too, not just name (overloaded imports have same name)
  for LI := 0 to FImports.Count - 1 do
  begin
    if FImports[LI].IsStatic and
       SameText(FImports[LI].DllName, ALibName) and
       (FImports[LI].FuncName = AFuncName) then
    begin
      // Same name — check if param signature also matches
      if Length(FImports[LI].ParamTypes) = Length(AParams) then
      begin
        LMatch := True;
        for LJ := 0 to Length(AParams) - 1 do
        begin
          if FImports[LI].ParamTypes[LJ] <> AParams[LJ] then
          begin
            LMatch := False;
            Break;
          end;
        end;
        if LMatch then
          Exit;  // Exact duplicate — skip
      end;
      // Same name but different params — not a duplicate, continue
    end;
  end;

  LImport := Default(TMyrIRImport);
  LImport.DllName := ALibName;
  LImport.FuncName := AFuncName;
  LImport.ReturnType := AReturn;
  LImport.IsVarArgs := AVarArgs;
  LImport.IsStatic := True;
  LImport.Linkage := ALinkage;

  SetLength(LImport.ParamTypes, Length(AParams));
  for LI := 0 to System.High(AParams) do
    LImport.ParamTypes[LI] := AParams[LI];

  FImports.Add(LImport);
end;

function TMyrIR.ImportHost(
  const AFuncName: string;
  const AHostAddr: Pointer;
  const AParams: array of TMyrValueType;
  const AReturn: TMyrValueType
): TMyrIR;
var
  LImport: TMyrIRImport;
  LI: Integer;
begin
  Result := Self;

  LImport := Default(TMyrIRImport);
  LImport.DllName := '';
  LImport.FuncName := AFuncName;
  LImport.ReturnType := AReturn;
  LImport.IsVarArgs := False;
  LImport.IsStatic := False;
  LImport.Linkage := plC;
  LImport.HostAddr := AHostAddr;

  SetLength(LImport.ParamTypes, Length(AParams));
  for LI := 0 to System.High(AParams) do
    LImport.ParamTypes[LI] := AParams[LI];

  FImports.Add(LImport);
end;

function TMyrIR.ImportHost(
  const AFuncName: string;
  const AHostAddr: Pointer;
  const AParamTypeNames: array of string;
  const AReturn: TMyrValueType
): TMyrIR;
var
  LImport: TMyrIRImport;
  LI: Integer;
  LTypeIndex: Integer;
  LName: string;
begin
  Result := Self;

  LImport := Default(TMyrIRImport);
  LImport.DllName := '';
  LImport.FuncName := AFuncName;
  LImport.ReturnType := AReturn;
  LImport.IsVarArgs := False;
  LImport.IsStatic := False;
  LImport.Linkage := plC;
  LImport.HostAddr := AHostAddr;

  // Resolve each param type name to a TMyrTypeRef
  SetLength(LImport.ParamTypes, Length(AParamTypeNames));
  SetLength(LImport.ParamTypeRefs, Length(AParamTypeNames));
  SetLength(LImport.ParamTypeNames, Length(AParamTypeNames));
  for LI := 0 to Length(AParamTypeNames) - 1 do
  begin
    LImport.ParamTypeNames[LI] := AParamTypeNames[LI];
    LName := AParamTypeNames[LI].ToLower();
    if LName = 'int8' then
    begin
      LImport.ParamTypes[LI] := cvtInt8;
      LImport.ParamTypeRefs[LI] := TMyrTypeRef.FromPrimitive(cvtInt8);
    end
    else if LName = 'int16' then
    begin
      LImport.ParamTypes[LI] := cvtInt16;
      LImport.ParamTypeRefs[LI] := TMyrTypeRef.FromPrimitive(cvtInt16);
    end
    else if LName = 'int32' then
    begin
      LImport.ParamTypes[LI] := cvtInt32;
      LImport.ParamTypeRefs[LI] := TMyrTypeRef.FromPrimitive(cvtInt32);
    end
    else if LName = 'int64' then
    begin
      LImport.ParamTypes[LI] := cvtInt64;
      LImport.ParamTypeRefs[LI] := TMyrTypeRef.FromPrimitive(cvtInt64);
    end
    else if LName = 'uint8' then
    begin
      LImport.ParamTypes[LI] := cvtUInt8;
      LImport.ParamTypeRefs[LI] := TMyrTypeRef.FromPrimitive(cvtUInt8);
    end
    else if LName = 'uint16' then
    begin
      LImport.ParamTypes[LI] := cvtUInt16;
      LImport.ParamTypeRefs[LI] := TMyrTypeRef.FromPrimitive(cvtUInt16);
    end
    else if LName = 'uint32' then
    begin
      LImport.ParamTypes[LI] := cvtUInt32;
      LImport.ParamTypeRefs[LI] := TMyrTypeRef.FromPrimitive(cvtUInt32);
    end
    else if LName = 'uint64' then
    begin
      LImport.ParamTypes[LI] := cvtUInt64;
      LImport.ParamTypeRefs[LI] := TMyrTypeRef.FromPrimitive(cvtUInt64);
    end
    else if LName = 'float32' then
    begin
      LImport.ParamTypes[LI] := cvtFloat32;
      LImport.ParamTypeRefs[LI] := TMyrTypeRef.FromPrimitive(cvtFloat32);
    end
    else if LName = 'float64' then
    begin
      LImport.ParamTypes[LI] := cvtFloat64;
      LImport.ParamTypeRefs[LI] := TMyrTypeRef.FromPrimitive(cvtFloat64);
    end
    else if (LName = 'pointer') or (LName = 'ptr') then
    begin
      LImport.ParamTypes[LI] := cvtPointer;
      LImport.ParamTypeRefs[LI] := TMyrTypeRef.FromPrimitive(cvtPointer);
    end
    else if LName = 'void' then
    begin
      LImport.ParamTypes[LI] := cvtVoid;
      LImport.ParamTypeRefs[LI] := TMyrTypeRef.FromPrimitive(cvtVoid);
    end
    else
    begin
      // Composite type — try type registry, defer if not found yet
      LTypeIndex := FindType(AParamTypeNames[LI]);
      if LTypeIndex >= 0 then
      begin
        LImport.ParamTypes[LI] := cvtVoid;  // Marker: not a simple primitive
        LImport.ParamTypeRefs[LI] := TMyrTypeRef.FromComposite(LTypeIndex);
      end
      else
      begin
        // Type not defined yet — will be resolved after script types are emitted
        LImport.ParamTypes[LI] := cvtVoid;
        LImport.ParamTypeRefs[LI] := TMyrTypeRef.None();
      end;
    end;
  end;

  FImports.Add(LImport);
end;

function TMyrIR.Global(const AName: string; const AType: TMyrValueType; const AIsPublic: Boolean): TMyrIR;
var
  LGlobal: TMyrIRGlobal;
begin
  LGlobal := Default(TMyrIRGlobal);
  LGlobal.GlobalName := AName;
  LGlobal.GlobalType := AType;
  LGlobal.GlobalTypeRef := TMyrTypeRef.FromPrimitive(AType);
  LGlobal.InitExpr := -1;  // Uninitialized
  LGlobal.IsPublic := AIsPublic;
  LGlobal.ImportIndex := -1;

  FGlobals.Add(LGlobal);
  Result := Self;
end;

function TMyrIR.Global(const AName: string; const AType: TMyrValueType; const AInit: TMyrIRExpr; const AIsPublic: Boolean): TMyrIR;
var
  LGlobal: TMyrIRGlobal;
begin
  LGlobal := Default(TMyrIRGlobal);
  LGlobal.GlobalName := AName;
  LGlobal.GlobalType := AType;
  LGlobal.GlobalTypeRef := TMyrTypeRef.FromPrimitive(AType);
  LGlobal.InitExpr := AInit.Index;
  LGlobal.IsPublic := AIsPublic;
  LGlobal.ImportIndex := -1;

  FGlobals.Add(LGlobal);
  Result := Self;
end;

function TMyrIR.Global(const AName: string; const ATypeRef: TMyrTypeRef; const AIsPublic: Boolean): TMyrIR;
var
  LGlobal: TMyrIRGlobal;
begin
  LGlobal := Default(TMyrIRGlobal);
  LGlobal.GlobalName := AName;
  LGlobal.GlobalType := cvtPointer;  // Managed types are pointers
  LGlobal.GlobalTypeRef := ATypeRef;
  LGlobal.InitExpr := -1;  // Uninitialized
  LGlobal.IsPublic := AIsPublic;
  LGlobal.ImportIndex := -1;

  FGlobals.Add(LGlobal);
  Result := Self;
end;

function TMyrIR.Global(const AName: string; const ATypeName: string; const AIsPublic: Boolean): TMyrIR;
var
  LGlobal: TMyrIRGlobal;
  LTypeIndex: Integer;
begin
  Result := Self;

  LTypeIndex := FindType(ATypeName);
  if LTypeIndex < 0 then
  begin
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_IR_UNKNOWN_TYPE, RSIRUnknownType, [ATypeName]);
    Exit;
  end;

  LGlobal := Default(TMyrIRGlobal);
  LGlobal.GlobalName := AName;
  LGlobal.GlobalType := cvtPointer;  // Managed/composite types are pointers
  LGlobal.GlobalTypeRef := TMyrTypeRef.FromComposite(LTypeIndex);
  LGlobal.InitExpr := -1;  // Uninitialized
  LGlobal.IsPublic := AIsPublic;
  LGlobal.ImportIndex := -1;

  FGlobals.Add(LGlobal);
end;

function TMyrIR.ImportGlobal(const AName, ADllName, AExternalName: string;
  const AType: TMyrValueType): TMyrIR;
var
  LGlobal: TMyrIRGlobal;
  LImport: TMyrIRImport;
  LImportIndex: Integer;
begin
  Result := Self;

  // Register an IR-level import for this data symbol (no params, void return)
  LImport := Default(TMyrIRImport);
  LImport.DllName := ADllName;
  LImport.FuncName := AExternalName;
  LImport.ReturnType := cvtVoid;

  LImportIndex := FImports.Count;
  FImports.Add(LImport);

  LGlobal := Default(TMyrIRGlobal);
  LGlobal.GlobalName := AName;
  LGlobal.GlobalType := AType;
  LGlobal.GlobalTypeRef := TMyrTypeRef.FromPrimitive(AType);
  LGlobal.InitExpr := -1;
  LGlobal.IsPublic := False;
  LGlobal.ImportIndex := LImportIndex;

  FGlobals.Add(LGlobal);
end;

function TMyrIR.ImportLibGlobal(const AName, ALibName, AExternalName: string;
  const AType: TMyrValueType): TMyrIR;
var
  LGlobal: TMyrIRGlobal;
  LImport: TMyrIRImport;
  LImportIndex: Integer;
begin
  Result := Self;

  // Static-lib data symbol: same import record as ImportLib, resolved by the
  // linker against the archive's .data and bound as LEA r64,[RIP+data].
  LImport := Default(TMyrIRImport);
  LImport.DllName := ALibName;
  LImport.FuncName := AExternalName;
  LImport.ReturnType := cvtVoid;
  LImport.IsStatic := True;
  LImport.Linkage := plC;

  LImportIndex := FImports.Count;
  FImports.Add(LImport);

  LGlobal := Default(TMyrIRGlobal);
  LGlobal.GlobalName := AName;
  LGlobal.GlobalType := AType;
  LGlobal.GlobalTypeRef := TMyrTypeRef.FromPrimitive(AType);
  LGlobal.InitExpr := -1;
  LGlobal.IsPublic := False;
  LGlobal.ImportIndex := LImportIndex;

  FGlobals.Add(LGlobal);
end;

function TMyrIR.Func(
  const AName: string;
  const AReturnType: TMyrValueType;
  const AIsEntryPoint: Boolean;
  const ALinkage: TMyrLinkage;
  const AIsPublic: Boolean
): TMyrIR;
var
  LFunc: TMyrIRFunc;
begin
  LFunc := Default(TMyrIRFunc);
  LFunc.FuncName := AName;
  LFunc.ReturnType := AReturnType;
  LFunc.ReturnTypeRef := TMyrTypeRef.FromPrimitive(AReturnType);
  LFunc.IsEntryPoint := AIsEntryPoint;
  LFunc.IsDllEntry := False;
  LFunc.IsPublic := AIsPublic;
  LFunc.Linkage := ALinkage;
  LFunc.IsVariadic := False;
  LFunc.Vars := TList<TMyrIRVar>.Create();
  LFunc.Stmts := TList<TMyrIRStmt>.Create();

  FCurrentFunc := FFunctions.Count;
  FFunctions.Add(LFunc);
  Result := Self;
end;

function TMyrIR.OverloadFunc(
  const AName: string;
  const AReturnType: TMyrValueType;
  const AIsEntryPoint: Boolean;
  const AIsPublic: Boolean
): TMyrIR;
var
  LFunc: TMyrIRFunc;
  LI: Integer;
begin
  Result := Self;

  // Validate: existing function(s) with same name must not have C linkage
  for LI := 0 to FFunctions.Count - 1 do
  begin
    if (FFunctions[LI].FuncName = AName) then
    begin
      if FFunctions[LI].Linkage = plC then
      begin
        if Assigned(FErrors) then
          FErrors.Add(esError, MYR_ERR_IR_OVERLOAD_C_LINKAGE,
            RSIROverloadCLinkage, [AName]);
        Exit;
      end;
    end;
  end;

  // Create function with forced C++ linkage
  LFunc := Default(TMyrIRFunc);
  LFunc.FuncName := AName;
  LFunc.ReturnType := AReturnType;
  LFunc.ReturnTypeRef := TMyrTypeRef.FromPrimitive(AReturnType);
  LFunc.IsEntryPoint := AIsEntryPoint;
  LFunc.IsDllEntry := False;
  LFunc.IsPublic := AIsPublic;
  LFunc.Linkage := plCPP;  // C++ linkage - forced, no parameter
  LFunc.IsVariadic := False;
  LFunc.Vars := TList<TMyrIRVar>.Create();
  LFunc.Stmts := TList<TMyrIRStmt>.Create();

  FCurrentFunc := FFunctions.Count;
  FFunctions.Add(LFunc);
end;

function TMyrIR.VariadicFunc(
  const AName: string;
  const AReturnType: TMyrValueType;
  const AIsEntryPoint: Boolean;
  const AIsPublic: Boolean
): TMyrIR;
var
  LFunc: TMyrIRFunc;
  LI: Integer;
begin
  Result := Self;

  // Validate: no existing function with same name (variadics cannot be overloaded)
  for LI := 0 to FFunctions.Count - 1 do
  begin
    if (FFunctions[LI].FuncName = AName) then
    begin
      if Assigned(FErrors) then
        FErrors.Add(esError, MYR_ERR_IR_VARIADIC_OVERLOAD,
            RSIRVariadicOverload, [AName]);
      Exit;
    end;
  end;

  // Create variadic function
  LFunc := Default(TMyrIRFunc);
  LFunc.FuncName := AName;
  LFunc.ReturnType := AReturnType;
  LFunc.ReturnTypeRef := TMyrTypeRef.FromPrimitive(AReturnType);
  LFunc.IsEntryPoint := AIsEntryPoint;
  LFunc.IsDllEntry := False;
  LFunc.IsPublic := AIsPublic;
  LFunc.Linkage := plC;  // Variadic uses C-style linkage (no mangling)
  LFunc.IsVariadic := True;
  LFunc.Vars := TList<TMyrIRVar>.Create();
  LFunc.Stmts := TList<TMyrIRStmt>.Create();

  FCurrentFunc := FFunctions.Count;
  FFunctions.Add(LFunc);
end;

function TMyrIR.DllMain(): TMyrIR;
var
  LFunc: TMyrIRFunc;
begin
  // DllMain signature: (HINSTANCE, DWORD, LPVOID) -> BOOL
  // In our types: (vtPointer, vtUInt32, vtPointer) -> vtInt32
  LFunc := Default(TMyrIRFunc);
  LFunc.FuncName := 'DllMain';
  LFunc.ReturnType := cvtInt32;  // BOOL
  LFunc.ReturnTypeRef := TMyrTypeRef.FromPrimitive(cvtInt32);
  LFunc.IsEntryPoint := False;  // Not the EXE entry point
  LFunc.IsDllEntry := True;     // This IS the DLL entry point
  LFunc.IsPublic := False;      // Not exported (OS calls it directly)
  LFunc.Linkage := plC;         // C linkage
  LFunc.IsVariadic := False;
  LFunc.Vars := TList<TMyrIRVar>.Create();
  LFunc.Stmts := TList<TMyrIRStmt>.Create();

  FCurrentFunc := FFunctions.Count;
  FFunctions.Add(LFunc);

  // Add standard DllMain parameters
  Param('hinstDLL', cvtPointer);   // HINSTANCE
  Param('fdwReason', cvtUInt32);   // DWORD
  Param('lpvReserved', cvtPointer); // LPVOID

  Result := Self;
end;

function TMyrIR.Param(const AName: string; const AType: TMyrValueType; const AByRef: Boolean): TMyrIR;
var
  LVar: TMyrIRVar;
  LFunc: TMyrIRFunc;
  LLen: Integer;
begin
  LFunc := GetCurrentFunc();

  LVar := Default(TMyrIRVar);
  LVar.VarName := AName;
  LVar.VarTypeRef := TMyrTypeRef.FromPrimitive(AType);
  LVar.IsParam := True;
  LVar.IsByRef := AByRef;

  LFunc.Vars.Add(LVar);

  // Track param types for mangling
  LLen := Length(LFunc.ParamTypes);
  SetLength(LFunc.ParamTypes, LLen + 1);
  LFunc.ParamTypes[LLen] := AType;

  FFunctions[FCurrentFunc] := LFunc;
  Result := Self;
end;

function TMyrIR.Param(const AName: string; const ATypeName: string; const AByRef: Boolean): TMyrIR;
var
  LVar: TMyrIRVar;
  LFunc: TMyrIRFunc;
  LTypeIndex: Integer;
begin
  Result := Self;
  LFunc := GetCurrentFunc();

  LTypeIndex := FindType(ATypeName);
  if LTypeIndex < 0 then
  begin
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_IR_UNKNOWN_TYPE, RSIRUnknownType, [ATypeName]);
    Exit;
  end;

  LVar := Default(TMyrIRVar);
  LVar.VarName := AName;
  LVar.VarTypeRef := TMyrTypeRef.FromComposite(LTypeIndex);
  LVar.IsParam := True;
  LVar.IsByRef := AByRef;

  LFunc.Vars.Add(LVar);
  FFunctions[FCurrentFunc] := LFunc;
end;

function TMyrIR.Returns(const ATypeName: string): TMyrIR;
var
  LFunc: TMyrIRFunc;
  LTypeIndex: Integer;
begin
  Result := Self;
  LFunc := GetCurrentFunc();

  LTypeIndex := FindType(ATypeName);
  if LTypeIndex < 0 then
  begin
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_IR_UNKNOWN_TYPE, RSIRUnknownType, [ATypeName]);
    Exit;
  end;

  // Set return type to pointer (large structs are returned via hidden pointer)
  LFunc.ReturnType := cvtPointer;
  LFunc.ReturnTypeRef := TMyrTypeRef.FromComposite(LTypeIndex);
  // ReturnSize is the AGGREGATE return size. > 8 selects the hidden-return-
  // pointer convention downstream (the C ABI rule at clink boundaries);
  // <= 8 returns packed in RAX. Pointer-slot composites (string, wstring,
  // dynarray, pointer, routine) return in RAX like any scalar: size 0.
  if FTypes[LTypeIndex].Kind in [tkRecord, tkUnion, tkFixedArray] then
  begin
    LFunc.ReturnSize := GetTypeSize(TMyrTypeRef.FromComposite(LTypeIndex));
    LFunc.ReturnAlignment := GetTypeAlignment(TMyrTypeRef.FromComposite(LTypeIndex));
  end
  else
  begin
    LFunc.ReturnSize := 0;
    LFunc.ReturnAlignment := 0;
  end;
  FFunctions[FCurrentFunc] := LFunc;
end;

