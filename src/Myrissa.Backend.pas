begin
  Result := 0;
  for LI := 0 to FObjects.Count - 1 do
  begin
    if FObjects[LI].Selected then
      Inc(Result);
  end;
end;

{ TMyrELFObjFile }
constructor TMyrELFObjFile.Create();
begin
  inherited Create();
  Sections := nil;
  Symbols := nil;
  Relas := nil;
  Selected := False;
end;

destructor TMyrELFObjFile.Destroy();
begin
  Sections := nil;
  Symbols := nil;
  Relas := nil;
  inherited Destroy();
end;

{ TMyrELFLinker }
constructor TMyrELFLinker.Create();
begin
  inherited Create();

  FObjects := TObjectList<TMyrELFObjFile>.Create(True);
  FSymbolIndex := TDictionary<string, TList<Integer>>.Create();

  FMergedText := TMemoryStream.Create();
  FMergedRData := TMemoryStream.Create();
  FMergedData := TMemoryStream.Create();

  FTextContribs := TList<TMyrLinkerContribution>.Create();
  FRDataContribs := TList<TMyrLinkerContribution>.Create();
  FDataContribs := TList<TMyrLinkerContribution>.Create();

  FResolvedSymbols := TDictionary<string, TMyrLinkerResolvedSymbol>.Create();
  FUnresolvedSymbols := TStringList.Create();
  FPendingRelocs := TList<TMyrLinkerPendingReloc>.Create();
end;

destructor TMyrELFLinker.Destroy();
var
  LPair: TPair<string, TList<Integer>>;
begin
  for LPair in FSymbolIndex do
    LPair.Value.Free();
  FSymbolIndex.Free();

  FPendingRelocs.Free();
  FUnresolvedSymbols.Free();
  FResolvedSymbols.Free();

  FDataContribs.Free();
  FRDataContribs.Free();
  FTextContribs.Free();

  FMergedData.Free();
  FMergedRData.Free();
  FMergedText.Free();

  FObjects.Free();

  inherited Destroy();
end;

function TMyrELFLinker.ReadStrZ(const AData: TBytes; const AOffset: Integer): string;
var
  LPos: Integer;
  LAnsi: AnsiString;
begin
  LAnsi := '';
  LPos := AOffset;
  while (LPos >= 0) and (LPos < Length(AData)) and (AData[LPos] <> 0) do
  begin
    LAnsi := LAnsi + AnsiChar(AData[LPos]);
    Inc(LPos);
  end;
  Result := string(LAnsi);
end;

function TMyrELFLinker.ParseELFObject(const AData: TBytes;
  const ASourcePath: string): TMyrELFObjFile;
var
  LObj: TMyrELFObjFile;
  LShOff: UInt64;
  LShNum: Word;
  LShEntSize: Word;
  LShStrNdx: Word;
  LI: Integer;
  LJ: Integer;
  LHdrOff: Integer;
  LShStrOff: UInt64;
  LSect: TMyrELFLinkSection;
  LNameOff: Cardinal;
  LDataOff: UInt64;
  LSymTabIdx: Integer;
  LStrTabIdx: Integer;
  LSymCount: Integer;
  LSym: TMyrELFLinkSymbol;
  LSymOff: Integer;
  LRelaCount: Integer;
  LRela: TMyrELFLinkRela;
  LRelaOff: Integer;
  LRelaList: TList<TMyrELFLinkRela>;
  LInfo: UInt64;
  LSectOffsets: TArray<UInt64>;
begin
  Result := nil;

  if Length(AData) < ELFLINK_EHDR_SIZE then
  begin
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_ELFLINK_TOO_SMALL,
        'ELF object too small: %s', [ASourcePath]);
    Status('ELF Linker: object too small: %s', [ASourcePath]);
    Exit;
  end;

  // Magic, class 64, machine, ET_REL
  if (AData[0] <> $7F) or (AData[1] <> Ord('E')) or
     (AData[2] <> Ord('L')) or (AData[3] <> Ord('F')) or (AData[4] <> 2) then
  begin
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_ELFLINK_BAD_MAGIC,
        'Not an ELF-64 object: %s', [ASourcePath]);
    Status('ELF Linker: bad ELF magic: %s', [ASourcePath]);
    Exit;
  end;
  if (PWord(@AData[18])^ <> ELFLINK_EM_X86_64) or
     (PWord(@AData[16])^ <> ELFLINK_ET_REL) then
  begin
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_ELFLINK_NOT_X86_64,
        'Not an x86-64 relocatable ELF object: %s', [ASourcePath]);
    Status('ELF Linker: not x86-64 ET_REL: %s', [ASourcePath]);
    Exit;
  end;

  LShOff := PUInt64(@AData[40])^;
  LShEntSize := PWord(@AData[58])^;
  LShNum := PWord(@AData[60])^;
  LShStrNdx := PWord(@AData[62])^;

  if (LShOff = 0) or (LShNum = 0) or (LShEntSize <> ELFLINK_SHDR_SIZE) then
  begin
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_ELFLINK_BAD_MAGIC,
        'ELF object has no usable section table: %s', [ASourcePath]);
    Status('ELF Linker: no section table: %s', [ASourcePath]);
    Exit;
  end;

  LObj := TMyrELFObjFile.Create();
  LObj.SourcePath := ASourcePath;

  // Section string table file offset (sh_offset of section LShStrNdx)
  LHdrOff := Integer(LShOff) + Integer(LShStrNdx) * ELFLINK_SHDR_SIZE;
  LShStrOff := PUInt64(@AData[LHdrOff + 24])^;

  // Parse section headers; remember each section's file offset for the
  // symbol/rela passes below.
  SetLength(LObj.Sections, LShNum);
  SetLength(LSectOffsets, LShNum);
  LSymTabIdx := -1;
  for LI := 0 to LShNum - 1 do
  begin
    LHdrOff := Integer(LShOff) + LI * ELFLINK_SHDR_SIZE;

    LNameOff := PCardinal(@AData[LHdrOff])^;
    LSect.SectionName := ReadStrZ(AData, Integer(LShStrOff) + Integer(LNameOff));
    LSect.ShType := PCardinal(@AData[LHdrOff + 4])^;
    LSect.Flags := PUInt64(@AData[LHdrOff + 8])^;
    LDataOff := PUInt64(@AData[LHdrOff + 24])^;
    LSect.DataSize := Cardinal(PUInt64(@AData[LHdrOff + 32])^);
    LSectOffsets[LI] := LDataOff;

    // Keep raw bytes for data-bearing sections only
    if (LSect.ShType <> SHT_NOBITS) and (LSect.DataSize > 0) and
       (LDataOff + LSect.DataSize <= UInt64(Length(AData))) then
    begin
      SetLength(LSect.RawData, LSect.DataSize);
      Move(AData[LDataOff], LSect.RawData[0], LSect.DataSize);
    end
    else
      LSect.RawData := nil;

    if (LSect.ShType = SHT_SYMTAB) and (LSymTabIdx < 0) then
      LSymTabIdx := LI;

    LObj.Sections[LI] := LSect;
  end;

  // Parse the symbol table (link field names the string table)
  if LSymTabIdx >= 0 then
  begin
    LHdrOff := Integer(LShOff) + LSymTabIdx * ELFLINK_SHDR_SIZE;
    LStrTabIdx := Integer(PCardinal(@AData[LHdrOff + 40])^);
    LSymCount := Integer(LObj.Sections[LSymTabIdx].DataSize) div ELFLINK_SYM_SIZE;

    SetLength(LObj.Symbols, LSymCount);
    for LI := 0 to LSymCount - 1 do
    begin
      LSymOff := Integer(LSectOffsets[LSymTabIdx]) + LI * ELFLINK_SYM_SIZE;
      LNameOff := PCardinal(@AData[LSymOff])^;
      if (LNameOff > 0) and (LStrTabIdx >= 0) and (LStrTabIdx < LShNum) then
        LSym.SymbolName := ReadStrZ(AData,
          Integer(LSectOffsets[LStrTabIdx]) + Integer(LNameOff))
      else
        LSym.SymbolName := '';
      LSym.Info := AData[LSymOff + 4];
      LSym.Shndx := PWord(@AData[LSymOff + 6])^;
      LSym.Value := PUInt64(@AData[LSymOff + 8])^;
      LSym.SymSize := PUInt64(@AData[LSymOff + 16])^;
      LObj.Symbols[LI] := LSym;
    end;
  end;

  // Parse every SHT_RELA section; sh_info names the section it applies to
  LRelaList := TList<TMyrELFLinkRela>.Create();
  try
    for LI := 0 to LShNum - 1 do
    begin
      if LObj.Sections[LI].ShType <> SHT_RELA then
        Continue;

      LHdrOff := Integer(LShOff) + LI * ELFLINK_SHDR_SIZE;
      LRela.TargetSection := Integer(PCardinal(@AData[LHdrOff + 44])^);
      LRelaCount := Integer(LObj.Sections[LI].DataSize) div ELFLINK_RELA_SIZE;

      for LJ := 0 to LRelaCount - 1 do
      begin
        LRelaOff := Integer(LSectOffsets[LI]) + LJ * ELFLINK_RELA_SIZE;
        LRela.RelaOffset := PUInt64(@AData[LRelaOff])^;
        LInfo := PUInt64(@AData[LRelaOff + 8])^;
        LRela.SymIndex := Cardinal(LInfo shr 32);
        LRela.RelType := Cardinal(LInfo and $FFFFFFFF);
        LRela.Addend := PInt64(@AData[LRelaOff + 16])^;
        LRelaList.Add(LRela);
      end;
    end;
    LObj.Relas := LRelaList.ToArray();
  finally
    LRelaList.Free();
  end;

  // Deferred static-lib dependencies: NUL-separated names in the
  // .note.myrissa.needlib section (ELF analogue of COFF /DEFAULTLIB)
  for LI := 0 to LShNum - 1 do
  begin
    if LObj.Sections[LI].SectionName = '.note.myrissa.needlib' then
    begin
      LObj.NeededLibs := ParseNeedLibNote(LObj.Sections[LI].RawData);
      Break;
    end;
  end;

  // Dynamic shared-object dependencies: symbol/library pairs in the
  // .note.myrissa.needdll section (ELF analogue of a COFF short-import)
  for LI := 0 to LShNum - 1 do
  begin
    if LObj.Sections[LI].SectionName = '.note.myrissa.needdll' then
    begin
      LObj.NeededDlls := ParseNeedDllNote(LObj.Sections[LI].RawData);
      Break;
    end;
  end;

  Result := LObj;
end;

function TMyrLinker.ParseNeedDllNote(const ARaw: TBytes): TArray<TMyrShortImportEntry>;
var
  LList: TList<TMyrShortImportEntry>;
  LEntry: TMyrShortImportEntry;
  LPos: Integer;

  function ReadNoteString(var APos: Integer): string;
  var
    LStart: Integer;
    LAnsi: AnsiString;
  begin
    Result := '';
    LStart := APos;
    while (APos < Length(ARaw)) and (ARaw[APos] <> 0) do
      Inc(APos);
    if APos > LStart then
    begin
      SetString(LAnsi, PAnsiChar(@ARaw[LStart]), APos - LStart);
      Result := string(LAnsi);
    end;
    Inc(APos); // skip NUL
  end;

begin
  // Triples of NUL-terminated strings: referenced symbol, exported symbol,
  // owning shared object -- as written by TMyrELFObjWriter. A trailing
  // incomplete triple is ignored.
  SetLength(Result, 0);
  if Length(ARaw) = 0 then
    Exit;

  LList := TList<TMyrShortImportEntry>.Create();
  try
    LPos := 0;
    while LPos < Length(ARaw) do
    begin
      LEntry := Default(TMyrShortImportEntry);
      LEntry.ReferencedName := ReadNoteString(LPos);
      if LPos >= Length(ARaw) then
        Break;
      LEntry.SymbolName := ReadNoteString(LPos);
      if LPos >= Length(ARaw) then
        Break;
      LEntry.DllName := ReadNoteString(LPos);
      if (LEntry.ReferencedName <> '') and (LEntry.SymbolName <> '') and
         (LEntry.DllName <> '') then
        LList.Add(LEntry);
    end;
    Result := LList.ToArray();
  finally
    LList.Free();
  end;
end;

function TMyrELFLinker.ParseNeedLibNote(const ARaw: TBytes): TArray<string>;
var
  LNames: TStringList;
  LPos: Integer;
  LStart: Integer;
  LAnsi: AnsiString;
begin
  // NUL-separated, NUL-terminated lib names as written by TMyrELFObjWriter.
  SetLength(Result, 0);
  if Length(ARaw) = 0 then
    Exit;

  LNames := TStringList.Create();
  try
    LNames.CaseSensitive := False;
    LNames.Duplicates := dupIgnore;
    LNames.Sorted := True;

    LPos := 0;
    while LPos < Length(ARaw) do
    begin
      LStart := LPos;
      while (LPos < Length(ARaw)) and (ARaw[LPos] <> 0) do
        Inc(LPos);
      if LPos > LStart then
      begin
        SetString(LAnsi, PAnsiChar(@ARaw[LStart]), LPos - LStart);
        LNames.Add(string(LAnsi));
      end;
      Inc(LPos); // skip NUL
    end;

    Result := LNames.ToStringArray();
  finally
    LNames.Free();
  end;
end;

procedure TMyrELFLinker.ParseARLibrary(const AData: TBytes;
  const ASourcePath: string; const ADebug: Boolean);
var
  LPos: Integer;
  LSig: AnsiString;
  LHeaderName: AnsiString;
  LHeaderSizeStr: AnsiString;
  LMemberSize: Cardinal;
  LMemberData: TBytes;
  LObj: TMyrELFObjFile;
  LIsLinkerMember: Boolean;
  LTrimmedName: string;
begin
  if Length(AData) < 8 then
  begin
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_ELFLINK_AR_TOO_SMALL,
        'Archive too small: %s', [ASourcePath]);
    Status('ELF Linker: archive too small: %s', [ASourcePath]);
    Exit;
  end;

  SetLength(LSig, 8);
  Move(AData[0], LSig[1], 8);
  if string(LSig) <> AR_SIGNATURE then
  begin
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_ELFLINK_AR_BAD_SIG,
        'Invalid archive signature: %s', [ASourcePath]);
    Status('ELF Linker: bad archive signature: %s', [ASourcePath]);
    Exit;
  end;

  LPos := 8;

  while LPos + AR_HEADER_SIZE <= Length(AData) do
  begin
    // 60-byte ar member header; verify end marker
    if (AData[LPos + 58] <> Ord('`')) or (AData[LPos + 59] <> 10) then
    begin
      Status('ELF Linker: invalid ar member header at offset %d: %s',
        [LPos, ASourcePath]);
      Break;
    end;

    SetLength(LHeaderName, 16);
    Move(AData[LPos], LHeaderName[1], 16);
    LHeaderName := AnsiString(TrimRight(string(LHeaderName)));

    SetLength(LHeaderSizeStr, 10);
    Move(AData[LPos + 48], LHeaderSizeStr[1], 10);
    LMemberSize := StrToIntDef(Trim(string(LHeaderSizeStr)), 0);

    LPos := LPos + AR_HEADER_SIZE;

    // '/' = symbol index, '//' = long-name table; both are skipped -- the
    // linker builds its own index from the members' symbol tables.
    LIsLinkerMember := (LHeaderName = '/') or (LHeaderName = '//');

    if (not LIsLinkerMember) and (LMemberSize >= ELFLINK_EHDR_SIZE) and
       (LPos + Integer(LMemberSize) <= Length(AData)) then
    begin
      SetLength(LMemberData, LMemberSize);
      Move(AData[LPos], LMemberData[0], LMemberSize);

      // Only parse members that look like ELF objects
      if (LMemberData[0] = $7F) and (LMemberData[1] = Ord('E')) then
      begin
        LObj := ParseELFObject(LMemberData, ASourcePath);
        if LObj <> nil then
        begin
          LTrimmedName := string(LHeaderName);
          if (Length(LTrimmedName) > 0) and
             (LTrimmedName[Length(LTrimmedName)] = '/') then
            LTrimmedName := Copy(LTrimmedName, 1, Length(LTrimmedName) - 1);
          LObj.MemberName := LTrimmedName;
          FObjects.Add(LObj);
        end;
      end;
    end;

    LPos := LPos + Integer(LMemberSize);
    if (LPos mod 2) <> 0 then
      Inc(LPos);
  end;

  Status(ADebug, 'ELF Linker: parsed archive %s -- %d object members',
    [ASourcePath, FObjects.Count]);
end;

function TMyrELFLinker.ClassifySection(const ASectionName: string): TMyrLinkerSectionKind;
begin
  if ASectionName = '.text' then
    Result := lskText
  else if ASectionName = '.rodata' then
    Result := lskRData
  else if ASectionName = '.data' then
    Result := lskData
  else if ASectionName = '.bss' then
    Result := lskBSS
  else
    Result := lskOther;
end;

procedure TMyrELFLinker.BuildGlobalSymbolIndex();
var
  LI: Integer;
  LJ: Integer;
  LObj: TMyrELFObjFile;
  LSym: TMyrELFLinkSymbol;
  LList: TList<Integer>;
begin
  // Symbol name -> object indices that DEFINE it (global, in a real section)
  for LI := 0 to FObjects.Count - 1 do
  begin
    LObj := FObjects[LI];
    for LJ := 0 to High(LObj.Symbols) do
    begin
      LSym := LObj.Symbols[LJ];

      if LSym.SymbolName = '' then
        Continue;
      if (LSym.Info shr 4) <> STB_GLOBAL_ELF then
        Continue;
      if (LSym.Shndx = 0) or (LSym.Shndx >= Word(Length(LObj.Sections))) then
        Continue;

      if not FSymbolIndex.TryGetValue(LSym.SymbolName, LList) then
      begin
        LList := TList<Integer>.Create();
        FSymbolIndex.Add(LSym.SymbolName, LList);
      end;
      if (LList.Count = 0) or (LList[LList.Count - 1] <> LI) then
        LList.Add(LI);
    end;
  end;
end;

procedure TMyrELFLinker.SelectObject(const AObjectIndex: Integer;
  const AWorkList: TList<Integer>);
var
  LObj: TMyrELFObjFile;
  LSym: TMyrELFLinkSymbol;
  LI: Integer;
  LDefObjList: TList<Integer>;
begin
  LObj := FObjects[AObjectIndex];
  if LObj.Selected then
    Exit;

  LObj.Selected := True;
  Status('ELF Linker: selected object [%d] %s',
    [AObjectIndex, TPath.GetFileName(LObj.SourcePath)]);

  // Undefined globals in this object pull in their defining objects
  for LI := 0 to High(LObj.Symbols) do
  begin
    LSym := LObj.Symbols[LI];
    if (LSym.SymbolName = '') or ((LSym.Info shr 4) <> STB_GLOBAL_ELF) then
      Continue;

    if LSym.Shndx = 0 then
    begin
      if FSymbolIndex.TryGetValue(LSym.SymbolName, LDefObjList) then
      begin
        if (LDefObjList.Count > 0) and (not FObjects[LDefObjList[0]].Selected) then
          AWorkList.Add(LDefObjList[0]);
      end;
    end;
  end;
end;

function TMyrELFLinker.AlignUp(const AValue: Cardinal;
  const AAlignment: Cardinal): Cardinal;
var
  LMask: Cardinal;
begin
  if AAlignment <= 1 then
    Result := AValue
  else
  begin
    LMask := AAlignment - 1;
    Result := (AValue + LMask) and (not LMask);
  end;
end;

function TMyrELFLinker.FindContribution(const AList: TList<TMyrLinkerContribution>;
  const AObjectIndex: Integer; const ASectionIndex: Integer;
  out ABase: Cardinal): Boolean;
var
  LK: Integer;
begin
  Result := False;
  ABase := 0;
  for LK := 0 to AList.Count - 1 do
  begin
    if (AList[LK].ObjectIndex = AObjectIndex) and
       (AList[LK].OrigSectionIndex = ASectionIndex) then
    begin
      ABase := AList[LK].MergedOffset;
      Result := True;
      Exit;
    end;
  end;
end;

procedure TMyrELFLinker.MergeSelectedObjects();
var
  LI: Integer;
  LJ: Integer;
  LObj: TMyrELFObjFile;
  LSect: TMyrELFLinkSection;
  LKind: TMyrLinkerSectionKind;
  LContrib: TMyrLinkerContribution;
  LTarget: TMemoryStream;
  LContribList: TList<TMyrLinkerContribution>;
  LAlignment: Cardinal;
  LCurrentSize: Cardinal;
  LAlignedSize: Cardinal;
  LPadding: Cardinal;
  LZeroByte: Byte;
begin
  LZeroByte := 0;

  for LI := 0 to FObjects.Count - 1 do
  begin
    LObj := FObjects[LI];
    if not LObj.Selected then
      Continue;

    for LJ := 0 to High(LObj.Sections) do
    begin
      LSect := LObj.Sections[LJ];
      LKind := ClassifySection(LSect.SectionName);

      if (LSect.DataSize = 0) or (LKind = lskOther) then
        Continue;
      // Only merge data-bearing kinds and BSS
      if not (LSect.ShType in [SHT_PROGBITS, SHT_NOBITS]) then
        Continue;

      LTarget := nil;
      LContribList := nil;
      LAlignment := 1;

      case LKind of
        lskText:
        begin
          LTarget := FMergedText;
          LContribList := FTextContribs;
          LAlignment := 16;
        end;
        lskRData:
        begin
          LTarget := FMergedRData;
          LContribList := FRDataContribs;
          LAlignment := 4;
        end;
        lskData,
        lskBSS:
        begin
          // BSS merges into .data as zero-filled bytes
          LTarget := FMergedData;
          LContribList := FDataContribs;
          LAlignment := 8;
        end;
      end;

      if (LTarget = nil) or (LContribList = nil) then
        Continue;

      // Align the stream
      LCurrentSize := Cardinal(LTarget.Size);
      LAlignedSize := AlignUp(LCurrentSize, LAlignment);
      LPadding := LAlignedSize - LCurrentSize;
      while LPadding > 0 do
      begin
        LTarget.WriteBuffer(LZeroByte, 1);
        Dec(LPadding);
      end;

      LContrib.ObjectIndex := LI;
      LContrib.OrigSectionIndex := LJ;
      LContrib.MergedOffset := Cardinal(LTarget.Size);
      LContrib.MergedSize := LSect.DataSize;
      LContribList.Add(LContrib);

      if Length(LSect.RawData) > 0 then
        LTarget.WriteBuffer(LSect.RawData[0], LSect.DataSize)
      else
      begin
        // SHT_NOBITS: allocate zeroed space
        LPadding := LSect.DataSize;
        while LPadding > 0 do
        begin
          LTarget.WriteBuffer(LZeroByte, 1);
          Dec(LPadding);
        end;
      end;
    end;
  end;

  Status('ELF Linker: merged sections -- .text=%d .rodata=%d .data=%d bytes',
    [FMergedText.Size, FMergedRData.Size, FMergedData.Size]);
end;

procedure TMyrELFLinker.CollectRelocations();
var
  LI: Integer;
  LK: Integer;
  LObj: TMyrELFObjFile;
  LRela: TMyrELFLinkRela;
  LSym: TMyrELFLinkSymbol;
  LPending: TMyrLinkerPendingReloc;
  LKind: TMyrLinkerSectionKind;
  LMergedBase: Cardinal;
  LContribList: TList<TMyrLinkerContribution>;
  LTargetBase: Cardinal;
  LResSym: TMyrLinkerResolvedSymbol;
  LTargetKind: TMyrLinkerSectionKind;
  LTargetList: TList<TMyrLinkerContribution>;
begin
  for LI := 0 to FObjects.Count - 1 do
  begin
    LObj := FObjects[LI];
    if not LObj.Selected then
      Continue;

    for LK := 0 to High(LObj.Relas) do
    begin
      LRela := LObj.Relas[LK];

      if (LRela.TargetSection < 0) or
         (LRela.TargetSection >= Length(LObj.Sections)) then
        Continue;

      LKind := ClassifySection(LObj.Sections[LRela.TargetSection].SectionName);
      case LKind of
        lskText:  LContribList := FTextContribs;
        lskRData: LContribList := FRDataContribs;
        lskData,
        lskBSS:   LContribList := FDataContribs;
      else
        Continue;
      end;

      if not FindContribution(LContribList, LI, LRela.TargetSection, LMergedBase) then
        Continue;

      if Integer(LRela.SymIndex) >= Length(LObj.Symbols) then
        Continue;
      LSym := LObj.Symbols[LRela.SymIndex];

      LPending.SectionKind := LKind;
      LPending.OffsetInMerged := LMergedBase + Cardinal(LRela.RelaOffset);
      LPending.RelocationType := Word(LRela.RelType);
      LPending.Addend := Int32(LRela.Addend);

      // Section symbols AND local (file-scope) defined symbols both resolve
      // through their owning section: a foreign compiler's static
      // functions/data are STB_LOCAL with st_value = offset in section.
      if (((LSym.Info and $F) = STT_SECTION_ELF) or
          (((LSym.Info shr 4) = STB_LOCAL) and (LSym.SymbolName <> ''))) and
         (LSym.Shndx > 0) and (LSym.Shndx < Word(Length(LObj.Sections))) then
      begin
        // Section symbol -- synthesize a unique internal name and register
        // its merged offset so the writer resolves it like any other symbol
        LPending.TargetSymbol := Format('__sect_%d_%d_%s',
          [LI, LSym.Shndx, LObj.Sections[LSym.Shndx].SectionName]);
        // Symbol-relative: fold st_value into the addend (0 for true section
        // symbols, the in-section offset for local function/data symbols)
        LPending.Addend := LPending.Addend + Int32(LSym.Value);

        if not FResolvedSymbols.ContainsKey(LPending.TargetSymbol) then
        begin
          LTargetKind := ClassifySection(LObj.Sections[LSym.Shndx].SectionName);
          case LTargetKind of
            lskText:  LTargetList := FTextContribs;
            lskRData: LTargetList := FRDataContribs;
            lskData,
            lskBSS:   LTargetList := FDataContribs;
          else
            LTargetList := nil;
          end;
          LResSym.SymbolName := LPending.TargetSymbol;
          LResSym.SectionKind := LTargetKind;
          LResSym.OffsetInMerged := 0;
          if (LTargetList <> nil) and
             FindContribution(LTargetList, LI, LSym.Shndx, LTargetBase) then
            LResSym.OffsetInMerged := LTargetBase;
          FResolvedSymbols.Add(LPending.TargetSymbol, LResSym);
        end;
      end
      else
        LPending.TargetSymbol := LSym.SymbolName;

      FPendingRelocs.Add(LPending);
    end;
  end;

  Status('ELF Linker: collected %d pending relocations', [FPendingRelocs.Count]);
end;

procedure TMyrELFLinker.AddObjectFile(const APath: string);
var
  LData: TBytes;
  LObj: TMyrELFObjFile;
begin
  if not FileExists(APath) then
  begin
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_ELFLINK_OBJ_NOT_FOUND,
        'Object file not found: %s', [APath]);
    Status('ELF Linker: object file not found: %s', [APath]);
    Exit;
  end;

  LData := TFile.ReadAllBytes(APath);
  LObj := ParseELFObject(LData, APath);
  if LObj <> nil then
  begin
    FObjects.Add(LObj);
    Status('ELF Linker: added object file: %s (%d sections, %d symbols)',
      [APath, Length(LObj.Sections), Length(LObj.Symbols)]);
  end;
end;

procedure TMyrELFLinker.AddLibraryFile(const APath: string; const ADebug: Boolean);
var
  LData: TBytes;
begin
  if not FileExists(APath) then
  begin
    if Assigned(FErrors) then
      FErrors.Add(esError, MYR_ERR_ELFLINK_LIB_NOT_FOUND,
        'Library file not found: %s', [APath]);
    Status('ELF Linker: library file not found: %s', [APath]);
    Exit;
  end;

  LData := TFile.ReadAllBytes(APath);
  ParseARLibrary(LData, APath, ADebug);
end;

procedure TMyrELFLinker.AddObjectFromMemory(const AData: TBytes;
  const AName: string);
var
  LObj: TMyrELFObjFile;
begin
  LObj := ParseELFObject(AData, AName);
  if LObj <> nil then
  begin
    FObjects.Add(LObj);
    Status('ELF Linker: added in-memory object: %s (%d sections, %d symbols)',
      [AName, Length(LObj.Sections), Length(LObj.Symbols)]);
  end;
end;

procedure TMyrELFLinker.Resolve(const ANeededSymbols: TStrings);
var
  LI: Integer;
  LJ: Integer;
  LWorkList: TList<Integer>;
  LDefObjList: TList<Integer>;
  LSymName: string;
  LObj: TMyrELFObjFile;
  LSym: TMyrELFLinkSymbol;
  LResSym: TMyrLinkerResolvedSymbol;
  LContribList: TList<TMyrLinkerContribution>;
  LBase: Cardinal;
  LKind: TMyrLinkerSectionKind;
begin
  Status('ELF Linker: resolving %d needed symbols across %d objects',
    [ANeededSymbols.Count, FObjects.Count]);

  // Phase 1: global symbol index
  BuildGlobalSymbolIndex();

  // Phase 2: select defining objects + transitive dependencies
  LWorkList := TList<Integer>.Create();
  try
    for LI := 0 to ANeededSymbols.Count - 1 do
    begin
      LSymName := ANeededSymbols[LI];
      if FSymbolIndex.TryGetValue(LSymName, LDefObjList) then
      begin
        if LDefObjList.Count > 0 then
          LWorkList.Add(LDefObjList[0]);
      end;
    end;

    LI := 0;
    while LI < LWorkList.Count do
    begin
      SelectObject(LWorkList[LI], LWorkList);
      Inc(LI);
    end;
  finally
    LWorkList.Free();
  end;

  // Phase 3: merge sections
  MergeSelectedObjects();

  // Phase 4: resolved symbol map (defined globals in selected objects)
  for LI := 0 to FObjects.Count - 1 do
  begin
    LObj := FObjects[LI];
    if not LObj.Selected then
      Continue;

    for LJ := 0 to High(LObj.Symbols) do
    begin
      LSym := LObj.Symbols[LJ];
      if (LSym.SymbolName = '') or ((LSym.Info shr 4) <> STB_GLOBAL_ELF) then
        Continue;
      if (LSym.Shndx = 0) or (LSym.Shndx >= Word(Length(LObj.Sections))) then
        Continue;

      LKind := ClassifySection(LObj.Sections[LSym.Shndx].SectionName);
      case LKind of
        lskText:  LContribList := FTextContribs;
        lskRData: LContribList := FRDataContribs;
        lskData,
        lskBSS:   LContribList := FDataContribs;
      else
        Continue;
      end;

      if FindContribution(LContribList, LI, LSym.Shndx, LBase) then
      begin
        LResSym.SymbolName := LSym.SymbolName;
        LResSym.SectionKind := LKind;
        LResSym.OffsetInMerged := LBase + Cardinal(LSym.Value);
        if not FResolvedSymbols.ContainsKey(LSym.SymbolName) then
          FResolvedSymbols.Add(LSym.SymbolName, LResSym);
      end;
    end;
  end;

  // Phase 5: relocations
  CollectRelocations();

  // Phase 6: unresolved needed symbols
  for LI := 0 to ANeededSymbols.Count - 1 do
  begin
    if not FResolvedSymbols.ContainsKey(ANeededSymbols[LI]) then
      FUnresolvedSymbols.Add(ANeededSymbols[LI]);
  end;

  Status('ELF Linker: resolved %d symbols, %d unresolved, %d pending relocations',
    [FResolvedSymbols.Count, FUnresolvedSymbols.Count, FPendingRelocs.Count]);
  for LI := 0 to FUnresolvedSymbols.Count - 1 do
    Status('ELF Linker: unresolved symbol: %s', [FUnresolvedSymbols[LI]]);
end;

function TMyrELFLinker.GetMergedText(): TBytes;
begin
  SetLength(Result, FMergedText.Size);
  if FMergedText.Size > 0 then
  begin
    FMergedText.Position := 0;
    FMergedText.ReadBuffer(Result[0], FMergedText.Size);
  end;
end;

function TMyrELFLinker.GetMergedTextSize(): Cardinal;
begin
  Result := Cardinal(FMergedText.Size);
end;

function TMyrELFLinker.GetMergedRData(): TBytes;
begin
  SetLength(Result, FMergedRData.Size);
  if FMergedRData.Size > 0 then
