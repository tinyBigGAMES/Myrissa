function TMyrIR.Syscall(const ANumber: TMyrIRExpr; const AArgs: array of TMyrIRExpr): TMyrIRExpr;
var
  LNode: TMyrIRExprNode;
  LI: Integer;
begin
  Result.Index := -1;

  // System V x86-64 passes at most 6 syscall arguments in registers.
  if Length(AArgs) > MAX_SYSCALL_ARGS then
  begin
    GetErrors().Add(TErrorSeverity.esError, MYR_ERR_TOO_MANY_ARGS,
      RSIRSyscallTooManyArgs, [Length(AArgs), MAX_SYSCALL_ARGS]);
    Exit;
  end;

  LNode := Default(TMyrIRExprNode);
  LNode.Kind := ekSyscall;
  LNode.ResultType := TMyrTypeRef.FromPrimitive(cvtInt64);
  LNode.SyscallNumber := ANumber.Index;

  SetLength(LNode.CallArgs, Length(AArgs));
  for LI := 0 to System.High(AArgs) do
    LNode.CallArgs[LI] := AArgs[LI].Index;

  Result := AddExpr(LNode);
end;


procedure TMyrIR.Clear();
var
  LI: Integer;
begin
  for LI := 0 to FFunctions.Count - 1 do
  begin
    FFunctions[LI].Vars.Free();
    FFunctions[LI].Stmts.Free();
  end;

  FImports.Clear();
  FStrings.Clear();
  FGlobals.Clear();
  FFunctions.Clear();
  FExpressions.Clear();
  FTypes.Clear();
  FCurrentFunc := -1;
  FBuildingRecordIndex := -1;
  FBuildingUnionIndex := -1;
  FBuildingEnumIndex := -1;
  FNextEnumOrdinal := 0;
  FNextOverlayGroup := 0;
  FAnonUnionFieldStart := -1;
  FNextAnonRecordGroup := 0;
  FAnonRecordInUnion := False;
  FSnapshotFuncs := -1;
  FSnapshotImports := -1;
  FSnapshotStrings := -1;
  FSnapshotGlobals := -1;
  FSnapshotExprs := -1;
end;

procedure TMyrIR.ResolveImportTypeRefs();
var
  LI: Integer;
  LJ: Integer;
  LImport: TMyrIRImport;
  LTypeIndex: Integer;
begin
  for LI := 0 to FImports.Count - 1 do
  begin
    LImport := FImports[LI];
    if Length(LImport.ParamTypeNames) = 0 then
      Continue;

    for LJ := 0 to Length(LImport.ParamTypeNames) - 1 do
    begin
      // Skip already-resolved or primitive types
      if LImport.ParamTypeRefs[LJ].IsValid() then
        Continue;

      // Try to resolve the deferred type name
      LTypeIndex := FindType(LImport.ParamTypeNames[LJ]);
      if LTypeIndex >= 0 then
      begin
        LImport.ParamTypeRefs[LJ] := TMyrTypeRef.FromComposite(LTypeIndex);
        LImport.ParamTypes[LJ] := cvtVoid;
      end;
    end;

    FImports[LI] := LImport;
  end;
end;

procedure TMyrIR.SaveSnapshot();
begin
  FSnapshotFuncs := FFunctions.Count;
  FSnapshotImports := FImports.Count;
  FSnapshotStrings := FStrings.Count;
  FSnapshotGlobals := FGlobals.Count;
  FSnapshotExprs := FExpressions.Count;
end;

procedure TMyrIR.RestoreSnapshot();
var
  LI: Integer;
  LCount: Integer;
begin
  if FSnapshotFuncs < 0 then
    Exit;

  // Free owned sub-objects on functions being removed
  for LI := FFunctions.Count - 1 downto FSnapshotFuncs do
  begin
    FFunctions[LI].Vars.Free();
    FFunctions[LI].Stmts.Free();
  end;

  // Truncate all lists back to snapshot point
  LCount := FFunctions.Count - FSnapshotFuncs;
  if LCount > 0 then
    FFunctions.DeleteRange(FSnapshotFuncs, LCount);

  LCount := FImports.Count - FSnapshotImports;
  if LCount > 0 then
    FImports.DeleteRange(FSnapshotImports, LCount);

  LCount := FStrings.Count - FSnapshotStrings;
  if LCount > 0 then
    FStrings.DeleteRange(FSnapshotStrings, LCount);

  LCount := FGlobals.Count - FSnapshotGlobals;
  if LCount > 0 then
    FGlobals.DeleteRange(FSnapshotGlobals, LCount);

  LCount := FExpressions.Count - FSnapshotExprs;
  if LCount > 0 then
    FExpressions.DeleteRange(FSnapshotExprs, LCount);

  // Reset snapshot
  FSnapshotFuncs := -1;
end;

function TMyrIR.GetUserFuncCount(): Integer;
begin
  if FSnapshotFuncs < 0 then
    Result := FFunctions.Count
  else
    Result := FSnapshotFuncs;
end;

function TMyrIR.HasStaticImports(): Boolean;
var
  LI: Integer;
begin
  Result := False;
  for LI := 0 to FImports.Count - 1 do
  begin
    if FImports[LI].IsStatic then
      Exit(True);
  end;
end;

procedure TMyrIR.ExternalizeRuntime();
var
  LI: Integer;
  LFunc: TMyrIRFunc;
  LGlobal: TMyrIRGlobal;
  LImport: TMyrIRImport;
begin
  // C model for static libs: the archive REFERENCES the runtime, the
  // consumer PROVIDES it. Every runtime function injected after the
  // snapshot becomes an undefined static import (DllName = '' means
  // "consumer provides", no lib lookup); every runtime global becomes an
  // import-backed global so lib code reads the consumer's single copy.
  if FSnapshotFuncs < 0 then
    Exit;

  // (1) Runtime functions -> static imports. Reverse order so DeleteRange
  // below removes exactly the tail.
  for LI := FFunctions.Count - 1 downto FSnapshotFuncs do
  begin
    LFunc := FFunctions[LI];
    LImport := Default(TMyrIRImport);
    LImport.DllName := '';
    LImport.FuncName := LFunc.FuncName;
    LImport.ReturnType := LFunc.ReturnType;
    LImport.ParamTypes := Copy(LFunc.ParamTypes);
    LImport.IsVarArgs := LFunc.IsVariadic;
    LImport.IsStatic := True;
    LImport.Linkage := LFunc.Linkage;
    LImport.IsNoReturn := LFunc.IsNoReturn;
    FImports.Add(LImport);
    LFunc.Vars.Free();
    LFunc.Stmts.Free();
  end;
  FFunctions.DeleteRange(FSnapshotFuncs, FFunctions.Count - FSnapshotFuncs);

  // (2) Runtime globals -> import-backed (same shape as ImportLibGlobal).
  // Globals are NOT deleted: user code may reference them by index.
  for LI := FSnapshotGlobals to FGlobals.Count - 1 do
  begin
    LGlobal := FGlobals[LI];
    LImport := Default(TMyrIRImport);
    LImport.DllName := '';
    LImport.FuncName := LGlobal.GlobalName;
    LImport.ReturnType := cvtVoid;
    LImport.IsStatic := True;
    LImport.Linkage := plC;
    LGlobal.ImportIndex := FImports.Count;
    FImports.Add(LImport);
    LGlobal.InitExpr := -1;
    LGlobal.IsPublic := False;
    FGlobals[LI] := LGlobal;
  end;

  // (3) Strings and expressions above the snapshot were referenced only by
  // the runtime bodies just removed.
  if FSnapshotStrings >= 0 then
    FStrings.DeleteRange(FSnapshotStrings, FStrings.Count - FSnapshotStrings);
  if FSnapshotExprs >= 0 then
    FExpressions.DeleteRange(FSnapshotExprs, FExpressions.Count - FSnapshotExprs);
end;

