  { TMyrLinker }
  TMyrLinker = class(TBaseObject)
  public
    constructor Create(); override;
    destructor Destroy(); override;

    // Input — add files to link
    procedure AddObjectFile(const APath: string); virtual;
    procedure AddLibraryFile(const APath: string; const ADebug: Boolean); virtual;
    procedure AddObjectFromMemory(const AData: TBytes; const AName: string); virtual;

    // Processing — resolve symbols and merge sections
    procedure Resolve(const ANeededSymbols: TStrings); virtual;

    // Output — merged section data
    function GetMergedText(): TBytes; virtual;
    function GetMergedTextSize(): Cardinal; virtual;
    function GetMergedRData(): TBytes; virtual;
    function GetMergedRDataSize(): Cardinal; virtual;
    function GetMergedData(): TBytes; virtual;
    function GetMergedDataSize(): Cardinal; virtual;
    function GetMergedPData(): TBytes; virtual;
    function GetMergedPDataSize(): Cardinal; virtual;
    function GetMergedXData(): TBytes; virtual;
    function GetMergedXDataSize(): Cardinal; virtual;

    // Symbol info
    function GetResolvedSymbols(): TDictionary<string, TMyrLinkerResolvedSymbol>; virtual;
    function GetUnresolvedSymbols(): TStringList; virtual;
    function GetPendingRelocations(): TList<TMyrLinkerPendingReloc>; virtual;

    // Register a symbol the consuming module itself provides (its own
    // runtime routine or global). Undefined references in linked objects
    // bind to it exactly as they would to another object's definition.
    // AKind is lskHostText or lskHostData; AOffset is the absolute offset
    // in the consumer's section. A linked-object definition of the same
    // name is left untouched -- the object wins.
    procedure AddHostSymbol(const AName: string; const AKind: TMyrLinkerSectionKind;
      const AOffset: Cardinal); virtual;

    // True when any loaded archive/object defines AName (symbol-table lookup only)
    function HasSymbol(const AName: string): Boolean; virtual;

    // Deferred static-lib dependencies declared by linked objects
    // (COFF /DEFAULTLIB drectve, ELF .note.myrissa.needlib)
    function GetNeededLibs(): TArray<string>; virtual;

    // IMPORT_OBJECT records collected from import-library members
    // (COFF short-import format; empty on formats without one)
    function GetShortImports(): TArray<TMyrShortImportEntry>; virtual;

    // Myrissa needdll note: triples of NUL-terminated strings (referenced
    // symbol, exported symbol, owning DLL/.so). One format, one parser, for
    // ELF .note.myrissa.needdll and COFF .myrissa.needdll alike.
    function ParseNeedDllNote(const ARaw: TBytes): TArray<TMyrShortImportEntry>;

    // Diagnostics
    function GetObjectCount(): Integer; virtual;
    function GetSelectedObjectCount(): Integer; virtual;
  end;

