function TMyrIR.EndFunc(): TMyrIR;
var
  LFunc: TMyrIRFunc;
  LNeedsReturn: Boolean;
begin
  // Ensure function has a return statement at the end
  LFunc := GetCurrentFunc();
  LNeedsReturn := True;
  if LFunc.Stmts.Count > 0 then
  begin
    if LFunc.Stmts[LFunc.Stmts.Count - 1].Kind in [skReturn, skReturnValue] then
      LNeedsReturn := False;
  end;
  if LNeedsReturn then
    Return();

  FCurrentFunc := -1;
  Result := Self;
end;

procedure TMyrIR.NormalizeNoReturnTerminators();
var
  LI: Integer;
  LFunc: TMyrIRFunc;
  LCount: Integer;
  LTargetIdx: Integer;
begin
  // A call to a noreturn function (TMyrIRFunc.IsNoReturn) is a block
  // terminator, the same as return. EndFunc cannot know that at the time
  // it runs -- user code is emitted BEFORE the runtime is injected, so the
  // callee (RT_Halt) does not exist yet when main's EndFunc appends its
  // implicit return. That return is unreachable, and every later pass had
  // to special-case the dead tail it produced.
  //
  // Run once after the runtime is injected, when every function is known:
  // drop the implicit void return that directly follows a noreturn call.
  // Only a bare skReturn is removed -- a value return is user intent.
  for LI := 0 to FFunctions.Count - 1 do
  begin
    LFunc := FFunctions[LI];
    LCount := LFunc.Stmts.Count;
    if LCount < 2 then
      Continue;
    if LFunc.Stmts[LCount - 1].Kind <> skReturn then
      Continue;
    if LFunc.Stmts[LCount - 2].Kind <> skCall then
      Continue;

    LTargetIdx := FindLocalFunc(LFunc.Stmts[LCount - 2].CallTarget);
    if (LTargetIdx >= 0) and FFunctions[LTargetIdx].IsNoReturn then
    begin
      LFunc.Stmts.Delete(LCount - 1);
      Continue;
    end;

    // In a static lib the runtime is externalized: RT_Halt is an import,
    // and the noreturn fact travels with it (TMyrIRImport.IsNoReturn).
    LTargetIdx := FindImport(LFunc.Stmts[LCount - 2].CallTarget);
    if (LTargetIdx >= 0) and FImports[LTargetIdx].IsNoReturn then
      LFunc.Stmts.Delete(LCount - 1);
  end;
end;

