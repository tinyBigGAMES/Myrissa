function TMyrIR.On(const AValues: array of TMyrIRExpr): TMyrIR;
var
  LStmt: TMyrIRStmt;
  LFunc: TMyrIRFunc;
  LI: Integer;
  LExpr: TMyrIRExprNode;
begin
  LFunc := GetCurrentFunc();

  LStmt := Default(TMyrIRStmt); LStmt.SourceFile := FCurrentSourceFile; LStmt.SourceLine := FCurrentSourceLine; LStmt.SourceColumn := FCurrentSourceColumn;
  LStmt.Kind := skOn;

  // Extract constant values from expressions
  SetLength(LStmt.CaseValues, Length(AValues));
  for LI := 0 to System.High(AValues) do
  begin
    if (AValues[LI].Index >= 0) and (AValues[LI].Index < FExpressions.Count) then
    begin
      LExpr := FExpressions[AValues[LI].Index];
      if LExpr.Kind = ekConstInt then
        LStmt.CaseValues[LI] := LExpr.ConstInt
      else
        LStmt.CaseValues[LI] := 0;  // Non-constant expression - error case
    end
    else
      LStmt.CaseValues[LI] := 0;
  end;

  LStmt.SourceLine := FCurrentSourceLine;
  LStmt.SourceColumn := FCurrentSourceColumn;
    LStmt.SourceFile := FCurrentSourceFile;
  LFunc.Stmts.Add(LStmt);
  FFunctions[FCurrentFunc] := LFunc;
  Result := Self;
end;

function TMyrIR.On(const AValues: array of Integer): TMyrIR;
var
  LStmt: TMyrIRStmt;
  LFunc: TMyrIRFunc;
  LI: Integer;
begin
  LFunc := GetCurrentFunc();

  LStmt := Default(TMyrIRStmt); LStmt.SourceFile := FCurrentSourceFile; LStmt.SourceLine := FCurrentSourceLine; LStmt.SourceColumn := FCurrentSourceColumn;
  LStmt.Kind := skOn;

  // Store raw integer values directly (these are case match values, not expression indices)
  SetLength(LStmt.CaseValues, Length(AValues));
  for LI := 0 to System.High(AValues) do
    LStmt.CaseValues[LI] := AValues[LI];

  LStmt.SourceLine := FCurrentSourceLine;
  LStmt.SourceColumn := FCurrentSourceColumn;
    LStmt.SourceFile := FCurrentSourceFile;
  LFunc.Stmts.Add(LStmt);
  FFunctions[FCurrentFunc] := LFunc;
  Result := Self;
end;

function TMyrIR.On(const AValues: array of TMyrIRExpr; const ARanges: array of TMyrIRCaseRange;
  const AIsUnsigned: Boolean): TMyrIR;
var
  LStmt: TMyrIRStmt;
  LFunc: TMyrIRFunc;
  LI: Integer;
  LExpr: TMyrIRExprNode;
begin
  LFunc := GetCurrentFunc();

  LStmt := Default(TMyrIRStmt);
  LStmt.Kind := skOn;
  LStmt.SourceFile := FCurrentSourceFile;
  LStmt.SourceLine := FCurrentSourceLine;
  LStmt.SourceColumn := FCurrentSourceColumn;

  // Discrete labels: extract the constant value out of each expression.
  SetLength(LStmt.CaseValues, Length(AValues));
  for LI := 0 to System.High(AValues) do
  begin
    if (AValues[LI].Index >= 0) and (AValues[LI].Index < FExpressions.Count) then
    begin
      LExpr := FExpressions[AValues[LI].Index];
      if LExpr.Kind = ekConstInt then
        LStmt.CaseValues[LI] := LExpr.ConstInt
      else
        LStmt.CaseValues[LI] := 0;  // Non-constant expression - error case
    end
    else
      LStmt.CaseValues[LI] := 0;
  end;

  // Range labels are carried verbatim; lowering to compares happens in SSA.
  // An inverted range (low > high) needs no guard here - it simply never
  // matches, which is the same behaviour the old label expansion produced.
  SetLength(LStmt.CaseRanges, Length(ARanges));
  for LI := 0 to System.High(ARanges) do
    LStmt.CaseRanges[LI] := ARanges[LI];

  // Selector signedness, resolved by the frontend. SSA lowers the range
  // compares and cannot determine this itself.
  LStmt.IsUnsignedCompare := AIsUnsigned;

  LFunc.Stmts.Add(LStmt);
  FFunctions[FCurrentFunc] := LFunc;
  Result := Self;
end;

