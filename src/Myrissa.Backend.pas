function TMyrIR.BlockCopy(const ADest: TMyrIRExpr; const ASrc: TMyrIRExpr;
  const ASize: Integer): TMyrIR;
var
  LStmt: TMyrIRStmt;
  LFunc: TMyrIRFunc;
begin
  // Whole-object move. ADest and ASrc must both be ADDRESS expressions -
  // a composite value expression lowers to an 8-byte scalar load, which is
  // the defect this operation exists to fix.
  LFunc := GetCurrentFunc();

  LStmt := Default(TMyrIRStmt); LStmt.SourceFile := FCurrentSourceFile; LStmt.SourceLine := FCurrentSourceLine; LStmt.SourceColumn := FCurrentSourceColumn;
  LStmt.Kind := skBlockCopy;
  LStmt.DestVar := '';
  LStmt.DestExpr := ADest.Index;
  LStmt.Expr := ASrc.Index;
  LStmt.CopySize := ASize;

  LFunc.Stmts.Add(LStmt);
  FFunctions[FCurrentFunc] := LFunc;
  Result := Self;
end;

