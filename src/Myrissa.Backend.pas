function TMyrIR.Str(const AValue: string): TMyrIRExpr;
var
  LNode: TMyrIRExprNode;
  LStr: TMyrIRString;
begin
  // Add string to table
  LStr := Default(TMyrIRString);
  LStr.Value := AValue;
  LStr.IsWide := False;
  FStrings.Add(LStr);

  // Create expression. A literal lowers to the ADDRESS of its .rdata bytes
  // (ekConstString -> sikAssign FromData), so its type is a pointer. Left at
  // Default this read as composite type #0 to any ResultType consumer.
  LNode := Default(TMyrIRExprNode);
  LNode.Kind := ekConstString;
  LNode.StringIndex := FStrings.Count - 1;
  LNode.ResultType := TMyrTypeRef.FromPrimitive(cvtPointer);
  Result := AddExpr(LNode);
end;

