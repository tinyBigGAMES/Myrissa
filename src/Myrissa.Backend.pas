function TMyrCodeBuilder.OpSetLiteral(const AElements: array of Integer; const ALowBound: Integer; const AStorageSize: Integer): TMyrTempHandle;
var
  LBitPattern: UInt64;
  LI: Integer;
  LInstr: TMyrInstruction;
begin
  // Compute the bit pattern from elements
  LBitPattern := 0;
  for LI := 0 to High(AElements) do
    LBitPattern := LBitPattern or (UInt64(1) shl (AElements[LI] - ALowBound));
  
  // Create temp with the bit pattern as immediate
  Result := AllocTemp();
  
  LInstr := Default(TMyrInstruction);
  LInstr.Kind := ikBitOr;  // Use OR with 0 to load immediate
  LInstr.Dest := Result;
  LInstr.Op1 := TMyrOperand.FromImm(0);
  LInstr.Op2 := TMyrOperand.FromImm(Int64(LBitPattern));
  AddInstr(LInstr);
end;

function TMyrCodeBuilder.OpSetUnion(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
begin
  // Union is bitwise OR
  Result := OpOr(ALeft, ARight);
end;

function TMyrCodeBuilder.OpSetDiff(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
var
  LNotRight: TMyrTempHandle;
begin
  // Difference is A AND (NOT B)
  LNotRight := OpNot(ARight);
  Result := OpAnd(ALeft, TMyrOperand.FromTemp(LNotRight));
end;

function TMyrCodeBuilder.OpSetInter(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
begin
  // Intersection is bitwise AND
  Result := OpAnd(ALeft, ARight);
end;

function TMyrCodeBuilder.OpSetIn(const AElement, ASet: TMyrOperand; const ALowBound: Integer): TMyrTempHandle;
var
  LAdjustedElement: TMyrTempHandle;
  LMask: TMyrTempHandle;
  LAndResult: TMyrTempHandle;
  LMemberResult: TMyrTempHandle;
  LNotNeg: TMyrTempHandle;
  LInRange: TMyrTempHandle;
  LBoundsOk: TMyrTempHandle;
begin
  // Test if element is in set: ((1 << (element - lowbound)) AND set) <> 0
  // With bounds check: adjusted must be in [0..63] to avoid SHL wrap-around
  
  // Adjust element by lowbound if needed
  if ALowBound <> 0 then
    LAdjustedElement := OpSub(AElement, TMyrOperand.FromImm(ALowBound))
  else
  begin
    // Just use element directly - copy to temp
    LAdjustedElement := OpAdd(AElement, TMyrOperand.FromImm(0));
  end;
  
  // Bounds check: adjusted >= 0 AND adjusted < 64
  LNotNeg := CmpGe(TMyrOperand.FromTemp(LAdjustedElement), TMyrOperand.FromImm(0));
  LInRange := CmpLt(TMyrOperand.FromTemp(LAdjustedElement), TMyrOperand.FromImm(64));
  LBoundsOk := OpAnd(TMyrOperand.FromTemp(LNotNeg), TMyrOperand.FromTemp(LInRange));
  
  // Create mask: 1 << adjustedElement
  LMask := OpShl(TMyrOperand.FromImm(1), TMyrOperand.FromTemp(LAdjustedElement));
  
  // AND with set
  LAndResult := OpAnd(TMyrOperand.FromTemp(LMask), ASet);
  
  // Compare with 0 (result is 1 if in set, 0 if not)
  LMemberResult := CmpNe(TMyrOperand.FromTemp(LAndResult), TMyrOperand.FromImm(0));
  
  // Final result: membership AND bounds check
  Result := OpAnd(TMyrOperand.FromTemp(LMemberResult), TMyrOperand.FromTemp(LBoundsOk));
end;

function TMyrCodeBuilder.OpSetEq(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
begin
  // Set equality is direct comparison
  Result := CmpEq(ALeft, ARight);
end;

function TMyrCodeBuilder.OpSetNe(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
begin
  // Set inequality is direct comparison
  Result := CmpNe(ALeft, ARight);
end;

function TMyrCodeBuilder.OpSetSubset(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
var
  LAndResult: TMyrTempHandle;
begin
  // A <= B (subset): (A AND B) = A
  LAndResult := OpAnd(ALeft, ARight);
  Result := CmpEq(TMyrOperand.FromTemp(LAndResult), ALeft);
end;

function TMyrCodeBuilder.OpSetSuperset(const ALeft, ARight: TMyrOperand): TMyrTempHandle;
var
  LAndResult: TMyrTempHandle;
begin
  // A >= B (superset): (A AND B) = B
  LAndResult := OpAnd(ALeft, ARight);
  Result := CmpEq(TMyrOperand.FromTemp(LAndResult), ARight);
end;

function TMyrCodeBuilder.VaCount(): TMyrTempHandle;
var
  LInstr: TMyrInstruction;
begin
  Result := AllocTemp();

  LInstr := Default(TMyrInstruction);
