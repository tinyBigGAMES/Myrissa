{ RebuildProductIData }
procedure RebuildProductIData(const AProduct: TMyrBuildProduct;
  const AImports: TMyrImportBuilder);
var
  LI: Integer;
  LJ: Integer;
  LEntry: TMyrImportEntry;
  LK: Integer;
  LIndex: Integer;

  procedure WriteIDataString(const AText: AnsiString);
  begin
    if Length(AText) > 0 then
      AProduct.IDataSection.WriteBuffer(AText[1], Length(AText));
    AProduct.IDataSection.WriteData(Byte(0));
  end;

  procedure AlignIData(const AAlign: Cardinal);
  begin
    while (Cardinal(AProduct.IDataSection.Size) mod AAlign) <> 0 do
      AProduct.IDataSection.WriteData(Byte(0));
  end;

begin
  // Reset every .idata product; IATEntries indices are import indices, so
  // static entries keep placeholder zeros.
  AProduct.IDataSection.Clear();
  AProduct.ImportDlls.Clear();
  AProduct.ImportsByDll.Clear();
  AProduct.IATEntries.Clear();
  AProduct.HintNamesOffset := 0;
  AProduct.INTOffset := 0;
  AProduct.IATOffset := 0;
  AProduct.DllNamesOffset := 0;

  // Map dynamic imports by DLL. Static imports resolve through archives and
  // never enter .idata; host imports belong to the in-memory mode.
  for LI := 0 to AImports.GetCount() - 1 do
  begin
    LEntry := AImports.GetEntryByIndex(LI);
    if LEntry.IsStatic then
      Continue;
    LIndex := AProduct.ImportDlls.IndexOf(LEntry.DllName);
    if LIndex < 0 then
    begin
      LIndex := AProduct.ImportDlls.Add(LEntry.DllName);
      AProduct.ImportsByDll.Add(TStringList.Create());
    end;
    // Loader-facing: the hint/name table must carry the symbol the DLL
    // exports, not the symbol this object references.
    AProduct.ImportsByDll[LIndex].AddObject(LEntry.ExternalName, TObject(LI));
  end;

  AProduct.HasImports := AImports.GetCount() > 0;
  if not AProduct.HasImports then
    Exit;

  // Layout:
  // 1. Import descriptors (one per DLL + null terminator)
  // 2. DLL names
  // 3. Hint/Name entries
  // 4. IAT (Import Address Table)
  // 5. INT (Import Name Table) - mirrors IAT

  // Write import descriptors (placeholders - RVAs fixed by the PE writer)
  for LI := 0 to AProduct.ImportDlls.Count - 1 do
  begin
    AProduct.IDataSection.WriteData(Cardinal(0));  // OriginalFirstThunk (INT)
    AProduct.IDataSection.WriteData(Cardinal(0));  // TimeDateStamp
    AProduct.IDataSection.WriteData(Cardinal(0));  // ForwarderChain
    AProduct.IDataSection.WriteData(Cardinal(0));  // Name
    AProduct.IDataSection.WriteData(Cardinal(0));  // FirstThunk (IAT)
  end;
  // Null terminator descriptor
  for LI := 1 to 5 do
    AProduct.IDataSection.WriteData(Cardinal(0));

  // Write DLL names
  AProduct.DllNamesOffset := AProduct.IDataSection.Size;
  for LI := 0 to AProduct.ImportDlls.Count - 1 do
    WriteIDataString(AnsiString(AProduct.ImportDlls[LI]));
  AlignIData(2);

  // Write hint/name entries
  AProduct.HintNamesOffset := AProduct.IDataSection.Size;
  for LI := 0 to AProduct.ImportDlls.Count - 1 do
  begin
    for LJ := 0 to AProduct.ImportsByDll[LI].Count - 1 do
    begin
      AProduct.IDataSection.WriteData(Word(0));  // Hint
      WriteIDataString(AnsiString(AProduct.ImportsByDll[LI][LJ]));
      AlignIData(2);
    end;
  end;
  AlignIData(8);

  // Write IAT
  AProduct.IATOffset := AProduct.IDataSection.Size;
  for LI := 0 to AProduct.ImportDlls.Count - 1 do
  begin
    for LJ := 0 to AProduct.ImportsByDll[LI].Count - 1 do
    begin
      // Store the IAT entry offset for this import
      LK := Integer(AProduct.ImportsByDll[LI].Objects[LJ]);  // Original import index
      while AProduct.IATEntries.Count <= LK do
        AProduct.IATEntries.Add(0);
      AProduct.IATEntries[LK] := AProduct.IDataSection.Size;
      AProduct.IDataSection.WriteData(UInt64(0));  // Placeholder - will point to hint/name
    end;
    AProduct.IDataSection.WriteData(UInt64(0));  // Null terminator
  end;

  // Write INT (mirrors IAT structure)
  AProduct.INTOffset := AProduct.IDataSection.Size;
  for LI := 0 to AProduct.ImportDlls.Count - 1 do
  begin
    for LJ := 0 to AProduct.ImportsByDll[LI].Count - 1 do
      AProduct.IDataSection.WriteData(UInt64(0));  // Placeholder
    AProduct.IDataSection.WriteData(UInt64(0));  // Null terminator
  end;
end;

