function TMyrImportBuilder.Add(const ADllName, AFuncName: string;
  const AReturnType: TMyrValueType; const AIsStatic: Boolean;
  const AHostAddr: Pointer): TMyrImportHandle;
var
  LEntry: TMyrImportEntry;
begin
  LEntry := Default(TMyrImportEntry);
  LEntry.DllName := ADllName;
  LEntry.FuncName := AFuncName;
  // Ordinary import: referenced symbol and exported symbol coincide.
  LEntry.ExternalName := AFuncName;
  LEntry.ReturnType := AReturnType;
  LEntry.IsStatic := AIsStatic;
  LEntry.HostAddr := AHostAddr;

  Result.Index := FEntries.Count;
  FEntries.Add(LEntry);
end;

function TMyrImportBuilder.Add(const ADllName, AFuncName: string;
  const AReturnType: TMyrValueType; const AIsStatic: Boolean;
  const ALinkage: TMyrLinkage; const AParamTypes: TArray<TMyrValueType>;
  const AHostAddr: Pointer): TMyrImportHandle;
begin
  Result := Add(ADllName, AFuncName, '', AReturnType, AIsStatic, ALinkage,
    AParamTypes, AHostAddr);
end;

function TMyrImportBuilder.Add(const ADllName, AFuncName, AExternalName: string;
  const AReturnType: TMyrValueType; const AIsStatic: Boolean;
  const ALinkage: TMyrLinkage; const AParamTypes: TArray<TMyrValueType>;
  const AHostAddr: Pointer): TMyrImportHandle;
var
  LEntry: TMyrImportEntry;
begin
  LEntry := Default(TMyrImportEntry);
  LEntry.DllName := ADllName;
  LEntry.FuncName := AFuncName;
  // Empty external name = ordinary import: referenced symbol and exported
  // symbol coincide. Non-empty = re-export forwarding pair.
  if AExternalName = '' then
    LEntry.ExternalName := AFuncName
  else
    LEntry.ExternalName := AExternalName;
  LEntry.ReturnType := AReturnType;
  LEntry.IsStatic := AIsStatic;
  LEntry.Linkage := ALinkage;
  LEntry.ParamTypes := Copy(AParamTypes);
  LEntry.HostAddr := AHostAddr;

  Result.Index := FEntries.Count;
  FEntries.Add(LEntry);
end;

