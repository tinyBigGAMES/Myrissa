function TMyrSSAFunc.IsByRefParam(const AName: string): Boolean;
var
  LI: Integer;
begin
  // True when AName is a BY-REF parameter of THIS function -- its slot
  // already holds the object's address, so a caller forwarding it as a var
  // argument must pass the slot's VALUE, never addrof(slot).
  Result := False;
  for LI := 0 to FLocals.Count - 1 do
  begin
    if (FLocals[LI].LocalName = AName) then
    begin
      Result := FLocals[LI].IsParam and FLocals[LI].IsByRef;
      Exit;
    end;
  end;
end;

